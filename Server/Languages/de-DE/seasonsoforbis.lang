# ---- Hytale's Anniversary: one day a year, with a banner, an Almanac page, that year's achievement and its title ----
calendar.hytale_anniversary.name = Hytale-Jubiläum
calendar.hytale_anniversary.flavor = Der Tag, an dem Hytale erschien. Wer jedes Jahr an diesem Tag hier ist, erhält den Jubiläumserfolg dieses Jahres.
calendar.hytale_anniversary.herald.start = Alles Gute zum Jubiläum, Hytale
