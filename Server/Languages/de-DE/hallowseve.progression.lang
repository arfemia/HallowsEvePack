# Allerheiligenabend-Fortschritt: die Questreihe des Alten Jack, Tagesaufgaben, Tafel und Stand, sein Gespräch und
# die Süßes-oder-Saures-Zeile, die Erfolge und der Titel der Saison und ihre Almanach-Seite.
# Die Schlüssel stehen ohne Präfix: die Bibliothek findet jeden an seinem Ende, egal wie diese Datei heißt.
# Zahlen kommen über {0} aus den Inhaltsdateien, also berührt eine Neuabstimmung nie eine Übersetzung.

# ---- Die Geldbörse ----
currency.hallows_eve_sweets.name = Allerheiligen-Naschwerk

# ---- Die Questreihe des Alten Jack ----
quest.hallows_eve_old_jack_meet.title = Laternen im Tempel
quest.hallows_eve_old_jack_meet.flavor = Es ist wieder Saison, also bin ich mit meinen Laternen zurück im Vergessenen Tempel. Jedes Tor zum Vergessenen Tempel bringt dich hin. Komm und such mich. Ich könnt 'ne Hand gebrauchen.
quest.hallows_eve_old_jack_1.title = Das Kürbisbeet
quest.hallows_eve_old_jack_1.flavor = Ernte diesen Monat einen Kürbis, und ab und zu ist einer kalt und leuchtet. Bring mir ein paar von den Geweihten.
quest.hallows_eve_old_jack_2.title = Laternenarbeit
quest.hallows_eve_old_jack_2.flavor = Jeder Kürbis voller Pulver gibt 'ne gute Laternenbombe ab. Wirf ein paar auf was, das es verdient hat, dann erzähl mir, wie sie gebrannt haben.
quest.hallows_eve_old_jack_3.title = Ghule auf den Stufen
quest.hallows_eve_old_jack_3.flavor = Nach Einbruch der Dunkelheit kriechen Hohle Ghule aus den alten Gräbern, hungrig. Schick ein paar zurück unter die Erde, bevor sie die Tempelstufen erreichen.
quest.hallows_eve_old_jack_4.title = Ektoplasma-Tour
quest.hallows_eve_old_jack_4.flavor = Die Verlorenen Seelen treiben umher, bis jemand sie gehen lässt. Befrei ein paar und bring mir das Ektoplasma, das sie zurücklassen; meine Laternen trinken das Zeug.
quest.hallows_eve_old_jack_5.title = Verfluchter Stein
quest.hallows_eve_old_jack_5.flavor = Bau diesen Monat Stein ab, egal welchen, und ab und zu fällt 'ne Verfluchte Geode raus. Knack ein paar auf; da steckt was Gutes drin, unter dem Fluch.
quest.hallows_eve_old_jack_lantern.title = Die Hohle Laterne
quest.hallows_eve_old_jack_lantern.flavor = Jedes Jahr geht die Hohle Laterne aus, und irgendwer muss sie wieder anzünden. Hau die Skelette um, die mein Gesicht tragen, dann bring mir, was die Laterne braucht.

# ---- Die Tagesaufgaben des Alten Jack ----
quest.hallows_eve_jack_daily_souls.title = Ruhelose Seelen
quest.hallows_eve_jack_daily_souls.flavor = Letzte Nacht sind noch mehr Verlorene Seelen hergetrieben. Befrei ein paar, bevor sie sich für immer niederlassen.
quest.hallows_eve_jack_daily_pumpkins.title = Kürbisrunde
quest.hallows_eve_jack_daily_pumpkins.flavor = Die Laternen verbrennen Geweihte Kürbisse schneller, als ich sie schnitzen kann. Bring mir vor Einbruch der Dunkelheit noch ein paar.
quest.hallows_eve_jack_daily_geodes.title = Geoden für Jack
quest.hallows_eve_jack_daily_geodes.flavor = Knack ein paar Verfluchte Geoden für mich auf. Meine Hände sind dafür inzwischen zu steif.

