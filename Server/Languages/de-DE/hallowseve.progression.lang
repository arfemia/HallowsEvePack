quest.category.hallows_eve = Halloween

# ---- Die Questreihe des Alten Jack ----
quest.hallows_eve_old_jack_meet.title = Laternen im Tempel
quest.hallows_eve_old_jack_meet.flavor = Es ist wieder Saison, also bin ich mit meinen Laternen zurück im Vergessenen Tempel. Jedes Tor zum Vergessenen Tempel bringt dich hin. Komm und such mich. Ich könnt 'ne Hand gebrauchen.
quest.hallows_eve_old_jack_1.title = Das Kürbisbeet
quest.hallows_eve_old_jack_1.flavor = Meine Laternen schnitze ich aus Geweihten Kürbissen, und mir gehen sie aus. Pflück Kürbisse von Hand und bring mir die kalten, leuchtenden.
quest.hallows_eve_old_jack_2.title = Laternenarbeit
quest.hallows_eve_old_jack_2.flavor = Ein Kürbis voller Pulver hält die Toten besser fern als jede Laterne. Wirf ein paar Laternenbomben, dann erzähl mir, wie sie gebrannt haben.
quest.hallows_eve_old_jack_3.title = Ghule auf den Stufen
quest.hallows_eve_old_jack_3.flavor = Meine Laternen halten die Ghule von den Stufen fern, aber nur gerade so. Leg nach Einbruch der Dunkelheit ein paar Hollow-Ghule zurück in die Erde.
quest.hallows_eve_old_jack_4.title = Ektoplasma-Tour
quest.hallows_eve_old_jack_4.flavor = Ektoplasma ist das, was in meinen Laternen brennt, und eine Verlorene Seele lässt welches zurück, wenn sie befreit wird. Befrei ein paar und bring es mir.
quest.hallows_eve_old_jack_5.title = Verfluchter Stein
quest.hallows_eve_old_jack_5.flavor = Der Stein gibt um diese Jahreszeit Verfluchte Geoden her, wenn du genug davon abbaust. Knack ein paar auf und behalt, was herausfällt.
quest.hallows_eve_old_jack_lantern.title = Die Hollow-Laterne
quest.hallows_eve_old_jack_lantern.flavor = Ich hab die Glut des Reiters. Jetzt will deine Hollow-Laterne einen Geweihten Kürbis und etwas Ektoplasma, und die Skelette mit meinem Gesicht sollen flach liegen.
quest.hallows_eve_old_jack_horseman.title = Der Reiter
quest.hallows_eve_old_jack_horseman.flavor = Der Grabwächter neben mir kennt den Weg in den Friedhof des Reiters, aber er öffnet das Tor nicht ohne eine Grabkerze, und die verkauf ich in meinem Laden, sobald ich dich als Stammgast zähle. Kauf eine, geh mit Freunden hinein und hau ihn aus dem Sattel.
quest.hallows_eve_old_jack_horseman_hard.title = Feuer für die Laterne
quest.hallows_eve_old_jack_horseman_hard.flavor = Deine Laterne will eine Flamme, die nicht ausgeht, und der Reiter trägt eine. Bitte den Grabwächter um den schweren Ritt, besiege ihn und bring mir seine Glut.

# ---- Die Tagesaufgaben des Alten Jack ----
quest.hallows_eve_jack_daily_souls.title = Ruhelose Seelen
quest.hallows_eve_jack_daily_souls.flavor = Letzte Nacht sind noch mehr Verlorene Seelen hergetrieben. Befrei ein paar, bevor sie sich für immer niederlassen.
quest.hallows_eve_jack_daily_pumpkins.title = Kürbisrunde
quest.hallows_eve_jack_daily_pumpkins.flavor = Die Laternen verbrennen Geweihte Kürbisse schneller, als ich sie schnitzen kann. Bring mir vor Einbruch der Dunkelheit noch ein paar.
quest.hallows_eve_jack_daily_geodes.title = Geoden für Jack
quest.hallows_eve_jack_daily_geodes.flavor = Knack ein paar Verfluchte Geoden für mich auf. Meine Hände sind dafür inzwischen zu steif.

# ---- Was die Beutetabellen von Halloween auszahlen: der Name der Belohnung und die Zeile darunter beim Überfahren ----
lootable.hallows_eve_meet_pay.title = Willkommen vom Alten Jack
lootable.hallows_eve_meet_pay.flavor = Ein paar Süßigkeiten zur Begrüßung.
lootable.hallows_eve_chain_pay.title = Lohn des Alten Jack
lootable.hallows_eve_chain_pay.flavor = Was der Alte Jack für jede Arbeit zahlt, die er dir gibt.
lootable.hallows_eve_daily_pay.title = Tageslohn des Alten Jack
lootable.hallows_eve_daily_pay.flavor = Was der Alte Jack für einen Tag Arbeit zahlt.
lootable.hallows_eve_lantern_pay.title = Dank des Alten Jack
lootable.hallows_eve_lantern_pay.flavor = Was der Alte Jack jedes Jahr dafür gibt, dass du die Hollow-Laterne anzündest.
lootable.hallows_eve_board_pay.title = Extras des Alten Jack
lootable.hallows_eve_board_pay.flavor = Ein bisschen obendrauf zu dem, was die Arbeit zahlt, für jeden, der an meiner Tafel arbeitet.
lootable.hallows_eve_board_sweets.title = Das Bonbonglas
lootable.hallows_eve_board_sweets.flavor = So viele, wie ich mit einer Hand greifen kann.
lootable.hallows_eve_hallowed_cache.title = Vorrat der Geweihten
lootable.hallows_eve_hallowed_cache.flavor = Die Geweihten lassen ihn dir da, jedes Mal, wenn du bei ihnen eine weitere Stufe über Ehrfürchtig steigst. Frag mich nicht, woher sie ihn haben.
lootable.hallows_eve_trick_or_treat.title = Süßes oder Saures
lootable.hallows_eve_trick_or_treat.flavor = Klopf an und sieh, was du kriegst. Meistens Süßes.
lootable.hallows_eve_treats.title = Etwas Süßes
lootable.hallows_eve_treats.flavor = Was du bekommst, wenn der Streich nicht zieht.
lootable.hallows_eve_geode_crack.title = Aufgeknackte Geode
lootable.hallows_eve_geode_crack.flavor = Was aus einer Verfluchten Geode fällt, wenn du sie aufknackst. Jedes Mal Kristall, und besser, wenn du Glück hast.

