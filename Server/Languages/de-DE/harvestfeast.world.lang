# Harvest Feast - the calendar's words (what the feast is called, and its banners) and the notice for
# a find. Keys are written bare: the library finds each one by its tail, whatever this file is called.
# Banners and notices print markup as text, so none of these values carries any.

# ---- Harvest Feast ----
calendar.harvest_feast.name = Erntefest
calendar.harvest_feast.flavor = Die Felder sind abgeerntet, und im Vergessenen Tempel wird eine lange Tafel aufgebaut.
calendar.harvest_feast.herald.start = Erntefest
calendar.harvest_feast.herald.start.sub = Martha die Köchin deckt die Tafel im Vergessenen Tempel.
calendar.harvest_feast.herald.end = Das Erntefest ist vorbei
calendar.harvest_feast.herald.end.sub = Die Tafel ist bis nächstes Jahr abgeräumt.

# ---- Finds ----
notify.harvest_feast_spice_found = Eine Prise Gewürz, beim Kürbis versteckt.

# ---- Costumes ----
# A costume's buff-bar tile name. Its effect's Name is this key in full
# (harvestfeast.world.effect...), because the client reads an effect's Name exactly as written.
effect.harvest_feast_costume_turkey.name = Truthahnkostüm
