board.grade.hallows_eve_skill = Fähigkeitsarbeit
boostrule.mmo_hallows_eve_harvest_moon.title = Erntemond
gearset.mmo_hallows_eve_hallowed.title = Geweihtes Set (Fähigkeiten)
gearset.mmo_hallows_eve_hallowed.tier_full = Helm und Schild zusammen: ein wenig mehr Glück und härtere Artillerie-Treffer.
quest.mmo_hallows_eve_daily_artillery.title = Laternendrill
quest.mmo_hallows_eve_daily_artillery.flavor = Ein guter Wurfarm braucht Übung, und das ist der Monat dafür. Wirf heute Nacht auf alles, was es verdient, und komm treffsicherer zurück.
quest.mmo_hallows_eve_daily_harvesting.title = Nachternte
quest.mmo_hallows_eve_daily_harvesting.flavor = Diesen Monat kommen kalte Kürbisse in den Beeten hoch, wenn jemand da ist, der sie erntet. Verbring heute die Nacht auf den Feldern.
quest.mmo_hallows_eve_daily_mining.title = Tiefe Schicht
quest.mmo_hallows_eve_daily_mining.flavor = Geoden finden die, die ihre Nächte unter Tage verbringen. Schieb heute Nacht eine lange Schicht.
quest.mmo_hallows_eve_daily_crafting.title = Fleißige Hände
quest.mmo_hallows_eve_daily_crafting.flavor = Jede Laterne auf den Tempelstufen hat jemand mit eigenen Händen gemacht. Verbring heute die Nacht an einer Werkbank, egal an welcher, und halt deine beschäftigt.
