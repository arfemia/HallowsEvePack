# Harvest Feast progression: Martha's intro quest, her questline, the yearly feast and the dailies, the
# feast board and the feast stall, her conversation, the season's achievements and titles, her
# reputation and the Almanac page, the shared meal and the invitation tour, and the feast's villagers.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. A quest,
# a contract or an achievement takes its words from the keys its id spells (quest.<id>.title and
# .flavor, achievement.<id>.title and .desc), so no content file names those. Numbers ride {0} and
# come from the content files, so a retune never touches a translation.

# ---- Martha's reputation ----
reputation.harvest_feast_host.name = Gunst beim Fest
reputation.harvest_feast_host.flavor = Martha merkt sich, wer zum Helfen kam und wer nur zum Essen.
reputation.harvest_feast_host.rank.neutral = Neuling
reputation.harvest_feast_host.rank.friendly = Nachbar
reputation.harvest_feast_host.rank.honored = Bekanntes Gesicht
reputation.harvest_feast_host.rank.revered = Familie
reputation.harvest_feast_host.rank.exalted = Oberhaupt der Tafel

# ---- The feast board ----
board.harvest_feast_daily.title = Tafel des Erntefests
board.harvest_feast_daily.desc = Feldarbeit und Küchenarbeit, jeden Morgen frisch. Je mehr du hilfst, desto mehr hänge ich für dich auf. Hol dir deinen Lohn, bevor die Tafel abgeräumt ist. Kommst du zu spät, wartet das Verdiente trotzdem in deinem Questbuch.
board.harvest_feast_daily.grade.field = Feldarbeit
board.harvest_feast_daily.grade.kitchen = Küchenarbeit
quest.harvest_feast_board_turkeys.title = Truthahntreiben
quest.harvest_feast_board_turkeys.flavor = Die Wälder sind diese Woche voller Truthähne. Erleg eine gute Handvoll, wenn du sie fangen kannst; sie rennen, als wüssten sie, was es zum Abendessen gibt.
quest.harvest_feast_board_wheat.title = Weizenernte
quest.harvest_feast_board_wheat.flavor = Der wilde Weizen wartet auf niemanden. Pflück ihn, bevor es der Frost tut.
quest.harvest_feast_board_pies.title = Kuchen für die Tafel
quest.harvest_feast_board_pies.flavor = Jeder Platz an der Tafel will ein Stück. Back ein paar Kürbiskuchen und bring sie her, solange sie warm sind.
quest.harvest_feast_board_roast.title = Feuerstelle
quest.harvest_feast_board_roast.flavor = Brat einen Haufen Fleisch über offenem Feuer. Allein der Duft lockt die Leute an die Tafel.

# ---- The feast stall ----
shop.harvest_feast_host.title = Der Feststand
shop.harvest_feast_host.desc = Rezepte aus meinem eigenen Buch, Popcorn tütenweise und ein paar Dinge fürs Haus.
shop.harvest_feast_host.category.kitchen = Küche
shop.harvest_feast_host.category.decor = Dekorationen
shop.harvest_feast_offer_recipe_apple_pie.title = Apfelkuchenrezept
shop.harvest_feast_offer_recipe_apple_pie.desc = Lies es einmal, und du kannst für immer Apfelkuchen backen.
shop.harvest_feast_offer_recipe_meat_pie.title = Fleischpastetenrezept
shop.harvest_feast_offer_recipe_meat_pie.desc = Marthas eigene Fleischpastete, aufgeschrieben für Freunde der Tafel.
shop.harvest_feast_offer_recipe_caesar_salad.title = Caesar-Salat-Rezept
shop.harvest_feast_offer_recipe_caesar_salad.desc = Marthas Caesar-Salat, aufgeschrieben für die Familie.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Abendessen im Tempel
quest.harvest_feast_martha_meet.flavor = Die Felder sind abgeerntet, also koche ich wieder im Vergessenen Tempel. Jedes Portal des Vergessenen Tempels bringt dich hin. Komm und such mich, und komm hungrig.
objective.harvest_feast.meet_martha = Finde Martha die Köchin im Vergessenen Tempel

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Weizen für die Öfen
quest.harvest_feast_host_1.flavor = Zuerst das Brot, immer. Der wilde Weizen wächst in dieser Jahreszeit dicht, also bring mir eine gute Armvoll für die Öfen.
quest.harvest_feast_host_2.title = Die Truthahnjagd
quest.harvest_feast_host_2.flavor = Die wilden Truthähne sind diesen Monat fett und laut, und nicht so dumm, wie sie aussehen. Erleg ein paar; ohne Braten taugt die Tafel nichts.
quest.harvest_feast_host_3.title = Der erste Kuchen
quest.harvest_feast_host_3.flavor = Du bist am Herd. Lern das Rezept, back einen Kürbiskuchen auf einem Kochherd und bring ihn mir.
quest.harvest_feast_the_feast.title = Die lange Tafel
quest.harvest_feast_the_feast.flavor = Einmal im Jahr stellen wir alles auf den Tisch und essen, bis keiner mehr stehen kann. Bring einen Kuchen, etwas Braten und einen Korb Karotten, dann decken wir gemeinsam.

# ---- Martha's dailies ----
quest.harvest_feast_daily_turkeys.title = Truthahnlauf
quest.harvest_feast_daily_turkeys.flavor = Der gestrige Braten ist bis auf den letzten Knochen weg. Bring mir noch ein paar Truthähne, dann fange ich einen neuen an.
quest.harvest_feast_daily_wheat.title = Brot für den Morgen
quest.harvest_feast_daily_wheat.flavor = Jeder Laib, den ich heute gebacken habe, ist schon weg. Bring mir mehr Weizen, sonst gibt es morgen früh kein Brot.
quest.harvest_feast_daily_roast.title = Braten für die Tafel
quest.harvest_feast_daily_roast.flavor = Brat Fleisch über dem Feuer und bring es her. Die Leute essen es auf, bevor es die Tafel erreicht.

