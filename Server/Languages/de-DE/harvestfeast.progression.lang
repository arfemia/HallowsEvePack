# Harvest Feast progression: Martha's intro quest, her questline, the yearly feast and the dailies, the
# feast board and the feast stall, her conversation, the season's achievements and titles, her
# reputation and the Almanac page, the shared meal and the invitation tour, and the feast's villagers.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. A quest,
# a contract or an achievement takes its words from the keys its id spells (quest.<id>.title and
# .flavor, achievement.<id>.title and .desc), so no content file names those. Numbers ride {0} and
# come from the content files, so a retune never touches a translation.

# ---- Harvest Coins ----
currency.harvest_feast_coins.name = Erntemünzen
currency.harvest_feast_coins.amount = {0, number} {0, plural, one {Erntemünze} other {Erntemünzen}}
currency.harvest_feast_coins.description = Gib sie in Marthas Laden im Vergessenen Tempel aus.

# ---- Martha's reputation ----
reputation.harvest_feast_host.name = Marthas Gunst
reputation.harvest_feast_host.flavor = Martha merkt sich, wer zum Helfen kam und wer nur zum Essen.
reputation.harvest_feast_host.rank.neutral = Neuling
reputation.harvest_feast_host.rank.friendly = Nachbar
reputation.harvest_feast_host.rank.honored = Freund
reputation.harvest_feast_host.rank.revered = Familie
reputation.harvest_feast_host.rank.exalted = Oberhaupt der Tafel
reputation.harvest_feast_host.earn.quests = Erledige ihre Aufträge und Tagesaufgaben und die Tagesaufgaben, die Tomas, Elsie und Bram dir geben.
reputation.harvest_feast_host.earn.board = Nimm Arbeiten von der Tafel des Erntefests an.
reputation.harvest_feast_host.earn.talk = Schau einmal am Tag auf ein Wort vorbei.
reputation.harvest_feast_host.earn.turkeys = Jage Truthähne in den Emerald Wilds, solange das Fest läuft (ein Wilder Truthahn bringt am meisten), und nimm so oft du willst Extra-Truthähne von ihr an.
reputation.harvest_feast_host.earn.gear = Trag das Ernte-Set aus ihrem Laden, dann gewinnst du ihre Gunst schneller.
lootable.harvest_feast_feast_basket.title = Festkorb
lootable.harvest_feast_feast_basket.flavor = Martha packt dir einen ein, jedes Mal wenn deine Gunst bei ihr eine weitere Stufe über Oberhaupt der Tafel steigt.
notify.harvest_feast_feast_basket = Ein Festkorb von Martha, für all deine Hilfe an der Tafel.
notify.harvest_feast_feast_served = Das Fest ist angerichtet!
notify.harvest_feast_feast_served.sub = {0} hat sich an Marthas Tafel zum Essen gesetzt.

# ---- The feast board ----
board.harvest_feast_daily.title = Tafel des Erntefests
board.harvest_feast_daily.desc = Feldarbeit und Küchenarbeit, jeden Morgen frisch. Je mehr du hilfst, desto mehr hänge ich für dich auf. Hol dir deinen Lohn, bevor die Tafel abgeräumt ist. Kommst du zu spät, wartet das Verdiente trotzdem in deinem Questbuch.
board.harvest_feast_daily.grade.field = Feldarbeit
board.harvest_feast_daily.grade.kitchen = Küchenarbeit
quest.harvest_feast_board_turkeys.title = Truthahnarbeit
quest.harvest_feast_board_turkeys.flavor = Jage Wilde Truthähne tagsüber in den Wäldern und auf den Ebenen der Emerald Wilds. Sie rennen, als wüssten sie, was es zum Abendessen gibt.
quest.harvest_feast_board_wheat.title = Weizenarbeit
quest.harvest_feast_board_wheat.flavor = Pflück wilden Weizen von Hand auf den Ebenen der Emerald Wilds. Er wartet nicht auf den Frost.
quest.harvest_feast_board_pumpkins.title = Kürbisarbeit
quest.harvest_feast_board_pumpkins.flavor = Pflück Kürbisse von Hand in den Herbstwäldern der Emerald Wilds. Jeder Kuchen fängt mit einem an.
quest.harvest_feast_board_carrots.title = Karottenarbeit
quest.harvest_feast_board_carrots.flavor = Pflück Karotten von Hand in den Wäldern der Emerald Wilds. Ich will einen vollen Korb für die Tafel.
quest.harvest_feast_board_pies.title = Kuchenarbeit
quest.harvest_feast_board_pies.flavor = Back Kürbiskuchen auf einem Kochherd und bring sie an die Tafel, solange sie warm sind.
quest.harvest_feast_board_roast.title = Kocharbeit
quest.harvest_feast_board_roast.flavor = Brat rohes Fleisch auf einem Lagerfeuer und bring es an die Tafel. Allein der Duft lockt die Leute an.
quest.harvest_feast_board_vegetables.title = Gemüsearbeit
quest.harvest_feast_board_vegetables.flavor = Brat Gemüse auf einem Lagerfeuer und bring es an die Tafel. Eine Karotte, Mais, ein Kürbis oder ein Pilz tut es.
quest.harvest_feast_board_spices.title = Gewürzarbeit
quest.harvest_feast_board_spices.flavor = Stell Gewürze auf einem Kochherd aus Blumen und einem Gemüse her, oder behalte die, die du beim Kürbispflücken findest. Bring sie her.

# ---- The feast stall ----
shop.harvest_feast_host.title = Der Fest-Laden
shop.harvest_feast_host.desc = Rezepte aus meinem eigenen Buch, Popcorn tütenweise, Kleidung für die Felder und ein paar Dinge fürs Haus.
shop.harvest_feast_host.category.kitchen = Küche
shop.harvest_feast_host.category.clothes = Kleidung
shop.harvest_feast_host.category.decor = Dekorationen
shop.harvest_feast_offer_recipe_turkey_pie.title = Rezept: Truthahnpastete
shop.harvest_feast_offer_recipe_turkey_pie.desc = Marthas eigene Fleischpastete. Back sie auf einem Kochherd für mehr maximale Gesundheit und weniger erlittenen Schaden, länger als jede andere Pastete.
shop.harvest_feast_offer_recipe_harvest_salad.title = Rezept: Erntesalat
shop.harvest_feast_offer_recipe_harvest_salad.desc = Karotten, Mais und Kürbis. Stell ihn auf einem Kochherd her für mehr maximale Ausdauer, länger als jeder andere Salat.
shop.harvest_feast_offer_recipe_marthas_roast.title = Rezept: Marthas Braten
shop.harvest_feast_offer_recipe_marthas_roast.desc = Ihre beste Speise, für die Familie aufgeschrieben. Mehr maximale Gesundheit und Ausdauer, und ihre Gunst steigt schneller, solange er wirkt.
shop.harvest_feast_offer_harvest_gloves.title = Erntehandschuhe
shop.harvest_feast_offer_harvest_gloves.desc = Warme Wollhandschuhe, Teil des Ernte-Sets. Trag das ganze Set, dann gewinnst du Marthas Gunst schneller.
shop.harvest_feast_offer_harvest_hat.title = Erntehut
shop.harvest_feast_offer_harvest_hat.desc = Ein warmer Wollhut, Teil des Ernte-Sets. Trag das ganze Set, dann gewinnst du Marthas Gunst schneller.
shop.harvest_feast_offer_harvest_trousers.title = Erntehose
shop.harvest_feast_offer_harvest_trousers.desc = Wollhose für die Felder, Teil des Ernte-Sets. Trag das ganze Set, dann gewinnst du Marthas Gunst schneller.
shop.harvest_feast_offer_harvest_tunic.title = Erntetunika
shop.harvest_feast_offer_harvest_tunic.desc = Eine Wolltunika, das letzte Teil des Ernte-Sets. Trag das ganze Set, dann gewinnst du Marthas Gunst schneller.

# ---- The Harvest Set ----
# A set's notice is a toast, so no value carries markup.
gearset.harvest_feast_harvest_set.title = Ernte-Set
gearset.harvest_feast_harvest_set.tier_half = Das halbe Set an: etwas mehr Gesundheit.
gearset.harvest_feast_harvest_set.tier_full = Das ganze Set an: noch mehr Gesundheit, und du gewinnst Marthas Gunst schneller.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Martha treffen
quest.harvest_feast_martha_meet.flavor = Die Felder sind abgeerntet, also koche ich wieder im Vergessenen Tempel. Jedes Portal des Vergessenen Tempels bringt dich hin. Komm und such mich, und komm hungrig.
objective.harvest_feast.meet_martha = Finde Martha die Köchin im Vergessenen Tempel

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Weizenernte
quest.harvest_feast_host_1.flavor = Zuerst das Brot, immer. Wilder Weizen wächst auf den Ebenen der Emerald Wilds. Pflück mir eine gute Armvoll von Hand und bring sie in den Vergessenen Tempel.
quest.harvest_feast_host_2.title = Truthahnjagd
quest.harvest_feast_host_2.flavor = Die Wilden Truthähne sind tagsüber in den Wäldern und auf den Ebenen der Emerald Wilds unterwegs. Erleg ein paar, dann komm zurück zu mir. Ohne Braten taugt die Tafel nichts.
quest.harvest_feast_host_3.title = Dein erster Kuchen
quest.harvest_feast_host_3.flavor = Du bist am Herd. Lern mit dem Rezept, das ich dir gegeben habe, wie es geht, back auf einem Kochherd einen Kürbiskuchen aus Teig, Kürbis und Gewürz und bring ihn mir.
quest.harvest_feast_the_feast.title = Das Fest
quest.harvest_feast_the_feast.flavor = Einmal im Jahr stellen wir alles auf den Tisch. Back einen Kürbiskuchen auf einem Kochherd, brat Fleisch auf einem Lagerfeuer, pflück Karotten in den Wäldern und bring alles zu mir.
quest.harvest_feast_supper_tomas.title = Abendessen für Tomas
quest.harvest_feast_supper_tomas.flavor = Tomas hat die ganze Woche Mehl geschleppt und sich nie gesetzt. Bring ihm einen Kürbiskuchen aus den Resten. Du findest ihn dort, wo die Straße auf das Kweebec-Dorf im Vergessenen Tempel trifft.
quest.harvest_feast_supper_elsie.title = Abendessen für Elsie
quest.harvest_feast_supper_elsie.flavor = Elsie hat jedes Tuch auf dieser Tafel gewebt und nie von einem gegessen. Bring ihr ein Gebratenes Gemüse. Sie ist auf der anderen Seite des Kweebec-Dorfs im Vergessenen Tempel.
quest.harvest_feast_supper_bram.title = Abendessen für Bram
quest.harvest_feast_supper_bram.flavor = Bram hat sein Vlies für uns von den Hügeln heruntergetragen. Bring ihm Gegartes Fleisch. Er ist auf der Wiese an der Straße in den Vergessenen Tempel.
objective.harvest_feast.supper_for_tomas = Bring Tomas dem Müller einen Kürbiskuchen
objective.harvest_feast.supper_for_elsie = Bring Elsie der Weberin ein Gebratenes Gemüse
objective.harvest_feast.supper_for_bram = Bring Bram dem Schäfer Gegartes Fleisch

# ---- Martha's dailies and Extra Turkeys ----
quest.harvest_feast_daily_turkeys.title = Tägliche Truthähne
quest.harvest_feast_daily_turkeys.flavor = Der gestrige Braten ist bis auf den letzten Knochen weg. Jage ein paar Wilde Truthähne mehr in den Emerald Wilds, dann fange ich einen neuen an.
quest.harvest_feast_daily_wheat.title = Täglicher Weizen
quest.harvest_feast_daily_wheat.flavor = Jeder Laib, den ich heute gebacken habe, ist schon weg. Bring mir mehr Weizen von den Ebenen, sonst gibt es morgen früh kein Brot.
quest.harvest_feast_daily_roast.title = Täglicher Braten
quest.harvest_feast_daily_roast.flavor = Brat rohes Fleisch auf einem Lagerfeuer und bring es her. Die Leute essen es auf, bevor es die Tafel erreicht.
quest.harvest_feast_extra_turkeys.title = Extra-Truthähne
quest.harvest_feast_extra_turkeys.flavor = Ich nehme jeden Truthahn, den du fangen kannst. Jage mehr Wilde Truthähne in den Emerald Wilds, dann komm zurück zu mir. So oft du willst.
quest.harvest_feast_miller_flour.title = Tägliches Mehl
quest.harvest_feast_miller_flour.flavor = Die Öfen fressen Mehl schneller, als meine Mühle es mahlen kann. Mahl Weizen auf einem Kochherd zu Mehl und bring mir etwas, ich sorge dafür, dass es zu Martha kommt.
quest.harvest_feast_weaver_spices.title = Tägliche Gewürze
quest.harvest_feast_weaver_spices.flavor = Ich brauche etwas Gewürz, um den orangen Rand des Tischläufers zu färben, und Martha nimmt den Rest. Stell Gewürze auf einem Kochherd aus Blumen und einem Gemüse her und bring sie mir.
quest.harvest_feast_shepherd_eggs.title = Tägliche Eier
quest.harvest_feast_shepherd_eggs.flavor = Tomas will Eier für seinen Teig, und ich bin der, der sich mit Hühnern auskennt. Halt ein paar in einem Hühnerstall und bring mir, was sie legen.
