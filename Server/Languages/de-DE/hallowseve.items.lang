# Halloween-Paket - die Worte des Geweihten Sets. Die Schlüssel stehen ohne Präfix: die Bibliothek findet
# jeden an seinem Ende, egal wie diese Datei heißt. Die Meldung des Sets ist ein Toast, also trägt kein Wert Markup.
gearset.hallows_eve_hallowed.title = Geweihtes Set
gearset.hallows_eve_hallowed.tier_full = Helm auf und Schild in der Hand: etwas mehr Gesundheit, Feuer setzt dir weniger zu, du leuchtest wie eine Laterne, und du gewinnst bei den Geweihten etwas schneller Gunst.
gearset.hallows_eve_hallowed.tier_pair = Ein Teil des Sets am Körper und ein Jack-Schild in der Hand: etwas mehr Gesundheit, Feuer setzt dir weniger zu, du leuchtest wie eine Laterne, und du gewinnst bei den Geweihten etwas schneller Gunst.
gearset.hallows_eve_hallowed.tier_armor = Helm, Brustplatte, Handschuhe und Beinschienen an: etwas mehr Gesundheit, und alles, was du in Brand setzt, brennt heißer.
gearset.hallows_eve_hallowed.tier_armor_shield = Alle vier an und Schild in der Hand: noch mehr Gesundheit, und dein Feuer brennt noch heißer.
gearset.hallows_eve_flaming_hallowed.title = Flammendes Geweihtes Set
gearset.hallows_eve_flaming_hallowed.tier_armor = Ein Brennender Jack-Helm oder der Flammende Helm des Reiters, dazu seine flammende Rüstung an: mehr Gesundheit, und alles, was du in Brand setzt, brennt viel heißer.
gearset.hallows_eve_flaming_hallowed.tier_armor_shield = Alle vier an und den Flammenden Jack-Schild in der Hand: noch mehr Gesundheit, und dein Feuer brennt noch heißer.

# The costumes' names, shown when a player hovers the costume's icon. The effect JSON spells the full
# key (hallowseve.items.effect...), because the client reads an effect's Name exactly as written.
effect.hallows_eve_costume_jack.name = Jack-Skelett-Kostüm
effect.hallows_eve_costume_lost_soul.name = Kostüm der Verlorenen Seele
effect.hallows_eve_lantern_burn.name = Verbrennung
effect.hallows_eve_fire_resistance.name = Feuerresistenz
