# Christmas progression: the season's currency, Santa's Nice List and Santa's Sack, the four Christmas
# stalls and their offers, the Christmas Set, the present's gift, Santa's conversation, the Christmas
# conversations of Tomas, Elsie and Bram, and the Christmas line their feast conversations gain.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. Numbers
# ride {0} and come from the content files, so a retune never touches a translation.

# ---- Christmas Coins ----
currency.christmas_coins.name = Weihnachtsmünzen
currency.christmas_coins.amount = {0, number} {0, plural, one {Weihnachtsmünze} other {Weihnachtsmünzen}}
currency.christmas_coins.description = Gib sie in den Weihnachtsläden im Vergessenen Tempel aus.

# ---- Santa's Nice List ----
reputation.christmas_nice_list.name = Brav-Liste des Weihnachtsmanns
reputation.christmas_nice_list.flavor = Der Weihnachtsmann prüft sie zweimal. Hilf ihm, seine Geschenke zurückzuholen, und du steigst auf.
reputation.christmas_nice_list.rank.neutral = Neuling
reputation.christmas_nice_list.rank.friendly = Auf der Liste
reputation.christmas_nice_list.rank.honored = Brav
reputation.christmas_nice_list.rank.revered = Sehr brav
reputation.christmas_nice_list.rank.exalted = Liebling des Weihnachtsmanns
reputation.christmas_nice_list.earn.quests = Hilf dem Weihnachtsmann, Tomas, Elsie und Bram im Vergessenen Tempel bei ihren Weihnachtsaufträgen und Tagesaufgaben.
reputation.christmas_nice_list.earn.board = Nimm Arbeiten von der Weihnachtstafel an. Frag den Weihnachtsmann, was zu tun ist.
reputation.christmas_nice_list.earn.thieves = Fang Geschenkdiebe nachts in den Emerald Wilds oder jederzeit im Schnee der Whisperfrost Frontiers. Andere Trorks zählen ein wenig mit, solange Weihnachten läuft.
reputation.christmas_nice_list.earn.presents = Gib einem Freund ein Weihnachtsgeschenk: Halte es in der Hand, sieh ihn an und klick mit links.
reputation.christmas_nice_list.earn.carols = Sing jedem im Tempel ein Weihnachtslied, je einmal am Tag.
reputation.christmas_nice_list.earn.yeti = Besiege den Yeti in der Yeti-Höhle. Bram auf der Wiese bringt dich hin. Dein erster Sieg am Tag zählt am meisten.
reputation.christmas_nice_list.earn.talk = Schau einmal am Tag beim Weihnachtsmann auf ein Wort vorbei.
reputation.christmas_nice_list.earn.gear = Trag das Weihnachts-Set aus Elsies Laden oder iss einen Weihnachtskuchen, dann steigst du schneller auf.
lootable.christmas_santas_sack.title = Sack des Weihnachtsmanns
lootable.christmas_santas_sack.flavor = Der Weihnachtsmann packt dir einen ein, jedes Mal wenn du eine weitere Stufe über Liebling des Weihnachtsmanns steigst.
lootable.christmas_present_gift.title = Weihnachtsgeschenk
lootable.christmas_present_gift.flavor = Ein paar Münzen und eine kleine Überraschung.
lootable.christmas_present_given.title = Ein Geschenk von einem Freund
lootable.christmas_present_given.flavor = Jemand hat dir das geschenkt. Besser, als das eigene zu öffnen.
lootable.christmas_stocking.title = Strumpf des Weihnachtsmanns
lootable.christmas_stocking.flavor = Eine Leckerei und etwas Taschengeld, und hin und wieder ein Geschenk.

# ---- The Christmas stalls ----
shop.christmas_santa.title = Laden des Weihnachtsmanns
shop.christmas_santa.desc = Päckchen zum Einpacken eigener Geschenke und Zuckerstangen für den kalten Heimweg.
shop.christmas_santa.category.packets = Weihnachtspäckchen
shop.christmas_santa.category.treats = Leckereien
shop.christmas_miller.title = Tomas' Bäckerei
shop.christmas_miller.desc = Die Rezepte für alles, was ich für den Weihnachtsmann backe, und frischer Teig, wenn du es eilig hast.
shop.christmas_miller.category.kitchen = Küche
shop.christmas_weaver.title = Elsies Laden
shop.christmas_weaver.desc = Geschenke, die ich selbst eingepackt habe, ein bisschen Magie und warme Kleidung für den Schnee.
shop.christmas_weaver.category.gifts = Geschenke
shop.christmas_weaver.category.clothes = Kleidung
shop.christmas_shepherd.title = Brams Schneebälle
shop.christmas_shepherd.desc = Fest gepackt. Pass auf, auf wen du wirfst.
shop.christmas_shepherd.category.snow = Schnee
shop.christmas_offer_recipe_gingerbread_cookie.title = Rezept: Lebkuchenmännchen
shop.christmas_offer_recipe_gingerbread_cookie.desc = Back sie auf einem Kochherd aus Teig und Gewürzen. Sie geben dir Schwung in die Beine.
shop.christmas_offer_recipe_hot_cocoa.title = Rezept: Heiße Schokolade
shop.christmas_offer_recipe_hot_cocoa.desc = Stell sie auf einem Kochherd her. Sie hält die Kälte draußen und lässt deine Gesundheit zurückkehren.
shop.christmas_offer_recipe_cake.title = Rezept: Weihnachtskuchen
shop.christmas_offer_recipe_cake.desc = Das Beste auf dem Tisch. Er kann alles, was die Lebkuchenmännchen und die Schokolade können, und du steigst auf der Brav-Liste des Weihnachtsmanns schneller auf, solange er wirkt.
shop.christmas_offer_present.title = Weihnachtsgeschenk
shop.christmas_offer_present.desc = Von Elsie eingepackt. Öffne es, um zu sehen, was drin ist.
shop.christmas_offer_christmas_wand.title = Weihnachtsstab
shop.christmas_offer_christmas_wand.desc = Richte ihn auf einen Freund, um ihn als Elf oder Rentier zu verkleiden.
shop.christmas_offer_santa_suit.title = Weihnachtsmannanzug
shop.christmas_offer_santa_suit.desc = Zieh ihn an, und du bist eine Weile der Weihnachtsmann.
shop.christmas_offer_christmas_gloves.title = Weihnachtshandschuhe
shop.christmas_offer_christmas_gloves.desc = Warme Handschuhe, Teil des Weihnachts-Sets. Trag das ganze Set, dann steigst du auf der Brav-Liste des Weihnachtsmanns schneller auf.
shop.christmas_offer_christmas_hat.title = Weihnachtshut
shop.christmas_offer_christmas_hat.desc = Ein warmer Hut, Teil des Weihnachts-Sets. Trag das ganze Set, dann steigst du auf der Brav-Liste des Weihnachtsmanns schneller auf.
shop.christmas_offer_christmas_trousers.title = Weihnachtshose
shop.christmas_offer_christmas_trousers.desc = Warme Hose für den Schnee, Teil des Weihnachts-Sets. Trag das ganze Set, dann steigst du auf der Brav-Liste des Weihnachtsmanns schneller auf.
shop.christmas_offer_christmas_coat.title = Weihnachtsmantel
shop.christmas_offer_christmas_coat.desc = Ein warmer Mantel, das letzte Teil des Weihnachts-Sets. Trag das ganze Set, dann steigst du auf der Brav-Liste des Weihnachtsmanns schneller auf.
shop.christmas_offer_snowballs_daily.title = Gratis-Schneebälle
shop.christmas_offer_snowballs_daily.desc = Ein Bündel Schneebälle von Bram, einmal am Tag gratis.
shop.christmas_offer_snowballs.title = Schneebälle
shop.christmas_offer_snowballs.desc = Noch ein Bündel, für den Fall, dass die gratis weg sind.
shop.christmas_offer_stocking.title = Strumpf des Weihnachtsmanns
shop.christmas_offer_stocking.desc = Einmal am Tag gratis. Greif hinein und sieh nach, was der Weihnachtsmann dir hinterlassen hat.

# ---- The Christmas Set ----
# A set's notice is a toast, so no value carries markup.
gearset.christmas_set.title = Weihnachts-Set
gearset.christmas_set.tier_half = Das halbe Set an: etwas mehr Gesundheit.
gearset.christmas_set.tier_full = Das ganze Set an: noch mehr Gesundheit, die Kälte beißt weniger, und du steigst auf der Brav-Liste des Weihnachtsmanns schneller auf.

# ---- Santa's conversation ----
dialogue.christmas_santa.off_season.text = Weihnachten ist vorbei, und mein Schlitten ist fürs Heimfahren gepackt.\nFinde mich nächsten Winter wieder.
dialogue.christmas_santa.off_season.opt.farewell = Auf Wiedersehen, Weihnachtsmann.
dialogue.christmas_santa.first_words.text = Ho ho ho. Da bist du ja.\nIch bin der Weihnachtsmann, und ich brauche Hilfe. Trorks in Weihnachtsmannmützen haben meinen Schlitten ausgeraubt und sind mit den Geschenken abgehauen. Fang diese <b>Geschenkdiebe</b> nachts in den <b>Emerald Wilds</b> oder jederzeit im Schnee der <b>Whisperfrost Frontiers</b>, und bring meine Geschenke zurück.
dialogue.christmas_santa.first_words.opt.hail = Ich helfe dir, Weihnachtsmann.
dialogue.christmas_santa.daily_word.text = Wieder da? Gut. Das ist ein weiterer Tag auf meiner <b>Brav-Liste</b>.\nDie Diebe sind noch da draußen. Behalte heute Nacht die Wälder im Auge.
dialogue.christmas_santa.menu.text = Nun denn. Was kann ich für dich tun?
dialogue.christmas_santa.who_are_you.text = Ich bin der Weihnachtsmann. Jedes Weihnachten bringe ich allen in Orbis Geschenke.\nDieses Jahr habe ich Hilfe. Tomas backt, Elsie packt die Geschenke ein und näht, und Bram versorgt alle mit Schneebällen.
dialogue.christmas_santa.about_thieves.text = Das sind Trorks in Weihnachtsmannmützen, und sie kämpfen nur mit den Fäusten, also sind sie dir nicht gewachsen.\nSuch nachts in den Wäldern und auf den Feldern der <b>Emerald Wilds</b> oder jederzeit im Schnee der <b>Whisperfrost Frontiers</b>. Viele von ihnen tragen noch ein Geschenk bei sich. Öffne es, und es gehört dir.
dialogue.christmas_santa.helpers.text = <b>Tomas</b> und <b>Elsie</b> haben ihre Läden gleich hier neben mir. Solange Marthas Fest noch läuft, helfen sie ihr beim <b>Kweebec-Dorf</b> am Ende der Straße.\n<b>Bram</b> ist draußen auf der Wiese, auf halbem Weg die Straße hinunter, von wo du hereingekommen bist.
dialogue.christmas_santa.opt.shop = Zeig mir deinen Laden.
dialogue.christmas_santa.opt.standing = Wie steht es bei dir um mich auf der Liste?
dialogue.christmas_santa.opt.thieves = Wo sind die Diebe?
dialogue.christmas_santa.opt.helpers = Wo sind deine Helfer?
dialogue.christmas_santa.opt.who = Wer bist du?
dialogue.christmas_santa.opt.back = Etwas anderes.
dialogue.christmas_santa.opt.farewell = Frohe Weihnachten, Weihnachtsmann.
dialogue.christmas_santa.opt.returned = Ich bin zurück.
dialogue.christmas_santa.opt.quests = Was ist zu tun?
dialogue.christmas_santa.opt.almanac = Zeig mir den Almanach.
dialogue.christmas_santa.opt.story = Wobei kann ich helfen?
dialogue.christmas_santa.meet_arrival.text = Ho ho ho. Du hast mich gefunden.\nIch bin der Weihnachtsmann, und ich brauche Hilfe. Trorks in Weihnachtsmannmützen haben meinen Schlitten auf der Straße ausgeraubt und sind mit den Geschenken abgehauen. Holen wir sie zurück.
dialogue.christmas_santa.meet_arrival.opt.hail = Ich helfe dir, Weihnachtsmann.
dialogue.christmas_santa.morning_arrival.text = Frohe Weihnachten. Sieh unter meinen Baum.\nDa liegt ein Geschenk mit deinem Namen darauf.
dialogue.christmas_santa.morning_arrival.opt.open = Für mich?
dialogue.christmas_santa.daily_word_story_done.text = Wieder da? Gut. Das ist ein weiterer Tag auf meiner <b>Brav-Liste</b>.\nDer Schlitten ist gepackt, also ist meine Geschichte bis nächstes Weihnachten erzählt. Ich habe aber jeden Tag noch <b>Arbeiten</b>, die <b>Geschenkdiebe</b> sind noch da draußen, und die <b>Läden</b> sind offen.
dialogue.christmas_santa.story_done.text = Der Schlitten ist gepackt, und das ist dein Verdienst.\nMeine Geschichte ist bis nächstes Weihnachten erzählt, aber es gibt noch viel zu tun. Komm jeden Tag wegen meiner <b>Arbeiten</b> vorbei, fang weiter <b>Geschenkdiebe</b>, und sieh nach, was es Neues in den <b>Läden</b> gibt.
dialogue.christmas_santa.story.text = Fang zuerst die <b>Geschenkdiebe</b> für mich. Dann braucht <b>Bram</b> Karotten für die Rentiere, <b>Tomas</b> braucht Hilfe bei den Plätzchen, und <b>Elsie</b> braucht Hilfe beim Einpacken. Danach komm zu mir zurück, wegen <b>Heiligabend</b>.\nIch habe auch jeden Tag Arbeiten. Frag mich, was zu tun ist.
dialogue.christmas_santa.thieves_offer.text = Diese Diebe haben noch meine Geschenke. Fang ein paar <b>Geschenkdiebe</b> für mich.\nSie kommen nachts in den Wäldern und auf den Feldern der <b>Emerald Wilds</b> heraus, und im Schnee der <b>Whisperfrost Frontiers</b> sind sie den ganzen Tag unterwegs. Jeder Trork, den du fängst, zählt.
dialogue.christmas_santa.thieves_offer.opt.accept = Ich fange sie.
dialogue.christmas_santa.thieves_brief.text = Such nachts in den <b>Emerald Wilds</b> oder jederzeit im Schnee der <b>Whisperfrost Frontiers</b>. Jeder Trork zählt.\nKomm zu mir zurück, wenn du genug gefangen hast.
dialogue.christmas_santa.thieves_ready.text = Du hast sie erwischt. Einer von ihnen hatte das hier bei sich. Öffne es, oder gib es einem Freund.\nNun, <b>Brams</b> Rentiere sind hungrig. Er ist auf der <b>Wiese</b>, auf halbem Weg die Straße hinunter, von wo du hereingekommen bist.
dialogue.christmas_santa.thieves_ready.opt.turnin = Bitte sehr.
dialogue.christmas_santa.eve_offer.text = Es ist fast <b>Heiligabend</b>, und der Schlitten ist noch nicht voll.\nBring mir <b>Lebkuchenmännchen</b> für den Sack und <b>Karotten</b> für die Rentiere. Und gib mir ein <b>Weihnachtsgeschenk</b> für den Schlitten.
dialogue.christmas_santa.eve_offer.opt.accept = Füllen wir den Schlitten.
dialogue.christmas_santa.eve_brief.text = <b>Lebkuchenmännchen</b> für den Sack und <b>Karotten</b> für die Rentiere. Bring sie her.\nFür das Geschenk: Halte es in der Hand, sieh mich an und klick mit links.
dialogue.christmas_santa.eve_ready.text = Jetzt ist der Schlitten voll. Ho ho ho.\nDiese Weihnachtskugel ist für dich. Häng sie dorthin, wo du sie jedes Weihnachten siehst.
dialogue.christmas_santa.eve_ready.opt.turnin = Frohe Weihnachten, Weihnachtsmann.
dialogue.christmas_santa.carols_offer.text = Nichts wärmt einen kalten Tempel wie ein Weihnachtslied.\nSing eines für die <b>Leute rund um den Vergessenen Tempel</b>, dann komm und erzähl mir, wie es lief. Nicht für mich, wohlgemerkt. Ich kenne alle Strophen.
dialogue.christmas_santa.carols_offer.opt.accept = Ich gehe singen.
dialogue.christmas_santa.carols_brief.text = Sprich mit den Leuten rund um den Tempel und wähle <b>Ein Weihnachtslied singen</b>. Meine Helfer sind ein guter Anfang.\nJeder hört nur einmal am Tag zu.
dialogue.christmas_santa.carols_ready.text = Ich habe dich bis hierher gehört. Gar nicht schlecht.
dialogue.christmas_santa.carols_ready.opt.turnin = Alle haben mitgesungen.
dialogue.christmas_santa.daily_thieves_offer.text = Diese Trorks sind wieder am Werk.\nFängst du heute ein paar mehr <b>Geschenkdiebe</b> für mich?
dialogue.christmas_santa.daily_thieves_offer.opt.accept = Ich fange sie.
dialogue.christmas_santa.daily_presents_offer.text = Meine Helfer arbeiten hart.\nGib jedem von ihnen heute ein <b>Weihnachtsgeschenk</b>. Halte eines in der Hand, sieh sie an und klick mit links.
dialogue.christmas_santa.daily_presents_offer.opt.accept = Ich verteile sie.
dialogue.christmas_santa.presents_brief.text = Gib <b>Tomas</b>, <b>Elsie</b> und <b>Bram</b> je ein <b>Weihnachtsgeschenk</b>. Halte eines in der Hand, sieh sie an und klick mit links.\nDie Diebe lassen Geschenke fallen, und <b>Elsie</b> verkauft sie.
dialogue.christmas_santa.extra_thieves_ready.text = Noch mehr Diebe gefangen. Meine Liste wird jeden Tag länger.
dialogue.christmas_santa.extra_thieves_ready.opt.turnin = Hier ist meine Zahl.
dialogue.christmas_santa.ready_generic.text = Schon fertig? Sehen wir mal.
dialogue.christmas_santa.ready_generic.opt.turnin = Es ist erledigt.

# ---- Santa's helpers: Tomas the Miller, Elsie the Weaver and Bram the Shepherd ----
dialogue.christmas_feast_line.opt.stall = Was gibt es in deinem Weihnachtsladen?
dialogue.christmas_feast_line.opt.quests = Gibt es Weihnachtsarbeit für mich?
dialogue.christmas_carol.opt.sing = Ein Weihnachtslied singen
dialogue.christmas_miller.off_season.text = Weihnachten ist vorbei, und der Ofen ist kalt geworden.\nBis wir uns wiedersehen, wenn der Schnee zurückkommt.
dialogue.christmas_miller.off_season.opt.farewell = Bis nächsten Winter.
dialogue.christmas_miller.greeting.text = Frohe Weihnachten. Der Weihnachtsmann braucht Plätzchen für seinen Sack, also habe ich meinen Ofen von der Mühle heraufgebracht.\nIch verkaufe die Rezepte für <b>Lebkuchenmännchen</b>, <b>Heiße Schokolade</b> und <b>Weihnachtskuchen</b>.
dialogue.christmas_miller.dough.text = Mahl <b>Weizen</b> an einem <b>Kochherd</b> zu <b>Mehl</b>, dann misch das Mehl am selben Herd mit <b>Eiern</b> und einem <b>Krug Wasser</b>.\nKeine Zeit? Ich verkaufe jeden Tag ein wenig Teig.
dialogue.christmas_miller.why.text = Trorks haben den Schlitten des Weihnachtsmanns auf der Straße ausgeraubt, und er hat das Dorf um Hilfe gebeten. Elsie und Bram sind auch gekommen.\nJemand muss den alten Mann ja versorgen.
dialogue.christmas_miller.opt.stall = Was verkaufst du?
dialogue.christmas_miller.opt.dough = Wie mache ich Teig?
dialogue.christmas_miller.opt.why = Warum bist du hier?
dialogue.christmas_miller.opt.thanks = Danke, Tomas.
dialogue.christmas_miller.opt.back = Nett von dir.
dialogue.christmas_miller.opt.farewell = Frohe Weihnachten, Tomas.
dialogue.christmas_miller.opt.quests = Gibt es Arbeit für mich?
dialogue.christmas_miller.opt.later = Gerade nicht.
dialogue.christmas_miller.next_elsie.text = Der Sack des Weihnachtsmanns füllt sich nicht von selbst. <b>Elsie</b> braucht Hilfe beim Einpacken.\nIhr Laden ist gleich hier, neben dem Weihnachtsmann. Solange Marthas Fest noch läuft, ist sie auf der anderen Seite des <b>Kweebec-Dorfs</b>.
dialogue.christmas_miller.cookies_offer.text = Bram hat dir mein Rezept gegeben? Gut. Der Weihnachtsmann will Plätzchen in seinem Sack.\nLern das Rezept, back ein <b>Lebkuchenmännchen</b> und bring es her. Ich will sehen, wie es geworden ist.
dialogue.christmas_miller.cookies_offer.opt.accept = Ich backe eines.
dialogue.christmas_miller.cookies_brief.text = Lern das Rezept, dann back ein <b>Lebkuchenmännchen</b> und bring mir eines.\nNoch nie Teig gemacht? Frag mich, wie.
dialogue.christmas_miller.cookies_ready.text = Das ist ein ordentlicher Lebkuchenmann. Riecht auch richtig.\nBack weiter. Der Weihnachtsmann will vor Heiligabend noch viel mehr.
dialogue.christmas_miller.cookies_ready.opt.turnin = Hier, probier.
dialogue.christmas_miller.baking_offer.text = Mein Ofen frisst Teig schneller, als ich ihn anrühren kann.\nBringst du mir heute etwas <b>Teig</b>?
dialogue.christmas_miller.baking_offer.opt.accept = Ich bringe Teig.
dialogue.christmas_miller.baking_brief.text = Bring mir etwas <b>Teig</b>.\nNoch nie gemacht? Frag mich, wie.
dialogue.christmas_miller.baking_ready.text = Frischer Teig. Der Ofen hat schon gewartet.
dialogue.christmas_miller.baking_ready.opt.turnin = Hier ist der Teig.
dialogue.christmas_weaver.off_season.text = Weihnachten ist vorbei, und die Bänder sind weggepackt.\nFinde mich nächsten Winter. Bis dahin habe ich neue Geschenke eingepackt.
dialogue.christmas_weaver.off_season.opt.farewell = Ich suche dich.
dialogue.christmas_weaver.greeting.text = Frohe Weihnachten. Die Diebe haben die Geschenke des Weihnachtsmanns zerrissen und schmutzig zurückgelassen, also packe ich jedes noch einmal ein.\nIch verkaufe <b>Weihnachtsgeschenke</b>, den <b>Weihnachtsstab</b>, den <b>Weihnachtsmannanzug</b> und das <b>Weihnachts-Set</b>. Je höher du auf der <b>Brav-Liste</b> des Weihnachtsmanns stehst, desto mehr kann ich dir verkaufen.
dialogue.christmas_weaver.presents.text = Klick mit rechts auf ein Geschenk, um es zu öffnen. Es ist immer etwas drin, und manchmal etwas Schönes.\nOder verschenk es: Halte es in der Hand, sieh einen Freund an und klick mit links. Er bekommt ein besseres Geschenk als du, und der Weihnachtsmann merkt es sich. Wenn der Weihnachtsmann oder einer von uns um ein Geschenk bittet, gib es auf dieselbe Weise ab.\nDie <b>Geschenkdiebe</b> tragen viele bei sich. Du findest sie nachts in den <b>Emerald Wilds</b>.
dialogue.christmas_weaver.why.text = Der Weihnachtsmann hat das Dorf um Hilfe gebeten, also bin ich hier. Jemand muss das alles einpacken.\nUnd jemand muss ihm einen neuen Mantel nähen. Die Trorks haben auch seinen Ersatzmantel mitgenommen.
dialogue.christmas_weaver.opt.stall = Zeig mir, was du hast.
dialogue.christmas_weaver.opt.presents = Was mache ich mit einem Geschenk?
dialogue.christmas_weaver.opt.why = Warum bist du hier?
dialogue.christmas_weaver.opt.thanks = Danke, Elsie.
dialogue.christmas_weaver.opt.back = Das ist viel Einpackerei.
dialogue.christmas_weaver.opt.farewell = Frohe Weihnachten, Elsie.
dialogue.christmas_weaver.opt.quests = Kann ich helfen?
dialogue.christmas_weaver.opt.later = Gerade nicht.
dialogue.christmas_weaver.next_santa.text = Der Weihnachtsmann hat noch eine Arbeit für dich vor <b>Heiligabend</b>.\nGeh und such ihn an seinem Baum.
dialogue.christmas_weaver.wrapping_offer.text = Mir geht das Band aus, und die Geschenke packen sich nicht von selbst ein.\nBring mir <b>Pflanzenfaser</b>. Und bring eines deiner Geschenke für mich zu <b>Bram</b>. Er hatte eine harte Woche.
dialogue.christmas_weaver.wrapping_offer.opt.accept = Ich helfe.
dialogue.christmas_weaver.wrapping_brief.text = Bring mir etwas <b>Pflanzenfaser</b>.\nGib dann <b>Bram</b> ein <b>Weihnachtsgeschenk</b>: Halte es in der Hand, sieh ihn an und klick mit links. Er ist auf der <b>Wiese</b> auf halbem Weg die Straße hinunter. Kein Geschenk? Ich verkaufe welche.
dialogue.christmas_weaver.wrapping_ready.text = Band für Tage, und Bram lächelt noch immer über sein Geschenk.\nDiese drei sind für dich. Und der Weihnachtsmann könnte noch einen Elfen gebrauchen, also halt still.
dialogue.christmas_weaver.wrapping_ready.opt.turnin = Danke, Elsie.
dialogue.christmas_weaver.fibre_offer.text = Mir ist schon wieder das Band ausgegangen.\nBring mir heute <b>Pflanzenfaser</b>, dann packe ich zwei Geschenke für dich ein.
dialogue.christmas_weaver.fibre_offer.opt.accept = Ich bringe welche.
dialogue.christmas_weaver.fibre_brief.text = Bring mir etwas <b>Pflanzenfaser</b>.
dialogue.christmas_weaver.fibre_ready.text = Schöne lange Fäden. Hier, zwei Geschenke, heute Morgen eingepackt.
dialogue.christmas_weaver.fibre_ready.opt.turnin = Hier ist die Faser.
dialogue.christmas_shepherd.off_season.text = Weihnachten ist vorbei. Für mich geht es zurück den Hügel hinauf.
dialogue.christmas_shepherd.off_season.opt.farewell = Sicheren Heimweg.
dialogue.christmas_shepherd.greeting.text = Frohe Weihnachten. Der Schlitten des Weihnachtsmanns wurde ausgeraubt, also bin ich zum Helfen heruntergekommen.\nIch verteile <b>Schneebälle</b>, jeden Tag ein Bündel gratis. Triff jemanden damit, und er wird für einen Moment langsamer. Tut nicht weh.
dialogue.christmas_shepherd.thieves.text = Trorks in Weihnachtsmannmützen. Sie kommen nachts in den <b>Wäldern</b> und auf den <b>Feldern</b> der <b>Emerald Wilds</b> heraus.\nOben im Schnee der <b>Whisperfrost Frontiers</b> sind sie den ganzen Tag unterwegs. Triff einen zuerst mit einem Schneeball. Das bremst ihn gleich.
dialogue.christmas_shepherd.why.text = Jemand muss den Schnee am Laufen halten.\nUnd der Weihnachtsmann hat nett gefragt.
dialogue.christmas_shepherd.opt.stall = Hast du Schneebälle?
dialogue.christmas_shepherd.opt.thieves = Wo sind die Diebe?
dialogue.christmas_shepherd.opt.why = Warum bist du hier?
dialogue.christmas_shepherd.opt.thanks = Danke, Bram.
dialogue.christmas_shepherd.opt.back = Verständlich.
dialogue.christmas_shepherd.opt.farewell = Frohe Weihnachten, Bram.
dialogue.christmas_shepherd.opt.quests = Brauchst du Hilfe?
dialogue.christmas_shepherd.opt.later = Gerade nicht.
dialogue.christmas_shepherd.next_tomas.text = <b>Tomas</b> will dich als Nächstes in der Küche.\nSein Laden ist neben dem Weihnachtsmann. Solange Marthas Fest noch läuft, steht er dort, wo die Straße auf das <b>Kweebec-Dorf</b> trifft.
dialogue.christmas_shepherd.reindeer_offer.text = Die Rentiere des Weihnachtsmanns haben nichts gefressen, seit die Trorks den Schlitten überfallen haben.\nBring mir <b>Karotten</b>.
dialogue.christmas_shepherd.reindeer_offer.opt.accept = Ich suche Karotten.
dialogue.christmas_shepherd.reindeer_brief.text = <b>Karotten</b> für die Rentiere. Bring sie her.
dialogue.christmas_shepherd.reindeer_ready.text = Damit bleiben sie flugfähig. Schneebälle für deine Mühe.\nUnd Tomas hat das hier bei mir für dich gelassen. Sein Plätzchenrezept, mit etwas Teig und Gewürz.
dialogue.christmas_shepherd.reindeer_ready.opt.turnin = Danke, Bram.
dialogue.christmas_shepherd.carrots_offer.text = Rentiere fressen den ganzen Tag.\nBringst du mir mehr <b>Karotten</b>? Ich lege Schneebälle drauf.
dialogue.christmas_shepherd.carrots_offer.opt.accept = Ich bringe Karotten.
dialogue.christmas_shepherd.carrots_brief.text = Mehr <b>Karotten</b>. Bring sie her.
dialogue.christmas_shepherd.carrots_ready.text = Gute Karotten. Die Rentiere werden sich darum streiten.
dialogue.christmas_shepherd.carrots_ready.opt.turnin = Bitte sehr.

# ---- Santa's story, the dailies and the carol tour ----
quest.christmas_santa_meet.title = Den Weihnachtsmann treffen
quest.christmas_santa_meet.flavor = Trorks haben meinen Schlitten ausgeraubt, und ich brauche Hilfe. Ich stehe bei meinem Baum im Vergessenen Tempel. Jedes Portal des Vergessenen Tempels bringt dich hin.
objective.christmas.meet_santa = Finde den Weihnachtsmann im Vergessenen Tempel
quest.christmas_present_thieves.title = Geschenkdiebe
quest.christmas_present_thieves.flavor = Trorks in Weihnachtsmannmützen sind mit meinen Geschenken abgehauen. Fang sie nachts in den Emerald Wilds oder jederzeit im Schnee der Whisperfrost Frontiers, dann komm zu mir zurück.
objective.christmas.catch_thieves = Fang {0} {0, plural, one {Geschenkdieb} other {Geschenkdiebe}}
quest.christmas_reindeer_food.title = Rentierfutter
quest.christmas_reindeer_food.flavor = Die Rentiere des Weihnachtsmanns haben nichts gefressen, seit der Schlitten ausgeraubt wurde. Bring mir ein paar Karotten. Ich bin auf der Wiese.
objective.christmas.bring_bram_carrots = Bring Bram {0} {0, plural, one {Karotte} other {Karotten}}
quest.christmas_gingerbread_cookies.title = Weihnachtsplätzchen
quest.christmas_gingerbread_cookies.flavor = Der Sack des Weihnachtsmanns braucht Plätzchen. Lern mein Rezept, back ein Lebkuchenmännchen und bring es mir beim Baum des Weihnachtsmanns.
objective.christmas.bring_tomas_cookie = Bring Tomas ein Lebkuchenmännchen
quest.christmas_wrapping_presents.title = Geschenke einpacken
quest.christmas_wrapping_presents.flavor = Ich brauche Pflanzenfaser für Band, also bring mir welche. Und gib eines deiner Geschenke Bram auf der Wiese. Er hatte eine harte Woche.
objective.christmas.bring_elsie_fibre = Bring Elsie {0} Pflanzenfaser
objective.christmas.give_bram_present = Gib Bram ein Weihnachtsgeschenk
quest.christmas_eve.title = Heiligabend
quest.christmas_eve.flavor = Der Schlitten fährt heute Nacht los. Bring mir Lebkuchenmännchen für den Sack und Karotten für die Rentiere, und gib mir ein Weihnachtsgeschenk für den Schlitten.
objective.christmas.bring_santa_cookies = Bring dem Weihnachtsmann {0} Lebkuchenmännchen
objective.christmas.bring_santa_carrots = Bring dem Weihnachtsmann {0} {0, plural, one {Karotte} other {Karotten}}
objective.christmas.give_santa_present = Gib dem Weihnachtsmann ein Weihnachtsgeschenk
quest.christmas_morning.title = Weihnachtsmorgen
quest.christmas_morning.flavor = Frohe Weihnachten. Unter meinem Baum im Vergessenen Tempel liegt ein Geschenk mit deinem Namen darauf. Komm und öffne es.
objective.christmas.morning = Öffne dein Geschenk unter dem Baum des Weihnachtsmanns
quest.christmas_daily_thieves.title = Tägliche Diebe
quest.christmas_daily_thieves.flavor = Diese Trorks sind wieder am Werk. Fang heute Nacht ein paar mehr Geschenkdiebe in den Emerald Wilds, dann komm zu mir zurück.
quest.christmas_daily_presents.title = Tägliche Geschenke
quest.christmas_daily_presents.flavor = Meine Helfer arbeiten hart. Gib Tomas, Elsie und Bram heute je ein Weihnachtsgeschenk. Halte eines in der Hand, sieh sie an und klick mit links.
objective.christmas.give_tomas_present = Gib Tomas ein Weihnachtsgeschenk
objective.christmas.give_elsie_present = Gib Elsie ein Weihnachtsgeschenk
quest.christmas_daily_baking.title = Tägliches Backen
quest.christmas_daily_baking.flavor = Mein Ofen frisst Teig schneller, als ich ihn anrühren kann. Bring mir welchen.
objective.christmas.bring_tomas_dough = Bring Tomas {0} Teig
quest.christmas_daily_wrapping.title = Tägliches Einpacken
quest.christmas_daily_wrapping.flavor = Mir ist schon wieder das Band ausgegangen. Bring mir Pflanzenfaser, dann packe ich zwei Geschenke für dich ein.
quest.christmas_daily_carrots.title = Tägliche Karotten
quest.christmas_daily_carrots.flavor = Die Rentiere fressen den ganzen Tag. Bring mir Karotten, und ich lege Schneebälle drauf.
quest.christmas_extra_thieves.title = Extra-Diebe
quest.christmas_extra_thieves.flavor = Ich nehme jeden Dieb, den du fangen kannst. Such nachts in den Emerald Wilds oder jederzeit im Schnee der Whisperfrost Frontiers, dann komm zu mir zurück. Mach es so oft du willst.
quest.christmas_carols.title = Weihnachtslieder
quest.christmas_carols.flavor = Nichts wärmt einen kalten Tempel wie ein Weihnachtslied. Sing eines für die Leute rund um den Vergessenen Tempel, dann komm und erzähl mir, wie es lief.
objective.christmas.sing_carols = Sing {0} {0, plural, one {Person} other {Personen}} ein Weihnachtslied

# ---- The Christmas Board ----
board.christmas_daily.title = Die Weihnachtstafel
board.christmas_daily.desc = Arbeiten draußen und Arbeiten in der Werkstatt, jeden Morgen frisch. Je höher du auf meiner Brav-Liste stehst, desto mehr hänge ich auf. Hol dir deinen Lohn, bevor der Schlitten abfährt. Kommst du zu spät, wartet er in deinem Questbuch.
board.christmas_daily.grade.outdoor = Arbeit draußen
board.christmas_daily.grade.workshop = Werkstattarbeit
quest.christmas_board_thieves.title = Diebesarbeit
quest.christmas_board_thieves.flavor = Fang Geschenkdiebe nachts in den Emerald Wilds oder jederzeit im Schnee der Whisperfrost Frontiers. Jeder Trork zählt.
quest.christmas_board_carrots.title = Karottenarbeit
quest.christmas_board_carrots.flavor = Pflück Karotten von Hand. Die Rentiere sind wieder hungrig.
objective.christmas.pick_carrots = Pflücke {0} {0, plural, one {Karotte} other {Karotten}}
quest.christmas_board_logs.title = Holzarbeit
quest.christmas_board_logs.flavor = Fäll Stämme von beliebigen Bäumen für das Feuer des Weihnachtsmanns. Der Tempel wird nachts kalt.
objective.christmas.chop_logs = Fäll {0} {0, plural, one {Stamm} other {Stämme}}
quest.christmas_board_eggs.title = Eierarbeit
quest.christmas_board_eggs.flavor = Tomas braucht Eier für seine Kuchen. Bring welche zur Tafel.
objective.christmas.bring_eggs = Bring {0} {0, plural, one {Ei} other {Eier}}
quest.christmas_board_cookies.title = Plätzchenarbeit
quest.christmas_board_cookies.flavor = Der Weihnachtsmann will mehr Plätzchen in seinem Sack. Back ein paar Lebkuchenmännchen und bring sie zur Tafel.
objective.christmas.bring_cookies = Bring {0} Lebkuchenmännchen
quest.christmas_board_dough.title = Teigarbeit
quest.christmas_board_dough.flavor = Bring etwas Teig zur Tafel. Tomas hat nie genug.
objective.christmas.bring_dough = Bring {0} Teig
quest.christmas_board_presents.title = Geschenkarbeit
quest.christmas_board_presents.flavor = Gib dem Weihnachtsmann Weihnachtsgeschenke für seinen Sack. Halte eines in der Hand, sieh ihn an und klick mit links.
objective.christmas.give_santa_presents = Gib dem Weihnachtsmann {0} {0, plural, one {Weihnachtsgeschenk} other {Weihnachtsgeschenke}}
quest.christmas_board_spices.title = Gewürzarbeit
quest.christmas_board_spices.flavor = Tomas' Lebkuchen braucht Gewürze. Bring welche zur Tafel.
objective.christmas.bring_spices = Bring {0} Gewürze

