# ---- Christmas in the Almanac ----
almanac.christmas.title = Weihnachten
almanac.christmas.flavor = Jeden Winter baut der Weihnachtsmann bei seinem Baum im Vergessenen Tempel auf, und das Dorf kommt, um ihm zu helfen.
almanac.christmas.thieves_caught = Geschenkdiebe gefangen
almanac.christmas.presents_opened = Geschenke geöffnet
almanac.christmas.presents_given = Geschenke an Freunde
almanac.christmas.carols_sung = Weihnachtslieder gesungen
almanac.christmas.snowballs_thrown = Schneebälle geworfen
almanac.christmas.yetis_defeated = Yetis besiegt
almanac.christmas.yeti.title = Der Yeti
almanac.christmas.yeti.line = Etwas Großes ist in eine Höhle oben im Schnee gezogen. Bring Bram etwas Yeti-Köder, dann führt er dich und deine Freunde in die Yeti-Höhle.
almanac.christmas.source.present = Geschenkdiebe lassen sie fallen, Elsie verkauft sie, und der Weihnachtsmann und seine Helfer verteilen sie.
almanac.christmas.source.snowball = Bram verteilt jeden Tag ein Bündel gratis.
almanac.christmas.source.cookie = An einem Kochherd nach Tomas' Rezept gebacken.
almanac.christmas.source.cook_dish = An einem Kochherd hergestellt, sobald du es aus einem Rezept gelernt hast, das Tomas verkauft.
almanac.christmas.source.recipe_cookie = Bram gibt es von Tomas weiter, während der Geschichte des Weihnachtsmanns, und Tomas verkauft es.
almanac.christmas.source.bakery_favor = In Tomas' Bäckerei verkauft, wenn du auf der Brav-Liste des Weihnachtsmanns aufsteigst.
almanac.christmas.source.candy_cane = Im Laden des Weihnachtsmanns verkauft und für jedes Weihnachtslied geschenkt, das du singst.
almanac.christmas.source.elsie_favor = In Elsies Laden verkauft, wenn du auf der Brav-Liste des Weihnachtsmanns aufsteigst.
almanac.christmas.source.santa_suit = In Elsies Laden verkauft und am Weihnachtsmorgen unter dem Baum des Weihnachtsmanns zu finden.
almanac.christmas.source.elf_suit = Elsie gibt dir einen, wenn du ihr beim Einpacken der Geschenke hilfst.
almanac.christmas.source.yeti_bait = In Brams Laden verkauft, sobald du seinen Rentieren die Karotten gebracht hast. Bram nimmt einen, um dich in die Yeti-Höhle zu führen.
almanac.christmas.source.yeti_fur = Der Yeti lässt manchmal eines zurück, wenn du ihn zum ersten Mal am Tag besiegst.
almanac.christmas.source.santa_stall = Im Laden des Weihnachtsmanns verkauft.
almanac.christmas.source.morning = Am Weihnachtsmorgen unter dem Baum des Weihnachtsmanns und hin und wieder in einem Sack des Weihnachtsmanns.
almanac.christmas.source.bauble = Fällt aus Bäumen, die du schlägst, solange Weihnachten läuft, und versteckt sich in Geschenken.
almanac.christmas.source.winter = Im Festivalregal im Laden des Weihnachtsmanns verkauft, solange Weihnachten läuft.
almanac.christmas.source.keepsake = Das Andenken von Heiligabend, einmal im Jahr geschenkt, wenn du dem Weihnachtsmann hilfst, seinen Schlitten zu füllen.
almanac.christmas.source.festival_favor = Im Festivalregal im Laden des Weihnachtsmanns an alle verkauft, die viel Festivalgunst haben.
