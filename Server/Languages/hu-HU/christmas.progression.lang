# Christmas progression: the season's currency, Santa's Nice List and Santa's Sack, the four Christmas
# stalls and their offers, the Christmas Set, the present's gift, Santa's conversation, the Christmas
# conversations of Tomas, Elsie and Bram, and the Christmas line their feast conversations gain.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. Numbers
# ride {0} and come from the content files, so a retune never touches a translation.

# ---- Christmas Coins ----
currency.christmas_coins.name = Karácsonyi Érme
currency.christmas_coins.amount = {0, number} {0, plural, one {Karácsonyi Érme} other {Karácsonyi Érme}}
currency.christmas_coins.description = Költsd el a karácsonyi boltokban a Feledett Templomban.

# ---- Santa's Nice List ----
reputation.christmas_nice_list.name = Mikulás Jók Listája
reputation.christmas_nice_list.flavor = A Mikulás kétszer is átnézi. Segíts neki visszaszerezni az ajándékait, és följebb jutsz rajta.
reputation.christmas_nice_list.rank.neutral = Újonc
reputation.christmas_nice_list.rank.friendly = A Listán
reputation.christmas_nice_list.rank.honored = Jó
reputation.christmas_nice_list.rank.revered = Nagyon Jó
reputation.christmas_nice_list.rank.exalted = Mikulás Kedvence
reputation.christmas_nice_list.earn.quests = Segíts a Mikulásnak, Tomasnak, Elsie-nek és Bramnak a Feledett Templomban a karácsonyi küldetéseikkel és napi munkáikkal.
reputation.christmas_nice_list.earn.board = Vállalj munkákat a Karácsonyi Táblán. Kérdezd meg a Mikulást, mit kell csinálni.
reputation.christmas_nice_list.earn.thieves = Kapj el Ajándéklopókat éjjel az Emerald Wilds-ban, vagy bármikor a Whisperfrost Frontiers havában. Más Trorkok is számítanak egy ideig, amíg tart a karácsony.
reputation.christmas_nice_list.earn.presents = Adj egy Karácsonyi Ajándékot egy barátnak: tartsd a kezedben, nézz rá, és kattints balra.
reputation.christmas_nice_list.earn.carols = Énekelj egy karácsonyi éneket bárkinek a templomban, naponta egyszer mindenkinek.
reputation.christmas_nice_list.earn.yeti = Győzd le a Jetit a Jeti Barlangjában. Bram a réten odavisz. Az első napi győzelmed számít a legtöbbet.
reputation.christmas_nice_list.earn.talk = Nézz be a Mikulásnál egy szóra naponta egyszer.
reputation.christmas_nice_list.earn.gear = Viseld a Karácsonyi Szettet Elsie boltjából, vagy edd meg a Karácsonyi bejglit, és gyorsabban haladsz följebb.
lootable.christmas_santas_sack.title = Mikulás-zsák
lootable.christmas_santas_sack.flavor = A Mikulás minden alkalommal becsomagol neked egyet, amikor a Mikulás Kedvence után még egy lépéssel följebb jutsz.
lootable.christmas_present_gift.title = Karácsonyi Ajándék
lootable.christmas_present_gift.flavor = Pár érme és egy kis meglepetés.
lootable.christmas_present_given.title = Ajándék egy Baráttól
lootable.christmas_present_given.flavor = Valaki neked adta ezt. Jobb, mint a sajátodat kibontani.
lootable.christmas_stocking.title = Mikulás-zokni
lootable.christmas_stocking.flavor = Egy finomság és egy kis zsebpénz, és néha egy ajándék.

# ---- The Christmas stalls ----
shop.christmas_santa.title = A Mikulás Boltja
shop.christmas_santa.desc = Csomagok a saját ajándékaid becsomagolásához, és cukorbotok a hideg hazaúthoz.
shop.christmas_santa.category.packets = Karácsonyi Csomagok
shop.christmas_santa.category.treats = Finomságok
shop.christmas_miller.title = Tomas Péksége
shop.christmas_miller.desc = Minden recept, amit a Mikulásnak sütök, és friss tészta, ha sietsz.
shop.christmas_miller.category.kitchen = Konyha
shop.christmas_weaver.title = Elsie Boltja
shop.christmas_weaver.desc = Magam csomagolta ajándékok, egy kis varázslat és meleg ruhák a hóra.
shop.christmas_weaver.category.gifts = Ajándékok
shop.christmas_weaver.category.clothes = Ruhák
shop.christmas_shepherd.title = Bram Hógolyói
shop.christmas_shepherd.desc = Keményre gyúrva. Vigyázz, kit dobsz meg velük.
shop.christmas_shepherd.category.snow = Hó
shop.christmas_offer_recipe_gingerbread_cookie.title = Mézeskalács receptje
shop.christmas_offer_recipe_gingerbread_cookie.desc = Süsd meg őket egy Szakács Tűzhelyen tésztából és fűszerből. Lendületet adnak a lépteidnek.
shop.christmas_offer_recipe_hot_cocoa.title = Forró kakaó receptje
shop.christmas_offer_recipe_hot_cocoa.desc = Készítsd el egy Szakács Tűzhelyen. Kint tartja a hideget, és visszahozza az életerődet.
shop.christmas_offer_recipe_cake.title = Karácsonyi bejgli receptje
shop.christmas_offer_recipe_cake.desc = A legjobb az asztalon. Mindent tud, amit a mézeskalács és a kakaó, és amíg tart, gyorsabban haladsz följebb a Mikulás Jók Listáján.
shop.christmas_offer_present.title = Karácsonyi Ajándék
shop.christmas_offer_present.desc = Elsie csomagolta. Nyisd ki, és meglátod, mi van benne.
shop.christmas_offer_christmas_wand.title = Karácsonyi Pálca
shop.christmas_offer_christmas_wand.desc = Irányítsd egy barátra, és manónak vagy rénszarvasnak öltözteted.
shop.christmas_offer_santa_suit.title = Mikulás-ruha
shop.christmas_offer_santa_suit.desc = Vedd fel, és egy ideig te vagy a Mikulás.
shop.christmas_offer_christmas_gloves.title = Karácsonyi Kesztyű
shop.christmas_offer_christmas_gloves.desc = Meleg kesztyű, a Karácsonyi Szett része. Viseld az egész szettet, és gyorsabban haladsz följebb a Mikulás Jók Listáján.
shop.christmas_offer_christmas_hat.title = Karácsonyi Sapka
shop.christmas_offer_christmas_hat.desc = Meleg sapka, a Karácsonyi Szett része. Viseld az egész szettet, és gyorsabban haladsz följebb a Mikulás Jók Listáján.
shop.christmas_offer_christmas_trousers.title = Karácsonyi Nadrág
shop.christmas_offer_christmas_trousers.desc = Meleg nadrág a hóra, a Karácsonyi Szett része. Viseld az egész szettet, és gyorsabban haladsz följebb a Mikulás Jók Listáján.
shop.christmas_offer_christmas_coat.title = Karácsonyi Kabát
shop.christmas_offer_christmas_coat.desc = Meleg kabát, a Karácsonyi Szett utolsó darabja. Viseld az egész szettet, és gyorsabban haladsz följebb a Mikulás Jók Listáján.
shop.christmas_offer_snowballs_daily.title = Ingyenes Hógolyók
shop.christmas_offer_snowballs_daily.desc = Egy köteg hógolyó Bramtól, naponta egyszer ingyen.
shop.christmas_offer_snowballs.title = Hógolyók
shop.christmas_offer_snowballs.desc = Még egy köteg, ha az ingyenesek elfogytak.
shop.christmas_offer_stocking.title = Mikulás-zokni
shop.christmas_offer_stocking.desc = Naponta egyszer ingyen. Nyúlj bele, és nézd meg, mit hagyott neked a Mikulás.

# ---- The Christmas Set ----
# A set's notice is a toast, so no value carries markup.
gearset.christmas_set.title = Karácsonyi Szett
gearset.christmas_set.tier_half = A szett fele rajtad: egy kicsivel több életerő.
gearset.christmas_set.tier_full = Az egész szett rajtad: megint több életerő, a hideg kevésbé mar, és gyorsabban haladsz följebb a Mikulás Jók Listáján.

# ---- Santa's conversation ----
dialogue.christmas_santa.off_season.text = A karácsonynak vége, a szánom pedig összecsomagolva áll hazafelé.\nKeress meg újra jövő télen.
dialogue.christmas_santa.off_season.opt.farewell = Viszlát, Mikulás.
dialogue.christmas_santa.first_words.text = Hó-hó-hó. Hát itt vagy.\nÉn vagyok a Mikulás, és kell egy kéz. Mikulássapkás Trorkok kirabolták a szánomat, és elvitték az ajándékokat. Kapd el azokat az <b>Ajándéklopókat</b> éjjel az <b>Emerald Wilds-ban</b>, vagy bármikor a <b>Whisperfrost Frontiers</b> havában, és hozd vissza az ajándékaimat.
dialogue.christmas_santa.first_words.opt.hail = Segítek, Mikulás.
dialogue.christmas_santa.daily_word.text = Már megint itt vagy? Jó. Ez egy újabb nap a <b>Jók Listáján</b>.\nA lopók még odakint vannak. Figyeld az erdőt ma éjjel.
dialogue.christmas_santa.menu.text = Nos. Miben segíthetek?
dialogue.christmas_santa.who_are_you.text = A Mikulás vagyok. Minden karácsonykor ajándékot hozok mindenkinek Orbisban.\nIdén segítőim vannak. Tomas süt, Elsie csomagol és varr, Bram pedig hógolyóval látja el az embereket.
dialogue.christmas_santa.about_thieves.text = Mikulássapkás Trorkok, és csak ököllel harcolnak, úgyhogy nem érnek fel hozzád.\nNézz körül éjjel az <b>Emerald Wilds</b> erdeiben és mezőin, vagy bármikor a <b>Whisperfrost Frontiers</b> havában. Sokuknál még ott az ajándék. Nyisd ki, és a tiéd.
dialogue.christmas_santa.helpers.text = <b>Tomas</b> és <b>Elsie</b> itt tartják a boltjukat mellettem. Amíg Martha lakomája tart, a <b>kweebec falunál</b> segítenek neki az út végén.\n<b>Bram</b> a réten van, félúton az úton, ahol bejöttél.
dialogue.christmas_santa.opt.shop = Mutasd a boltodat.
dialogue.christmas_santa.opt.standing = Hogy állok a listádon?
dialogue.christmas_santa.opt.thieves = Hol vannak a lopók?
dialogue.christmas_santa.opt.helpers = Hol vannak a segítőid?
dialogue.christmas_santa.opt.who = Ki vagy te?
dialogue.christmas_santa.opt.back = Valami mást.
dialogue.christmas_santa.opt.farewell = Boldog karácsonyt, Mikulás.
dialogue.christmas_santa.opt.returned = Visszajöttem.
dialogue.christmas_santa.opt.quests = Mit kell csinálni?
dialogue.christmas_santa.opt.almanac = Mutasd az Almanachot.
dialogue.christmas_santa.opt.story = Miben segíthetek?
dialogue.christmas_santa.meet_arrival.text = Hó-hó-hó. Megtaláltál.\nA Mikulás vagyok, és kell egy kéz. Mikulássapkás Trorkok kirabolták a szánomat az úton, és elvitték az ajándékokat. Szerezzük vissza őket.
dialogue.christmas_santa.meet_arrival.opt.hail = Segítek, Mikulás.
dialogue.christmas_santa.morning_arrival.text = Boldog karácsonyt. Nézz a fám alá.\nVan ott egy ajándék a te neveddel.
dialogue.christmas_santa.morning_arrival.opt.open = Nekem?
dialogue.christmas_santa.daily_word_story_done.text = Már megint itt vagy? Jó. Ez egy újabb nap a <b>Jók Listáján</b>.\nA szán be van csomagolva, úgyhogy a történetem jövő karácsonyig véget ért. Minden nap van még <b>munkám</b>, az <b>Ajándéklopók</b> még odakint vannak, és a <b>boltok</b> nyitva.
dialogue.christmas_santa.story_done.text = A szán be van csomagolva, és ez a te érdemed.\nA történetem jövő karácsonyig véget ért, de van még bőven. Gyere be minden nap a <b>munkáimért</b>, kapd tovább az <b>Ajándéklopókat</b>, és nézd meg, mi új a <b>boltokban</b>.
dialogue.christmas_santa.story.text = Először kapd el nekem az <b>Ajándéklopókat</b>. Aztán <b>Bramnak</b> sárgarépa kell a rénszarvasoknak, <b>Tomasnak</b> segítség a mézeskalácsnál, <b>Elsie-nek</b> pedig a csomagolásnál. Utána gyere vissza hozzám <b>Szentestére</b>.\nMinden nap van munkám is. Kérdezd meg, mit kell csinálni.
dialogue.christmas_santa.thieves_offer.text = Azoknál a lopóknál még ott az ajándékom. Kapj el párat az <b>Ajándéklopókból</b> nekem.\nÉjjel jönnek elő az <b>Emerald Wilds</b> erdeiben és mezőin, a <b>Whisperfrost Frontiers</b> havában pedig egész nap kint vannak. Bármelyik Trork számít, akit elkapsz.
dialogue.christmas_santa.thieves_offer.opt.accept = Elkapom őket.
dialogue.christmas_santa.thieves_brief.text = Nézz körül éjjel az <b>Emerald Wilds-ban</b>, vagy bármikor a <b>Whisperfrost Frontiers</b> havában. Bármelyik Trork számít.\nGyere vissza hozzám, ha eleget elkaptál.
dialogue.christmas_santa.thieves_ready.text = Megvannak. Az egyiknél ez volt. Nyisd ki, vagy add oda egy barátnak.\nNa most, <b>Bram</b> rénszarvasai éhesek. A <b>réten</b> van, félúton az úton, ahol bejöttél.
dialogue.christmas_santa.thieves_ready.opt.turnin = Tessék.
dialogue.christmas_santa.eve_offer.text = Mindjárt <b>Szenteste</b>, és a szán még nem tele.\nHozz nekem <b>Mézeskalácsot</b> a zsákba és <b>sárgarépát</b> a rénszarvasoknak. És adj egy <b>Karácsonyi Ajándékot</b> a szánra.
dialogue.christmas_santa.eve_offer.opt.accept = Töltsük meg a szánt.
dialogue.christmas_santa.eve_brief.text = Süss <b>Mézeskalácsot</b> egy <b>Szakács Tűzhelyen</b>, és szedj <b>sárgarépát</b> az <b>Emerald Wilds</b> erdeiben.\nAz ajándékot tartsd a kezedben, nézz rám, és kattints balra.
dialogue.christmas_santa.eve_ready.text = Megtelt a szán. Hó-hó-hó.\nEz a dísz a tiéd. Akaszd oda, ahol minden karácsonykor látod.
dialogue.christmas_santa.eve_ready.opt.turnin = Boldog karácsonyt, Mikulás.
dialogue.christmas_santa.carols_offer.text = Semmi sem melegíti úgy a hideg templomot, mint egy karácsonyi ének.\nÉnekelj egyet <b>a Feledett Templom körüli embereknek</b>, aztán gyere, és mondd el, hogy ment. Nekem ne, ugye. Én minden szöveget tudok.
dialogue.christmas_santa.carols_offer.opt.accept = Megyek énekelni.
dialogue.christmas_santa.carols_brief.text = Beszélj az emberekkel a templom körül, és válaszd az <b>Éneklek egy karácsonyi éneket</b> lehetőséget. A segítőim jó kezdet.\nMindenki naponta egyszer hallgat meg.
dialogue.christmas_santa.carols_ready.text = Innen is hallottalak. Egyáltalán nem rossz.
dialogue.christmas_santa.carols_ready.opt.turnin = Mindenki velem énekelt.
dialogue.christmas_santa.daily_thieves_offer.text = Azok a Trorkok megint nekiláttak.\nElkapsz ma még párat az <b>Ajándéklopókból</b>?
dialogue.christmas_santa.daily_thieves_offer.opt.accept = Elkapom őket.
dialogue.christmas_santa.daily_presents_offer.text = A segítőim keményen dolgoznak.\nAdj mindegyiknek egy <b>Karácsonyi Ajándékot</b> ma. Tarts egyet a kezedben, nézz rájuk, és kattints balra.
dialogue.christmas_santa.daily_presents_offer.opt.accept = Kiosztom őket.
dialogue.christmas_santa.presents_brief.text = Adj egy <b>Karácsonyi Ajándékot</b> <b>Tomasnak</b>, <b>Elsie-nek</b> és <b>Bramnak</b>. Tarts egyet a kezedben, nézz rájuk, és kattints balra.\nA lopók ejtenek ajándékot, és <b>Elsie</b> árul.
dialogue.christmas_santa.extra_thieves_ready.text = Még több lopó elkapva. A listám minden nap hosszabb.
dialogue.christmas_santa.extra_thieves_ready.opt.turnin = Itt a számom.
dialogue.christmas_santa.ready_generic.text = Már kész is? Lássuk.
dialogue.christmas_santa.ready_generic.opt.turnin = Kész van.

# ---- Santa's helpers: Tomas the Miller, Elsie the Weaver and Bram the Shepherd ----
dialogue.christmas_feast_line.opt.stall = Mi van a karácsonyi boltodban?
dialogue.christmas_feast_line.opt.quests = Van számomra karácsonyi munka?
dialogue.christmas_carol.opt.sing = Éneklek egy karácsonyi éneket
dialogue.christmas_miller.off_season.text = A karácsonynak vége, a kemence kihűlt.\nLátjuk egymást, ha visszajön a hó.
dialogue.christmas_miller.off_season.opt.farewell = Jövő télen találkozunk.
dialogue.christmas_miller.greeting.text = Boldog karácsonyt. A Mikulásnak mézeskalács kell a zsákjába, úgyhogy felhoztam a kemencémet a malomból.\nÁrulom a <b>Mézeskalács</b>, a <b>Forró kakaó</b> és a <b>Karácsonyi bejgli</b> receptjét. Süsd meg őket egy <b>Szakács Tűzhelyen</b>.
dialogue.christmas_miller.dough.text = Őrölj <b>búzát</b> <b>liszttá</b> egy <b>Szakács Tűzhelyen</b>, aztán keverd a lisztet <b>tojással</b> és egy <b>korsó vízzel</b> ugyanazon a tűzhelyen.\nSiet az idő? Naponta árulok egy kis tésztát.
dialogue.christmas_miller.why.text = Trorkok kirabolták a Mikulás szánját az úton, és ő segítséget kért a falutól. Elsie és Bram is eljött.\nValakinek etetnie kell az öreget.
dialogue.christmas_miller.opt.stall = Mit árulsz?
dialogue.christmas_miller.opt.dough = Hogyan csinálok tésztát?
dialogue.christmas_miller.opt.why = Miért vagy itt?
dialogue.christmas_miller.opt.thanks = Kösz, Tomas.
dialogue.christmas_miller.opt.back = Rendes tőled.
dialogue.christmas_miller.opt.farewell = Boldog karácsonyt, Tomas.
dialogue.christmas_miller.opt.quests = Van számomra munka?
dialogue.christmas_miller.opt.later = Most nem.
dialogue.christmas_miller.next_elsie.text = A Mikulás zsákja nem telik meg magától. <b>Elsie-nek</b> kell egy kéz a csomagolásnál.\nA boltja itt van, a Mikulás mellett. Amíg Martha lakomája tart, a <b>kweebec falu</b> túlsó oldalán van.
dialogue.christmas_miller.cookies_offer.text = Bram odaadta a receptemet? Jó. A Mikulás mézeskalácsot akar a zsákjába.\nTanuld meg a receptet, süss egy <b>Mézeskalácsot</b> egy <b>Szakács Tűzhelyen</b>, és hozd ide. Látni akarom, hogy sikerült.
dialogue.christmas_miller.cookies_offer.opt.accept = Sütök egyet.
dialogue.christmas_miller.cookies_brief.text = A receptlappal tanuld meg, aztán süss egy <b>Mézeskalácsot</b> egy <b>Szakács Tűzhelyen</b> <b>tésztából</b> és <b>fűszerből</b>.\nHozz nekem egyet.
dialogue.christmas_miller.cookies_ready.text = Ez aztán igazi mézeskalácsember. Az illata is jó.\nSüss tovább. A Mikulás sokkal többet akar majd Szenteste előtt.
dialogue.christmas_miller.cookies_ready.opt.turnin = Tessék, kóstold meg.
dialogue.christmas_miller.baking_offer.text = A kemencém gyorsabban eszi a tésztát, mint ahogy keverem.\nHozol ma nekem egy kis <b>tésztát</b>?
dialogue.christmas_miller.baking_offer.opt.accept = Hozok tésztát.
dialogue.christmas_miller.baking_brief.text = Készíts <b>tésztát</b> egy <b>Szakács Tűzhelyen</b>, és hozd ide.\nSosem csináltál? Kérdezd meg, hogyan.
dialogue.christmas_miller.baking_ready.text = Friss tészta. A kemence már várt rá.
dialogue.christmas_miller.baking_ready.opt.turnin = Itt a tészta.
dialogue.christmas_weaver.off_season.text = A karácsonynak vége, a szalagok elpakolva.\nKeress meg jövő télen. Addigra új ajándékokat csomagolok.
dialogue.christmas_weaver.off_season.opt.farewell = Keresni foglak.
dialogue.christmas_weaver.greeting.text = Boldog karácsonyt. A lopók szakadtan és sárosan hagyták a Mikulás ajándékait, úgyhogy mindet újra becsomagolom.\nÁrulok <b>Karácsonyi Ajándékot</b>, <b>Karácsonyi Pálcát</b>, <b>Mikulás-ruhát</b> és <b>Karácsonyi Szettet</b>. Minél följebb vagy a Mikulás <b>Jók Listáján</b>, annál többet adhatok el neked.
dialogue.christmas_weaver.presents.text = Jobb gombbal kattints egy ajándékra a kibontásához. Mindig van benne valami, és néha valami szép.\nVagy add tovább: tartsd a kezedben, nézz egy barátra, és kattints balra. Jobb ajándékot kap, mint amit te kapnál, és a Mikulás észreveszi. Ha a Mikulás vagy valamelyikünk ajándékot kér, ugyanígy add át.\nAz <b>Ajándéklopóknál</b> sok van. Éjjel találod őket az <b>Emerald Wilds-ban</b>.
dialogue.christmas_weaver.why.text = A Mikulás segítséget kért a falutól, úgyhogy itt vagyok. Valakinek be kell csomagolnia mindezt.\nÉs valakinek új kabátot kell varrnia neki. A Trorkok a tartalékot is elvitték.
dialogue.christmas_weaver.opt.stall = Mutasd, mid van.
dialogue.christmas_weaver.opt.presents = Mit csináljak egy ajándékkal?
dialogue.christmas_weaver.opt.why = Miért vagy itt?
dialogue.christmas_weaver.opt.thanks = Köszönöm, Elsie.
dialogue.christmas_weaver.opt.back = Sok a csomagolnivaló.
dialogue.christmas_weaver.opt.farewell = Boldog karácsonyt, Elsie.
dialogue.christmas_weaver.opt.quests = Segíthetek?
dialogue.christmas_weaver.opt.later = Most nem.
dialogue.christmas_weaver.next_santa.text = A Mikulásnak még egy munkája van számodra <b>Szenteste</b> előtt.\nMenj, és keresd meg a fájánál.
dialogue.christmas_weaver.wrapping_offer.text = Kifogyok a szalagból, és az ajándékok nem csomagolják be magukat.\nHozz nekem <b>Növényi Rostot</b>. A fűből szedheted. És vidd el az egyik ajándékodat <b>Bramnak</b> helyettem. Nehéz hete volt.
dialogue.christmas_weaver.wrapping_offer.opt.accept = Segítek.
dialogue.christmas_weaver.wrapping_brief.text = Szedj <b>Növényi Rostot</b> a fűből, és hozd ide nekem.\nAztán adj <b>Bramnak</b> egy <b>Karácsonyi Ajándékot</b>: tartsd a kezedben, nézz rá, és kattints balra. A <b>réten</b> van, félúton az úton. Nincs ajándék? Én árulok.
dialogue.christmas_weaver.wrapping_ready.text = Szalag napokra, és Bram még mindig mosolyog az ajándékán.\nEz a három a tiéd. És a Mikulásnak jól jönne még egy manó, úgyhogy maradj nyugton.
dialogue.christmas_weaver.wrapping_ready.opt.turnin = Köszönöm, Elsie.
dialogue.christmas_weaver.fibre_offer.text = Megint kifogytam a szalagból.\nHozz nekem ma <b>Növényi Rostot</b>, és becsomagolok neked két ajándékot.
dialogue.christmas_weaver.fibre_offer.opt.accept = Hozok egy keveset.
dialogue.christmas_weaver.fibre_brief.text = Szedj <b>Növényi Rostot</b> a fűből, és hozd ide nekem.
dialogue.christmas_weaver.fibre_ready.text = Jó hosszú szálak. Tessék, két ajándék, ma reggel csomagolva.
dialogue.christmas_weaver.fibre_ready.opt.turnin = Itt a rost.
dialogue.christmas_shepherd.off_season.text = Vége a karácsonynak. Megyek vissza a dombra.
dialogue.christmas_shepherd.off_season.opt.farewell = Jó utat haza.
dialogue.christmas_shepherd.greeting.text = Boldog karácsonyt. A Mikulás szánját kirabolták, úgyhogy lejöttem segíteni.\nOsztok <b>hógolyót</b>, naponta egy köteg ingyen. Ha eltalálsz valakit eggyel, egy pillanatra lelassul. Nem fáj.
dialogue.christmas_shepherd.thieves.text = Mikulássapkás Trorkok. Éjjel jönnek elő az <b>Emerald Wilds</b> <b>erdeiben</b> és <b>mezőin</b>.\nFönt a <b>Whisperfrost Frontiers</b> havában egész nap kint vannak. Előbb dobj rá egy hógolyót. Rendesen lelassítja.
dialogue.christmas_shepherd.why.text = Valakinek biztosítania kell a havat.\nÉs a Mikulás szépen kérte.
dialogue.christmas_shepherd.opt.stall = Van hógolyód?
dialogue.christmas_shepherd.opt.thieves = Hol vannak a lopók?
dialogue.christmas_shepherd.opt.why = Miért vagy itt?
dialogue.christmas_shepherd.opt.thanks = Kösz, Bram.
dialogue.christmas_shepherd.opt.back = Igazad van.
dialogue.christmas_shepherd.opt.farewell = Boldog karácsonyt, Bram.
dialogue.christmas_shepherd.opt.quests = Kell egy kéz?
dialogue.christmas_shepherd.opt.later = Most nem.
dialogue.christmas_shepherd.next_tomas.text = <b>Tomas</b> legközelebb a konyhában akar látni.\nA boltja a Mikulás mellett van. Amíg Martha lakomája tart, ott van, ahol az út találkozik a <b>kweebec faluval</b>.
dialogue.christmas_shepherd.reindeer_offer.text = A Mikulás rénszarvasai nem ettek, amióta a Trorkok megtámadták a szánt.\nHozz nekem <b>sárgarépát</b>. Vadon terem az <b>Emerald Wilds</b> erdeiben.
dialogue.christmas_shepherd.reindeer_offer.opt.accept = Keresek sárgarépát.
dialogue.christmas_shepherd.reindeer_brief.text = Szedj <b>sárgarépát</b> az <b>Emerald Wilds</b> erdeiben, és hozd ide.
dialogue.christmas_shepherd.reindeer_ready.text = Ettől repülnek tovább. Hógolyók a fáradságodért.\nTomas pedig hagyott itt neked ezt. A mézeskalács receptje, egy kis tésztával és fűszerrel.
dialogue.christmas_shepherd.reindeer_ready.opt.turnin = Kösz, Bram.
dialogue.christmas_shepherd.carrots_offer.text = A rénszarvasok egész nap esznek.\nHozol még <b>sárgarépát</b>? Hógolyót is adok hozzá.
dialogue.christmas_shepherd.carrots_offer.opt.accept = Hozok sárgarépát.
dialogue.christmas_shepherd.carrots_brief.text = <b>Sárgarépa</b> az <b>Emerald Wilds</b> erdeiből. Hozd ide.
dialogue.christmas_shepherd.carrots_ready.text = Jó sárgarépa. A rénszarvasok összevesznek rajta.
dialogue.christmas_shepherd.carrots_ready.opt.turnin = Tessék.

# ---- Santa's story, the dailies and the carol tour ----
quest.christmas_santa_meet.title = Találkozz a Mikulással
quest.christmas_santa_meet.flavor = Trorkok kirabolták a szánomat, és segítség kell. A fám mellett vagyok a Feledett Templomban. Bármelyik Feledett Templom-kapu elvisz oda.
objective.christmas.meet_santa = Találd meg a Mikulást a Feledett Templomban
quest.christmas_present_thieves.title = Ajándéklopók
quest.christmas_present_thieves.flavor = Mikulássapkás Trorkok elvitték az ajándékaimat. Kapd el őket éjjel az Emerald Wilds-ban, vagy bármikor a Whisperfrost Frontiers havában, aztán gyere vissza hozzám.
objective.christmas.catch_thieves = Kapj el {0} {0, plural, one {Ajándéklopót} other {Ajándéklopót}}
quest.christmas_reindeer_food.title = Rénszarvaseledel
quest.christmas_reindeer_food.flavor = A Mikulás rénszarvasai nem ettek, amióta kirabolták a szánt. Szedj sárgarépát az Emerald Wilds erdeiben, és hozd el nekem a rétre.
objective.christmas.bring_bram_carrots = Hozz Bramnak {0} {0, plural, one {Sárgarépát} other {Sárgarépát}}
quest.christmas_gingerbread_cookies.title = Karácsonyi Sütik
quest.christmas_gingerbread_cookies.flavor = A Mikulás zsákjába mézeskalács kell. Tanuld meg a receptemet, süss egy Mézeskalácsot egy Szakács Tűzhelyen tésztából és fűszerből, és hozd el nekem a Mikulás fájához.
objective.christmas.bring_tomas_cookie = Hozz Tomasnak egy Mézeskalácsot
quest.christmas_wrapping_presents.title = Ajándékcsomagolás
quest.christmas_wrapping_presents.flavor = Növényi Rost kell a szalaghoz, úgyhogy szedj egy keveset a fűből, és hozd el nekem. És adj egyet az ajándékaid közül Bramnak a réten. Nehéz hete volt.
objective.christmas.bring_elsie_fibre = Hozz Elsie-nek {0} Növényi Rostot
objective.christmas.give_bram_present = Adj Bramnak egy Karácsonyi Ajándékot
quest.christmas_eve.title = Szenteste
quest.christmas_eve.flavor = A szán ma este indul. Hozz nekem Mézeskalácsot a zsákba és sárgarépát a rénszarvasoknak, és adj egy Karácsonyi Ajándékot a szánra.
objective.christmas.bring_santa_cookies = Hozz a Mikulásnak {0} {0, plural, one {Mézeskalácsot} other {Mézeskalácsot}}
objective.christmas.bring_santa_carrots = Hozz a Mikulásnak {0} {0, plural, one {Sárgarépát} other {Sárgarépát}}
objective.christmas.give_santa_present = Adj a Mikulásnak egy Karácsonyi Ajándékot
quest.christmas_morning.title = Karácsony Reggele
quest.christmas_morning.flavor = Boldog karácsonyt. A fám alatt van egy ajándék a Feledett Templomban, a te neveddel. Gyere, és bontsd ki.
objective.christmas.morning = Bontsd ki az ajándékodat a Mikulás fája alatt
quest.christmas_daily_thieves.title = Napi Lopók
quest.christmas_daily_thieves.flavor = Azok a Trorkok megint nekiláttak. Kapj el még párat az Ajándéklopókból ma éjjel az Emerald Wilds-ban, aztán gyere vissza hozzám.
quest.christmas_daily_presents.title = Napi Ajándékok
quest.christmas_daily_presents.flavor = A segítőim keményen dolgoznak. Adj Tomasnak, Elsie-nek és Bramnak egy-egy Karácsonyi Ajándékot ma. Tarts egyet a kezedben, nézz rájuk, és kattints balra.
objective.christmas.give_tomas_present = Adj Tomasnak egy Karácsonyi Ajándékot
objective.christmas.give_elsie_present = Adj Elsie-nek egy Karácsonyi Ajándékot
quest.christmas_daily_baking.title = Napi Sütés
quest.christmas_daily_baking.flavor = A kemencém gyorsabban eszi a tésztát, mint ahogy keverem. Készíts tésztát egy Szakács Tűzhelyen, és hozz nekem egy keveset.
objective.christmas.bring_tomas_dough = Hozz Tomasnak {0} Tésztát
quest.christmas_daily_wrapping.title = Napi Csomagolás
quest.christmas_daily_wrapping.flavor = Megint kifogytam a szalagból. Szedj Növényi Rostot a fűből, és hozd el nekem, és becsomagolok neked két ajándékot.
quest.christmas_daily_carrots.title = Napi Sárgarépa
quest.christmas_daily_carrots.flavor = A rénszarvasok egész nap esznek. Hozz nekem sárgarépát az Emerald Wilds erdeiből, és hógolyót is adok hozzá.
quest.christmas_extra_thieves.title = Extra Lopók
quest.christmas_extra_thieves.flavor = Minden lopót elviszek, akit el tudsz kapni. Nézz körül éjjel az Emerald Wilds-ban, vagy bármikor a Whisperfrost Frontiers havában, aztán gyere vissza hozzám. Ahányszor csak akarod.
quest.christmas_carols.title = Karácsonyi Énekek
quest.christmas_carols.flavor = Semmi sem melegíti úgy a hideg templomot, mint egy karácsonyi ének. Énekelj egyet a Feledett Templom körüli embereknek, aztán gyere, és mondd el, hogy ment.
objective.christmas.sing_carols = Énekelj egy karácsonyi éneket {0} {0, plural, one {embernek} other {embernek}}

# ---- The Christmas Board ----
board.christmas_daily.title = A Karácsonyi Tábla
board.christmas_daily.desc = Kinti munkák és műhelymunkák, minden reggel frissen. Minél följebb vagy a Jók Listámon, annál többet rakok ki. Vedd fel a béredet, mielőtt a szán elindul. Ha elkésel, a Küldetésnaplódban vár.
board.christmas_daily.grade.outdoor = Kinti munka
board.christmas_daily.grade.workshop = Műhelymunka
