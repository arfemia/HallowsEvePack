objective.christmas.chop_logs = Vágj {0} {0, plural, one {farönköt} other {farönköt}}
quest.christmas_board_eggs.title = Tojásmunka
quest.christmas_board_eggs.flavor = Tomasnak tojás kell a bejglijéhez. Tarts csirkéket egy Csirkeólban, vagy keress madárfészket, és hozd a tojásokat a táblához.
