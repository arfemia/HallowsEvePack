board.grade.hallows_eve_skill = Képességmunka
boostrule.mmo_hallows_eve_harvest_moon.title = Aratási Hold
gearset.mmo_hallows_eve_hallowed.title = Megszentelt Szett (képességek)
gearset.mmo_hallows_eve_hallowed.tier_full = Sisak és pajzs együtt: kicsivel több szerencse, és erősebb Tüzérség-találatok.
quest.mmo_hallows_eve_daily_artillery.title = Lámpásgyakorlat
quest.mmo_hallows_eve_daily_artillery.flavor = A jó dobókarhoz gyakorlás kell, és ez a hónap épp erre való. Dobj ma éjjel arra, ami megérdemli, és gyere vissza biztosabb célzással.
quest.mmo_hallows_eve_daily_harvesting.title = Éjszakai Aratás
quest.mmo_hallows_eve_daily_harvesting.flavor = A tökföld nem takarítja be magát, és a hideg tökök csak biztos kéznek jönnek elő. Töltsd ma az éjszakát a földeken.
quest.mmo_hallows_eve_daily_mining.title = Műszak a Mélyben
quest.mmo_hallows_eve_daily_mining.flavor = A kő annak adja oda a geodáit, aki ismeri. Húzz le ma éjjel egy hosszú műszakot a föld alatt, és ismerd meg jobban.
quest.mmo_hallows_eve_daily_crafting.title = Szorgos Kezek
quest.mmo_hallows_eve_daily_crafting.flavor = A templom lépcsőjén minden lámpást valakinek a keze készített. Töltsd ma az éjszakát egy munkapadnál, bármelyiknél, és ne hagyd pihenni a sajátodat.
