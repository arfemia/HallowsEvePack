
# Harvest Feast with MMO Skill Tree: the words for the skill jobs on the feast board, the board's skill
# band and the feast's Harvesting boost. Nothing reads them on a server without MMO Skill Tree.
# Keys are written bare: MMO Skill Tree and the library find each one by its tail, whatever this file is
# called. A skill job takes its words from the keys its id spells (quest.<id>.title and .flavor).

# ---- The feast board's skill band ----
board.harvest_feast_daily.grade.skill = Képességmunka

# ---- The skill jobs ----
quest.mmo_harvest_feast_daily_harvesting.title = Teli Földek
quest.mmo_harvest_feast_daily_harvesting.flavor = Több terem odakint a földeken, mint amennyit egy pár kéz be tud hordani. Töltsd a mai napot szedéssel, és légy benne gyorsabb.
quest.mmo_harvest_feast_daily_crafting.title = Zsúfolt Munkapadok
quest.mmo_harvest_feast_daily_crafting.flavor = A munkapadok ezen a héten nem hűlnek ki. Töltsd a mai napot készítéssel; bármelyik munkapad megteszi.
quest.mmo_harvest_feast_daily_archery.title = Vadász Gyakorlat
quest.mmo_harvest_feast_daily_archery.flavor = A pulykák egy lépéstől is megriadnak. Tanulj meg messziről leteríteni őket, és a sült hálás lesz.
quest.mmo_harvest_feast_daily_woodcutting.title = Sütőfa
quest.mmo_harvest_feast_daily_woodcutting.flavor = A sütők egész héten falják a fát. Vágj ki néhány fát, és tartsd égve a tüzet.

# ---- The feast's boost ----
boostrule.mmo_harvest_feast_harvesting.title = Aratási Lakoma
