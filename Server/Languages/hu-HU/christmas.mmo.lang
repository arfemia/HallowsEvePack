boostrule.mmo_christmas_day.title = Karácsony napja
boostrule.mmo_christmas_new_years_eve.title = Szilveszter

# ---- The Christmas Set's skill half (only where MMO Skill Tree runs) ----
# A set's notice is a toast, so no value carries markup.
gearset.mmo_christmas_set.tier_half = Még több Favágás XP.
gearset.mmo_christmas_set.tier_full = Megint több Favágás XP, és jobb szerencse, ha fát vágsz.

# ---- Christmas Morning's treats, and Bram's present ----
lootable.christmas_treats.title = Egy Zacskó Finomság
lootable.christmas_treats.flavor = Cukorbot, mézeskalács vagy kakaó, és néha egy egész Karácsonyi bejgli.
lootable.christmas_bram_decorations.title = Bram Ajándéka
lootable.christmas_bram_decorations.flavor = Egy kis extra Bramtól minden kibontott ajándékban: egy karácsonyi dekoráció az otthonodra.

# ---- The villagers' secrets ----
quest.christmas_tomas_apprentice.title = Tomas Tanítványa
quest.christmas_tomas_apprentice.flavor = Süsd meg a karácsonyi finomságaimat egy Szakács Tűzhelyen. Minden elkészült finomság számít. Süss eleget, és eladom neked a saját karácsonyi kalácsom receptjét.
quest.christmas_elsie_apprentice.title = Elsie Tanítványa
quest.christmas_elsie_apprentice.flavor = Tegyél ki karácsonyi dekorációkat az otthonodban. Tegyél ki eleget, és eladom neked a Rénszarvas-ruhámat.
quest.christmas_bram_apprentice.title = Bram Tanítványa
quest.christmas_bram_apprentice.flavor = Hozz le rönköket bármelyik fáról. Vágj eleget, és minden kibontott Karácsonyi Ajándékban lesz tőlem egy kis extra.
shop.christmas_offer_recipe_tomas_loaf.title = Tomas karácsonyi kalácsának receptje
shop.christmas_offer_recipe_tomas_loaf.desc = Tomas saját édes kalácsa. Gyorsabban mozogsz, és a hideg kevésbé mar, amíg tart.
shop.christmas_offer_reindeer_suit.title = Rénszarvas-ruha
shop.christmas_offer_reindeer_suit.desc = Vedd fel, és egy ideig a Mikulás egyik rénszarvasa vagy.
# A lock line reads "Requires " and then one of these; each server loads the one its overlay names.
factor.christmas_tomas_key.name = Tomas Tanítványának teljesítése
factor.christmas_tomas_key.name_mmo = Tomas Tanítványának teljesítése vagy a Craftolás 20. szintje
factor.christmas_elsie_key.name = Elsie Tanítványának teljesítése
factor.christmas_elsie_key.name_mmo = Elsie Tanítványának teljesítése vagy az Építés 20. szintje
# A costume's buff-bar tile name. Its effect's Name is this key in full (christmas.mmo.effect...).
effect.christmas_costume_reindeer_suit.name = Rénszarvas-ruha

# ---- Tomas's secret, in his Christmas conversation ----
dialogue.christmas_miller.apprentice_offer.text = Van egy titkom: egy saját <b>karácsonyi kalács</b>, édesebb bármelyik bejglinél.\nSüsd meg a karácsonyi finomságaimat egy <b>Szakács Tűzhelyen</b> egy ideig, és eladom neked a receptet.
dialogue.christmas_miller.apprentice_offer.opt.accept = Taníts meg.
dialogue.christmas_miller.apprentice_brief.text = Süss <b>Mézeskalácsot</b>, <b>Forró kakaót</b> vagy <b>Karácsonyi bejglit</b> egy <b>Szakács Tűzhelyen</b>. Mindegyik számít. Gyere vissza, ha eleget sütöttél.
dialogue.christmas_miller.apprentice_ready.text = Nézd csak, igazi pék lett belőled. A <b>karácsonyi kalács</b> receptje most már ott van a boltomban neked.
dialogue.christmas_miller.apprentice_ready.opt.turnin = Kösz, Tomas.
dialogue.christmas_miller.opt.secret_skill = Mi van, ha már jó szakács vagyok?
dialogue.christmas_miller.secret_skill.text = Akkor nincs szükséged a leckéimre. Érd el a <b>Craftolás 20. szintjét</b>, és ugyanúgy eladom neked a <b>karácsonyi kalács</b> receptjét.\nVagy süss velem egy ideig. Mindkettő jó.

# ---- Elsie's secret, in her Christmas conversation ----
dialogue.christmas_weaver.apprentice_offer.text = Van egy titkom: egy <b>Rénszarvas-ruha</b>, amit magam varrtam. Nem akárkinek való.\nTegyél ki <b>karácsonyi dekorációkat</b> az otthonodban, és ha eleget kitettél, eladok neked egyet.
dialogue.christmas_weaver.apprentice_offer.opt.accept = Díszíteni fogok.
dialogue.christmas_weaver.apprentice_brief.text = Tegyél ki girlandokat, fényeket, koszorúkat, hóembereket, bármilyen karácsonyi dekorációt az otthonodban. Itt a templomban semmit sem lehet kirakni. Dekorációkat a fesztiválpolcon találsz bármelyik karácsonyi boltban, és a Karácsonyi Ajándékokban.
dialogue.christmas_weaver.apprentice_ready.text = Az otthonod biztos gyönyörű. A <b>Rénszarvas-ruhám</b> most már ott van a boltomban neked.
dialogue.christmas_weaver.apprentice_ready.opt.turnin = Köszönöm, Elsie.
dialogue.christmas_weaver.opt.secret_skill = Mi van, ha már jól díszítek?
dialogue.christmas_weaver.secret_skill.text = Akkor nincs szükséged a leckéimre. Érd el az <b>Építés 20. szintjét</b>, és ugyanúgy eladom neked a <b>Rénszarvas-ruhámat</b>.\nVagy díszíts velem egy ideig. Mindkettő jó.

# ---- Bram's secret, in his Christmas conversation ----
dialogue.christmas_shepherd.apprentice_offer.text = Van egy titkom. Segíts lehozni a rönköket, és minden kibontott <b>Karácsonyi Ajándékban</b> lesz tőlem egy kis extra. Egy dekoráció, talán a hópehely a fa tetejére.
dialogue.christmas_shepherd.apprentice_offer.opt.accept = Vágok.
dialogue.christmas_shepherd.apprentice_brief.text = Vágj rönköket bármelyik fából. Minden törzsblokk számít. Gyere vissza, ha eleget vágtál.
dialogue.christmas_shepherd.apprentice_ready.text = Szép kupac. Mostantól minden kibontott <b>Karácsonyi Ajándékban</b> lesz tőlem egy kis extra.
dialogue.christmas_shepherd.apprentice_ready.opt.turnin = Kösz, Bram.
dialogue.christmas_shepherd.opt.secret_skill = Mi van, ha már jól bánok a fejszével?
dialogue.christmas_shepherd.secret_skill.text = Akkor nincs rám szükséged. Érd el a <b>Favágás 20. szintjét</b>, és minden kibontott <b>Karácsonyi Ajándékban</b> lesz tőlem egy kis extra.\nVagy vágj velem egy ideig. Mindkettő jó.
