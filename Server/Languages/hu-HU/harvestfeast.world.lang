# Harvest Feast - the calendar's words (what the feast is called, and its banners) and the notice for
# a find. Keys are written bare: the library finds each one by its tail, whatever this file is called.
# Banners and notices print markup as text, so none of these values carries any.

# ---- Harvest Feast ----
calendar.harvest_feast.name = Aratási Lakoma
calendar.harvest_feast.flavor = A termés a fedél alatt, és a Feledett Templomban felállítanak egy hosszú asztalt.
calendar.harvest_feast.herald.start = Aratási Lakoma
calendar.harvest_feast.herald.start.sub = Martha, a Szakács megteríti az asztalt a Feledett Templomban.
calendar.harvest_feast.herald.end = Az Aratási Lakoma véget ért
calendar.harvest_feast.herald.end.sub = Az asztalt jövő évig elpakolták.

# ---- Finds ----
notify.harvest_feast_spice_found = Egy csipet fűszer, a tök mellé bújtatva.

# ---- Costumes ----
# A costume's buff-bar tile name. Its effect's Name is this key in full
# (harvestfeast.world.effect...), because the client reads an effect's Name exactly as written.
effect.harvest_feast_costume_turkey.name = Pulykajelmez
