# Harvest Feast progression: Martha's intro quest, her questline, the yearly feast and the dailies, the
# feast board and the feast stall, her conversation, the season's achievements and titles, her
# reputation and the Almanac page, the shared meal and the invitation tour, and the feast's villagers.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. A quest,
# a contract or an achievement takes its words from the keys its id spells (quest.<id>.title and
# .flavor, achievement.<id>.title and .desc), so no content file names those. Numbers ride {0} and
# come from the content files, so a retune never touches a translation.

# ---- Martha's reputation ----
reputation.harvest_feast_host.name = Lakomai Kegy
reputation.harvest_feast_host.flavor = Martha emlékszik, ki jött segíteni, és ki jött csak enni.
reputation.harvest_feast_host.rank.neutral = Újonc
reputation.harvest_feast_host.rank.friendly = Szomszéd
reputation.harvest_feast_host.rank.honored = Ismerős Arc
reputation.harvest_feast_host.rank.revered = Család
reputation.harvest_feast_host.rank.exalted = Asztalfő

# ---- The feast board ----
board.harvest_feast_daily.title = A Lakoma Táblája
board.harvest_feast_daily.desc = Mezei munkák és konyhai munkák, minden reggel frissen. Minél többet segítesz, annál többet rakok ki neked. Vedd fel a béredet, mielőtt az asztalt elpakolják. Ha elkésel, amit megkerestél, még vár a Küldetésnaplódban.
board.harvest_feast_daily.grade.field = Mezei munka
board.harvest_feast_daily.grade.kitchen = Konyhai munka
quest.harvest_feast_board_turkeys.title = Pulykahajsza
quest.harvest_feast_board_turkeys.flavor = Ezen a héten tele az erdő pulykával. Teríts le jó párat, ha utolérheted őket; úgy futnak, mintha tudnák, mi lesz vacsorára.
quest.harvest_feast_board_wheat.title = Búzaaratás
quest.harvest_feast_board_wheat.flavor = A vadbúza nem vár senkire. Szedd le, mielőtt a dér megteszi.
quest.harvest_feast_board_pies.title = Pitét az Asztalra
quest.harvest_feast_board_pies.flavor = Az asztalnál minden ülés egy szeletet kíván. Süss pár tökpitét, és hozd át, amíg meleg.
quest.harvest_feast_board_roast.title = Tűzrakás
quest.harvest_feast_board_roast.flavor = Süss egy halom húst nyílt tűzön. Az illata egymaga az asztalhoz hozza az embereket.

# ---- The feast stall ----
shop.harvest_feast_host.title = A Lakoma Standja
shop.harvest_feast_host.desc = Receptek a saját könyvemből, pattogatott kukorica zacskószám, meg pár dolog a házhoz.
shop.harvest_feast_host.category.kitchen = Konyha
shop.harvest_feast_host.category.decor = Dekorációk
shop.harvest_feast_offer_recipe_apple_pie.title = Almás Pite Recept
shop.harvest_feast_offer_recipe_apple_pie.desc = Olvasd el egyszer, és örökre süthetsz almás pitét.
shop.harvest_feast_offer_recipe_meat_pie.title = Húspite Recept
shop.harvest_feast_offer_recipe_meat_pie.desc = Martha saját húspitéje, leírva az asztal barátainak.
shop.harvest_feast_offer_recipe_caesar_salad.title = Caesar Saláta Recept
shop.harvest_feast_offer_recipe_caesar_salad.desc = Martha Caesar salátája, leírva a családnak.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Vacsora a Templomban
quest.harvest_feast_martha_meet.flavor = A termés a fedél alatt, úgyhogy megint a Feledett Templomban főzök. Bármelyik Feledett Templom-kapu elvisz oda. Gyere, keress meg, és éhesen gyere.
objective.harvest_feast.meet_martha = Találd meg Marthát, a Szakácsot a Feledett Templomban

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Búza a Sütőknek
quest.harvest_feast_host_1.flavor = Előbb a kenyér, mindig az. A vadbúza ilyenkor sűrűn terem, hozz hát egy jó karnyit a sütőknek.
quest.harvest_feast_host_2.title = A Pulykavadászat
quest.harvest_feast_host_2.flavor = A vadpulykák ebben a hónapban kövérek és hangosak, és nem olyan buták, mint amilyennek látszanak. Teríts le párat; asztal sült nélkül semmit sem ér.
quest.harvest_feast_host_3.title = Az Első Pite
quest.harvest_feast_host_3.flavor = Te jössz a tűzhelynél. Tanuld meg a receptet, süss egy tökpitét egy Szakács Tűzhelyen, és hozd el nekem.
quest.harvest_feast_the_feast.title = A Hosszú Asztal
quest.harvest_feast_the_feast.flavor = Évente egyszer mindent az asztalra teszünk, és addig eszünk, amíg senki sem bír felállni. Hozz egy pitét, némi sültet és egy kosár sárgarépát, és együtt terítünk meg.

# ---- Martha's dailies ----
quest.harvest_feast_daily_turkeys.title = Pulykafutam
quest.harvest_feast_daily_turkeys.flavor = A tegnapi sültből az utolsó csontig semmi sem maradt. Hozz még pár pulykát, és kezdek egy újat.
quest.harvest_feast_daily_wheat.title = Kenyér Reggelre
quest.harvest_feast_daily_wheat.flavor = Minden ma sütött cipóm elfogyott. Hozz még búzát, különben nincs kenyér reggelre.
quest.harvest_feast_daily_roast.title = Sült az Asztalra
quest.harvest_feast_daily_roast.flavor = Süss húst tűzön, és hozd ide. Az emberek mindig megeszik, mielőtt az asztalra kerülne.

