gearset.harvest_feast_harvest_set.tier_full = Az egész szett rajtad: megint több életerő, és gyorsabban szerzed Martha kegyét.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Találkozz Marthával
quest.harvest_feast_martha_meet.flavor = A termés a fedél alatt, úgyhogy megint a Feledett Templomban főzök. Bármelyik Feledett Templom-kapu elvisz oda. Gyere, keress meg, és éhesen gyere.
objective.harvest_feast.meet_martha = Találd meg Marthát, a Szakácsot a Feledett Templomban

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Búzaaratás
quest.harvest_feast_host_1.flavor = Előbb a kenyér, mindig az. A vadbúza az Emerald Wilds mezőin terem. Szedj nekem egy jó karnyit kézzel, és hozd a Feledett Templomba.
quest.harvest_feast_host_2.title = Pulykavadászat
quest.harvest_feast_host_2.flavor = Sült nélkül mit sem ér az asztal. Vadássz Vadpulykákra nappal az Emerald Wilds erdeiben és mezőin, aztán gyere vissza hozzám.
quest.harvest_feast_host_3.title = Az Első Pite
quest.harvest_feast_host_3.flavor = Te jössz a tűzhelynél. Tanuld meg a receptet, amit adtam, süss egy tökpitét, és hozd el nekem.
quest.harvest_feast_the_feast.title = A Lakoma
quest.harvest_feast_the_feast.flavor = Évente egyszer mindent az asztalra teszünk. Hozz nekem egy tökpitét, egy kis főtt húst és sárgarépát.
quest.harvest_feast_supper_tomas.title = Vacsora Tomasnak
quest.harvest_feast_supper_tomas.flavor = Tomas egész héten lisztet cipelt, és le sem ült. Vidd el neki a maradékból egy tökpitét. Ott van, ahol az út találkozik a kweebec faluval a Feledett Templomban.
quest.harvest_feast_supper_elsie.title = Vacsora Elsie-nek
quest.harvest_feast_supper_elsie.flavor = Elsie szőtte az asztal minden abroszát, és egyikről sem evett. Vidd el neki egy sült zöldséget. A kweebec falu túlsó oldalán van a Feledett Templomban.
quest.harvest_feast_supper_bram.title = Vacsora Bramnak
quest.harvest_feast_supper_bram.flavor = Bram levitte nekünk a gyapját a dombokról. Vidd el neki egy kis főtt húst. A réten van, a Feledett Templomba vezető út mellett.
objective.harvest_feast.supper_for_tomas = Vigyél egy Tökpitét Tomasnak, a Molnárnak
objective.harvest_feast.supper_for_elsie = Vigyél egy Sült Zöldséget Elsie-nek, a Takácsnak
objective.harvest_feast.supper_for_bram = Vigyél Főtt Vadhúst Bramnak, a Pásztornak

# ---- Martha's dailies and Extra Turkeys ----
quest.harvest_feast_daily_turkeys.title = Napi Pulykák
quest.harvest_feast_daily_turkeys.flavor = A tegnapi sült az utolsó csontig elfogyott. Vadássz még pár Vadpulykára az Emerald Wilds-ban, aztán gyere vissza hozzám.
quest.harvest_feast_daily_wheat.title = Napi Búza
quest.harvest_feast_daily_wheat.flavor = Minden ma sütött cipóm elfogyott. Szedj még búzát az Emerald Wilds mezőin, és hozd ide.
quest.harvest_feast_daily_roast.title = Napi Sült
quest.harvest_feast_daily_roast.flavor = A sültet mindig megeszik, mielőtt az asztalra érne. Süss meg egy kis húst, és hozd ide.
quest.harvest_feast_extra_turkeys.title = Extra Pulykák
quest.harvest_feast_extra_turkeys.flavor = Minden pulykát elviszek, amit el tudsz kapni. Vadássz Vadpulykákra az Emerald Wilds-ban, aztán gyere vissza hozzám, ahányszor csak akarod.
quest.harvest_feast_miller_flour.title = Napi Liszt
quest.harvest_feast_miller_flour.flavor = A sütők gyorsabban eszik a lisztet, mint ahogy a malmom őrli. Hozz nekem egy kicsit.
quest.harvest_feast_weaver_spices.title = Napi Fűszer
quest.harvest_feast_weaver_spices.flavor = Fűszer kell, hogy narancsra fessem az asztali futót. Hozz nekem egy kicsit.
quest.harvest_feast_shepherd_eggs.title = Napi Tojás
quest.harvest_feast_shepherd_eggs.flavor = Tomasnak tojás kell a tésztájához, és én vagyok, aki ért a csirkékhez. Hozz nekem párat.
