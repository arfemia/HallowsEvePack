reputation.harvest_feast_host.rank.friendly = Vizinho
reputation.harvest_feast_host.rank.honored = Cara Conhecida
reputation.harvest_feast_host.rank.revered = Da Família
reputation.harvest_feast_host.rank.exalted = Cabeceira da Mesa

# ---- The feast board ----
board.harvest_feast_daily.title = O Quadro da Festa
board.harvest_feast_daily.desc = Serviço de campo e serviço de cozinha, novinhos toda manhã. Quanto mais você ajuda, mais eu separo para você. Pegue o seu pagamento antes que a mesa seja guardada. Se chegar tarde, o que você ganhou continua esperando no seu Livro de Objetivos.
board.harvest_feast_daily.grade.field = Trabalho de Campo
board.harvest_feast_daily.grade.kitchen = Trabalho de Cozinha
quest.harvest_feast_board_turkeys.title = Caça aos Perus
quest.harvest_feast_board_turkeys.flavor = O mato está cheio de perus esta semana. Abata uns bons, se conseguir alcançar; eles correm como quem sabe o que vai para o jantar.
quest.harvest_feast_board_wheat.title = Colheita de Trigo
quest.harvest_feast_board_wheat.flavor = O trigo selvagem não espera ninguém. Colha antes que a geada chegue.
quest.harvest_feast_board_pies.title = Tortas para a Mesa
quest.harvest_feast_board_pies.flavor = Todo lugar à mesa quer uma fatia. Asse umas tortas de abóbora e traga enquanto estão quentes.
quest.harvest_feast_board_roast.title = Fogueira de Assar
quest.harvest_feast_board_roast.flavor = Cozinhe uma pilha de carne em fogo aberto. Só o cheiro já traz gente para a mesa.

