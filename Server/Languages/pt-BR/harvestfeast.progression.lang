# ---- The feast board ----
board.harvest_feast_daily.title = O Quadro da Festa
board.harvest_feast_daily.desc = Serviço de campo e serviço de cozinha, novinhos toda manhã. Quanto mais você ajuda, mais eu separo para você. Pegue o seu pagamento antes que a mesa seja guardada. Se chegar tarde, o que você ganhou continua esperando no seu Livro de Objetivos.
board.harvest_feast_daily.grade.field = Trabalho de Campo
board.harvest_feast_daily.grade.kitchen = Trabalho de Cozinha
quest.harvest_feast_board_turkeys.title = Serviço de Peru
quest.harvest_feast_board_turkeys.flavor = Cace Perus Selvagens de dia, no mato e nas planícies das Emerald Wilds. Preciso deles para o assado.
quest.harvest_feast_board_wheat.title = Serviço de Trigo
quest.harvest_feast_board_wheat.flavor = Colha trigo selvagem à mão nas planícies das Emerald Wilds. É o pão de amanhã.
quest.harvest_feast_board_pumpkins.title = Serviço de Abóbora
quest.harvest_feast_board_pumpkins.flavor = Colha abóboras à mão nos bosques de outono das Emerald Wilds. Toda torta começa com uma.
quest.harvest_feast_board_carrots.title = Serviço de Cenoura
quest.harvest_feast_board_carrots.flavor = Colha cenouras à mão nas florestas das Emerald Wilds. Quero uma cesta cheia para a mesa.
quest.harvest_feast_board_pies.title = Serviço de Torta
quest.harvest_feast_board_pies.flavor = A mesa sempre quer mais torta. Asse algumas tortas de abóbora e traga para mim.
quest.harvest_feast_board_roast.title = Serviço de Assado
quest.harvest_feast_board_roast.flavor = Cozinhe um pouco de carne e traga para mim. Só o cheiro já traz gente.
quest.harvest_feast_board_vegetables.title = Serviço de Legumes
quest.harvest_feast_board_vegetables.flavor = Asse alguns legumes e traga para a mesa.
quest.harvest_feast_board_spices.title = Serviço de Tempero
quest.harvest_feast_board_spices.flavor = Traga-me uns Temperos. Colher abóboras à mão rende alguns.

# ---- The feast stall ----
shop.harvest_feast_host.title = A Loja da Festa
shop.harvest_feast_host.desc = Receitas do meu próprio livro, pipoca por saco, roupa para os campos e algumas coisas para a casa.
