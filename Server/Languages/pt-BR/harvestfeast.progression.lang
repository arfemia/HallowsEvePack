shop.harvest_feast_offer_recipe_harvest_salad.title = Receita de Salada da Colheita
shop.harvest_feast_offer_recipe_harvest_salad.desc = Cenouras, milho e abóbora. Faça num Forno do Chefe para ter mais estâmina máxima, por mais tempo que em qualquer outra salada.
shop.harvest_feast_offer_recipe_marthas_roast.title = Receita do Assado da Martha
shop.harvest_feast_offer_recipe_marthas_roast.desc = O melhor prato dela, anotado para a família. Mais vida e estâmina máximas, e o favor dela sobe mais rápido enquanto durar.
shop.harvest_feast_offer_harvest_gloves.title = Luvas da Colheita
shop.harvest_feast_offer_harvest_gloves.desc = Luvas de lã quentinhas, parte do Conjunto da Colheita. Use o conjunto inteiro e você ganha o favor da Martha mais rápido.
shop.harvest_feast_offer_harvest_hat.title = Chapéu da Colheita
shop.harvest_feast_offer_harvest_hat.desc = Um chapéu de lã quente, parte do Conjunto da Colheita. Use o conjunto inteiro e você ganha o favor da Martha mais rápido.
shop.harvest_feast_offer_harvest_trousers.title = Calça da Colheita
shop.harvest_feast_offer_harvest_trousers.desc = Calça de lã para os campos, parte do Conjunto da Colheita. Use o conjunto inteiro e você ganha o favor da Martha mais rápido.
shop.harvest_feast_offer_harvest_tunic.title = Túnica da Colheita
shop.harvest_feast_offer_harvest_tunic.desc = Uma túnica de lã, a última peça do Conjunto da Colheita. Use o conjunto inteiro e você ganha o favor da Martha mais rápido.

