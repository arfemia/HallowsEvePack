# ---- The feast board ----
board.harvest_feast_daily.title = O Quadro da Festa
board.harvest_feast_daily.desc = Serviço de campo e serviço de cozinha, novinhos toda manhã. Quanto mais você ajuda, mais eu separo para você. Pegue o seu pagamento antes que a mesa seja guardada. Se chegar tarde, o que você ganhou continua esperando no seu Livro de Objetivos.
board.harvest_feast_daily.grade.field = Trabalho de Campo
board.harvest_feast_daily.grade.kitchen = Trabalho de Cozinha
quest.harvest_feast_board_turkeys.title = Serviço de Peru
quest.harvest_feast_board_turkeys.flavor = Cace Perus Selvagens de dia, no mato e nas planícies das Emerald Wilds. Eles correm como quem sabe o que vai para o jantar.
quest.harvest_feast_board_wheat.title = Serviço de Trigo
quest.harvest_feast_board_wheat.flavor = Colha trigo selvagem à mão nas planícies das Emerald Wilds. Ele não espera a geada.
quest.harvest_feast_board_pumpkins.title = Serviço de Abóbora
quest.harvest_feast_board_pumpkins.flavor = Colha abóboras à mão nos bosques de outono das Emerald Wilds. Toda torta começa com uma.
quest.harvest_feast_board_carrots.title = Serviço de Cenoura
quest.harvest_feast_board_carrots.flavor = Colha cenouras à mão nas florestas das Emerald Wilds. Quero uma cesta cheia para a mesa.
quest.harvest_feast_board_pies.title = Serviço de Torta
quest.harvest_feast_board_pies.flavor = Asse tortas de abóbora num Forno do Chefe e traga para a mesa enquanto estão quentes.
quest.harvest_feast_board_roast.title = Serviço de Assado
quest.harvest_feast_board_roast.flavor = Cozinhe carne crua numa Fogueira e traga para a mesa. Só o cheiro já traz gente.
quest.harvest_feast_board_vegetables.title = Serviço de Legumes
quest.harvest_feast_board_vegetables.flavor = Asse legumes numa Fogueira e traga para a mesa. Uma cenoura, milho, uma abóbora ou um cogumelo servem.
quest.harvest_feast_board_spices.title = Serviço de Tempero
quest.harvest_feast_board_spices.flavor = Faça Temperos num Forno do Chefe com flores e um legume, ou guarde os que achar colhendo abóboras. Traga aqui.

# ---- The feast stall ----
shop.harvest_feast_host.title = A Loja da Festa
shop.harvest_feast_host.desc = Receitas do meu próprio livro, pipoca por saco, roupa para os campos e algumas coisas para a casa.
shop.harvest_feast_host.category.kitchen = Cozinha
shop.harvest_feast_host.category.clothes = Roupas
shop.harvest_feast_host.category.decor = Decoração
shop.harvest_feast_offer_recipe_turkey_pie.title = Receita de Torta de Peru
shop.harvest_feast_offer_recipe_turkey_pie.desc = A torta de carne da própria Martha. Asse num Forno do Chefe para ter mais vida máxima e sofrer menos dano, por mais tempo que em qualquer outra torta.
shop.harvest_feast_offer_recipe_harvest_salad.title = Receita de Salada da Colheita
shop.harvest_feast_offer_recipe_harvest_salad.desc = Cenouras, milho e abóbora. Faça num Forno do Chefe para ter mais estâmina máxima, por mais tempo que em qualquer outra salada.
shop.harvest_feast_offer_recipe_marthas_roast.title = Receita do Assado da Martha
shop.harvest_feast_offer_recipe_marthas_roast.desc = O melhor prato dela, anotado para a família. Mais vida e estâmina máximas, e o favor dela sobe mais rápido enquanto durar.
shop.harvest_feast_offer_harvest_gloves.title = Luvas da Colheita
shop.harvest_feast_offer_harvest_gloves.desc = Luvas de lã quentinhas, parte do Conjunto da Colheita. Use o conjunto inteiro e você ganha o favor da Martha mais rápido.
shop.harvest_feast_offer_harvest_hat.title = Chapéu da Colheita
shop.harvest_feast_offer_harvest_hat.desc = Um chapéu de lã quente, parte do Conjunto da Colheita. Use o conjunto inteiro e você ganha o favor da Martha mais rápido.
shop.harvest_feast_offer_harvest_trousers.title = Calça da Colheita
shop.harvest_feast_offer_harvest_trousers.desc = Calça de lã para os campos, parte do Conjunto da Colheita. Use o conjunto inteiro e você ganha o favor da Martha mais rápido.
shop.harvest_feast_offer_harvest_tunic.title = Túnica da Colheita
shop.harvest_feast_offer_harvest_tunic.desc = Uma túnica de lã, a última peça do Conjunto da Colheita. Use o conjunto inteiro e você ganha o favor da Martha mais rápido.

