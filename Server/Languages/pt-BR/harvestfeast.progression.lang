# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Conheça a Martha
quest.harvest_feast_martha_meet.flavor = A colheita está feita, então estou cozinhando no Templo Esquecido de novo. Qualquer Portal do Templo Esquecido leva você até lá. Venha me achar, e venha com fome.
objective.harvest_feast.meet_martha = Encontre Martha, a Cozinheira, no Templo Esquecido

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Colheita de Trigo
quest.harvest_feast_host_1.flavor = Pão primeiro, sempre. O trigo selvagem cresce nas planícies das Emerald Wilds. Colha à mão um bom monte e traga para o Templo Esquecido.
quest.harvest_feast_host_2.title = A Caça ao Peru
quest.harvest_feast_host_2.flavor = A mesa não presta sem um assado. Cace Perus Selvagens de dia no mato e nas planícies das Emerald Wilds, depois volte aqui.
quest.harvest_feast_host_3.title = A Primeira Torta
quest.harvest_feast_host_3.flavor = Sua vez no fogão. Aprenda a receita que dei, asse uma torta de abóbora e traga para mim.
quest.harvest_feast_the_feast.title = O Banquete
quest.harvest_feast_the_feast.flavor = Uma vez por ano a gente põe tudo na mesa. Traga-me uma torta de abóbora, um pouco de carne cozida e cenouras.
quest.harvest_feast_supper_tomas.title = Jantar para o Tomas
quest.harvest_feast_supper_tomas.flavor = Tomas carregou farinha a semana toda e não sentou nem uma vez. Leve para ele uma torta de abóbora das sobras. Ele está onde a estrada encontra a vila dos kweebecs, no Templo Esquecido.
quest.harvest_feast_supper_elsie.title = Jantar para a Elsie
quest.harvest_feast_supper_elsie.flavor = Elsie teceu todas as toalhas daquela mesa e nunca comeu em cima de uma. Leve para ela um legume assado. Ela está do outro lado da vila dos kweebecs, no Templo Esquecido.
quest.harvest_feast_supper_bram.title = Jantar para o Bram
quest.harvest_feast_supper_bram.flavor = Bram trouxe a lã das colinas até aqui por nós. Leve para ele um pouco de carne cozida. Ele está no pasto junto à estrada de entrada do Templo Esquecido.
objective.harvest_feast.supper_for_tomas = Leve uma Torta de Abóbora para Tomas, o Moleiro
objective.harvest_feast.supper_for_elsie = Leve um Legume Assado para Elsie, a Tecelã
objective.harvest_feast.supper_for_bram = Leve Carne Selvagem Cozida para Bram, o Pastor

# ---- Martha's dailies and Extra Turkeys ----
quest.harvest_feast_daily_turkeys.title = Perus do Dia
quest.harvest_feast_daily_turkeys.flavor = O assado de ontem foi até o último osso. Cace mais uns Perus Selvagens nas Emerald Wilds, depois volte aqui.
quest.harvest_feast_daily_wheat.title = Trigo do Dia
quest.harvest_feast_daily_wheat.flavor = Cada pão que assei hoje já sumiu. Colha mais trigo nas planícies das Emerald Wilds e traga aqui.
quest.harvest_feast_daily_roast.title = Assado do Dia
quest.harvest_feast_daily_roast.flavor = O assado some antes de chegar à mesa. Cozinhe um pouco de carne e traga aqui.
quest.harvest_feast_extra_turkeys.title = Perus Extras
quest.harvest_feast_extra_turkeys.flavor = Aceito todo peru que você conseguir pegar. Cace Perus Selvagens nas Emerald Wilds e volte aqui, quantas vezes quiser.
quest.harvest_feast_miller_flour.title = Farinha Diária
quest.harvest_feast_miller_flour.flavor = Os fornos comem farinha mais rápido do que meu moinho consegue moer. Traga-me um pouco.
quest.harvest_feast_weaver_spices.title = Temperos Diários
quest.harvest_feast_weaver_spices.flavor = Preciso de tempero para tingir de laranja o caminho de mesa. Traga-me um pouco.
quest.harvest_feast_shepherd_eggs.title = Ovos Diários
quest.harvest_feast_shepherd_eggs.flavor = Tomas quer ovos para a massa dele, e eu sou quem entende de galinhas. Traga uns para mim.
