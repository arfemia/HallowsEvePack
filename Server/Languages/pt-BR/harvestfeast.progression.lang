shop.harvest_feast_host.title = A Barraca da Festa
shop.harvest_feast_host.desc = Receitas do meu próprio livro, pipoca por saco e algumas coisas para a casa.
shop.harvest_feast_host.category.kitchen = Cozinha
shop.harvest_feast_host.category.decor = Decoração
shop.harvest_feast_offer_recipe_apple_pie.title = Receita de Torta de Maçã
shop.harvest_feast_offer_recipe_apple_pie.desc = Leia uma vez e você assa torta de maçã para sempre.
shop.harvest_feast_offer_recipe_meat_pie.title = Receita de Torta de Carne
shop.harvest_feast_offer_recipe_meat_pie.desc = A torta de carne da própria Martha, anotada para os amigos da mesa.
shop.harvest_feast_offer_recipe_caesar_salad.title = Receita de Salada César
shop.harvest_feast_offer_recipe_caesar_salad.desc = A salada César da Martha, anotada para a família.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Ceia no Templo
quest.harvest_feast_martha_meet.flavor = A colheita está feita, então estou cozinhando no Templo Esquecido de novo. Qualquer Portal do Templo Esquecido leva você até lá. Venha me achar, e venha com fome.
objective.harvest_feast.meet_martha = Encontre Martha, a Cozinheira, no Templo Esquecido

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Trigo para os Fornos
quest.harvest_feast_host_1.flavor = Pão primeiro, sempre. O trigo selvagem cresce grosso nesta época, então me traga um bom monte para os fornos.
quest.harvest_feast_host_2.title = A Caça ao Peru
quest.harvest_feast_host_2.flavor = Os perus selvagens estão gordos e barulhentos este mês, e não são tão bobos quanto parecem. Abata alguns; a mesa não presta sem um assado.
quest.harvest_feast_host_3.title = A Primeira Torta
quest.harvest_feast_host_3.flavor = Sua vez no fogão. Aprenda a receita, asse uma torta de abóbora num Forno do Chefe e traga para mim.
quest.harvest_feast_the_feast.title = A Mesa Comprida
quest.harvest_feast_the_feast.flavor = Uma vez por ano a gente põe tudo na mesa e come até ninguém se aguentar de pé. Traga uma torta, um pouco de assado e uma cesta de cenouras, e a gente arruma tudo junto.

# ---- Martha's dailies ----
quest.harvest_feast_daily_turkeys.title = Corrida dos Perus
quest.harvest_feast_daily_turkeys.flavor = O assado de ontem foi até o último osso. Traga mais uns perus e eu começo outro.
quest.harvest_feast_daily_wheat.title = Pão para a Manhã
quest.harvest_feast_daily_wheat.flavor = Cada pão que assei hoje já sumiu. Traga mais trigo, ou não tem pão de manhã.
quest.harvest_feast_daily_roast.title = Assado para a Mesa
quest.harvest_feast_daily_roast.flavor = Cozinhe um pouco de carne no fogo e traga aqui. O povo come tudo antes de chegar à mesa.

