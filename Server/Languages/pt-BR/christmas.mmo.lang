objective.christmas.bring_elsie_wool = Traga {0} {0, plural, one {rolo} other {rolos}} de lã para a Elsie
objective.christmas.hunt_wolves = Cace {0} {0, plural, one {lobo} other {lobos}}
objective.christmas.bake_treats = Asse {0} guloseimas do Tomas

# ---- Two days inside Christmas ----
calendar.christmas_day.name = Dia de Natal
calendar.christmas_day.flavor = O grande dia em si.
calendar.christmas_new_years_eve.name = Véspera de Ano-Novo
calendar.christmas_new_years_eve.flavor = A última noite do ano.

# ---- The boosts (only where MMO Skill Tree runs) ----
boostrule.mmo_christmas_trades.title = Natal
boostrule.mmo_christmas_day.title = Dia de Natal
boostrule.mmo_christmas_new_years_eve.title = Véspera de Ano-Novo

# ---- The Christmas Set's skill half (only where MMO Skill Tree runs) ----
# A set's notice is a toast, so no value carries markup.
gearset.mmo_christmas_set.tier_half = E mais XP de Lenhador.
gearset.mmo_christmas_set.tier_full = E ainda mais XP de Lenhador, e mais sorte ao cortar árvores.

# ---- Christmas Morning's treats, and Bram's present ----
lootable.christmas_treats.title = Um Saco de Guloseimas
lootable.christmas_treats.flavor = Bengalas doces, biscoitos ou chocolate quente, e de vez em quando um Bolo de Natal inteiro.
lootable.christmas_bram_decorations.title = O Presente do Bram
lootable.christmas_bram_decorations.flavor = Um extra do Bram em cada presente que você abre: uma decoração de Natal para a sua casa.

# ---- The villagers' secrets ----
quest.christmas_tomas_apprentice.title = Aprendiz do Tomas
quest.christmas_tomas_apprentice.flavor = Asse as minhas guloseimas de Natal num Forno do Chefe. Cada guloseima que você fizer conta. Asse o bastante e eu vendo a você a receita do meu próprio Pão de Natal.
quest.christmas_elsie_apprentice.title = Aprendiz da Elsie
quest.christmas_elsie_apprentice.flavor = Coloque decorações de Natal na sua casa. Coloque o bastante e eu vendo a você a minha Roupa de Rena.
quest.christmas_bram_apprentice.title = Aprendiz do Bram
quest.christmas_bram_apprentice.flavor = Derrube troncos de qualquer árvore. Corte o bastante e todo Presente de Natal que você abrir traz um pouco a mais de mim.
shop.christmas_offer_recipe_tomas_loaf.title = Receita do Pão de Natal do Tomas
shop.christmas_offer_recipe_tomas_loaf.desc = O pão doce do próprio Tomas. Você anda mais rápido e o frio morde menos enquanto durar.
shop.christmas_offer_reindeer_suit.title = Roupa de Rena
shop.christmas_offer_reindeer_suit.desc = Vista e você é uma das renas do Papai Noel por um tempo.
# A lock line reads "Requires " and then one of these; each server loads the one its overlay names.
factor.christmas_tomas_key.name = concluir o Aprendiz do Tomas
factor.christmas_tomas_key.name_mmo = concluir o Aprendiz do Tomas ou chegar ao nível 20 de Fabricação
factor.christmas_elsie_key.name = concluir o Aprendiz da Elsie
factor.christmas_elsie_key.name_mmo = concluir o Aprendiz da Elsie ou chegar ao nível 20 de Construção
# A costume's buff-bar tile name. Its effect's Name is this key in full (christmas.mmo.effect...).
effect.christmas_costume_reindeer_suit.name = Roupa de Rena

# ---- Tomas's secret, in his Christmas conversation ----
dialogue.christmas_miller.apprentice_offer.text = Tenho um segredo: um <b>Pão de Natal</b> só meu, mais doce que qualquer bolo.\nAsse as minhas guloseimas de Natal num <b>Forno do Chefe</b> por um tempo e eu vendo a receita a você.
dialogue.christmas_miller.apprentice_offer.opt.accept = Ensine-me.
dialogue.christmas_miller.apprentice_brief.text = Asse <b>Biscoitos de Gengibre</b>, <b>Chocolate Quente</b> ou <b>Bolo de Natal</b> num <b>Forno do Chefe</b>. Cada um conta. Volte quando tiver assado o bastante.
dialogue.christmas_miller.apprentice_ready.text = Olhe só, um padeiro de verdade. A receita do meu <b>Pão de Natal</b> está na minha loja para você agora.
dialogue.christmas_miller.apprentice_ready.opt.turnin = Obrigado, Tomas.
dialogue.christmas_miller.opt.secret_skill = E se eu já cozinho bem?
dialogue.christmas_miller.secret_skill.text = Então não precisa das minhas lições. Chegue ao <b>nível 20 de Fabricação</b> e eu vendo a você a receita do meu <b>Pão de Natal</b> do mesmo jeito.\nOu asse comigo por um tempo. Dos dois jeitos serve.

# ---- Elsie's secret, in her Christmas conversation ----
dialogue.christmas_weaver.apprentice_offer.text = Tenho um segredo: uma <b>Roupa de Rena</b> que eu mesma costurei. Não é para qualquer um.\nColoque <b>decorações de Natal</b> na sua casa, e quando tiver colocado o bastante, vendo uma a você.
dialogue.christmas_weaver.apprentice_offer.opt.accept = Eu decoro.
dialogue.christmas_weaver.apprentice_brief.text = Coloque guirlandas, luzes, coroas, bonecos de neve, qualquer decoração de Natal, na sua casa. Nada pode ser colocado aqui no templo. Você acha decorações na Prateleira do Festival de qualquer loja de Natal, e dentro de Presentes de Natal.
dialogue.christmas_weaver.apprentice_ready.text = Sua casa deve estar linda. Minha <b>Roupa de Rena</b> está na minha loja para você agora.
dialogue.christmas_weaver.apprentice_ready.opt.turnin = Obrigado, Elsie.
dialogue.christmas_weaver.opt.secret_skill = E se eu já decoro bem?
dialogue.christmas_weaver.secret_skill.text = Então não precisa das minhas lições. Chegue ao <b>nível 20 de Construção</b> e vendo a você a minha <b>Roupa de Rena</b> do mesmo jeito.\nOu decore comigo por um tempo. De qualquer jeito está bem.

# ---- Bram's secret, in his Christmas conversation ----
dialogue.christmas_shepherd.apprentice_offer.text = Tenho um segredo. Ajude-me a derrubar troncos e todo <b>Presente de Natal</b> que você abrir traz um pouco a mais de mim. Uma decoração, talvez o floco de neve para o topo da árvore.
dialogue.christmas_shepherd.apprentice_offer.opt.accept = Eu corto.
dialogue.christmas_shepherd.apprentice_brief.text = Corte troncos de qualquer árvore. Cada bloco de tronco conta. Volte quando tiver o bastante.
dialogue.christmas_shepherd.apprentice_ready.text = Que bela pilha. Daqui em diante, todo <b>Presente de Natal</b> que você abrir tem um pouco a mais de mim dentro.
dialogue.christmas_shepherd.apprentice_ready.opt.turnin = Obrigado, Bram.
dialogue.christmas_shepherd.opt.secret_skill = E se eu já sou bom com o machado?
dialogue.christmas_shepherd.secret_skill.text = Então não precisa de mim. Chegue ao <b>nível 20 de Lenhador</b> e todo <b>Presente de Natal</b> que você abrir traz um pouco a mais de mim.\nOu corte comigo por um tempo. Dos dois jeitos serve.
