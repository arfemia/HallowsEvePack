# Harvest Feast - the calendar's words (what the feast is called, and its banners) and the notice for
# a find. Keys are written bare: the library finds each one by its tail, whatever this file is called.
# Banners and notices print markup as text, so none of these values carries any.

# ---- Harvest Feast ----
calendar.harvest_feast.name = Festa da Colheita
calendar.harvest_feast.flavor = A colheita está feita, e uma mesa comprida é posta no Templo Esquecido.
calendar.harvest_feast.herald.start = Festa da Colheita
calendar.harvest_feast.herald.start.sub = Martha, a Cozinheira, está pondo a mesa no Templo Esquecido.
calendar.harvest_feast.herald.end = A Festa da Colheita acabou
calendar.harvest_feast.herald.end.sub = A mesa foi guardada até o ano que vem.

# ---- Finds ----
notify.harvest_feast_spice_found = Uma pitada de tempero, escondida junto da abóbora.

# ---- Costumes ----
# A costume's buff-bar tile name. Its effect's Name is this key in full
# (harvestfeast.world.effect...), because the client reads an effect's Name exactly as written.
effect.harvest_feast_costume_turkey.name = Fantasia de Peru
