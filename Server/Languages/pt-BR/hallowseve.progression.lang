# Progressão da Noite das Bruxas: a linha de missões do Velho Jack, diárias, quadro e banca, a conversa dele e
# a fala de doces ou travessuras, as conquistas e o título da temporada, e a página dela no Almanaque.
# As chaves são escritas sem prefixo: a biblioteca encontra cada uma pelo final, seja qual for o nome deste arquivo.
# Os números vêm em {0} e saem dos arquivos de conteúdo, então um rebalanceamento nunca mexe numa tradução.

# ---- A carteira ----
currency.hallows_eve_sweets.name = Doces das Bruxas
currency.hallows_eve_sweets.amount = {0, number} {0, plural, one {Doce das Bruxas} other {Doces das Bruxas}}
currency.hallows_eve_sweets.description = Gaste-os na loja do Velho Jack no Templo Esquecido.
quest.category.hallows_eve = Noite das Bruxas

# ---- A linha de missões do Velho Jack ----
quest.hallows_eve_old_jack_meet.title = Lanternas no Templo
quest.hallows_eve_old_jack_meet.flavor = É a temporada de novo, então voltei pro Templo Esquecido com as minhas lanternas. Qualquer Portal do Templo Esquecido te leva até lá. Vem me procurar. Uma ajuda me cairia bem.
quest.hallows_eve_old_jack_1.title = Canteiro de Abóboras
quest.hallows_eve_old_jack_1.flavor = Minhas lanternas são entalhadas de Abóboras Consagradas, e tô ficando sem. Colhe abóbora com as mãos e me traz as frias, que brilham.
quest.hallows_eve_old_jack_2.title = Serviço de Lanterna
quest.hallows_eve_old_jack_2.flavor = Abóbora recheada de pólvora segura os mortos melhor que qualquer lanterna. Joga umas Bombas-Lanterna, depois me conta como elas queimaram.
quest.hallows_eve_old_jack_3.title = Carniçais nos Degraus
quest.hallows_eve_old_jack_3.flavor = Minhas lanternas seguram os carniçais longe dos degraus, mas por pouco. Põe uns Carniçais Ocos de volta debaixo da terra depois que escurece.
quest.hallows_eve_old_jack_4.title = Busca de Ectoplasma
quest.hallows_eve_old_jack_4.flavor = É Ectoplasma que queima nas minhas lanternas, e uma Alma Perdida deixa um pouco pra trás quando é solta. Liberta umas e me traz.
quest.hallows_eve_old_jack_5.title = Pedra Amaldiçoada
quest.hallows_eve_old_jack_5.flavor = A pedra solta Geodos Amaldiçoados nesta época do ano, se você quebrar bastante. Quebra uns e fica com o que cair.
quest.hallows_eve_old_jack_lantern.title = A Lanterna Oca
quest.hallows_eve_old_jack_lantern.flavor = Já tenho a brasa do Cavaleiro. Agora a sua Lanterna Oca quer uma Abóbora Consagrada, um pouco de Ectoplasma e os esqueletos com a minha cara caídos no chão.
quest.hallows_eve_old_jack_horseman.title = A Cavalgada
quest.hallows_eve_old_jack_horseman.flavor = O Coveiro ao meu lado sabe o caminho pro cemitério do Cavaleiro, mas não abre o portão sem uma Vela Funerária, e eu vendo essas na minha loja quando te considero Freguês. Compra uma, entra com amigos e derruba ele da sela.
quest.hallows_eve_old_jack_horseman_hard.title = Fogo para a Lanterna
quest.hallows_eve_old_jack_horseman_hard.flavor = Sua lanterna quer uma chama que não se apaga, e o Cavaleiro carrega uma. Pede ao Coveiro a cavalgada difícil, vence ele e me traz a brasa dele.

# ---- As diárias do Velho Jack ----
quest.hallows_eve_jack_daily_souls.title = Almas Inquietas
quest.hallows_eve_jack_daily_souls.flavor = Mais Almas Perdidas chegaram vagando ontem à noite. Liberta algumas antes que elas se instalem de vez.
quest.hallows_eve_jack_daily_horseman.title = De Volta à Sela
quest.hallows_eve_jack_daily_horseman.flavor = Ele está de volta à sela, como toda noite. Leva uma Vela Funerária ao Coveiro e derruba ele daquele cavalo de novo. A cavalgada comum, entendeu, não a difícil.
quest.hallows_eve_jack_daily_pumpkins.title = Ronda das Abóboras
quest.hallows_eve_jack_daily_pumpkins.flavor = As lanternas consomem Abóboras Consagradas mais rápido do que eu dou conta de entalhar. Me traz mais umas antes de escurecer.
quest.hallows_eve_jack_daily_geodes.title = Geodos para Jack
quest.hallows_eve_jack_daily_geodes.flavor = Quebra uns dois Geodos Amaldiçoados pra mim. Minhas mãos andam duras demais pra isso.

# ---- What Hallow's Eve's loot tables pay: the name on the reward, and the line under it on hover ----
lootable.hallows_eve_meet_pay.title = Boas-Vindas do Velho Jack
lootable.hallows_eve_meet_pay.flavor = Uns doces pra dizer olá.
lootable.hallows_eve_chain_pay.title = Pagamento do Velho Jack
lootable.hallows_eve_chain_pay.flavor = O que o Velho Jack paga por cada serviço que te passa.
lootable.hallows_eve_daily_pay.title = Pagamento Diário do Velho Jack
lootable.hallows_eve_daily_pay.flavor = O que o Velho Jack paga por um dia de trabalho.
lootable.hallows_eve_lantern_pay.title = Agradecimento do Velho Jack
lootable.hallows_eve_lantern_pay.flavor = O que o Velho Jack dá a cada ano por acender a Lanterna Oca.
lootable.hallows_eve_board_pay.title = Extras do Velho Jack
lootable.hallows_eve_board_pay.flavor = Um pouco mais por cima do que o serviço paga, pra quem trabalha no meu quadro.
lootable.hallows_eve_board_sweets.title = O Pote de Doces
lootable.hallows_eve_board_sweets.flavor = Quantos eu conseguir pegar numa mão só.
lootable.hallows_eve_hallowed_cache.title = Agrado dos Consagrados
lootable.hallows_eve_hallowed_cache.flavor = Os Consagrados deixam isto pra você toda vez que você sobe mais um degrau além de Exaltado com eles. Não me pergunta onde arranjam.
lootable.hallows_eve_trick_or_treat.title = Doces ou Travessuras
lootable.hallows_eve_trick_or_treat.flavor = Bate e vê o que ganha. Doces, na maioria.
lootable.hallows_eve_treats.title = Algo Doce
lootable.hallows_eve_treats.flavor = O que você ganha quando a travessura não pega.
lootable.hallows_eve_geode_crack.title = Geodo Quebrado
lootable.hallows_eve_geode_crack.flavor = O que cair de um Geodo Amaldiçoado quando você quebra. Sempre cristal, e melhor se você tiver sorte.

