# Progressão da Noite das Bruxas: a linha de missões do Velho Jack, diárias, quadro e banca, a conversa dele e
# a fala de doces ou travessuras, as conquistas e o título da temporada, e a página dela no Almanaque.
# As chaves são escritas sem prefixo: a biblioteca encontra cada uma pelo final, seja qual for o nome deste arquivo.
# Os números vêm em {0} e saem dos arquivos de conteúdo, então um rebalanceamento nunca mexe numa tradução.

# ---- A carteira ----
currency.hallows_eve_sweets.name = Doces das Bruxas

# ---- A linha de missões do Velho Jack ----
quest.hallows_eve_old_jack_meet.title = Lanternas no Templo
quest.hallows_eve_old_jack_meet.flavor = É a temporada de novo, então voltei pro Templo Esquecido com as minhas lanternas. Qualquer Portal do Templo Esquecido te leva até lá. Vem me procurar. Uma ajuda me cairia bem.
quest.hallows_eve_old_jack_1.title = Canteiro de Abóboras
quest.hallows_eve_old_jack_1.flavor = Colhe abóbora este mês que de vez em quando sai uma fria e brilhando. Me traz algumas dessas Consagradas.
quest.hallows_eve_old_jack_2.title = Serviço de Lanterna
quest.hallows_eve_old_jack_2.flavor = Qualquer abóbora recheada de pólvora vira uma boa Bomba-Lanterna. Joga umas em alguma coisa que tá merecendo, depois me conta como elas queimaram.
quest.hallows_eve_old_jack_3.title = Carniçais nos Degraus
quest.hallows_eve_old_jack_3.flavor = Os Carniçais Ocos saem rastejando das covas velhas depois que escurece, com fome. Põe uns de volta debaixo da terra antes que eles cheguem aos degraus do templo.
quest.hallows_eve_old_jack_4.title = Busca de Ectoplasma
quest.hallows_eve_old_jack_4.flavor = As Almas Perdidas ficam vagando até alguém soltar elas. Liberta umas e me traz o Ectoplasma que elas deixam pra trás; minhas lanternas bebem esse troço.
quest.hallows_eve_old_jack_5.title = Pedra Amaldiçoada
quest.hallows_eve_old_jack_5.flavor = Quebra pedra este mês, qualquer pedra, que de vez em quando cai um Geodo Amaldiçoado dela. Quebra uns; tem coisa boa neles, debaixo da maldição.
quest.hallows_eve_old_jack_lantern.title = A Lanterna Oca
quest.hallows_eve_old_jack_lantern.flavor = Todo ano a Lanterna Oca se apaga, e alguém tem que acender de novo. Derruba os esqueletos que usam a minha cara, depois me traz o que a lanterna precisa.

# ---- As diárias do Velho Jack ----
quest.hallows_eve_jack_daily_souls.title = Almas Inquietas
quest.hallows_eve_jack_daily_souls.flavor = Mais Almas Perdidas chegaram vagando ontem à noite. Liberta algumas antes que elas se instalem de vez.
quest.hallows_eve_jack_daily_pumpkins.title = Ronda das Abóboras
quest.hallows_eve_jack_daily_pumpkins.flavor = As lanternas consomem Abóboras Consagradas mais rápido do que eu dou conta de entalhar. Me traz mais umas antes de escurecer.
quest.hallows_eve_jack_daily_geodes.title = Geodos para Jack
quest.hallows_eve_jack_daily_geodes.flavor = Quebra uns dois Geodos Amaldiçoados pra mim. Minhas mãos andam duras demais pra isso.

