# Pacote Noite das Bruxas - as palavras do conjunto Consagrado. As chaves são escritas sem prefixo: a biblioteca
# encontra cada uma pelo final, seja qual for o nome deste arquivo. O aviso do conjunto é um toast, então nenhum valor leva marcação.
gearset.hallows_eve_hallowed.title = Conjunto Consagrado
gearset.hallows_eve_hallowed.tier_pair = Uma peça do conjunto no corpo e um Escudo de Jack na mão: um pouco mais de vida, o fogo fere menos, você brilha como uma lanterna e ganha o favor dos Consagrados um pouco mais rápido.
gearset.hallows_eve_hallowed.tier_armor = Elmo, peitoral, manoplas e grevas vestidos: um pouco mais de vida, e tudo o que você incendeia queima mais forte.
gearset.hallows_eve_hallowed.tier_armor_shield = Os quatro vestidos e o escudo na mão: ainda mais vida, e o seu fogo queima mais forte ainda.
gearset.hallows_eve_flaming_hallowed.title = Conjunto Consagrado Flamejante
gearset.hallows_eve_flaming_hallowed.tier_armor = Um Elmo de Jack Ardente ou o Elmo Flamejante do Cavaleiro, com a armadura flamejante dele vestida: mais vida, e tudo o que você incendeia queima bem mais forte.
gearset.hallows_eve_flaming_hallowed.tier_armor_shield = Os quatro vestidos e o Escudo de Jack Flamejante na mão: ainda mais vida, e o seu fogo queima mais forte ainda.

# The costumes' names, shown when a player hovers the costume's icon. The effect JSON spells the full
# key (hallowseve.items.effect...), because the client reads an effect's Name exactly as written.
effect.hallows_eve_costume_jack.name = Fantasia de Esqueleto de Jack
effect.hallows_eve_costume_lost_soul.name = Fantasia de Alma Perdida
effect.hallows_eve_lantern_burn.name = Queimadura

# The Fire Resistance Potion's buff, shown when a player hovers its icon.
effect.hallows_eve_fire_resistance.name = Resistência ao Fogo

