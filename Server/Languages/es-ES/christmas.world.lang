# Christmas - the calendar's words (what Christmas and Christmas Morning are called, and their banners),
# the costumes' names and the notice for Santa's Sack. Keys are written bare: the library finds each one
# by its tail, whatever this file is called. Banners and notices print markup as text, so none of these
# values carries any.

# ---- Christmas ----
calendar.christmas.name = Navidad
calendar.christmas.flavor = Papá Noel está en el Templo Olvidado, y unos Trorks con gorro de Papá Noel han huido con sus regalos.
calendar.christmas.herald.start = Navidad
calendar.christmas.herald.start.sub = Papá Noel está en el Templo Olvidado, y unos Trorks le han robado los regalos.
calendar.christmas.herald.end = La Navidad ha terminado
calendar.christmas.herald.end.sub = El trineo de Papá Noel se guarda hasta el año que viene.

# ---- Christmas Morning ----
calendar.christmas_morning.name = Mañana de Navidad
calendar.christmas_morning.flavor = La mañana de Navidad en el Templo Olvidado, con algo bajo el árbol de Papá Noel.
calendar.christmas_morning.herald.start = Feliz Navidad
calendar.christmas_morning.herald.start.sub = Ve a ver a Papá Noel al Templo Olvidado.

# ---- Costumes ----
# A costume's buff-bar tile name. Its effect's Name is this key in full (christmas.world.effect...),
# because the client reads an effect's Name exactly as written.
effect.christmas_costume_elf.name = Disfraz de Elfo
effect.christmas_costume_reindeer.name = Disfraz de Reno
effect.christmas_costume_elf_suit.name = Traje de Elfo
effect.christmas_costume_santa.name = Traje de Papá Noel

# ---- Christmas Cheer ----
# What a friend's present leaves on you: its buff-bar tile name. Its effect's Name is this key in full.
effect.christmas_cheer.name = Espíritu Navideño

# ---- Santa's Sack ----
notify.christmas_santas_sack = Un Saco de Papá Noel, por subir aún más en la Lista de Buenos.

# ---- Christmas Eve ----
# The banner when a player collects Christmas Eve's pay. The sub line's {0} is the player's name.
notify.christmas_eve_delivered = El Trineo Está Lleno
notify.christmas_eve_delivered.sub = {0} ayudó a Papá Noel a prepararse para Nochebuena.
