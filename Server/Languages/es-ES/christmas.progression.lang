# Christmas progression: the season's currency, Santa's Nice List and Santa's Sack, the four Christmas
# stalls and their offers, the Christmas Set, the present's gift, Santa's conversation, the Christmas
# conversations of Tomas, Elsie and Bram, and the Christmas line their feast conversations gain.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. Numbers
# ride {0} and come from the content files, so a retune never touches a translation.

# ---- Christmas Coins ----
currency.christmas_coins.name = Monedas de Navidad
currency.christmas_coins.amount = {0, number} {0, plural, one {Moneda de Navidad} other {Monedas de Navidad}}
currency.christmas_coins.description = Gástalas en las tiendas de Navidad del Templo Olvidado.

# ---- Santa's Nice List ----
reputation.christmas_nice_list.name = Lista de Buenos de Papá Noel
reputation.christmas_nice_list.flavor = Papá Noel la revisa dos veces. Ayúdale a recuperar sus regalos y subirás en ella.
reputation.christmas_nice_list.rank.neutral = Recién Llegado
reputation.christmas_nice_list.rank.friendly = En la Lista
reputation.christmas_nice_list.rank.honored = Bueno
reputation.christmas_nice_list.rank.revered = Muy Bueno
reputation.christmas_nice_list.rank.exalted = Favorito de Papá Noel
reputation.christmas_nice_list.earn.quests = Ayuda a Papá Noel, Tomas, Elsie y Bram en el Templo Olvidado con sus misiones y trabajos diarios de Navidad.
reputation.christmas_nice_list.earn.board = Coge trabajos del Tablón de Navidad. Pregunta a Papá Noel qué hay que hacer.
reputation.christmas_nice_list.earn.thieves = Atrapa Ladrones de Regalos de noche en las Emerald Wilds, o a cualquier hora en la nieve de las Whisperfrost Frontiers. Los demás Trorks cuentan un poco mientras dure la Navidad.
reputation.christmas_nice_list.earn.presents = Regala un Regalo de Navidad a un amigo: sostenlo, míralo y haz clic izquierdo.
reputation.christmas_nice_list.earn.carols = Canta un villancico a cualquiera en el templo, una vez al día a cada uno.
reputation.christmas_nice_list.earn.yeti = Vence al Yeti en la Cueva del Yeti. Bram, en el prado, te lleva allí. Tu primera victoria de cada día cuenta más.
reputation.christmas_nice_list.earn.talk = Pasa a charlar con Papá Noel una vez al día.
reputation.christmas_nice_list.earn.gear = Lleva el Conjunto de Navidad de la tienda de Elsie, o come un Pastel de Navidad, y subirás más rápido.
lootable.christmas_santas_sack.title = Saco de Papá Noel
lootable.christmas_santas_sack.flavor = Papá Noel te prepara uno cada vez que subes otro escalón más allá de Favorito de Papá Noel.
lootable.christmas_present_gift.title = Regalo de Navidad
lootable.christmas_present_gift.flavor = Unas monedas y una pequeña sorpresa.
lootable.christmas_present_given.title = Un Regalo de un Amigo
lootable.christmas_present_given.flavor = Alguien te ha regalado esto. Mejor que abrir el tuyo.
lootable.christmas_stocking.title = Calcetín de Papá Noel
lootable.christmas_stocking.flavor = Un dulce y algo de dinero para gastar, y de vez en cuando un regalo.

# ---- The Christmas stalls ----
shop.christmas_santa.title = Tienda de Papá Noel
shop.christmas_santa.desc = Paquetes para envolver tus propios regalos, y bastones de caramelo para el frío camino a casa.
shop.christmas_santa.category.packets = Paquetes de Navidad
shop.christmas_santa.category.treats = Dulces
shop.christmas_miller.title = Panadería de Tomas
shop.christmas_miller.desc = Las recetas de todo lo que horneo para Papá Noel, y masa fresca si tienes prisa.
shop.christmas_miller.category.kitchen = Cocina
shop.christmas_weaver.title = Tienda de Elsie
shop.christmas_weaver.desc = Regalos que he envuelto yo misma, un poco de magia, y ropa de abrigo para la nieve.
shop.christmas_weaver.category.gifts = Regalos
shop.christmas_weaver.category.clothes = Ropa
shop.christmas_shepherd.title = Bolas de Nieve de Bram
shop.christmas_shepherd.desc = Bien apretadas. Cuidado con a quién se las tiras.
shop.christmas_shepherd.category.snow = Nieve
shop.christmas_offer_recipe_gingerbread_cookie.title = Receta de Galleta de Jengibre
shop.christmas_offer_recipe_gingerbread_cookie.desc = Hornéalas en una Cocina del Chef con masa y especias. Te dan un empujón al andar.
shop.christmas_offer_recipe_hot_cocoa.title = Receta de Chocolate Caliente
shop.christmas_offer_recipe_hot_cocoa.desc = Prepáralo en una Cocina del Chef. Deja fuera el frío y te devuelve la salud poco a poco.
shop.christmas_offer_recipe_cake.title = Receta de Pastel de Navidad
shop.christmas_offer_recipe_cake.desc = Lo mejor de la mesa. Hace todo lo que hacen las galletas y el chocolate, y mientras dura subes más rápido en la Lista de Buenos de Papá Noel.
shop.christmas_offer_present.title = Regalo de Navidad
shop.christmas_offer_present.desc = Envuelto por Elsie. Ábrelo para ver qué hay dentro.
shop.christmas_offer_christmas_wand.title = Varita de Navidad
shop.christmas_offer_christmas_wand.desc = Apúntala a un amigo para disfrazarlo de elfo o de reno.
shop.christmas_offer_santa_suit.title = Traje de Papá Noel
shop.christmas_offer_santa_suit.desc = Póntelo y serás Papá Noel por un rato.
shop.christmas_offer_christmas_gloves.title = Guantes de Navidad
shop.christmas_offer_christmas_gloves.desc = Guantes calentitos, parte del Conjunto de Navidad. Lleva el conjunto entero y subirás más rápido en la Lista de Buenos de Papá Noel.
shop.christmas_offer_christmas_hat.title = Gorro de Navidad
shop.christmas_offer_christmas_hat.desc = Un gorro calentito, parte del Conjunto de Navidad. Lleva el conjunto entero y subirás más rápido en la Lista de Buenos de Papá Noel.
shop.christmas_offer_christmas_trousers.title = Pantalones de Navidad
shop.christmas_offer_christmas_trousers.desc = Pantalones calentitos para la nieve, parte del Conjunto de Navidad. Lleva el conjunto entero y subirás más rápido en la Lista de Buenos de Papá Noel.
shop.christmas_offer_christmas_coat.title = Abrigo de Navidad
shop.christmas_offer_christmas_coat.desc = Un abrigo calentito, la última pieza del Conjunto de Navidad. Lleva el conjunto entero y subirás más rápido en la Lista de Buenos de Papá Noel.
shop.christmas_offer_snowballs_daily.title = Bolas de Nieve Gratis
shop.christmas_offer_snowballs_daily.desc = Un puñado de bolas de nieve de Bram, gratis una vez al día.
shop.christmas_offer_snowballs.title = Bolas de Nieve
shop.christmas_offer_snowballs.desc = Otro puñado, para cuando se acaben las gratis.
shop.christmas_offer_stocking.title = Calcetín de Papá Noel
shop.christmas_offer_stocking.desc = Gratis una vez al día. Mete la mano y mira qué te ha dejado Papá Noel.

# ---- The Christmas Set ----
# A set's notice is a toast, so no value carries markup.
gearset.christmas_set.title = Conjunto de Navidad
gearset.christmas_set.tier_half = Medio conjunto puesto: un poco más de salud.
gearset.christmas_set.tier_full = El conjunto entero puesto: más salud todavía, el frío muerde menos, y subes más rápido en la Lista de Buenos de Papá Noel.

# ---- Santa's conversation ----
dialogue.christmas_santa.off_season.text = La Navidad ha terminado, y mi trineo está listo para volver a casa.\nVen a buscarme otra vez el próximo invierno.
dialogue.christmas_santa.off_season.opt.farewell = Adiós, Papá Noel.
dialogue.christmas_santa.first_words.text = Jo, jo, jo. Ahí estás.\nSoy Papá Noel, y necesito una mano. Unos Trorks con gorro de Papá Noel asaltaron mi trineo y huyeron con los regalos. Atrapa a esos <b>Ladrones de Regalos</b> de noche en las <b>Emerald Wilds</b>, o a cualquier hora en la nieve de las <b>Whisperfrost Frontiers</b>, y tráeme mis regalos.
dialogue.christmas_santa.first_words.opt.hail = Te ayudaré, Papá Noel.
dialogue.christmas_santa.daily_word.text = ¿Otra vez por aquí? Bien. Ya es otro día en mi <b>Lista de Buenos</b>.\nLos ladrones siguen ahí fuera. Vigila el bosque esta noche.
dialogue.christmas_santa.menu.text = Bueno. ¿Qué puedo hacer por ti?
dialogue.christmas_santa.who_are_you.text = Soy Papá Noel. Cada Navidad llevo regalos a todos en Orbis.\nEste año tengo ayuda. Tomas hornea, Elsie envuelve los regalos y cose, y Bram mantiene a todo el mundo con bolas de nieve.
dialogue.christmas_santa.about_thieves.text = Son Trorks con gorro de Papá Noel, y solo pelean a puñetazos, así que no son rival para ti.\nBusca de noche en los bosques y campos de las <b>Emerald Wilds</b>, o a cualquier hora en la nieve de las <b>Whisperfrost Frontiers</b>. A muchos aún les queda un regalo. Ábrelo, y es tuyo.
dialogue.christmas_santa.helpers.text = <b>Tomas</b> y <b>Elsie</b> tienen sus tiendas aquí mismo, a mi lado. Mientras el banquete de Martha siga en marcha, la están ayudando junto a la <b>aldea de los Kweebecs</b>, al final del camino.\n<b>Bram</b> está en el prado, a mitad del camino desde donde entraste.
dialogue.christmas_santa.opt.shop = A ver tu tienda.
dialogue.christmas_santa.opt.standing = ¿Cómo voy en tu lista?
dialogue.christmas_santa.opt.thieves = ¿Dónde están los ladrones?
dialogue.christmas_santa.opt.helpers = ¿Dónde están tus ayudantes?
dialogue.christmas_santa.opt.who = ¿Quién eres?
dialogue.christmas_santa.opt.back = Otra cosa.
dialogue.christmas_santa.opt.farewell = Feliz Navidad, Papá Noel.
dialogue.christmas_santa.opt.returned = Ya he vuelto.
dialogue.christmas_santa.opt.quests = ¿Qué hay que hacer?
dialogue.christmas_santa.opt.almanac = Enséñame el Almanaque.
dialogue.christmas_santa.opt.story = ¿En qué puedo ayudar?
dialogue.christmas_santa.meet_arrival.text = Jo, jo, jo. Me has encontrado.\nSoy Papá Noel, y necesito una mano. Unos Trorks con gorro de Papá Noel asaltaron mi trineo en el camino y huyeron con los regalos. Vamos a recuperarlos.
dialogue.christmas_santa.meet_arrival.opt.hail = Te ayudaré, Papá Noel.
dialogue.christmas_santa.morning_arrival.text = Feliz Navidad. Mira bajo mi árbol.\nHay un regalo con tu nombre.
dialogue.christmas_santa.morning_arrival.opt.open = ¿Para mí?
dialogue.christmas_santa.daily_word_story_done.text = ¿Otra vez por aquí? Bien. Ya es otro día en mi <b>Lista de Buenos</b>.\nEl trineo está listo, así que mi historia termina hasta la próxima Navidad. Aún tengo <b>trabajos</b> cada día, los <b>Ladrones de Regalos</b> siguen ahí fuera, y las <b>tiendas</b> están abiertas.
dialogue.christmas_santa.story_done.text = El trineo está listo, y es cosa tuya.\nMi historia termina hasta la próxima Navidad, pero aún queda mucho. Pasa cada día por mis <b>trabajos</b>, sigue atrapando <b>Ladrones de Regalos</b>, y mira qué hay de nuevo en las <b>tiendas</b>.
dialogue.christmas_santa.story.text = Primero, atrápame a los <b>Ladrones de Regalos</b>. Luego <b>Bram</b> necesita zanahorias para los renos, <b>Tomas</b> necesita una mano con las galletas, y <b>Elsie</b> necesita ayuda con el envoltorio. Después, vuelve a verme para <b>Nochebuena</b>.\nTambién tengo trabajos cada día. Pregúntame qué hay que hacer.
dialogue.christmas_santa.thieves_offer.text = Esos ladrones aún tienen mis regalos. Atrápame a unos cuantos <b>Ladrones de Regalos</b>.\nSalen de noche en los bosques y campos de las <b>Emerald Wilds</b>, y andan por ahí todo el día en la nieve de las <b>Whisperfrost Frontiers</b>. Cualquier Trork que atrapes cuenta.
dialogue.christmas_santa.thieves_offer.opt.accept = Los atraparé.
dialogue.christmas_santa.thieves_brief.text = Busca de noche en las <b>Emerald Wilds</b>, o a cualquier hora en la nieve de las <b>Whisperfrost Frontiers</b>. Cualquier Trork cuenta.\nVuelve a verme cuando hayas atrapado bastantes.
dialogue.christmas_santa.thieves_ready.text = Los has atrapado. Uno llevaba esto encima. Ábrelo, o regálaselo a un amigo.\nAhora, los renos de <b>Bram</b> tienen hambre. Está en el <b>prado</b>, a mitad del camino desde donde entraste.
dialogue.christmas_santa.thieves_ready.opt.turnin = Aquí tienes.
dialogue.christmas_santa.eve_offer.text = Ya casi es <b>Nochebuena</b>, y el trineo aún no está lleno.\nTráeme <b>Galletas de Jengibre</b> para el saco y <b>zanahorias</b> para los renos. Y dame un <b>Regalo de Navidad</b> para el trineo.
dialogue.christmas_santa.eve_offer.opt.accept = Llenemos el trineo.
dialogue.christmas_santa.eve_brief.text = Hornea <b>Galletas de Jengibre</b> en una <b>Cocina del Chef</b> y recoge <b>zanahorias</b> en los bosques de las <b>Emerald Wilds</b>.\nPara el regalo, sostenlo, mírame y haz clic izquierdo.
dialogue.christmas_santa.eve_ready.text = Ya está lleno el trineo. Jo, jo, jo.\nEste adorno es para ti. Cuélgalo donde lo veas cada Navidad.
dialogue.christmas_santa.eve_ready.opt.turnin = Feliz Navidad, Papá Noel.
dialogue.christmas_santa.carols_offer.text = Nada calienta un templo frío como un villancico.\nCanta uno a la <b>gente del Templo Olvidado</b>, y ven a contarme qué tal fue. A mí no, ojo. Me sé todas las letras.
dialogue.christmas_santa.carols_offer.opt.accept = Voy a cantar.
dialogue.christmas_santa.carols_brief.text = Habla con la gente del templo y elige <b>Cantar un villancico</b>. Mis ayudantes son un buen comienzo.\nCada persona te escuchará una vez al día.
dialogue.christmas_santa.carols_ready.text = Te oí desde aquí. Nada mal.
dialogue.christmas_santa.carols_ready.opt.turnin = Todos cantaron conmigo.
dialogue.christmas_santa.daily_thieves_offer.text = Esos Trorks han vuelto a las andadas.\n¿Me atrapas unos cuantos <b>Ladrones de Regalos</b> más hoy?
dialogue.christmas_santa.daily_thieves_offer.opt.accept = Los atraparé.
dialogue.christmas_santa.daily_presents_offer.text = Mis ayudantes trabajan duro.\nDale a cada uno un <b>Regalo de Navidad</b> hoy. Sostén uno, míralos y haz clic izquierdo.
dialogue.christmas_santa.daily_presents_offer.opt.accept = Los repartiré.
dialogue.christmas_santa.presents_brief.text = Dale un <b>Regalo de Navidad</b> a <b>Tomas</b>, <b>Elsie</b> y <b>Bram</b>. Sostén uno, míralos y haz clic izquierdo.\nLos ladrones sueltan regalos, y <b>Elsie</b> los vende.
dialogue.christmas_santa.extra_thieves_ready.text = Más ladrones atrapados. Mi lista crece cada día.
dialogue.christmas_santa.extra_thieves_ready.opt.turnin = Aquí va mi cuenta.
dialogue.christmas_santa.ready_generic.text = ¿Ya has terminado? A ver.
dialogue.christmas_santa.ready_generic.opt.turnin = Está hecho.

# ---- Santa's helpers: Tomas the Miller, Elsie the Weaver and Bram the Shepherd ----
dialogue.christmas_feast_line.opt.stall = ¿Qué hay en tu tienda de Navidad?
dialogue.christmas_feast_line.opt.quests = ¿Algún trabajo de Navidad para mí?
dialogue.christmas_carol.opt.sing = Cantar un villancico
dialogue.christmas_miller.off_season.text = La Navidad ha terminado, y el horno se ha enfriado.\nNos vemos cuando vuelva la nieve.
dialogue.christmas_miller.off_season.opt.farewell = Hasta el próximo invierno.
dialogue.christmas_miller.greeting.text = Feliz Navidad. Papá Noel necesita galletas para su saco, así que he subido mi horno desde el molino.\nVendo las recetas de <b>Galletas de Jengibre</b>, <b>Chocolate Caliente</b> y <b>Pastel de Navidad</b>. Prepáralos en una <b>Cocina del Chef</b>.
dialogue.christmas_miller.dough.text = Muele <b>trigo</b> hasta hacer <b>harina</b> en una <b>Cocina del Chef</b>, y luego mezcla la harina con <b>huevos</b> y una <b>jarra de agua</b> en la misma cocina.\n¿Vas justo de tiempo? Vendo un poco de masa cada día.
dialogue.christmas_miller.why.text = Unos Trorks asaltaron el trineo de Papá Noel en el camino, y él pidió ayuda al pueblo. Elsie y Bram también vinieron.\nAlguien tiene que dar de comer al viejo.
dialogue.christmas_miller.opt.stall = ¿Qué vendes?
dialogue.christmas_miller.opt.dough = ¿Cómo hago masa?
dialogue.christmas_miller.opt.why = ¿Por qué estás aquí?
dialogue.christmas_miller.opt.thanks = Gracias, Tomas.
dialogue.christmas_miller.opt.back = Qué amable.
dialogue.christmas_miller.opt.farewell = Feliz Navidad, Tomas.
dialogue.christmas_miller.opt.quests = ¿Algún trabajo para mí?
dialogue.christmas_miller.opt.later = Ahora no.
dialogue.christmas_miller.next_elsie.text = El saco de Papá Noel no se llena solo. <b>Elsie</b> necesita una mano con el envoltorio.\nSu tienda está aquí mismo, junto a Papá Noel. Mientras el banquete de Martha siga en marcha, está al otro lado de la <b>aldea de los Kweebecs</b>.
dialogue.christmas_miller.cookies_offer.text = ¿Bram te dio mi receta? Bien. Papá Noel quiere galletas en su saco.\nAprende la receta, hornea una <b>Galleta de Jengibre</b> en una <b>Cocina del Chef</b> y tráela aquí. Quiero ver cómo sale.
dialogue.christmas_miller.cookies_offer.opt.accept = Hornearé una.
dialogue.christmas_miller.cookies_brief.text = Usa la página de la receta para aprenderla, y luego hornea una <b>Galleta de Jengibre</b> en una <b>Cocina del Chef</b> con <b>masa</b> y <b>especias</b>.\nTráeme una.
dialogue.christmas_miller.cookies_ready.text = Eso es un hombrecillo de jengibre como Dios manda. Huele bien, también.\nSigue horneando. Papá Noel querrá muchas más antes de Nochebuena.
dialogue.christmas_miller.cookies_ready.opt.turnin = Toma, pruébala.
dialogue.christmas_miller.baking_offer.text = Mi horno se come la masa más rápido de lo que la mezclo.\n¿Me traes algo de <b>masa</b> hoy?
dialogue.christmas_miller.baking_offer.opt.accept = Te traeré masa.
dialogue.christmas_miller.baking_brief.text = Haz <b>masa</b> en una <b>Cocina del Chef</b> y tráela aquí.\n¿Nunca la has hecho? Pregúntame cómo.
dialogue.christmas_miller.baking_ready.text = Masa fresca. El horno estaba esperando.
dialogue.christmas_miller.baking_ready.opt.turnin = Aquí está la masa.
dialogue.christmas_weaver.off_season.text = La Navidad ha terminado y las cintas están guardadas.\nVen a buscarme el próximo invierno. Para entonces tendré regalos nuevos envueltos.
dialogue.christmas_weaver.off_season.opt.farewell = Te buscaré.
dialogue.christmas_weaver.greeting.text = Feliz Navidad. Los ladrones dejaron los regalos de Papá Noel rotos y llenos de barro, así que los estoy envolviendo todos otra vez.\nVendo <b>Regalos de Navidad</b>, la <b>Varita de Navidad</b>, el <b>Traje de Papá Noel</b> y el <b>Conjunto de Navidad</b>. Cuanto más alto estés en la <b>Lista de Buenos</b> de Papá Noel, más puedo venderte.
dialogue.christmas_weaver.presents.text = Haz clic derecho en un regalo para abrirlo. Siempre hay algo dentro, y a veces algo precioso.\nO regálalo: sostenlo, mira a un amigo y haz clic izquierdo. Recibe un regalo mejor que el tuyo, y Papá Noel se da cuenta. Cuando Papá Noel o uno de nosotros te pida un regalo, entrégalo del mismo modo.\nLos <b>Ladrones de Regalos</b> llevan muchos. Los encontrarás de noche en las <b>Emerald Wilds</b>.
dialogue.christmas_weaver.why.text = Papá Noel pidió ayuda al pueblo, así que aquí estoy. Alguien tiene que envolver todo esto.\nY alguien tiene que coserle un abrigo nuevo. Los Trorks se llevaron también el de repuesto.
dialogue.christmas_weaver.opt.stall = Enséñame lo que tienes.
dialogue.christmas_weaver.opt.presents = ¿Qué hago con un regalo?
dialogue.christmas_weaver.opt.why = ¿Por qué estás aquí?
dialogue.christmas_weaver.opt.thanks = Gracias, Elsie.
dialogue.christmas_weaver.opt.back = Es mucho envoltorio.
dialogue.christmas_weaver.opt.farewell = Feliz Navidad, Elsie.
dialogue.christmas_weaver.opt.quests = ¿Puedo ayudar?
dialogue.christmas_weaver.opt.later = Ahora no.
dialogue.christmas_weaver.next_santa.text = Papá Noel tiene un trabajo más para ti antes de <b>Nochebuena</b>.\nVe a verlo junto a su árbol.
dialogue.christmas_weaver.wrapping_offer.text = Me estoy quedando sin cinta, y los regalos no se envuelven solos.\nTráeme <b>Fibra Vegetal</b>. Puedes recogerla de la hierba. Y llévale uno de tus regalos a <b>Bram</b> de mi parte. Ha tenido una semana dura.
dialogue.christmas_weaver.wrapping_offer.opt.accept = Te ayudaré.
dialogue.christmas_weaver.wrapping_brief.text = Recoge <b>Fibra Vegetal</b> de la hierba y tráemela.\nLuego dale a <b>Bram</b> un <b>Regalo de Navidad</b>: sostenlo, míralo y haz clic izquierdo. Está en el <b>prado</b>, a mitad del camino. ¿No tienes regalo? Los vendo.
dialogue.christmas_weaver.wrapping_ready.text = Cinta para rato, y Bram sigue sonriendo por su regalo.\nEstos tres son para ti. Y a Papá Noel le vendría bien otro elfo, así que quédate quieto.
dialogue.christmas_weaver.wrapping_ready.opt.turnin = Gracias, Elsie.
dialogue.christmas_weaver.fibre_offer.text = Me he quedado sin cinta otra vez.\nTráeme <b>Fibra Vegetal</b> hoy y te envolveré dos regalos.
dialogue.christmas_weaver.fibre_offer.opt.accept = Te traeré algo.
dialogue.christmas_weaver.fibre_brief.text = Recoge <b>Fibra Vegetal</b> de la hierba y tráemela.
dialogue.christmas_weaver.fibre_ready.text = Hebras largas y buenas. Toma, dos regalos, envueltos esta mañana.
dialogue.christmas_weaver.fibre_ready.opt.turnin = Aquí está la fibra.
dialogue.christmas_shepherd.off_season.text = Se acabó la Navidad. Yo me vuelvo colina arriba.
dialogue.christmas_shepherd.off_season.opt.farewell = Buen camino a casa.
dialogue.christmas_shepherd.greeting.text = Feliz Navidad. Asaltaron el trineo de Papá Noel, así que bajé a ayudar.\nReparto <b>bolas de nieve</b>, un puñado gratis cada día. Dale a alguien con una y se ralentiza un momento. No hace daño.
dialogue.christmas_shepherd.thieves.text = Trorks con gorro de Papá Noel. Salen de noche por los <b>bosques</b> y <b>campos</b> de las <b>Emerald Wilds</b>.\nArriba, en la nieve de las <b>Whisperfrost Frontiers</b>, andan todo el día. Dale primero con una bola de nieve. Lo frena en seco.
dialogue.christmas_shepherd.why.text = Alguien tiene que mantener la nieve.\nY Papá Noel lo pidió con buenas maneras.
dialogue.christmas_shepherd.opt.stall = ¿Tienes bolas de nieve?
dialogue.christmas_shepherd.opt.thieves = ¿Dónde están los ladrones?
dialogue.christmas_shepherd.opt.why = ¿Por qué estás aquí?
dialogue.christmas_shepherd.opt.thanks = Gracias, Bram.
dialogue.christmas_shepherd.opt.back = Tiene sentido.
dialogue.christmas_shepherd.opt.farewell = Feliz Navidad, Bram.
dialogue.christmas_shepherd.opt.quests = ¿Necesitas una mano?
dialogue.christmas_shepherd.opt.later = Ahora no.
dialogue.christmas_shepherd.next_tomas.text = <b>Tomas</b> te quiere ahora en la cocina.\nSu tienda está junto a Papá Noel. Mientras el banquete de Martha siga en marcha, está donde el camino se une a la <b>aldea de los Kweebecs</b>.
dialogue.christmas_shepherd.reindeer_offer.text = Los renos de Papá Noel no han comido desde que los Trorks asaltaron el trineo.\nTráeme <b>zanahorias</b>. Crecen silvestres en los bosques de las <b>Emerald Wilds</b>.
dialogue.christmas_shepherd.reindeer_offer.opt.accept = Buscaré zanahorias.
dialogue.christmas_shepherd.reindeer_brief.text = Recoge <b>zanahorias</b> en los bosques de las <b>Emerald Wilds</b> y tráelas aquí.
dialogue.christmas_shepherd.reindeer_ready.text = Con esto seguirán volando. Bolas de nieve, por las molestias.\nY Tomas me dejó esto para ti. Su receta de galletas, con un poco de masa y especias.
dialogue.christmas_shepherd.reindeer_ready.opt.turnin = Gracias, Bram.
dialogue.christmas_shepherd.carrots_offer.text = Los renos comen todo el día.\n¿Me traes más <b>zanahorias</b>? Te añado bolas de nieve.
dialogue.christmas_shepherd.carrots_offer.opt.accept = Traeré zanahorias.
dialogue.christmas_shepherd.carrots_brief.text = <b>Zanahorias</b>, de los bosques de las <b>Emerald Wilds</b>. Tráelas aquí.
dialogue.christmas_shepherd.carrots_ready.text = Buenas zanahorias. Los renos se pelearán por ellas.
dialogue.christmas_shepherd.carrots_ready.opt.turnin = Aquí tienes.

# ---- Santa's story, the dailies and the carol tour ----
quest.christmas_santa_meet.title = Conoce a Papá Noel
quest.christmas_santa_meet.flavor = Unos Trorks asaltaron mi trineo, y necesito ayuda. Estoy junto a mi árbol en el Templo Olvidado. Cualquier Portal al Templo Olvidado te lleva hasta allí.
objective.christmas.meet_santa = Encuentra a Papá Noel en el Templo Olvidado
quest.christmas_present_thieves.title = Ladrones de Regalos
quest.christmas_present_thieves.flavor = Unos Trorks con gorro de Papá Noel han huido con mis regalos. Atrápalos de noche en las Emerald Wilds, o a cualquier hora en la nieve de las Whisperfrost Frontiers, y vuelve a verme.
objective.christmas.catch_thieves = Atrapa {0} {0, plural, one {Ladrón de Regalos} other {Ladrones de Regalos}}
quest.christmas_reindeer_food.title = Comida para los Renos
quest.christmas_reindeer_food.flavor = Los renos de Papá Noel no han comido desde que asaltaron el trineo. Recoge zanahorias en los bosques de las Emerald Wilds y tráemelas al prado.
objective.christmas.bring_bram_carrots = Trae a Bram {0} {0, plural, one {Zanahoria} other {Zanahorias}}
quest.christmas_gingerbread_cookies.title = Galletas de Navidad
quest.christmas_gingerbread_cookies.flavor = El saco de Papá Noel necesita galletas. Aprende mi receta, hornea una Galleta de Jengibre en una Cocina del Chef con masa y especias, y tráemela junto al árbol de Papá Noel.
objective.christmas.bring_tomas_cookie = Trae a Tomas una Galleta de Jengibre
quest.christmas_wrapping_presents.title = Envolver Regalos
quest.christmas_wrapping_presents.flavor = Necesito Fibra Vegetal para la cinta, así que recoge algo de la hierba y tráemela. Y dale uno de tus regalos a Bram en el prado. Ha tenido una semana dura.
objective.christmas.bring_elsie_fibre = Trae a Elsie {0} de Fibra Vegetal
objective.christmas.give_bram_present = Dale a Bram un Regalo de Navidad
quest.christmas_eve.title = Nochebuena
quest.christmas_eve.flavor = El trineo sale esta noche. Tráeme Galletas de Jengibre para el saco y zanahorias para los renos, y dame un Regalo de Navidad para el trineo.
objective.christmas.bring_santa_cookies = Trae a Papá Noel {0} {0, plural, one {Galleta} other {Galletas}} de Jengibre
objective.christmas.bring_santa_carrots = Trae a Papá Noel {0} {0, plural, one {Zanahoria} other {Zanahorias}}
objective.christmas.give_santa_present = Dale a Papá Noel un Regalo de Navidad
quest.christmas_morning.title = Mañana de Navidad
quest.christmas_morning.flavor = Feliz Navidad. Hay un regalo bajo mi árbol en el Templo Olvidado, y lleva tu nombre. Ven a abrirlo.
objective.christmas.morning = Abre tu regalo bajo el árbol de Papá Noel
quest.christmas_daily_thieves.title = Ladrones Diarios
quest.christmas_daily_thieves.flavor = Esos Trorks han vuelto a las andadas. Atrapa unos cuantos Ladrones de Regalos más esta noche en las Emerald Wilds, y vuelve a verme.
quest.christmas_daily_presents.title = Regalos Diarios
quest.christmas_daily_presents.flavor = Mis ayudantes trabajan duro. Dale hoy un Regalo de Navidad a Tomas, a Elsie y a Bram. Sostén uno, míralos y haz clic izquierdo.
objective.christmas.give_tomas_present = Dale a Tomas un Regalo de Navidad
objective.christmas.give_elsie_present = Dale a Elsie un Regalo de Navidad
quest.christmas_daily_baking.title = Horneado Diario
quest.christmas_daily_baking.flavor = Mi horno se come la masa más rápido de lo que la mezclo. Haz masa en una Cocina del Chef y tráeme algo.
objective.christmas.bring_tomas_dough = Trae a Tomas {0} de Masa
quest.christmas_daily_wrapping.title = Envoltorio Diario
quest.christmas_daily_wrapping.flavor = Me he quedado sin cinta otra vez. Recoge Fibra Vegetal de la hierba y tráemela, y te envolveré dos regalos.
quest.christmas_daily_carrots.title = Zanahorias Diarias
quest.christmas_daily_carrots.flavor = Los renos comen todo el día. Tráeme zanahorias de los bosques de las Emerald Wilds y te añado bolas de nieve.
quest.christmas_extra_thieves.title = Ladrones Extra
quest.christmas_extra_thieves.flavor = Me quedo con todos los ladrones que puedas atrapar. Busca de noche en las Emerald Wilds, o a cualquier hora en la nieve de las Whisperfrost Frontiers, y vuelve a verme. Hazlo tantas veces como quieras.
quest.christmas_carols.title = Villancicos de Navidad
quest.christmas_carols.flavor = Nada calienta un templo frío como un villancico. Canta uno a la gente del Templo Olvidado y ven a contarme qué tal fue.
objective.christmas.sing_carols = Canta un villancico a {0} {0, plural, one {persona} other {personas}}

# ---- The Christmas Board ----
board.christmas_daily.title = Tablón de Navidad
board.christmas_daily.desc = Trabajos al aire libre y de taller, nuevos cada mañana. Cuanto más alto estés en mi Lista de Buenos, más pongo. Cobra antes de que se vaya el trineo. Si llegas tarde, te espera en tu Libro de Misiones.
board.christmas_daily.grade.outdoor = Trabajo al Aire Libre
board.christmas_daily.grade.workshop = Trabajo de Taller
quest.christmas_board_thieves.title = Trabajo de Ladrones
quest.christmas_board_thieves.flavor = Atrapa Ladrones de Regalos de noche en las Emerald Wilds, o a cualquier hora en la nieve de las Whisperfrost Frontiers. Cualquier Trork cuenta.
quest.christmas_board_carrots.title = Trabajo de Zanahorias
quest.christmas_board_carrots.flavor = Recoge zanahorias a mano en los bosques de las Emerald Wilds. Los renos vuelven a tener hambre.
objective.christmas.pick_carrots = Recoge {0} {0, plural, one {Zanahoria} other {Zanahorias}}
quest.christmas_board_logs.title = Trabajo de Troncos
quest.christmas_board_logs.flavor = Corta troncos de cualquier árbol para el fuego de Papá Noel. El templo se enfría de noche.
objective.christmas.chop_logs = Corta {0} {0, plural, one {tronco} other {troncos}}
quest.christmas_board_eggs.title = Trabajo de Huevos
quest.christmas_board_eggs.flavor = Tomas necesita huevos para sus pasteles. Cría gallinas en un Gallinero, o busca un nido de pájaro, y lleva los huevos al tablón.
objective.christmas.bring_eggs = Trae {0} {0, plural, one {Huevo} other {Huevos}}
quest.christmas_board_cookies.title = Trabajo de Galletas
quest.christmas_board_cookies.flavor = Hornea Galletas de Jengibre en una Cocina del Chef y llévalas al tablón.
objective.christmas.bring_cookies = Trae {0} {0, plural, one {Galleta} other {Galletas}} de Jengibre
quest.christmas_board_dough.title = Trabajo de Masa
quest.christmas_board_dough.flavor = Haz masa en una Cocina del Chef y llévala al tablón. A Tomas nunca le basta.
objective.christmas.bring_dough = Trae {0} de Masa
quest.christmas_board_presents.title = Trabajo de Regalos
quest.christmas_board_presents.flavor = Dale a Papá Noel Regalos de Navidad para su saco. Sostén uno, míralo y haz clic izquierdo.
objective.christmas.give_santa_presents = Dale a Papá Noel {0} {0, plural, one {Regalo} other {Regalos}} de Navidad
quest.christmas_board_spices.title = Trabajo de Especias
quest.christmas_board_spices.flavor = Haz Especias en una Cocina del Chef con flores y una verdura, y llévalas al tablón.
objective.christmas.bring_spices = Trae {0} Especias

