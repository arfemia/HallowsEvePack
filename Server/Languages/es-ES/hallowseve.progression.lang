# Progresión de la Noche de Ánimas: la cadena de misiones del Viejo Jack, sus diarias, su tablón y su tienda, su
# conversación y la línea de truco o trato, los logros y el título de la temporada, y su página del Almanaque.
# Las claves van sin prefijo: la biblioteca encuentra cada una por su final, se llame como se llame este archivo.
# Los números van en {0} y salen de los archivos de contenido, así que un reajuste nunca toca una traducción.

# ---- El monedero ----
currency.hallows_eve_sweets.name = Dulces de Ánimas
currency.hallows_eve_sweets.amount = {0, number} {0, plural, one {Dulce de Ánimas} other {Dulces de Ánimas}}
currency.hallows_eve_sweets.description = Gástalos en la tienda del Viejo Jack, en el Templo Olvidado.
quest.category.hallows_eve = Noche de Ánimas

# ---- La cadena de misiones del Viejo Jack ----
quest.hallows_eve_old_jack_meet.title = Faroles en el Templo
quest.hallows_eve_old_jack_meet.flavor = Ya es otra vez la temporada, así que he vuelto al Templo Olvidado con mis faroles. Cualquier Portal al Templo Olvidado te lleva hasta allí. Ven a buscarme. No me vendría mal una mano.
quest.hallows_eve_old_jack_1.title = El Calabazar
quest.hallows_eve_old_jack_1.flavor = Mis faroles se tallan con Calabazas Consagradas, y me quedan pocas. Recoge calabazas a mano y tráeme las frías y relucientes.
quest.hallows_eve_old_jack_2.title = Faena de Faroles
quest.hallows_eve_old_jack_2.flavor = Una calabaza rellena de pólvora aleja a los muertos mejor que cualquier farol. Tira unas cuantas Bombas Farol y luego me cuentas cómo ardieron.
quest.hallows_eve_old_jack_3.title = Gules en la Escalera
quest.hallows_eve_old_jack_3.flavor = Mis faroles mantienen a los gules lejos de la escalera, pero por los pelos. Devuelve a unos cuantos Gules Descarnados bajo tierra al caer la noche.
quest.hallows_eve_old_jack_4.title = Recogida de Ectoplasma
quest.hallows_eve_old_jack_4.flavor = El Ectoplasma es lo que arde en mis faroles, y un Alma Perdida deja algo atrás cuando se la libera. Libera a unas cuantas y tráemelo.
quest.hallows_eve_old_jack_5.title = Piedra Maldita
quest.hallows_eve_old_jack_5.flavor = La piedra suelta Geodas Malditas en esta época del año, si rompes la suficiente. Abre unas cuantas y quédate con lo que caiga.
quest.hallows_eve_old_jack_lantern.title = El Farol de Ánimas
quest.hallows_eve_old_jack_lantern.flavor = Tengo la brasa del Jinete. Ahora tu Farol de Ánimas quiere una Calabaza Consagrada, algo de Ectoplasma y a los esqueletos con mi cara tumbados.
quest.hallows_eve_old_jack_horseman.title = El Jinete
quest.hallows_eve_old_jack_horseman.flavor = El Sepulturero que está a mi lado conoce el camino al cementerio del Jinete, pero no abrirá la verja sin una Vela Sepulcral, y yo las vendo en mi tienda en cuanto te cuente como Asiduo. Compra una, entra con amigos y derríbalo de la silla.
quest.hallows_eve_old_jack_horseman_hard.title = Fuego para el Farol
quest.hallows_eve_old_jack_horseman_hard.flavor = Tu farol quiere una llama que no se apague, y el Jinete lleva una. Pídele al Sepulturero la cabalgata difícil, véncelo y tráeme su brasa.

# ---- Las diarias del Viejo Jack ----
quest.hallows_eve_jack_daily_souls.title = Almas Inquietas
quest.hallows_eve_jack_daily_souls.flavor = Anoche llegaron más Almas Perdidas, a la deriva. Libera a unas cuantas antes de que se instalen para siempre.
quest.hallows_eve_jack_daily_pumpkins.title = Ronda de Calabazas
quest.hallows_eve_jack_daily_pumpkins.flavor = Los faroles queman Calabazas Consagradas más deprisa de lo que yo puedo tallarlas. Tráeme unas cuantas más antes de que oscurezca.
quest.hallows_eve_jack_daily_geodes.title = Geodas para Jack
quest.hallows_eve_jack_daily_geodes.flavor = Rompe un par de Geodas Malditas por mí. Últimamente tengo las manos demasiado agarrotadas para eso.
quest.hallows_eve_jack_daily_horseman.title = De Vuelta en la Silla
quest.hallows_eve_jack_daily_horseman.flavor = Ya está otra vez en la silla, como todas las noches. Lleva una Vela Sepulcral al Sepulturero y derríbalo de ese caballo de nuevo. La cabalgata normal, ojo, no la difícil.

# ---- Premios: lo que pagan el Viejo Jack y los Consagrados ----
lootable.hallows_eve_meet_pay.title = Bienvenida del Viejo Jack
lootable.hallows_eve_meet_pay.flavor = Unos dulces para saludar.
lootable.hallows_eve_chain_pay.title = Paga del Viejo Jack
lootable.hallows_eve_chain_pay.flavor = Lo que paga el Viejo Jack por cada trabajo que te da.
lootable.hallows_eve_daily_pay.title = Paga Diaria del Viejo Jack
lootable.hallows_eve_daily_pay.flavor = Lo que paga el Viejo Jack por un día de trabajo.
lootable.hallows_eve_lantern_pay.title = Gracias del Viejo Jack
lootable.hallows_eve_lantern_pay.flavor = Lo que da el Viejo Jack cada año por encender el Farol de Ánimas.
lootable.hallows_eve_board_pay.title = Extras del Viejo Jack
lootable.hallows_eve_board_pay.flavor = Un poco más sobre lo que paga el trabajo, para quien atiende mi tablón.
lootable.hallows_eve_board_sweets.title = El Tarro de Caramelos
lootable.hallows_eve_board_sweets.flavor = Todos los que me caben en una mano.
lootable.hallows_eve_hallowed_cache.title = Alijo de los Consagrados
lootable.hallows_eve_hallowed_cache.flavor = Los Consagrados te dejan esto cada vez que subes un escalón más allá de Exaltado con ellos. No me preguntes de dónde lo sacan.
lootable.hallows_eve_trick_or_treat.title = Truco o Trato
lootable.hallows_eve_trick_or_treat.flavor = Llama y mira qué te toca. Tratos, sobre todo.
lootable.hallows_eve_treats.title = Algo Dulce
lootable.hallows_eve_treats.flavor = Lo que recibes cuando el truco no cuaja.
lootable.hallows_eve_geode_crack.title = Geoda Abierta
lootable.hallows_eve_geode_crack.flavor = Lo que cae de una Geoda Maldita cuando la abres. Siempre cristal, y mejor si tienes suerte.

