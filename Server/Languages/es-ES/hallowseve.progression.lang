# Progresión de la Noche de Ánimas: la cadena de misiones del Viejo Jack, sus diarias, su tablón y su puesto, su
# conversación y la línea de truco o trato, los logros y el título de la temporada, y su página del Almanaque.
# Las claves van sin prefijo: la biblioteca encuentra cada una por su final, se llame como se llame este archivo.
# Los números van en {0} y salen de los archivos de contenido, así que un reajuste nunca toca una traducción.

# ---- El monedero ----
currency.hallows_eve_sweets.name = Dulces de Ánimas

# ---- La cadena de misiones del Viejo Jack ----
quest.hallows_eve_old_jack_meet.title = Faroles en el Templo
quest.hallows_eve_old_jack_meet.flavor = Ya es otra vez la temporada, así que he vuelto al Templo Olvidado con mis faroles. Cualquiera de los portales del templo te lleva hasta allí. Ven a buscarme. No me vendría mal una mano.
quest.hallows_eve_old_jack_1.title = El Calabazar
quest.hallows_eve_old_jack_1.flavor = Recoge una calabaza este mes y de vez en cuando te sale una fría y reluciente. Tráeme unas cuantas de esas consagradas.
quest.hallows_eve_old_jack_2.title = Faena de Faroles
quest.hallows_eve_old_jack_2.flavor = Una calabaza consagrada con la mecha corta da una buena Bomba Farol. Tira unas cuantas a algo que se lo tenga merecido, y luego me cuentas cómo ardieron.
quest.hallows_eve_old_jack_3.title = Gules en la Escalera
quest.hallows_eve_old_jack_3.flavor = Los Gules Descarnados salen a rastras de las tumbas viejas al caer la noche, con hambre. Devuelve a unos cuantos bajo tierra antes de que lleguen a la escalera del templo.
quest.hallows_eve_old_jack_4.title = Recogida de Ectoplasma
quest.hallows_eve_old_jack_4.flavor = Las Almas Perdidas andan a la deriva hasta que alguien las deja ir. Libera a unas cuantas y tráeme el ectoplasma que dejan atrás; mis faroles se lo beben.
quest.hallows_eve_old_jack_5.title = Piedra Maldita
quest.hallows_eve_old_jack_5.flavor = Cava hondo este mes y a la piedra le salen geodas que zumban. Abre unas cuantas; hay algo bueno en ellas, debajo de la maldición.
quest.hallows_eve_old_jack_lantern.title = El Farol de Ánimas
quest.hallows_eve_old_jack_lantern.flavor = Cada año el Farol de Ánimas se apaga, y alguien tiene que volver a encenderlo. Tumba a los esqueletos que llevan mi cara, y luego tráeme lo que necesita el farol.

# ---- Las diarias del Viejo Jack ----
quest.hallows_eve_jack_daily_souls.title = Almas Inquietas
quest.hallows_eve_jack_daily_souls.flavor = Anoche llegaron más Almas Perdidas, a la deriva. Libera a unas cuantas antes de que se instalen para siempre.
quest.hallows_eve_jack_daily_pumpkins.title = Ronda de Calabazas
quest.hallows_eve_jack_daily_pumpkins.flavor = Los faroles queman calabazas consagradas más deprisa de lo que yo puedo tallarlas. Tráeme unas cuantas más antes de que oscurezca.
quest.hallows_eve_jack_daily_geodes.title = Piedra que Zumba
quest.hallows_eve_jack_daily_geodes.flavor = La piedra del fondo vuelve a zumbar. Rompe un par de Geodas Malditas antes de que se rompan solas.

