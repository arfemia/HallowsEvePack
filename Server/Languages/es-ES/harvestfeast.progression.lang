# Harvest Feast progression: Martha's intro quest, her questline, the yearly feast and the dailies, the
# feast board and the feast stall, her conversation, the season's achievements and titles, her
# reputation and the Almanac page, the shared meal and the invitation tour, and the feast's villagers.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. A quest,
# a contract or an achievement takes its words from the keys its id spells (quest.<id>.title and
# .flavor, achievement.<id>.title and .desc), so no content file names those. Numbers ride {0} and
# come from the content files, so a retune never touches a translation.

# ---- Martha's reputation ----
reputation.harvest_feast_host.name = Favor del Banquete
reputation.harvest_feast_host.flavor = Martha recuerda quién vino a ayudar y quién solo vino a comer.
reputation.harvest_feast_host.rank.neutral = Recién Llegado
reputation.harvest_feast_host.rank.friendly = Vecino
reputation.harvest_feast_host.rank.honored = Cara Conocida
reputation.harvest_feast_host.rank.revered = De la Familia
reputation.harvest_feast_host.rank.exalted = Cabecera de la Mesa

# ---- The feast board ----
board.harvest_feast_daily.title = Tablón del Banquete
board.harvest_feast_daily.desc = Trabajos del campo y de la cocina, nuevos cada mañana. Cuanto más ayudas, más te reservo. Cobra antes de que se recoja la mesa. Si llegas tarde, lo que hayas ganado te espera en tu Libro de Misiones.
board.harvest_feast_daily.grade.field = Trabajo de Campo
board.harvest_feast_daily.grade.kitchen = Trabajo de Cocina
quest.harvest_feast_board_turkeys.title = Batida de Pavos
quest.harvest_feast_board_turkeys.flavor = El bosque está lleno de pavos esta semana. Abate unos cuantos, si logras alcanzarlos; corren como si supieran qué hay para cenar.
quest.harvest_feast_board_wheat.title = Siega del Trigo
quest.harvest_feast_board_wheat.flavor = El trigo silvestre no espera a nadie. Recógelo antes de que llegue la helada.
quest.harvest_feast_board_pies.title = Pasteles para la Mesa
quest.harvest_feast_board_pies.flavor = Cada asiento de la mesa quiere su trozo. Hornea un par de pasteles de calabaza y tráelos mientras estén calientes.
quest.harvest_feast_board_roast.title = Hoguera de Asar
quest.harvest_feast_board_roast.flavor = Cocina un buen montón de carne al fuego. Solo con el olor ya viene la gente a la mesa.

# ---- The feast stall ----
shop.harvest_feast_host.title = Puesto del Banquete
shop.harvest_feast_host.desc = Recetas de mi propio libro, palomitas por bolsas y unas cuantas cosas para la casa.
shop.harvest_feast_host.category.kitchen = Cocina
shop.harvest_feast_host.category.decor = Decoración
shop.harvest_feast_offer_recipe_apple_pie.title = Receta de Pastel de Manzana
shop.harvest_feast_offer_recipe_apple_pie.desc = Léela una vez y sabrás hornear pasteles de manzana para siempre.
shop.harvest_feast_offer_recipe_meat_pie.title = Receta de Pastel de Carne
shop.harvest_feast_offer_recipe_meat_pie.desc = El pastel de carne de la propia Martha, anotado para los amigos de la mesa.
shop.harvest_feast_offer_recipe_caesar_salad.title = Receta de Ensalada César
shop.harvest_feast_offer_recipe_caesar_salad.desc = La ensalada César de Martha, anotada para la familia.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Cena en el Templo
quest.harvest_feast_martha_meet.flavor = La cosecha está recogida, así que vuelvo a cocinar en el Templo Olvidado. Cualquier Portal del Templo Olvidado te lleva hasta allí. Ven a buscarme, y ven con hambre.
objective.harvest_feast.meet_martha = Encuentra a Martha la Cocinera en el Templo Olvidado

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Trigo para los Hornos
quest.harvest_feast_host_1.flavor = Primero el pan, siempre. El trigo silvestre crece espeso en esta época, así que tráeme un buen brazado para los hornos.
quest.harvest_feast_host_2.title = La Caza del Pavo
quest.harvest_feast_host_2.flavor = Los pavos silvestres están gordos y ruidosos este mes, y no son tan tontos como parecen. Abate unos cuantos; la mesa no sirve de nada sin un asado.
quest.harvest_feast_host_3.title = El Primer Pastel
quest.harvest_feast_host_3.flavor = Te toca ponerte ante los fogones. Aprende esa receta, hornea un pastel de calabaza en un Fogón de Chef y tráemelo.
quest.harvest_feast_the_feast.title = La Mesa Larga
quest.harvest_feast_the_feast.flavor = Una vez al año lo ponemos todo en la mesa y comemos hasta que nadie se tiene en pie. Trae un pastel, algo de asado y una cesta de zanahorias, y lo serviremos juntos.

# ---- Martha's dailies ----
quest.harvest_feast_daily_turkeys.title = Carrera de Pavos
quest.harvest_feast_daily_turkeys.flavor = El asado de ayer quedó en el hueso. Tráeme unos cuantos pavos más y pondré otro.
quest.harvest_feast_daily_wheat.title = Pan para la Mañana
quest.harvest_feast_daily_wheat.flavor = Todas las hogazas que horneé hoy ya se han ido. Tráeme más trigo, o mañana no hay pan.
quest.harvest_feast_daily_roast.title = Asado para la Mesa
quest.harvest_feast_daily_roast.flavor = Cocina algo de carne al fuego y tráela aquí. La gente se la come antes de que llegue a la mesa.

