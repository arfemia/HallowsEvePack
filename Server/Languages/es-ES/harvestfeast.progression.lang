gearset.harvest_feast_harvest_set.tier_full = El conjunto entero puesto: más salud todavía, y ganas el favor de Martha más rápido.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Conoce a Martha
quest.harvest_feast_martha_meet.flavor = La cosecha está recogida, así que vuelvo a cocinar en el Templo Olvidado. Cualquier Portal al Templo Olvidado te lleva hasta allí. Ven a buscarme, y ven con hambre.
objective.harvest_feast.meet_martha = Encuentra a Martha la Cocinera en el Templo Olvidado

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Siega del Trigo
quest.harvest_feast_host_1.flavor = Primero el pan, siempre. El trigo silvestre crece en las llanuras de las Emerald Wilds. Recógeme un buen brazado a mano y tráelo al Templo Olvidado.
quest.harvest_feast_host_2.title = Caza del Pavo
quest.harvest_feast_host_2.flavor = Los Pavos Silvestres andan de día por el bosque y las llanuras de las Emerald Wilds. Abate unos cuantos y vuelve conmigo. La mesa no sirve de nada sin un asado.
quest.harvest_feast_host_3.title = Tu Primer Pastel
quest.harvest_feast_host_3.flavor = Te toca ponerte ante los fogones. Usa la receta que te di para aprenderla, hornea un pastel de calabaza en un Fogón de Chef con masa, una calabaza y especia, y tráemelo.
quest.harvest_feast_the_feast.title = El Banquete
quest.harvest_feast_the_feast.flavor = Una vez al año lo ponemos todo en la mesa. Hornea un pastel de calabaza en un Fogón de Chef, cocina carne en una Hoguera, recoge zanahorias en los bosques y tráemelo todo.

# ---- Martha's dailies and Extra Turkeys ----
quest.harvest_feast_daily_turkeys.title = Pavos Diarios
quest.harvest_feast_daily_turkeys.flavor = El asado de ayer quedó en el hueso. Abate unos cuantos Pavos Silvestres más en las Emerald Wilds y pondré otro.
quest.harvest_feast_daily_wheat.title = Trigo Diario
quest.harvest_feast_daily_wheat.flavor = Todas las hogazas que horneé hoy ya se han ido. Tráeme más trigo de las llanuras, o mañana no hay pan.
quest.harvest_feast_daily_roast.title = Asado Diario
quest.harvest_feast_daily_roast.flavor = Cocina carne cruda en una Hoguera y tráela aquí. La gente se la come antes de que llegue a la mesa.
quest.harvest_feast_extra_turkeys.title = Pavos Extra
quest.harvest_feast_extra_turkeys.flavor = Aceptaré todos los pavos que atrapes. Abate más Pavos Silvestres en las Emerald Wilds y vuelve conmigo. Hazlo tantas veces como quieras.

