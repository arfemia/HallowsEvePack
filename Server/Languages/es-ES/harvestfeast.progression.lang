gearset.harvest_feast_harvest_set.title = Conjunto de la Cosecha
gearset.harvest_feast_harvest_set.tier_half = Medio conjunto puesto: un poco más de salud.
gearset.harvest_feast_harvest_set.tier_full = El conjunto entero puesto: más salud todavía, y ganas el favor de Martha más rápido.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Conoce a Martha
quest.harvest_feast_martha_meet.flavor = La cosecha está recogida, así que vuelvo a cocinar en el Templo Olvidado. Cualquier Portal al Templo Olvidado te lleva hasta allí. Ven a buscarme, y ven con hambre.
objective.harvest_feast.meet_martha = Encuentra a Martha la Cocinera en el Templo Olvidado

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Siega del Trigo
quest.harvest_feast_host_1.flavor = Primero el pan, siempre. El trigo silvestre crece en las llanuras de las Emerald Wilds. Recógeme un buen brazado a mano y tráelo al Templo Olvidado.
quest.harvest_feast_host_2.title = Caza del Pavo
quest.harvest_feast_host_2.flavor = Sin un asado la mesa no sirve de nada. Caza Pavos Silvestres de día en el bosque y las llanuras de las Emerald Wilds y vuelve conmigo.
quest.harvest_feast_host_3.title = Tu Primer Pastel
quest.harvest_feast_host_3.flavor = Te toca ponerte ante los fogones. Aprende la receta que te di, hornea un pastel de calabaza y tráemelo.
quest.harvest_feast_the_feast.title = El Banquete
quest.harvest_feast_the_feast.flavor = Una vez al año lo ponemos todo en la mesa. Tráeme un pastel de calabaza, algo de carne cocinada y zanahorias.
quest.harvest_feast_supper_tomas.title = Cena para Tomas
quest.harvest_feast_supper_tomas.flavor = Tomas cargó harina toda la semana y no se sentó ni un momento. Llévale un pastel de calabaza de las sobras. Está donde el camino llega a la aldea de los Kweebecs, en el Templo Olvidado.
quest.harvest_feast_supper_elsie.title = Cena para Elsie
quest.harvest_feast_supper_elsie.flavor = Elsie tejió todos los manteles de esa mesa y nunca comió en uno. Llévale una verdura asada. Está al otro lado de la aldea de los Kweebecs, en el Templo Olvidado.
quest.harvest_feast_supper_bram.title = Cena para Bram
quest.harvest_feast_supper_bram.flavor = Bram bajó su lana de las colinas por nosotros. Llévale algo de carne cocinada. Está en el prado junto al camino que entra al Templo Olvidado.
objective.harvest_feast.supper_for_tomas = Lleva un Pastel de Calabaza a Tomas el Molinero
objective.harvest_feast.supper_for_elsie = Lleva una Verdura Asada a Elsie la Tejedora
objective.harvest_feast.supper_for_bram = Lleva Carne Silvestre Cocinada a Bram el Pastor

# ---- Martha's dailies and Extra Turkeys ----
quest.harvest_feast_daily_turkeys.title = Pavos Diarios
quest.harvest_feast_daily_turkeys.flavor = El asado de ayer quedó en el hueso. Caza unos cuantos Pavos Silvestres más en las Emerald Wilds y vuelve conmigo.
quest.harvest_feast_daily_wheat.title = Trigo Diario
quest.harvest_feast_daily_wheat.flavor = Todas las hogazas que horneé hoy ya se han ido. Recoge más trigo en las llanuras de las Emerald Wilds y tráelo aquí.
quest.harvest_feast_daily_roast.title = Asado Diario
quest.harvest_feast_daily_roast.flavor = El asado se lo comen antes de que llegue a la mesa. Cocina algo de carne y tráela aquí.
quest.harvest_feast_extra_turkeys.title = Pavos Extra
quest.harvest_feast_extra_turkeys.flavor = Me llevo todos los pavos que atrapes. Caza Pavos Silvestres en las Emerald Wilds y vuelve conmigo, tantas veces como quieras.
quest.harvest_feast_miller_flour.title = Harina Diaria
quest.harvest_feast_miller_flour.flavor = Los hornos se comen la harina más rápido de lo que mi molino la muele. Tráeme algo.
quest.harvest_feast_weaver_spices.title = Especias Diarias
quest.harvest_feast_weaver_spices.flavor = Necesito especia para teñir de naranja el camino de mesa. Tráeme algo.
quest.harvest_feast_shepherd_eggs.title = Huevos Diarios
quest.harvest_feast_shepherd_eggs.flavor = Tomas quiere huevos para su masa, y yo soy el que sabe de gallinas. Tráeme unos cuantos.
