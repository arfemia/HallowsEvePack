reputation.harvest_feast_host.flavor = Martha recuerda quién vino a ayudar y quién solo vino a comer.
reputation.harvest_feast_host.rank.neutral = Recién Llegado
reputation.harvest_feast_host.rank.friendly = Vecino
reputation.harvest_feast_host.rank.honored = Amigo
reputation.harvest_feast_host.rank.revered = De la Familia
reputation.harvest_feast_host.rank.exalted = Cabecera de la Mesa
reputation.harvest_feast_host.earn.quests = Haz sus misiones y sus encargos diarios, y los encargos diarios que te dan Tomas, Elsie y Bram.
reputation.harvest_feast_host.earn.board = Coge trabajos del Tablón del Banquete.
reputation.harvest_feast_host.earn.talk = Pasa a charlar una vez al día.
reputation.harvest_feast_host.earn.turkeys = Caza pavos en las Emerald Wilds mientras dure la fiesta (un Pavo Silvestre da la mayor reputación) y recibe de ella Pavos Extra tantas veces como quieras.
reputation.harvest_feast_host.earn.gear = Lleva el Conjunto de la Cosecha de su tienda y ganarás su favor más rápido.
lootable.harvest_feast_feast_basket.title = Cesta del Banquete
lootable.harvest_feast_feast_basket.flavor = Martha te prepara una cada vez que tu favor con ella sube otro escalón más allá de Cabecera de la Mesa.
notify.harvest_feast_feast_basket = Una Cesta del Banquete de Martha, por toda tu ayuda en la mesa.
notify.harvest_feast_feast_served = ¡El Banquete está servido!
notify.harvest_feast_feast_served.sub = {0} se sentó a comer en la mesa de Martha.

# ---- The feast board ----
board.harvest_feast_daily.title = Tablón del Banquete
board.harvest_feast_daily.desc = Trabajos del campo y de la cocina, nuevos cada mañana. Cuanto más ayudas, más te reservo. Cobra antes de que se recoja la mesa. Si llegas tarde, lo que hayas ganado te espera en tu Libro de Misiones.
board.harvest_feast_daily.grade.field = Trabajo de Campo
board.harvest_feast_daily.grade.kitchen = Trabajo de Cocina
quest.harvest_feast_board_turkeys.title = Trabajo de Pavos
quest.harvest_feast_board_turkeys.flavor = Caza Pavos Silvestres de día en el bosque y en las llanuras de las Emerald Wilds. Los necesito para el asado.
quest.harvest_feast_board_wheat.title = Trabajo de Trigo
quest.harvest_feast_board_wheat.flavor = Recoge trigo silvestre a mano en las llanuras de las Emerald Wilds. Es el pan de mañana.
quest.harvest_feast_board_pumpkins.title = Trabajo de Calabazas
quest.harvest_feast_board_pumpkins.flavor = Recoge calabazas a mano en los bosques otoñales de las Emerald Wilds. Todo pastel empieza con una.
quest.harvest_feast_board_carrots.title = Trabajo de Zanahorias
quest.harvest_feast_board_carrots.flavor = Recoge zanahorias a mano en los bosques de las Emerald Wilds. Quiero una cesta llena para la mesa.
quest.harvest_feast_board_pies.title = Trabajo de Pasteles
quest.harvest_feast_board_pies.flavor = La mesa siempre pide más pastel. Hornea unos pasteles de calabaza y tráemelos.
quest.harvest_feast_board_roast.title = Trabajo de Cocina
quest.harvest_feast_board_roast.flavor = Cocina algo de carne y tráemela. Solo con el olor ya viene la gente.
quest.harvest_feast_board_vegetables.title = Trabajo de Verduras
quest.harvest_feast_board_vegetables.flavor = Asa unas verduras y tráelas a la mesa.
quest.harvest_feast_board_spices.title = Trabajo de Especias
quest.harvest_feast_board_spices.flavor = Tráeme algo de Especias. Al recoger calabazas a mano aparecen algunas.

# ---- The feast stall ----
shop.harvest_feast_host.title = Tienda del Banquete
shop.harvest_feast_host.desc = Recetas de mi propio libro, palomitas por bolsas, ropa para el campo y unas cuantas cosas para la casa.
shop.harvest_feast_host.category.kitchen = Cocina
shop.harvest_feast_host.category.clothes = Ropa
shop.harvest_feast_host.category.decor = Decoración
shop.harvest_feast_offer_recipe_turkey_pie.title = Receta: Pastel de Pavo
shop.harvest_feast_offer_recipe_turkey_pie.desc = El pastel de carne de Martha. Hornéalo en una Cocina del Chef para tener más salud máxima y recibir menos daño, durante más tiempo que con cualquier otro pastel.
shop.harvest_feast_offer_recipe_harvest_salad.title = Receta: Ensalada de la Cosecha
shop.harvest_feast_offer_recipe_harvest_salad.desc = Zanahorias, maíz y calabaza. Prepárala en una Cocina del Chef para tener más resistencia máxima, durante más tiempo que con cualquier otra ensalada.
shop.harvest_feast_offer_recipe_marthas_roast.title = Receta: Asado de Martha
shop.harvest_feast_offer_recipe_marthas_roast.desc = Su mejor plato, apuntado para la familia. Más salud y resistencia máximas, y su favor llega más rápido mientras dure.
shop.harvest_feast_offer_harvest_gloves.title = Guantes de la Cosecha
shop.harvest_feast_offer_harvest_gloves.desc = Guantes de lana abrigados, parte del Conjunto de la Cosecha. Lleva el conjunto entero y ganarás el favor de Martha más rápido.
shop.harvest_feast_offer_harvest_hat.title = Sombrero de la Cosecha
shop.harvest_feast_offer_harvest_hat.desc = Un sombrero de lana abrigado, parte del Conjunto de la Cosecha. Lleva el conjunto entero y ganarás el favor de Martha más rápido.
shop.harvest_feast_offer_harvest_trousers.title = Pantalones de la Cosecha
shop.harvest_feast_offer_harvest_trousers.desc = Pantalones de lana para el campo, parte del Conjunto de la Cosecha. Lleva el conjunto entero y ganarás el favor de Martha más rápido.
shop.harvest_feast_offer_harvest_tunic.title = Túnica de la Cosecha
shop.harvest_feast_offer_harvest_tunic.desc = Una túnica de lana, la última pieza del Conjunto de la Cosecha. Lleva el conjunto entero y ganarás el favor de Martha más rápido.

# ---- The Harvest Set ----
