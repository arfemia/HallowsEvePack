notify.hallows_eve_horseman_unhorsed = ¡El Jinete sale despedido de la silla!
notify.hallows_eve_horseman_head_off = ¡Su cabeza sale volando! Derríbala y podrá volver a ser herido.
notify.hallows_eve_horseman_head_down = La cabeza cae. ¡Acaba con ella!
notify.hallows_eve_horseman_head_returned = Su cabeza vuelve a él, y sus heridas se cierran.
notify.hallows_eve_horseman_wrath = ¡El Jinete arde de furia!
notify.hallows_eve_horseman_engaged = ¡El Jinete sin Cabeza cabalga!
notify.hallows_eve_horseman_engaged.sub = Aléjate de los círculos brillantes. Cuando su cabeza salga volando, derríbala.
notify.hallows_eve_horseman_defeated = ¡El Jinete sin Cabeza cae!
notify.hallows_eve_horseman_wiped = El Jinete sigue cabalgando.
