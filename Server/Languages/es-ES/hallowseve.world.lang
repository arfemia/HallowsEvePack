claim.hallows_eve_horseman_chase = El Botín del Jinete
claim.hallows_eve_horseman_chase_hard = El Botín del Jinete (Difícil)
dungeon.hallows_eve_graveyard.name = El Cementerio del Jinete
dungeon.hallows_eve_graveyard.description = Un cementerio amurallado donde el Jinete sin Cabeza cabalga de noche. Trae amigos.
dungeon.hallows_eve_graveyard.goal = Mata a los cuatro Esqueletos Jack que rodean la fuente para despertar al Jinete sin Cabeza y derrótalo. Cuando su cabeza salga volando, derríbala, o no se le podrá herir.
