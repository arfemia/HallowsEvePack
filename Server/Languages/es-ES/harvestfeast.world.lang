# Harvest Feast - the calendar's words (what the feast is called, and its banners) and the notice for
# a find. Keys are written bare: the library finds each one by its tail, whatever this file is called.
# Banners and notices print markup as text, so none of these values carries any.

# ---- Harvest Feast ----
calendar.harvest_feast.name = Banquete de la Cosecha
calendar.harvest_feast.flavor = La cosecha está recogida, y se monta una mesa larga en el Templo Olvidado.
calendar.harvest_feast.herald.start = Banquete de la Cosecha
calendar.harvest_feast.herald.start.sub = Martha la Cocinera está poniendo la mesa en el Templo Olvidado.
calendar.harvest_feast.herald.end = El Banquete de la Cosecha ha terminado
calendar.harvest_feast.herald.end.sub = La mesa se recoge hasta el año que viene.

# ---- Finds ----
notify.harvest_feast_spice_found = Una pizca de especia, escondida entre la calabaza.

# ---- Costumes ----
# A costume's buff-bar tile name. Its effect's Name is this key in full
# (harvestfeast.world.effect...), because the client reads an effect's Name exactly as written.
effect.harvest_feast_costume_turkey.name = Disfraz de Pavo
