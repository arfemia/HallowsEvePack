# Christmas progression: the season's currency, Santa's Nice List and Santa's Sack, the four Christmas
# stalls and their offers, the Christmas Set, the present's gift, Santa's conversation, the Christmas
# conversations of Tomas, Elsie and Bram, and the Christmas line their feast conversations gain.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. Numbers
# ride {0} and come from the content files, so a retune never touches a translation.

# ---- Christmas Coins ----
currency.christmas_coins.name = Рождественские монеты
currency.christmas_coins.amount = {0, number} {0, plural, one {рождественская монета} few {рождественские монеты} many {рождественских монет} other {рождественские монеты}}
currency.christmas_coins.description = Тратьте их в рождественских лавках в Забытом храме.

# ---- Santa's Nice List ----
reputation.christmas_nice_list.name = Список хороших Санта-Клауса
reputation.christmas_nice_list.flavor = Санта-Клаус проверяет его дважды. Помоги ему вернуть подарки, и ты поднимешься выше.
reputation.christmas_nice_list.rank.neutral = Новичок
reputation.christmas_nice_list.rank.friendly = В списке
reputation.christmas_nice_list.rank.honored = Хороший
reputation.christmas_nice_list.rank.revered = Очень хороший
reputation.christmas_nice_list.rank.exalted = Любимчик Санта-Клауса
reputation.christmas_nice_list.earn.quests = Помогай Санта-Клаусу, Томасу, Элси и Брэму в Забытом храме: выполняй их рождественские квесты и ежедневные работы.
reputation.christmas_nice_list.earn.board = Бери работу с Рождественской доски. Спроси Санта-Клауса, что нужно сделать.
reputation.christmas_nice_list.earn.thieves = Лови Похитителей подарков ночью в Emerald Wilds или в любое время в снегах Whisperfrost Frontiers. Пока идёт Рождество, немного засчитываются и другие трорки.
reputation.christmas_nice_list.earn.presents = Подари Рождественский подарок другу: держи его в руке, смотри на друга и щёлкни левой кнопкой.
reputation.christmas_nice_list.earn.carols = Пой рождественскую песню любому в храме, по разу в день каждому.
reputation.christmas_nice_list.earn.yeti = Победи Йети в Пещере Йети. Туда тебя отведёт Брэм на лугу. Больше всего даёт первая победа за день.
reputation.christmas_nice_list.earn.talk = Заглядывай к Санта-Клаусу поговорить раз в день.
reputation.christmas_nice_list.earn.gear = Носи Рождественский комплект из лавки Элси или ешь Рождественский рулет, и будешь подниматься быстрее.
lootable.christmas_santas_sack.title = Мешок Санта-Клауса
lootable.christmas_santas_sack.flavor = Санта-Клаус собирает тебе такой каждый раз, когда ты поднимаешься ещё на ступень выше «Любимчика Санта-Клауса».
lootable.christmas_present_gift.title = Рождественский подарок
lootable.christmas_present_gift.flavor = Несколько монет и небольшой сюрприз.
lootable.christmas_present_given.title = Подарок от друга
lootable.christmas_present_given.flavor = Тебе это подарили. Это лучше, чем открывать свой.
lootable.christmas_stocking.title = Носок Санта-Клауса
lootable.christmas_stocking.flavor = Лакомство и немного карманных денег, а иногда и подарок.

# ---- The Christmas stalls ----
shop.christmas_santa.title = Лавка Санта-Клауса
shop.christmas_santa.desc = Наборы для упаковки собственных подарков и карамельные трости для холодной дороги домой.
shop.christmas_santa.category.packets = Рождественские наборы
shop.christmas_santa.category.treats = Угощения
shop.christmas_miller.title = Пекарня Томаса
shop.christmas_miller.desc = Рецепты всего, что я пеку для Санта-Клауса, и свежее тесто, если ты торопишься.
shop.christmas_miller.category.kitchen = Кухня
shop.christmas_weaver.title = Лавка Элси
shop.christmas_weaver.desc = Подарки, которые я упаковала сама, немного волшебства и тёплая одежда для снега.
shop.christmas_weaver.category.gifts = Подарки
shop.christmas_weaver.category.clothes = Одежда
shop.christmas_shepherd.title = Снежки Брэма
shop.christmas_shepherd.desc = Слеплены крепко. Смотри, в кого бросаешь.
shop.christmas_shepherd.category.snow = Снег
shop.christmas_offer_recipe_gingerbread_cookie.title = Рецепт: Пряничный человечек
shop.christmas_offer_recipe_gingerbread_cookie.desc = Пеки их на Кухонной плите из теста и специй. С ними шаг становится пружинистым.
shop.christmas_offer_recipe_hot_cocoa.title = Рецепт: Горячее какао
shop.christmas_offer_recipe_hot_cocoa.desc = Готовь его на Кухонной плите. Оно прогоняет холод и возвращает здоровье.
shop.christmas_offer_recipe_cake.title = Рецепт: Рождественский рулет
shop.christmas_offer_recipe_cake.desc = Лучшее, что есть на столе. Он делает всё, что делают пряники и какао, а ещё, пока он действует, ты быстрее поднимаешься в Списке хороших Санта-Клауса.
shop.christmas_offer_present.title = Рождественский подарок
shop.christmas_offer_present.desc = Упакован Элси. Открой и посмотри, что внутри.
shop.christmas_offer_christmas_wand.title = Рождественская палочка
shop.christmas_offer_christmas_wand.desc = Направь её на друга, чтобы нарядить его эльфом или оленем.
shop.christmas_offer_santa_suit.title = Наряд Санта-Клауса
shop.christmas_offer_santa_suit.desc = Надень его, и ты на какое-то время Санта-Клаус.
shop.christmas_offer_christmas_gloves.title = Рождественские перчатки
shop.christmas_offer_christmas_gloves.desc = Тёплые перчатки, часть Рождественского комплекта. Надень весь комплект, и ты быстрее поднимешься в Списке хороших Санта-Клауса.
shop.christmas_offer_christmas_hat.title = Рождественская шапка
shop.christmas_offer_christmas_hat.desc = Тёплая шапка, часть Рождественского комплекта. Надень весь комплект, и ты быстрее поднимешься в Списке хороших Санта-Клауса.
shop.christmas_offer_christmas_trousers.title = Рождественские штаны
shop.christmas_offer_christmas_trousers.desc = Тёплые штаны для снега, часть Рождественского комплекта. Надень весь комплект, и ты быстрее поднимешься в Списке хороших Санта-Клауса.
shop.christmas_offer_christmas_coat.title = Рождественское пальто
shop.christmas_offer_christmas_coat.desc = Тёплое пальто, последняя часть Рождественского комплекта. Надень весь комплект, и ты быстрее поднимешься в Списке хороших Санта-Клауса.
shop.christmas_offer_snowballs_daily.title = Бесплатные снежки
shop.christmas_offer_snowballs_daily.desc = Связка снежков от Брэма, бесплатно раз в день.
shop.christmas_offer_snowballs.title = Снежки
shop.christmas_offer_snowballs.desc = Ещё одна связка, когда бесплатные кончились.
shop.christmas_offer_stocking.title = Носок Санта-Клауса
shop.christmas_offer_stocking.desc = Бесплатно раз в день. Запусти руку и посмотри, что оставил тебе Санта-Клаус.

# ---- The Christmas Set ----
# A set's notice is a toast, so no value carries markup.
gearset.christmas_set.title = Рождественский комплект
gearset.christmas_set.tier_half = Половина комплекта надета: немного больше здоровья.
gearset.christmas_set.tier_full = Весь комплект надет: ещё больше здоровья, холод кусает слабее, и ты быстрее поднимаешься в Списке хороших Санта-Клауса.

# ---- Santa's conversation ----
dialogue.christmas_santa.off_season.text = Рождество закончилось, и мои сани собраны в дорогу домой.\nНайди меня снова следующей зимой.
dialogue.christmas_santa.off_season.opt.farewell = До свидания, Санта-Клаус.
dialogue.christmas_santa.first_words.text = Хо-хо-хо. Вот и ты.\nЯ Санта-Клаус, и мне нужна помощь. Трорки в колпаках Санта-Клауса ограбили мои сани и убежали с подарками. Лови <b>Похитителей подарков</b> ночью в <b>Emerald Wilds</b> или в любое время в снегах <b>Whisperfrost Frontiers</b> и верни мои подарки.
dialogue.christmas_santa.first_words.opt.hail = Я помогу, Санта-Клаус.
dialogue.christmas_santa.daily_word.text = Опять пришёл? Хорошо. Это ещё один день в моём <b>Списке хороших</b>.\nВоры всё ещё где-то там. Приглядывай сегодня ночью за лесом.
dialogue.christmas_santa.menu.text = Ну что ж. Чем могу помочь?
dialogue.christmas_santa.who_are_you.text = Я Санта-Клаус. Каждое Рождество я приношу подарки всем в Орбисе.\nВ этом году у меня есть помощники. Томас печёт, Элси упаковывает подарки и шьёт, а Брэм снабжает всех снежками.
dialogue.christmas_santa.about_thieves.text = Это трорки в колпаках Санта-Клауса, и дерутся они только кулаками, так что тебе они не соперники.\nИщи их ночью в лесах и на полях <b>Emerald Wilds</b> или в любое время в снегах <b>Whisperfrost Frontiers</b>. У многих всё ещё есть подарок. Открой его, и он твой.
dialogue.christmas_santa.helpers.text = <b>Томас</b> и <b>Элси</b> держат свои лавки прямо здесь, рядом со мной. Пока идёт пир Марты, они помогают ей у <b>деревни квибеков</b> в конце дороги.\n<b>Брэм</b> на лугу, на полпути по дороге от того места, где ты вошёл.
dialogue.christmas_santa.opt.shop = Покажи свою лавку.
dialogue.christmas_santa.opt.standing = Как у меня дела в твоём списке?
dialogue.christmas_santa.opt.thieves = Где воры?
dialogue.christmas_santa.opt.helpers = Где твои помощники?
dialogue.christmas_santa.opt.who = Кто ты?
dialogue.christmas_santa.opt.back = Другое.
dialogue.christmas_santa.opt.farewell = С Рождеством, Санта-Клаус.
dialogue.christmas_santa.opt.returned = Я вернулся.
dialogue.christmas_santa.opt.quests = Что нужно сделать?
dialogue.christmas_santa.opt.almanac = Покажи Альманах.
dialogue.christmas_santa.opt.story = Чем я могу помочь?
dialogue.christmas_santa.meet_arrival.text = Хо-хо-хо. Ты меня нашёл.\nЯ Санта-Клаус, и мне нужна помощь. Трорки в колпаках Санта-Клауса ограбили мои сани на дороге и убежали с подарками. Давай вернём их.
dialogue.christmas_santa.meet_arrival.opt.hail = Я помогу, Санта-Клаус.
dialogue.christmas_santa.morning_arrival.text = С Рождеством. Загляни под мою ёлку.\nТам лежит подарок с твоим именем.
dialogue.christmas_santa.morning_arrival.opt.open = Для меня?
dialogue.christmas_santa.daily_word_story_done.text = Опять пришёл? Хорошо. Это ещё один день в моём <b>Списке хороших</b>.\nСани собраны, так что моя история до следующего Рождества закончена. Но каждый день у меня есть <b>работы</b>, <b>Похитители подарков</b> всё ещё где-то там, и <b>лавки</b> открыты.
dialogue.christmas_santa.story_done.text = Сани собраны, и это твоя заслуга.\nМоя история до следующего Рождества закончена, но дел ещё хватает. Заходи каждый день за моими <b>работами</b>, лови дальше <b>Похитителей подарков</b> и смотри, что нового в <b>лавках</b>.
dialogue.christmas_santa.story.text = Сначала поймай для меня <b>Похитителей подарков</b>. Потом <b>Брэму</b> нужна морковь для оленей, <b>Томасу</b> нужна помощь с пряниками, а <b>Элси</b> нужна помощь с упаковкой. После этого возвращайся ко мне за <b>Сочельником</b>.\nКаждый день у меня есть и другие работы. Спроси, что нужно сделать.
dialogue.christmas_santa.thieves_offer.text = Эти воры всё ещё держат мои подарки. Поймай для меня несколько <b>Похитителей подарков</b>.\nОни выходят ночью в лесах и на полях <b>Emerald Wilds</b>, а в снегах <b>Whisperfrost Frontiers</b> бродят весь день. Засчитывается любой пойманный трорк.
dialogue.christmas_santa.thieves_offer.opt.accept = Я их поймаю.
dialogue.christmas_santa.thieves_brief.text = Ищи их ночью в <b>Emerald Wilds</b> или в любое время в снегах <b>Whisperfrost Frontiers</b>. Засчитывается любой трорк.\nВозвращайся ко мне, когда поймаешь достаточно.
dialogue.christmas_santa.thieves_ready.text = Ты их поймал. У одного из них нашлось вот это. Открой или подари другу.\nТеперь об оленях <b>Брэма</b>: они голодные. Он на <b>лугу</b>, на полпути по дороге от того места, где ты вошёл.
dialogue.christmas_santa.thieves_ready.opt.turnin = Вот, держи.
dialogue.christmas_santa.eve_offer.text = Скоро <b>Сочельник</b>, а сани ещё не полны.\nПринеси мне <b>пряничных человечков</b> для мешка и <b>морковь</b> для оленей. И дай мне <b>Рождественский подарок</b> для саней.
dialogue.christmas_santa.eve_offer.opt.accept = Давай наполним сани.
dialogue.christmas_santa.eve_brief.text = <b>Пряничные человечки</b> в мешок и <b>морковь</b> для оленей. Неси их сюда.\nЧто до подарка, держи его в руке, смотри на меня и щёлкни левой кнопкой.
dialogue.christmas_santa.eve_ready.text = Вот теперь сани полны. Хо-хо-хо.\nЭта игрушка тебе. Повесь её там, где будешь видеть её каждое Рождество.
dialogue.christmas_santa.eve_ready.opt.turnin = С Рождеством, Санта-Клаус.
dialogue.christmas_santa.carols_offer.text = Ничто не греет холодный храм, как рождественская песня.\nСпой её <b>людям вокруг Забытого храма</b>, потом приди и расскажи, как всё прошло. Только не мне. Я все слова знаю.
dialogue.christmas_santa.carols_offer.opt.accept = Пойду петь.
dialogue.christmas_santa.carols_brief.text = Поговори с людьми вокруг храма и выбери <b>Спеть песню</b>. Мои помощники - хорошее начало.\nКаждый послушает раз в день.
dialogue.christmas_santa.carols_ready.text = Я слышал тебя отсюда. Совсем неплохо.
dialogue.christmas_santa.carols_ready.opt.turnin = Все подпевали.
dialogue.christmas_santa.daily_thieves_offer.text = Эти трорки взялись за старое.\nПоймаешь сегодня ещё несколько <b>Похитителей подарков</b> для меня?
dialogue.christmas_santa.daily_thieves_offer.opt.accept = Я их поймаю.
dialogue.christmas_santa.daily_presents_offer.text = Мои помощники много трудятся.\nПодари каждому из них сегодня <b>Рождественский подарок</b>. Держи его в руке, смотри на них и щёлкни левой кнопкой.
dialogue.christmas_santa.daily_presents_offer.opt.accept = Я всё раздам.
dialogue.christmas_santa.presents_brief.text = Подари <b>Рождественский подарок</b> <b>Томасу</b>, <b>Элси</b> и <b>Брэму</b>. Держи его в руке, смотри на них и щёлкни левой кнопкой.\nПодарки выпадают из воров, а <b>Элси</b> их продаёт.
dialogue.christmas_santa.extra_thieves_ready.text = Ещё воры пойманы. Мой список с каждым днём длиннее.
dialogue.christmas_santa.extra_thieves_ready.opt.turnin = Вот мой счёт.
dialogue.christmas_santa.ready_generic.text = Уже готово? Посмотрим.
dialogue.christmas_santa.ready_generic.opt.turnin = Готово.

# ---- Santa's helpers: Tomas the Miller, Elsie the Weaver and Bram the Shepherd ----
dialogue.christmas_feast_line.opt.stall = Что у тебя в рождественской лавке?
dialogue.christmas_feast_line.opt.quests = Есть для меня рождественская работа?
dialogue.christmas_carol.opt.sing = Спеть песню
dialogue.christmas_miller.off_season.text = Рождество закончилось, и печь остыла.\nУвидимся, когда вернётся снег.
dialogue.christmas_miller.off_season.opt.farewell = До следующей зимы.
dialogue.christmas_miller.greeting.text = С Рождеством. Санта-Клаусу нужны пряники в мешок, так что я перенёс печь с мельницы сюда.\nЯ продаю рецепты <b>пряничных человечков</b>, <b>Горячего какао</b> и <b>Рождественского рулета</b>.
dialogue.christmas_miller.dough.text = Смели <b>пшеницу</b> в <b>муку</b> на <b>Кухонной плите</b>, потом смешай муку с <b>яйцами</b> и <b>кружкой воды</b> на той же плите.\nНет времени? Я каждый день продаю немного теста.
dialogue.christmas_miller.why.text = Трорки ограбили сани Санта-Клауса на дороге, и он попросил деревню о помощи. Элси и Брэм тоже пришли.\nКому-то надо кормить старика.
dialogue.christmas_miller.opt.stall = Что ты продаёшь?
dialogue.christmas_miller.opt.dough = Как сделать тесто?
dialogue.christmas_miller.opt.why = Зачем ты здесь?
dialogue.christmas_miller.opt.thanks = Спасибо, Томас.
dialogue.christmas_miller.opt.back = Это хорошо с твоей стороны.
dialogue.christmas_miller.opt.farewell = С Рождеством, Томас.
dialogue.christmas_miller.opt.quests = Есть для меня работа?
dialogue.christmas_miller.opt.later = Сейчас не могу.
dialogue.christmas_miller.next_elsie.text = Мешок Санта-Клауса сам не наполнится. <b>Элси</b> нужна помощь с упаковкой.\nЕё лавка прямо здесь, рядом с Санта-Клаусом. Пока идёт пир Марты, она на дальней стороне <b>деревни квибеков</b>.
dialogue.christmas_miller.cookies_offer.text = Брэм передал тебе мой рецепт? Хорошо. Санта-Клаус хочет пряников в мешок.\nВыучи рецепт, испеки <b>пряничного человечка</b> и принеси сюда. Хочу посмотреть, что получилось.
dialogue.christmas_miller.cookies_offer.opt.accept = Испеку один.
dialogue.christmas_miller.cookies_brief.text = Выучи рецепт, потом испеки <b>пряничного человечка</b> и принеси мне одного.\nНе замешивал тесто никогда? Спроси меня как.
dialogue.christmas_miller.cookies_ready.text = Вот это настоящий пряничный человечек. И пахнет как надо.\nПеки дальше. До Сочельника Санта-Клаусу понадобится ещё много.
dialogue.christmas_miller.cookies_ready.opt.turnin = Вот, попробуй.
dialogue.christmas_miller.baking_offer.text = Моя печь ест тесто быстрее, чем я его замешиваю.\nПринесёшь мне сегодня немного <b>теста</b>?
dialogue.christmas_miller.baking_offer.opt.accept = Принесу тесто.
dialogue.christmas_miller.baking_brief.text = Принеси мне <b>тесто</b>.\nНе делал его никогда? Спроси меня как.
dialogue.christmas_miller.baking_ready.text = Свежее тесто. Печь уже заждалась.
dialogue.christmas_miller.baking_ready.opt.turnin = Вот тесто.
dialogue.christmas_weaver.off_season.text = Рождество закончилось, и ленты убраны.\nНайди меня следующей зимой. К тому времени у меня будут упакованы новые подарки.
dialogue.christmas_weaver.off_season.opt.farewell = Я тебя найду.
dialogue.christmas_weaver.greeting.text = С Рождеством. Воры оставили подарки Санта-Клауса порванными и грязными, так что я упаковываю каждый заново.\nЯ продаю <b>Рождественские подарки</b>, <b>Рождественскую палочку</b>, <b>Наряд Санта-Клауса</b> и <b>Рождественский комплект</b>. Чем выше ты в <b>Списке хороших</b> Санта-Клауса, тем больше я могу тебе продать.
dialogue.christmas_weaver.presents.text = Щёлкни правой кнопкой по подарку, чтобы открыть его. Внутри всегда что-то есть, а иногда и что-то чудесное.\nИли подари его: держи в руке, смотри на друга и щёлкни левой кнопкой. Друг получит подарок лучше, чем достался бы тебе, а Санта-Клаус заметит. Если Санта-Клаус или кто-то из нас просит подарок, передай его так же.\nУ <b>Похитителей подарков</b> их много. Найдёшь их ночью в <b>Emerald Wilds</b>.
dialogue.christmas_weaver.why.text = Санта-Клаус попросил деревню о помощи, вот я и здесь. Кому-то надо упаковать всё это.\nИ кому-то надо сшить ему новое пальто. Трорки утащили и запасное.
dialogue.christmas_weaver.opt.stall = Покажи, что у тебя есть.
dialogue.christmas_weaver.opt.presents = Что мне делать с подарком?
dialogue.christmas_weaver.opt.why = Зачем ты здесь?
dialogue.christmas_weaver.opt.thanks = Спасибо, Элси.
dialogue.christmas_weaver.opt.back = Столько упаковки.
dialogue.christmas_weaver.opt.farewell = С Рождеством, Элси.
dialogue.christmas_weaver.opt.quests = Могу я помочь?
dialogue.christmas_weaver.opt.later = Сейчас не могу.
dialogue.christmas_weaver.next_santa.text = У Санта-Клауса есть для тебя ещё одно дело до <b>Сочельника</b>.\nЗайди к нему у его ёлки.
dialogue.christmas_weaver.wrapping_offer.text = У меня кончается лента, а подарки сами себя не упакуют.\nПринеси мне <b>Растительное волокно</b>. И отнеси один из своих подарков <b>Брэму</b>. У него была тяжёлая неделя.
dialogue.christmas_weaver.wrapping_offer.opt.accept = Я помогу.
dialogue.christmas_weaver.wrapping_brief.text = Принеси мне <b>Растительное волокно</b>.\nПотом подари <b>Брэму</b> <b>Рождественский подарок</b>: держи его в руке, смотри на него и щёлкни левой кнопкой. Он на <b>лугу</b> на полпути по дороге. Нет подарка? Я их продаю.
dialogue.christmas_weaver.wrapping_ready.text = Ленты теперь на много дней, а Брэм всё ещё улыбается своему подарку.\nЭти три тебе. А Санта-Клаусу пригодился бы ещё один эльф, так что замри.
dialogue.christmas_weaver.wrapping_ready.opt.turnin = Спасибо, Элси.
dialogue.christmas_weaver.fibre_offer.text = У меня опять кончилась лента.\nПринеси мне сегодня <b>Растительное волокно</b>, и я упакую для тебя два подарка.
dialogue.christmas_weaver.fibre_offer.opt.accept = Принесу немного.
dialogue.christmas_weaver.fibre_brief.text = Принеси мне <b>Растительное волокно</b>.
dialogue.christmas_weaver.fibre_ready.text = Хорошие длинные пряди. Вот, два подарка, упакованные сегодня утром.
dialogue.christmas_weaver.fibre_ready.opt.turnin = Вот волокно.
dialogue.christmas_shepherd.off_season.text = Рождество кончилось. Я обратно на холм.
dialogue.christmas_shepherd.off_season.opt.farewell = Доброй дороги домой.
dialogue.christmas_shepherd.greeting.text = С Рождеством. Сани Санта-Клауса ограбили, так что я спустился помочь.\nЯ раздаю <b>снежки</b>, по связке в день бесплатно. Попади кому-нибудь, и он на миг замедлится. Не больно.
dialogue.christmas_shepherd.thieves.text = Трорки в колпаках Санта-Клауса. Выходят ночью в <b>лесах</b> и на <b>полях</b> <b>Emerald Wilds</b>.\nВ снегах <b>Whisperfrost Frontiers</b> они бродят весь день. Сперва кинь в такого снежок. Сразу замедлится.
dialogue.christmas_shepherd.why.text = Кому-то надо, чтобы снег не кончался.\nА Санта-Клаус попросил по-хорошему.
dialogue.christmas_shepherd.opt.stall = Снежки есть?
dialogue.christmas_shepherd.opt.thieves = Где воры?
dialogue.christmas_shepherd.opt.why = Зачем ты здесь?
dialogue.christmas_shepherd.opt.thanks = Спасибо, Брэм.
dialogue.christmas_shepherd.opt.back = Справедливо.
dialogue.christmas_shepherd.opt.farewell = С Рождеством, Брэм.
dialogue.christmas_shepherd.opt.quests = Нужна помощь?
dialogue.christmas_shepherd.opt.later = Сейчас не могу.
dialogue.christmas_shepherd.next_tomas.text = Теперь <b>Томас</b> ждёт тебя на кухне.\nЕго лавка рядом с Санта-Клаусом. Пока идёт пир Марты, он там, где дорога выходит к <b>деревне квибеков</b>.
dialogue.christmas_shepherd.reindeer_offer.text = Олени Санта-Клауса не ели с тех пор, как трорки напали на сани.\nПринеси мне <b>морковь</b>.
dialogue.christmas_shepherd.reindeer_offer.opt.accept = Найду морковь.
dialogue.christmas_shepherd.reindeer_brief.text = <b>Морковь</b> для оленей. Неси сюда.
dialogue.christmas_shepherd.reindeer_ready.text = Теперь они полетят. Вот снежки за труды.\nИ Томас оставил у меня вот это для тебя. Его рецепт пряников, с щепоткой теста и специй.
dialogue.christmas_shepherd.reindeer_ready.opt.turnin = Спасибо, Брэм.
dialogue.christmas_shepherd.carrots_offer.text = Олени едят весь день.\nПринесёшь ещё <b>моркови</b>? Добавлю снежков.
dialogue.christmas_shepherd.carrots_offer.opt.accept = Принесу морковь.
dialogue.christmas_shepherd.carrots_brief.text = Ещё <b>моркови</b>. Неси сюда.
dialogue.christmas_shepherd.carrots_ready.text = Хорошая морковь. Олени за неё передерутся.
dialogue.christmas_shepherd.carrots_ready.opt.turnin = Держи.

# ---- Santa's story, the dailies and the carol tour ----
quest.christmas_santa_meet.title = Знакомство с Санта-Клаусом
quest.christmas_santa_meet.flavor = Трорки ограбили мои сани, и мне нужна помощь. Я у своей ёлки в Забытом храме. Туда ведут любые Врата забытого храма.
objective.christmas.meet_santa = Найдите Санта-Клауса в Забытом храме
quest.christmas_present_thieves.title = Похитители подарков
quest.christmas_present_thieves.flavor = Трорки в колпаках Санта-Клауса убежали с моими подарками. Лови их ночью в Emerald Wilds или в любое время в снегах Whisperfrost Frontiers, потом возвращайся ко мне.
objective.christmas.catch_thieves = Поймайте {0} {0, plural, one {Похитителя подарков} few {Похитителей подарков} many {Похитителей подарков} other {Похитителя подарков}}
quest.christmas_reindeer_food.title = Корм для оленей
quest.christmas_reindeer_food.flavor = Олени Санта-Клауса не ели с тех пор, как ограбили сани. Принеси мне морковь. Я на лугу.
objective.christmas.bring_bram_carrots = Принесите Брэму {0} {0, plural, one {морковь} few {моркови} many {морковей} other {моркови}}
quest.christmas_gingerbread_cookies.title = Рождественские пряники
quest.christmas_gingerbread_cookies.flavor = В мешок Санта-Клауса нужны пряники. Выучи мой рецепт, испеки пряничного человечка и принеси мне к ёлке Санта-Клауса.
objective.christmas.bring_tomas_cookie = Принесите Томасу пряничного человечка
quest.christmas_wrapping_presents.title = Упаковка подарков
quest.christmas_wrapping_presents.flavor = Мне нужно Растительное волокно для ленты, так что принеси мне его. И подари один из своих подарков Брэму на лугу. У него была тяжёлая неделя.
objective.christmas.bring_elsie_fibre = Принесите Элси растительного волокна: {0}
objective.christmas.give_bram_present = Подарите Брэму Рождественский подарок
quest.christmas_eve.title = Сочельник
quest.christmas_eve.flavor = Сани отправляются сегодня ночью. Принеси мне пряничных человечков для мешка и морковь для оленей и дай мне Рождественский подарок для саней.
objective.christmas.bring_santa_cookies = Принесите Санта-Клаусу {0} {0, plural, one {пряничного человечка} few {пряничных человечков} many {пряничных человечков} other {пряничного человечка}}
objective.christmas.bring_santa_carrots = Принесите Санта-Клаусу {0} {0, plural, one {морковь} few {моркови} many {морковей} other {моркови}}
objective.christmas.give_santa_present = Подарите Санта-Клаусу Рождественский подарок
quest.christmas_morning.title = Рождественское утро
quest.christmas_morning.flavor = С Рождеством. Под моей ёлкой в Забытом храме лежит подарок с твоим именем. Приди и открой его.
objective.christmas.morning = Откройте свой подарок под ёлкой Санта-Клауса
quest.christmas_daily_thieves.title = Воры на день
quest.christmas_daily_thieves.flavor = Эти трорки взялись за старое. Поймай сегодня ночью ещё несколько Похитителей подарков в Emerald Wilds, потом возвращайся ко мне.
quest.christmas_daily_presents.title = Подарки на день
quest.christmas_daily_presents.flavor = Мои помощники много трудятся. Подари Томасу, Элси и Брэму по Рождественскому подарку сегодня. Держи его в руке, смотри на них и щёлкни левой кнопкой.
objective.christmas.give_tomas_present = Подарите Томасу Рождественский подарок
objective.christmas.give_elsie_present = Подарите Элси Рождественский подарок
quest.christmas_daily_baking.title = Выпечка на день
quest.christmas_daily_baking.flavor = Моя печь ест тесто быстрее, чем я его замешиваю. Принеси мне немного.
objective.christmas.bring_tomas_dough = Принесите Томасу теста: {0}
quest.christmas_daily_wrapping.title = Упаковка на день
quest.christmas_daily_wrapping.flavor = У меня опять кончилась лента. Принеси мне Растительное волокно, и я упакую для тебя два подарка.
quest.christmas_daily_carrots.title = Морковь на день
quest.christmas_daily_carrots.flavor = Олени едят весь день. Принеси мне морковь, и я добавлю снежков.
quest.christmas_extra_thieves.title = Лишние воры
quest.christmas_extra_thieves.flavor = Я возьму всех воров, каких сумеешь поймать. Ищи их ночью в Emerald Wilds или в любое время в снегах Whisperfrost Frontiers, потом возвращайся ко мне. Делай это, сколько захочешь.
quest.christmas_carols.title = Рождественские песни
quest.christmas_carols.flavor = Ничто не греет холодный храм, как рождественская песня. Спой её людям вокруг Забытого храма, потом приди и расскажи, как всё прошло.
objective.christmas.sing_carols = Спойте песню {0} {0, plural, one {человеку} few {людям} many {людям} other {человека}}

# ---- The Christmas Board ----
board.christmas_daily.title = Рождественская доска
board.christmas_daily.desc = Работа на улице и работа в мастерской, каждое утро новая. Чем выше ты в моём Списке хороших, тем больше я выкладываю. Забирай плату, пока сани не уехали. Опоздаешь, и она дождётся тебя в Книге квестов.
board.christmas_daily.grade.outdoor = Работа на улице
board.christmas_daily.grade.workshop = Работа в мастерской
quest.christmas_board_thieves.title = Заказ на воров
