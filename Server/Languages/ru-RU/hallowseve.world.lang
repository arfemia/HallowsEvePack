# Пак «Канун Всех Святых» - слова календаря (как называется каждое событие и его баннеры) и
# уведомления о находках. Ключи пишутся без префикса: библиотека находит каждый по его окончанию, как бы
# ни назывался этот файл. Баннеры и уведомления печатают разметку как текст, поэтому ни одно из этих значений её не содержит.

# ---- Канун Всех Святых ----
calendar.hallows_eve.name = Канун Всех Святых
calendar.hallows_eve.flavor = Старый Джек обосновывается в Забытом храме, а по ночам бродят мертвецы.
calendar.hallows_eve.herald.start = Канун Всех Святых
calendar.hallows_eve.herald.start.sub = Старый Джек ждёт у Забытого храма.
calendar.hallows_eve.herald.end = Канун Всех Святых окончен
calendar.hallows_eve.herald.end.sub = Фонари гаснут до следующей осени.

# ---- Урожайная луна ----
calendar.harvest_moon.name = Урожайная луна
calendar.harvest_moon.flavor = Луна висит полная и оранжевая, и всё больше мертвецов вылезает на неё поглядеть.
calendar.harvest_moon.herald.start = Урожайная луна
calendar.harvest_moon.herald.start.sub = Этой ночью мертвецам неспокойно. Не гасите фонарь.
calendar.harvest_moon.herald.end = Урожайная луна заходит
calendar.harvest_moon.herald.end.sub = Ночи снова затихают.

# ---- Находки ----
notify.hallows_eve_geode_found = Проклятая жеода, прямо среди обломков.

# ---- Бой со Всадником без головы ----
notify.hallows_eve_horseman_unhorsed = Всадника выбросило из седла!
notify.hallows_eve_horseman_head_off = Его голова слетает! Рубите её, и его снова можно ранить.
notify.hallows_eve_horseman_head_down = Голова падает. Рубите его!
notify.hallows_eve_horseman_head_returned = Голова возвращается к нему, и его раны закрываются.
notify.hallows_eve_horseman_wrath = Всадник горит яростью!
notify.hallows_eve_horseman_engaged = Всадник без головы скачет!
notify.hallows_eve_horseman_engaged.sub = Не стойте на светящихся кругах. Когда его голова слетит, рубите её.
notify.hallows_eve_horseman_defeated = Всадник без головы пал!
notify.hallows_eve_horseman_wiped = Всадник скачет дальше.
notify.hallows_eve_horseman_wiped.sub = Рубите его голову, когда она слетит. Пока она на свободе, его не ранить, а если она вернётся к нему, он исцелится.
claim.hallows_eve_horseman_chase = Клад Всадника
claim.hallows_eve_horseman_chase_hard = Клад Всадника (сложный)
dungeon.hallows_eve_graveyard.name = Кладбище Всадника
dungeon.hallows_eve_graveyard.description = Кладбище за стеной, где по ночам скачет Всадник без головы. Приведите друзей.
dungeon.hallows_eve_graveyard.goal = Убейте четырёх Скелетов-Джеков у фонтана, чтобы разбудить Всадника без головы, а затем одолейте его. Когда его голова слетит, рубите её, иначе его не ранить.
dungeon.hallows_eve_graveyard_hard.name = Кладбище Всадника (сложное)
dungeon.hallows_eve_graveyard_hard.description = Всадник без головы скачет здесь яростнее и роняет то, чего не роняет нигде больше. Приведите больше друзей.
dungeon.hallows_eve_graveyard_hard.goal = Отбейтесь от волн скелетов у фонтана, чтобы разбудить Всадника без головы, а затем одолейте его на сложной скачке. Когда его голова слетит, срубите её, иначе его не ранить.
dungeon.hallows_eve_graveyard.cost_hint = Старый Джек продаёт Могильные свечи в своей лавке в Забытом храме, когда сочтёт вас Завсегдатаем.
dungeon.hallows_eve_graveyard_hard.cost_hint = Старый Джек продаёт Пылающие могильные свечи в своей лавке в Забытом храме, когда сочтёт вас Доверенным.
dungeon.hallows_eve_graveyard.confirm = Зажечь свечу
dungeon.hallows_eve_graveyard.chest = Ваша награда ждёт в сундуке, где он пал.
