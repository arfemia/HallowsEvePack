# Harvest Feast - the calendar's words (what the feast is called, and its banners) and the notice for
# a find. Keys are written bare: the library finds each one by its tail, whatever this file is called.
# Banners and notices print markup as text, so none of these values carries any.

# ---- Harvest Feast ----
calendar.harvest_feast.name = Праздник урожая
calendar.harvest_feast.flavor = Поля убраны, и в Забытом Храме накрывают длинный стол.
calendar.harvest_feast.herald.start = Праздник урожая
calendar.harvest_feast.herald.start.sub = Марта-повариха накрывает на стол в Забытом Храме.
calendar.harvest_feast.herald.end = Праздник урожая закончился
calendar.harvest_feast.herald.end.sub = Стол убран до следующего года.

# ---- Finds ----
notify.harvest_feast_spice_found = Щепотка специй, спрятанная в тыкве.

# ---- Costumes ----
# A costume's buff-bar tile name. Its effect's Name is this key in full
# (harvestfeast.world.effect...), because the client reads an effect's Name exactly as written.
effect.harvest_feast_costume_turkey.name = Костюм индюка
