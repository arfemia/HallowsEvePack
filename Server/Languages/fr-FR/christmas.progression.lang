# Christmas progression: the season's currency, Santa's Nice List and Santa's Sack, the four Christmas
# stalls and their offers, the Christmas Set, the present's gift, Santa's conversation, the Christmas
# conversations of Tomas, Elsie and Bram, and the Christmas line their feast conversations gain.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. Numbers
# ride {0} and come from the content files, so a retune never touches a translation.

# ---- Christmas Coins ----
currency.christmas_coins.name = Pièces de Noël
currency.christmas_coins.amount = {0, number} {0, plural, one {Pièce de Noël} other {Pièces de Noël}}
currency.christmas_coins.description = À dépenser dans les boutiques de Noël, dans le Temple de l'Oubli.

# ---- Santa's Nice List ----
reputation.christmas_nice_list.name = Liste des gentils du Père Noël
reputation.christmas_nice_list.flavor = Le Père Noël la vérifie deux fois. Aidez-le à retrouver ses cadeaux et vous y montez.
reputation.christmas_nice_list.rank.neutral = Nouveau venu
reputation.christmas_nice_list.rank.friendly = Sur la liste
reputation.christmas_nice_list.rank.honored = Gentil
reputation.christmas_nice_list.rank.revered = Très gentil
reputation.christmas_nice_list.rank.exalted = Chouchou du Père Noël
reputation.christmas_nice_list.earn.quests = Aidez le Père Noël, Tomas, Elsie et Bram dans le Temple de l'Oubli avec leurs quêtes de Noël et leurs tâches du jour.
reputation.christmas_nice_list.earn.board = Prenez des tâches sur le Tableau de Noël. Demandez au Père Noël ce qu'il y a à faire.
reputation.christmas_nice_list.earn.thieves = Attrapez des Voleurs de cadeaux la nuit dans les Emerald Wilds, ou à toute heure dans la neige des Whisperfrost Frontiers. Les autres Trorks comptent un peu pendant Noël.
reputation.christmas_nice_list.earn.presents = Offrez un Cadeau de Noël à un ami : tenez-le, regardez-le et faites un clic gauche.
reputation.christmas_nice_list.earn.carols = Chantez un chant de Noël à n'importe qui dans le temple, une fois par jour chacun.
reputation.christmas_nice_list.earn.yeti = Battez le Yéti dans la Grotte du Yéti. Bram, dans la prairie, vous y emmène. Votre première victoire de la journée compte le plus.
reputation.christmas_nice_list.earn.talk = Passez dire un mot au Père Noël une fois par jour.
reputation.christmas_nice_list.earn.gear = Portez la Panoplie de Noël de la boutique d'Elsie, ou mangez un Gâteau de Noël, et vous montez plus vite.
lootable.christmas_santas_sack.title = Hotte du Père Noël
lootable.christmas_santas_sack.flavor = Le Père Noël vous en prépare une chaque fois que vous montez d'un cran de plus au-delà de Chouchou du Père Noël.
lootable.christmas_present_gift.title = Cadeau de Noël
lootable.christmas_present_gift.flavor = Quelques pièces et une petite surprise.
lootable.christmas_present_given.title = Un cadeau d'un ami
lootable.christmas_present_given.flavor = Quelqu'un vous l'a offert. C'est mieux que d'ouvrir le sien.
lootable.christmas_stocking.title = Chaussette du Père Noël
lootable.christmas_stocking.flavor = Une friandise et un peu d'argent de poche, et de temps en temps un cadeau.

# ---- The Christmas stalls ----
shop.christmas_santa.title = Boutique du Père Noël
shop.christmas_santa.desc = Des paquets pour emballer vos propres cadeaux, et des sucres d'orge pour la marche froide du retour.
shop.christmas_santa.category.packets = Paquets de Noël
shop.christmas_santa.category.treats = Friandises
shop.christmas_miller.title = Boulangerie de Tomas
shop.christmas_miller.desc = Les recettes de tout ce que je cuis pour le Père Noël, et de la pâte fraîche si vous êtes pressé.
shop.christmas_miller.category.kitchen = Cuisine
shop.christmas_weaver.title = Boutique d'Elsie
shop.christmas_weaver.desc = Des cadeaux que j'ai emballés moi-même, un peu de magie, et des vêtements chauds pour la neige.
shop.christmas_weaver.category.gifts = Cadeaux
shop.christmas_weaver.category.clothes = Vêtements
shop.christmas_shepherd.title = Boules de neige de Bram
shop.christmas_shepherd.desc = Bien tassées. Faites attention à qui vous les lancez.
shop.christmas_shepherd.category.snow = Neige
shop.christmas_offer_recipe_gingerbread_cookie.title = Recette du biscuit au pain d'épices
shop.christmas_offer_recipe_gingerbread_cookie.desc = À cuire sur une Cuisinière du chef avec de la pâte et des épices. Ils vous donnent du ressort.
shop.christmas_offer_recipe_hot_cocoa.title = Recette du chocolat chaud
shop.christmas_offer_recipe_hot_cocoa.desc = À préparer sur une Cuisinière du chef. Il garde le froid dehors et votre santé revient.
shop.christmas_offer_recipe_cake.title = Recette du gâteau de Noël
shop.christmas_offer_recipe_cake.desc = Le meilleur de la table. Il fait tout ce que font les biscuits et le chocolat, et vous montez plus vite sur la Liste des gentils tant que l'effet dure.
shop.christmas_offer_present.title = Cadeau de Noël
shop.christmas_offer_present.desc = Emballé par Elsie. Ouvrez-le pour voir ce qu'il y a dedans.
shop.christmas_offer_christmas_wand.title = Baguette de Noël
shop.christmas_offer_christmas_wand.desc = Pointez-la sur un ami pour le déguiser en elfe ou en renne.
shop.christmas_offer_santa_suit.title = Tenue de Père Noël
shop.christmas_offer_santa_suit.desc = Enfilez-la et vous voilà Père Noël pour un moment.
shop.christmas_offer_christmas_gloves.title = Gants de Noël
shop.christmas_offer_christmas_gloves.desc = Des gants chauds, qui font partie de la Panoplie de Noël. Portez toute la panoplie et vous montez plus vite sur la Liste des gentils.
shop.christmas_offer_christmas_hat.title = Bonnet de Noël
shop.christmas_offer_christmas_hat.desc = Un bonnet chaud, qui fait partie de la Panoplie de Noël. Portez toute la panoplie et vous montez plus vite sur la Liste des gentils.
shop.christmas_offer_christmas_trousers.title = Pantalon de Noël
shop.christmas_offer_christmas_trousers.desc = Un pantalon chaud pour la neige, qui fait partie de la Panoplie de Noël. Portez toute la panoplie et vous montez plus vite sur la Liste des gentils.
shop.christmas_offer_christmas_coat.title = Manteau de Noël
shop.christmas_offer_christmas_coat.desc = Un manteau chaud, la dernière pièce de la Panoplie de Noël. Portez toute la panoplie et vous montez plus vite sur la Liste des gentils.
shop.christmas_offer_snowballs_daily.title = Boules de neige gratuites
shop.christmas_offer_snowballs_daily.desc = Un lot de boules de neige de Bram, gratuit une fois par jour.
shop.christmas_offer_snowballs.title = Boules de neige
shop.christmas_offer_snowballs.desc = Un autre lot, quand les gratuites sont épuisées.
shop.christmas_offer_stocking.title = Chaussette du Père Noël
shop.christmas_offer_stocking.desc = Gratuite une fois par jour. Plongez la main et voyez ce que le Père Noël vous a laissé.

# ---- The Christmas Set ----
# A set's notice is a toast, so no value carries markup.
gearset.christmas_set.title = Panoplie de Noël
gearset.christmas_set.tier_half = La moitié de la panoplie portée : un peu plus de santé.
gearset.christmas_set.tier_full = Toute la panoplie portée : encore plus de santé, le froid mord moins, et vous montez plus vite sur la Liste des gentils.

# ---- Santa's conversation ----
dialogue.christmas_santa.off_season.text = Noël est fini, et mon traîneau est rangé pour la maison.\nReviens me voir l'hiver prochain.
dialogue.christmas_santa.off_season.opt.farewell = Au revoir, Père Noël.
dialogue.christmas_santa.first_words.text = Ho ho ho. Te voilà.\nJe suis le Père Noël, et j'ai besoin d'un coup de main. Des Trorks en bonnet de Père Noël ont pillé mon traîneau et filé avec les cadeaux. Attrape ces <b>Voleurs de cadeaux</b> la nuit dans les <b>Emerald Wilds</b>, ou à toute heure dans la neige des <b>Whisperfrost Frontiers</b>, et rapporte-moi mes cadeaux.
dialogue.christmas_santa.first_words.opt.hail = Je vais t'aider, Père Noël.
dialogue.christmas_santa.daily_word.text = Déjà de retour ? Bien. Voilà un jour de plus sur ma <b>Liste des gentils</b>.\nLes voleurs rôdent toujours. Garde un œil sur les bois ce soir.
dialogue.christmas_santa.menu.text = Bon. Que puis-je faire pour toi ?
dialogue.christmas_santa.who_are_you.text = Je suis le Père Noël. Chaque Noël, j'apporte des cadeaux à tout le monde dans Orbis.\nCette année, j'ai de l'aide. Tomas cuit, Elsie emballe les cadeaux et coud, et Bram garde tout le monde en boules de neige.
dialogue.christmas_santa.about_thieves.text = Ce sont des Trorks en bonnet de Père Noël, et ils ne se battent qu'à coups de poing, alors ils ne font pas le poids face à toi.\nCherche la nuit dans les bois et les champs des <b>Emerald Wilds</b>, ou à toute heure dans la neige des <b>Whisperfrost Frontiers</b>. Beaucoup portent encore un cadeau. Ouvre-le, il est à toi.
dialogue.christmas_santa.helpers.text = <b>Tomas</b> et <b>Elsie</b> tiennent leurs boutiques ici, à côté de moi. Tant que la fête de Martha dure, ils l'aident près du <b>village kweebec</b>, au bout de la route.\n<b>Bram</b> est dans la prairie, à mi-chemin sur la route depuis l'endroit où tu es arrivé.
dialogue.christmas_santa.opt.shop = Montre-moi ta boutique.
dialogue.christmas_santa.opt.standing = Où j'en suis sur ta liste ?
dialogue.christmas_santa.opt.thieves = Où sont les voleurs ?
dialogue.christmas_santa.opt.helpers = Où sont tes aides ?
dialogue.christmas_santa.opt.who = Qui es-tu ?
dialogue.christmas_santa.opt.back = Autre chose.
dialogue.christmas_santa.opt.farewell = Joyeux Noël, Père Noël.
dialogue.christmas_santa.opt.returned = Me revoilà.
dialogue.christmas_santa.opt.quests = Qu'y a-t-il à faire ?
dialogue.christmas_santa.opt.almanac = Montre-moi l'Almanach.
dialogue.christmas_santa.opt.story = En quoi puis-je aider ?
dialogue.christmas_santa.meet_arrival.text = Ho ho ho. Tu m'as trouvé.\nJe suis le Père Noël, et j'ai besoin d'un coup de main. Des Trorks en bonnet de Père Noël ont pillé mon traîneau sur la route et filé avec les cadeaux. Allons les récupérer.
dialogue.christmas_santa.meet_arrival.opt.hail = Je vais t'aider, Père Noël.
dialogue.christmas_santa.morning_arrival.text = Joyeux Noël. Regarde sous mon sapin.\nIl y a un cadeau avec ton nom dessus.
dialogue.christmas_santa.morning_arrival.opt.open = Pour moi ?
dialogue.christmas_santa.daily_word_story_done.text = Déjà de retour ? Bien. Voilà un jour de plus sur ma <b>Liste des gentils</b>.\nLe traîneau est plein, alors mon histoire est finie jusqu'à Noël prochain. J'ai encore des <b>tâches</b> chaque jour, les <b>Voleurs de cadeaux</b> rôdent toujours, et les <b>boutiques</b> sont ouvertes.
dialogue.christmas_santa.story_done.text = Le traîneau est plein, et c'est grâce à toi.\nMon histoire est finie jusqu'à Noël prochain, mais il reste de quoi faire. Passe chaque jour pour mes <b>tâches</b>, continue d'attraper des <b>Voleurs de cadeaux</b>, et vois ce qu'il y a de nouveau dans les <b>boutiques</b>.
dialogue.christmas_santa.story.text = D'abord, attrape les <b>Voleurs de cadeaux</b> pour moi. Ensuite <b>Bram</b> a besoin de carottes pour les rennes, <b>Tomas</b> a besoin d'un coup de main avec les biscuits, et <b>Elsie</b> a besoin d'aide pour les emballages. Après ça, reviens me voir pour la <b>Veille de Noël</b>.\nJ'ai aussi des tâches chaque jour. Demande-moi ce qu'il y a à faire.
dialogue.christmas_santa.thieves_offer.text = Ces voleurs ont toujours mes cadeaux. Attrape-moi quelques <b>Voleurs de cadeaux</b>.\nIls sortent la nuit dans les bois et les champs des <b>Emerald Wilds</b>, et ils rôdent toute la journée dans la neige des <b>Whisperfrost Frontiers</b>. Tout Trork attrapé compte.
dialogue.christmas_santa.thieves_offer.opt.accept = Je vais les attraper.
dialogue.christmas_santa.thieves_brief.text = Cherche la nuit dans les <b>Emerald Wilds</b>, ou à toute heure dans la neige des <b>Whisperfrost Frontiers</b>. Tout Trork compte.\nReviens me voir quand tu en auras attrapé assez.
dialogue.christmas_santa.thieves_ready.text = Tu les as eus. L'un d'eux avait ceci sur lui. Ouvre-le, ou offre-le à un ami.\nMaintenant, les rennes de <b>Bram</b> ont faim. Il est dans la <b>prairie</b>, à mi-chemin sur la route depuis l'endroit où tu es arrivé.
dialogue.christmas_santa.thieves_ready.opt.turnin = Tiens.
dialogue.christmas_santa.eve_offer.text = C'est bientôt la <b>Veille de Noël</b>, et le traîneau n'est pas encore plein.\nApporte-moi des <b>Biscuits au pain d'épices</b> pour la hotte et des <b>carottes</b> pour les rennes. Et donne-moi un <b>Cadeau de Noël</b> pour le traîneau.
dialogue.christmas_santa.eve_offer.opt.accept = Remplissons le traîneau.
dialogue.christmas_santa.eve_brief.text = Des <b>Biscuits au pain d'épices</b> pour la hotte et des <b>carottes</b> pour les rennes. Apporte-les ici.\nPour le cadeau, tiens-le, regarde-moi et fais un clic gauche.
dialogue.christmas_santa.eve_ready.text = Voilà le traîneau plein. Ho ho ho.\nCette boule est pour toi. Accroche-la là où tu la verras chaque Noël.
dialogue.christmas_santa.eve_ready.opt.turnin = Joyeux Noël, Père Noël.
dialogue.christmas_santa.carols_offer.text = Rien ne réchauffe un temple froid comme un chant de Noël.\nChantes-en un à <b>des gens autour du Temple de l'Oubli</b>, puis viens me dire comment ça s'est passé. Pas à moi, attention. Je connais déjà toutes les paroles.
dialogue.christmas_santa.carols_offer.opt.accept = Je vais chanter.
dialogue.christmas_santa.carols_brief.text = Parle aux gens autour du temple et choisis <b>Chanter un chant de Noël</b>. Mes aides sont un bon début.\nChacun t'écoutera une fois par jour.
dialogue.christmas_santa.carols_ready.text = Je t'ai entendu d'ici. Pas mal du tout.
dialogue.christmas_santa.carols_ready.opt.turnin = Tout le monde a chanté avec moi.
dialogue.christmas_santa.daily_thieves_offer.text = Ces Trorks remettent ça.\nAttrape-moi encore quelques <b>Voleurs de cadeaux</b> aujourd'hui ?
dialogue.christmas_santa.daily_thieves_offer.opt.accept = Je vais les attraper.
dialogue.christmas_santa.daily_presents_offer.text = Mes aides travaillent dur.\nOffre à chacun d'eux un <b>Cadeau de Noël</b> aujourd'hui. Tiens-en un, regarde-les et fais un clic gauche.
dialogue.christmas_santa.daily_presents_offer.opt.accept = Je vais les distribuer.
dialogue.christmas_santa.presents_brief.text = Offre un <b>Cadeau de Noël</b> à <b>Tomas</b>, <b>Elsie</b> et <b>Bram</b>. Tiens-en un, regarde-les et fais un clic gauche.\nLes voleurs lâchent des cadeaux, et <b>Elsie</b> en vend.
dialogue.christmas_santa.extra_thieves_ready.text = D'autres voleurs attrapés. Ma liste s'allonge chaque jour.
dialogue.christmas_santa.extra_thieves_ready.opt.turnin = Voici mon compte.
dialogue.christmas_santa.ready_generic.text = Déjà fini ? Voyons.
dialogue.christmas_santa.ready_generic.opt.turnin = C'est fait.

# ---- Santa's helpers: Tomas the Miller, Elsie the Weaver and Bram the Shepherd ----
dialogue.christmas_feast_line.opt.stall = Qu'y a-t-il dans ta boutique de Noël ?
dialogue.christmas_feast_line.opt.quests = Du travail de Noël pour moi ?
dialogue.christmas_carol.opt.sing = Chanter un chant de Noël
dialogue.christmas_miller.off_season.text = Noël est fini, et le four est refroidi.\nOn se reverra quand la neige reviendra.
dialogue.christmas_miller.off_season.opt.farewell = À l'hiver prochain.
dialogue.christmas_miller.greeting.text = Joyeux Noël. Le Père Noël veut des biscuits pour sa hotte, alors j'ai monté mon four depuis le moulin.\nJe vends les recettes des <b>Biscuits au pain d'épices</b>, du <b>Chocolat chaud</b> et du <b>Gâteau de Noël</b>.
dialogue.christmas_miller.dough.text = Moud du <b>blé</b> en <b>farine</b> sur une <b>Cuisinière du chef</b>, puis mélange la farine avec des <b>œufs</b> et une <b>chope d'eau</b> sur la même cuisinière.\nPas le temps ? Je vends un peu de pâte chaque jour.
dialogue.christmas_miller.why.text = Des Trorks ont pillé le traîneau du Père Noël sur la route, et il a demandé de l'aide au village. Elsie et Bram sont venus aussi.\nIl faut bien que quelqu'un nourrisse le vieil homme.
dialogue.christmas_miller.opt.stall = Que vends-tu ?
dialogue.christmas_miller.opt.dough = Comment faire de la pâte ?
dialogue.christmas_miller.opt.why = Pourquoi es-tu ici ?
dialogue.christmas_miller.opt.thanks = Merci, Tomas.
dialogue.christmas_miller.opt.back = C'est gentil à toi.
dialogue.christmas_miller.opt.farewell = Joyeux Noël, Tomas.
dialogue.christmas_miller.opt.quests = Du travail pour moi ?
dialogue.christmas_miller.opt.later = Pas maintenant.
dialogue.christmas_miller.next_elsie.text = La hotte du Père Noël ne se remplira pas toute seule. <b>Elsie</b> a besoin d'un coup de main pour les emballages.\nSa boutique est juste ici, à côté du Père Noël. Tant que la fête de Martha dure, elle est de l'autre côté du <b>village kweebec</b>.
dialogue.christmas_miller.cookies_offer.text = Bram t'a donné ma recette ? Bien. Le Père Noël veut des biscuits dans sa hotte.\nApprends la recette, cuis un <b>Biscuit au pain d'épices</b> et apporte-le ici. Je veux voir ce que ça donne.
dialogue.christmas_miller.cookies_offer.opt.accept = J'en cuirai un.
dialogue.christmas_miller.cookies_brief.text = Apprends la recette, puis cuis un <b>Biscuit au pain d'épices</b> et apporte-m'en un.\nTu n'as jamais fait de pâte ? Demande-moi comment.
dialogue.christmas_miller.cookies_ready.text = Voilà un vrai bonhomme en pain d'épices. Il sent bon, en plus.\nContinue à cuire. Le Père Noël en voudra beaucoup d'autres avant la Veille de Noël.
dialogue.christmas_miller.cookies_ready.opt.turnin = Tiens, goûte.
dialogue.christmas_miller.baking_offer.text = Mon four mange la pâte plus vite que je ne la mélange.\nM'apporteras-tu de la <b>pâte</b> aujourd'hui ?
dialogue.christmas_miller.baking_offer.opt.accept = J'apporterai de la pâte.
dialogue.christmas_miller.baking_brief.text = Apporte-moi de la <b>pâte</b>.\nTu n'en as jamais fait ? Demande-moi comment.
dialogue.christmas_miller.baking_ready.text = De la pâte fraîche. Le four attendait.
dialogue.christmas_miller.baking_ready.opt.turnin = Voici la pâte.
dialogue.christmas_weaver.off_season.text = Noël est fini et les rubans sont rangés.\nReviens me voir l'hiver prochain. J'aurai de nouveaux cadeaux emballés d'ici là.
dialogue.christmas_weaver.off_season.opt.farewell = Je viendrai te chercher.
dialogue.christmas_weaver.greeting.text = Joyeux Noël. Les voleurs ont laissé les cadeaux du Père Noël déchirés et pleins de boue, alors je les emballe tous de nouveau.\nJe vends des <b>Cadeaux de Noël</b>, la <b>Baguette de Noël</b>, la <b>Tenue de Père Noël</b> et la <b>Panoplie de Noël</b>. Plus tu montes sur la <b>Liste des gentils</b> du Père Noël, plus je peux te vendre de choses.
dialogue.christmas_weaver.presents.text = Fais un clic droit sur un cadeau pour l'ouvrir. Il y a toujours quelque chose dedans, et parfois quelque chose de joli.\nOu offre-le : tiens-le, regarde un ami et fais un clic gauche. Il reçoit un plus beau présent que toi, et le Père Noël le remarque. Quand le Père Noël ou l'un de nous demande un cadeau, donne-le de la même façon.\nLes <b>Voleurs de cadeaux</b> en portent beaucoup. Tu les trouveras la nuit dans les <b>Emerald Wilds</b>.
dialogue.christmas_weaver.why.text = Le Père Noël a demandé de l'aide au village, alors me voici. Il faut bien que quelqu'un emballe tout ça.\nEt que quelqu'un lui couse un nouveau manteau. Les Trorks ont pris son manteau de rechange aussi.
dialogue.christmas_weaver.opt.stall = Montre-moi ce que tu as.
dialogue.christmas_weaver.opt.presents = Que faire d'un cadeau ?
dialogue.christmas_weaver.opt.why = Pourquoi es-tu ici ?
dialogue.christmas_weaver.opt.thanks = Merci, Elsie.
dialogue.christmas_weaver.opt.back = Ça fait beaucoup d'emballages.
dialogue.christmas_weaver.opt.farewell = Joyeux Noël, Elsie.
dialogue.christmas_weaver.opt.quests = Puis-je aider ?
dialogue.christmas_weaver.opt.later = Pas maintenant.
dialogue.christmas_weaver.next_santa.text = Le Père Noël a encore une tâche pour toi avant la <b>Veille de Noël</b>.\nVa le voir près de son sapin.
dialogue.christmas_weaver.wrapping_offer.text = Je n'ai bientôt plus de ruban, et les cadeaux ne vont pas s'emballer tout seuls.\nApporte-moi de la <b>Fibre végétale</b>. Et porte un de tes cadeaux à <b>Bram</b> pour moi. Il a eu une rude semaine.
dialogue.christmas_weaver.wrapping_offer.opt.accept = Je vais aider.
dialogue.christmas_weaver.wrapping_brief.text = Apporte-moi de la <b>Fibre végétale</b>.\nPuis offre un <b>Cadeau de Noël</b> à <b>Bram</b> : tiens-le, regarde-le et fais un clic gauche. Il est dans la <b>prairie</b>, à mi-chemin sur la route. Pas de cadeau ? J'en vends.
dialogue.christmas_weaver.wrapping_ready.text = Du ruban pour des jours, et Bram sourit encore de son cadeau.\nCes trois-là sont pour toi. Et le Père Noël aurait bien besoin d'un elfe de plus, alors ne bouge pas.
dialogue.christmas_weaver.wrapping_ready.opt.turnin = Merci, Elsie.
dialogue.christmas_weaver.fibre_offer.text = Je n'ai plus de ruban, encore une fois.\nApporte-moi de la <b>Fibre végétale</b> aujourd'hui et j'emballerai deux cadeaux pour toi.
dialogue.christmas_weaver.fibre_offer.opt.accept = J'en apporterai.
dialogue.christmas_weaver.fibre_brief.text = Apporte-moi de la <b>Fibre végétale</b>.
dialogue.christmas_weaver.fibre_ready.text = De belles longues fibres. Tiens, deux cadeaux, emballés ce matin.
dialogue.christmas_weaver.fibre_ready.opt.turnin = Voici la fibre.
dialogue.christmas_shepherd.off_season.text = Noël est fini. Je remonte sur la colline.
dialogue.christmas_shepherd.off_season.opt.farewell = Bonne route du retour.
dialogue.christmas_shepherd.greeting.text = Joyeux Noël. Le traîneau du Père Noël a été pillé, alors je suis descendu aider.\nJe distribue des <b>boules de neige</b>, un lot gratuit chaque jour. Touche quelqu'un avec et il ralentit un instant. Ça ne fait pas mal.
dialogue.christmas_shepherd.thieves.text = Des Trorks en bonnet de Père Noël. Ils sortent la nuit dans les <b>bois</b> et les <b>champs</b> des <b>Emerald Wilds</b>.\nEn haut, dans la neige des <b>Whisperfrost Frontiers</b>, ils rôdent toute la journée. Touche-en un d'abord avec une boule de neige. Ça le ralentit net.
dialogue.christmas_shepherd.why.text = Il faut bien que quelqu'un fasse venir la neige.\nEt le Père Noël l'a demandé gentiment.
dialogue.christmas_shepherd.opt.stall = Tu as des boules de neige ?
dialogue.christmas_shepherd.opt.thieves = Où sont les voleurs ?
dialogue.christmas_shepherd.opt.why = Pourquoi es-tu ici ?
dialogue.christmas_shepherd.opt.thanks = Merci, Bram.
dialogue.christmas_shepherd.opt.back = Bien sûr.
dialogue.christmas_shepherd.opt.farewell = Joyeux Noël, Bram.
dialogue.christmas_shepherd.opt.quests = Besoin d'un coup de main ?
dialogue.christmas_shepherd.opt.later = Pas maintenant.
dialogue.christmas_shepherd.next_tomas.text = <b>Tomas</b> te veut en cuisine, ensuite.\nSa boutique est à côté du Père Noël. Tant que la fête de Martha dure, il est là où la route rejoint le <b>village kweebec</b>.
dialogue.christmas_shepherd.reindeer_offer.text = Les rennes du Père Noël n'ont pas mangé depuis que les Trorks ont attaqué le traîneau.\nApporte-moi des <b>carottes</b>.
dialogue.christmas_shepherd.reindeer_offer.opt.accept = Je vais trouver des carottes.
dialogue.christmas_shepherd.reindeer_brief.text = Des <b>carottes</b> pour les rennes. Apporte-les ici.
dialogue.christmas_shepherd.reindeer_ready.text = Ça les fera voler. Des boules de neige, pour ta peine.\nEt Tomas m'a laissé ceci pour toi. Sa recette de biscuits, avec un peu de pâte et d'épices.
dialogue.christmas_shepherd.reindeer_ready.opt.turnin = Merci, Bram.
dialogue.christmas_shepherd.carrots_offer.text = Les rennes mangent toute la journée.\nM'apporteras-tu d'autres <b>carottes</b> ? J'y ajoute des boules de neige.
dialogue.christmas_shepherd.carrots_offer.opt.accept = J'apporterai des carottes.
dialogue.christmas_shepherd.carrots_brief.text = Encore des <b>carottes</b>. Apporte-les ici.
dialogue.christmas_shepherd.carrots_ready.text = De bonnes carottes. Les rennes vont se les disputer.
dialogue.christmas_shepherd.carrots_ready.opt.turnin = Tiens.

# ---- Santa's story, the dailies and the carol tour ----
quest.christmas_santa_meet.title = Rencontrer le Père Noël
quest.christmas_santa_meet.flavor = Des Trorks ont pillé mon traîneau, et j'ai besoin d'aide. Je suis près de mon sapin dans le Temple de l'Oubli. N'importe quelle Entrée du Temple de l'Oubli t'y mènera.
objective.christmas.meet_santa = Trouvez le Père Noël dans le Temple de l'Oubli
quest.christmas_present_thieves.title = Voleurs de cadeaux
quest.christmas_present_thieves.flavor = Des Trorks en bonnet de Père Noël ont filé avec mes cadeaux. Attrape-les la nuit dans les Emerald Wilds, ou à toute heure dans la neige des Whisperfrost Frontiers, puis reviens me voir.
objective.christmas.catch_thieves = Attrapez {0} {0, plural, one {Voleur de cadeaux} other {Voleurs de cadeaux}}
quest.christmas_reindeer_food.title = De quoi nourrir les rennes
quest.christmas_reindeer_food.flavor = Les rennes du Père Noël n'ont pas mangé depuis le pillage du traîneau. Apporte-moi des carottes. Je suis dans la prairie.
objective.christmas.bring_bram_carrots = Apportez {0} {0, plural, one {Carotte} other {Carottes}} à Bram
quest.christmas_gingerbread_cookies.title = Biscuits de Noël
quest.christmas_gingerbread_cookies.flavor = La hotte du Père Noël a besoin de biscuits. Apprends ma recette, cuis un Biscuit au pain d'épices et apporte-le-moi près du sapin du Père Noël.
objective.christmas.bring_tomas_cookie = Apportez un Biscuit au pain d'épices à Tomas
quest.christmas_wrapping_presents.title = Emballer les cadeaux
quest.christmas_wrapping_presents.flavor = Il me faut de la Fibre végétale pour le ruban, alors apporte-m'en. Et offre un de tes cadeaux à Bram dans la prairie. Il a eu une rude semaine.
objective.christmas.bring_elsie_fibre = Apportez {0} Fibre végétale à Elsie
objective.christmas.give_bram_present = Offrez un Cadeau de Noël à Bram
quest.christmas_eve.title = Veille de Noël
quest.christmas_eve.flavor = Le traîneau part ce soir. Apporte-moi des Biscuits au pain d'épices pour la hotte et des carottes pour les rennes, et donne-moi un Cadeau de Noël pour le traîneau.
objective.christmas.bring_santa_cookies = Apportez {0} {0, plural, one {Biscuit au pain d'épices} other {Biscuits au pain d'épices}} au Père Noël
objective.christmas.bring_santa_carrots = Apportez {0} {0, plural, one {Carotte} other {Carottes}} au Père Noël
objective.christmas.give_santa_present = Offrez un Cadeau de Noël au Père Noël
quest.christmas_morning.title = Matin de Noël
quest.christmas_morning.flavor = Joyeux Noël. Il y a un cadeau sous mon sapin dans le Temple de l'Oubli, et il porte ton nom. Viens l'ouvrir.
objective.christmas.morning = Ouvrez votre cadeau sous le sapin du Père Noël
quest.christmas_daily_thieves.title = Voleurs du jour
quest.christmas_daily_thieves.flavor = Ces Trorks remettent ça. Attrape encore quelques Voleurs de cadeaux ce soir dans les Emerald Wilds, puis reviens me voir.
quest.christmas_daily_presents.title = Cadeaux du jour
quest.christmas_daily_presents.flavor = Mes aides travaillent dur. Offre aujourd'hui un Cadeau de Noël à Tomas, Elsie et Bram. Tiens-en un, regarde-les et fais un clic gauche.
objective.christmas.give_tomas_present = Offrez un Cadeau de Noël à Tomas
objective.christmas.give_elsie_present = Offrez un Cadeau de Noël à Elsie
quest.christmas_daily_baking.title = Cuisson du jour
quest.christmas_daily_baking.flavor = Mon four mange la pâte plus vite que je ne la mélange. Apporte-m'en.
objective.christmas.bring_tomas_dough = Apportez {0} Pâte à Tomas
quest.christmas_daily_wrapping.title = Emballage du jour
quest.christmas_daily_wrapping.flavor = Je n'ai plus de ruban, encore une fois. Apporte-moi de la Fibre végétale et j'emballerai deux cadeaux pour toi.
quest.christmas_daily_carrots.title = Carottes du jour
quest.christmas_daily_carrots.flavor = Les rennes mangent toute la journée. Apporte-moi des carottes et j'ajoute des boules de neige.
quest.christmas_extra_thieves.title = Voleurs en plus
quest.christmas_extra_thieves.flavor = Je prends tous les voleurs que tu peux attraper. Cherche la nuit dans les Emerald Wilds, ou à toute heure dans la neige des Whisperfrost Frontiers, puis reviens me voir. Fais-le aussi souvent que tu veux.
quest.christmas_carols.title = Chants de Noël
quest.christmas_carols.flavor = Rien ne réchauffe un temple froid comme un chant de Noël. Chantes-en un à des gens autour du Temple de l'Oubli, puis viens me dire comment ça s'est passé.
objective.christmas.sing_carols = Chantez un chant de Noël à {0} {0, plural, one {personne} other {personnes}}

# ---- The Christmas Board ----
board.christmas_daily.title = Tableau de Noël
board.christmas_daily.desc = Des tâches dehors et des tâches à l'atelier, fraîches chaque matin. Plus tu montes sur ma Liste des gentils, plus j'en affiche. Touche ta paie avant que le traîneau parte. Si tu es en retard, elle t'attend dans ton Carnet de quêtes.
board.christmas_daily.grade.outdoor = Travail dehors
board.christmas_daily.grade.workshop = Travail à l'atelier
quest.christmas_board_thieves.title = Tâche des voleurs
quest.christmas_board_thieves.flavor = Attrape des Voleurs de cadeaux la nuit dans les Emerald Wilds, ou à toute heure dans la neige des Whisperfrost Frontiers. Tout Trork compte.
quest.christmas_board_carrots.title = Tâche des carottes
quest.christmas_board_carrots.flavor = Cueille des carottes à la main. Les rennes ont de nouveau faim.
objective.christmas.pick_carrots = Cueillez {0} {0, plural, one {Carotte} other {Carottes}}
quest.christmas_board_logs.title = Tâche des bûches
quest.christmas_board_logs.flavor = Coupe des bûches sur n'importe quel arbre pour le feu du Père Noël. Le temple est froid la nuit.
objective.christmas.chop_logs = Coupez {0} {0, plural, one {bûche} other {bûches}}
quest.christmas_board_eggs.title = Tâche des œufs
quest.christmas_board_eggs.flavor = Tomas a besoin d'œufs pour ses gâteaux. Apportes-en au tableau.
objective.christmas.bring_eggs = Apportez {0} {0, plural, one {Œuf} other {Œufs}}
quest.christmas_board_cookies.title = Tâche des biscuits
quest.christmas_board_cookies.flavor = Le Père Noël veut encore des biscuits dans sa hotte. Cuis des Biscuits au pain d'épices et apporte-les au tableau.
objective.christmas.bring_cookies = Apportez {0} {0, plural, one {Biscuit au pain d'épices} other {Biscuits au pain d'épices}}
quest.christmas_board_dough.title = Tâche de la pâte
quest.christmas_board_dough.flavor = Apporte de la pâte au tableau. Tomas n'en a jamais assez.
objective.christmas.bring_dough = Apportez {0} Pâte
quest.christmas_board_presents.title = Tâche des cadeaux
quest.christmas_board_presents.flavor = Offre des Cadeaux de Noël au Père Noël pour sa hotte. Tiens-en un, regarde-le et fais un clic gauche.
objective.christmas.give_santa_presents = Offrez {0} {0, plural, one {Cadeau de Noël} other {Cadeaux de Noël}} au Père Noël
quest.christmas_board_spices.title = Tâche des épices
quest.christmas_board_spices.flavor = Le pain d'épices de Tomas a besoin d'Épices. Apportes-en au tableau.
objective.christmas.bring_spices = Apportez {0} Épices

