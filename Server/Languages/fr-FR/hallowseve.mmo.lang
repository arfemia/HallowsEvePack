board.grade.hallows_eve_skill = Travail de compétence
boostrule.mmo_hallows_eve_harvest_moon.title = Lune des Moissons
gearset.mmo_hallows_eve_hallowed.title = Panoplie Sanctifiée (compétences)
gearset.mmo_hallows_eve_hallowed.tier_full = Heaume et bouclier ensemble : un peu plus de chance, et des coups d'Artillerie plus forts.
quest.mmo_hallows_eve_daily_artillery.title = Lancer de lanternes
quest.mmo_hallows_eve_daily_artillery.flavor = Un bon bras, ça se travaille, et c'est le mois pour ça. Lance sur ce qui le mérite ce soir et reviens avec un tir plus sûr.
quest.mmo_hallows_eve_daily_harvesting.title = Récolte de nuit
quest.mmo_hallows_eve_daily_harvesting.flavor = Ce mois-ci, des citrouilles froides poussent dans les potagers, s'il y a quelqu'un pour les cueillir. Passe la nuit dans les champs.
quest.mmo_hallows_eve_daily_mining.title = Poste de fond
quest.mmo_hallows_eve_daily_mining.flavor = Les géodes se montrent à ceux qui passent leurs nuits sous terre. Fais un long poste cette nuit.
quest.mmo_hallows_eve_daily_crafting.title = Mains occupées
quest.mmo_hallows_eve_daily_crafting.flavor = Chaque lanterne sur les marches du temple a été faite par les mains de quelqu'un. Passe la nuit à un établi, n'importe lequel, et occupe les tiennes.
