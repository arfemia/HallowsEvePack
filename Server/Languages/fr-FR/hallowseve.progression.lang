# Progression de la Veille de la Toussaint : la suite de quêtes du Vieux Jack, ses quotidiennes, son tableau et
# sa boutique, sa conversation et la réplique des bonbons ou un sort, les succès de la saison et son titre, et sa
# page d'Almanach. Les clés sont écrites nues : la bibliothèque trouve chacune par sa fin, quel que soit le nom
# de ce fichier. Les nombres passent par {0} et viennent des fichiers de contenu, donc un réglage ne touche
# jamais une traduction.

# ---- Le porte-monnaie ----
currency.hallows_eve_sweets.name = Friandises de la Toussaint
currency.hallows_eve_sweets.amount = {0, number} {0, plural, one {Friandise de la Toussaint} other {Friandises de la Toussaint}}
currency.hallows_eve_sweets.description = Dépensez-les dans la boutique du Vieux Jack, au Temple de l'Oubli.
quest.category.hallows_eve = Veille de la Toussaint

# ---- La suite de quêtes du Vieux Jack ----
quest.hallows_eve_old_jack_meet.title = Lanternes dans le temple
quest.hallows_eve_old_jack_meet.flavor = C'est de nouveau la saison, alors me revoilà au Temple de l'Oubli avec mes lanternes. N'importe quelle Entrée du Temple de l'Oubli t'y mènera. Viens me trouver. J'aurais bien besoin d'un coup de main.
quest.hallows_eve_old_jack_1.title = Champ de citrouilles
quest.hallows_eve_old_jack_1.flavor = Mes lanternes sont sculptées dans des Citrouilles Sanctifiées, et j'en manque. Cueille des citrouilles à la main et rapporte-moi les froides, celles qui luisent.
quest.hallows_eve_old_jack_2.title = Travail de lanternes
quest.hallows_eve_old_jack_2.flavor = Une citrouille bourrée de poudre tient les morts à distance mieux que n'importe quelle lanterne. Lance quelques Bombes-Lanternes, puis dis-moi comment elles ont brûlé.
quest.hallows_eve_old_jack_3.title = Goules sur les marches
quest.hallows_eve_old_jack_3.flavor = Mes lanternes gardent les goules loin des marches, mais de justesse. Renvoie quelques Goules Creuses sous terre après la tombée de la nuit.
quest.hallows_eve_old_jack_4.title = Tournée d'ectoplasme
quest.hallows_eve_old_jack_4.flavor = C'est l'Ectoplasme qui brûle dans mes lanternes, et une Âme Perdue en laisse quand on la libère. Libères-en quelques-unes et apporte-le-moi.
quest.hallows_eve_old_jack_5.title = Pierre maudite
quest.hallows_eve_old_jack_5.flavor = La pierre rend des Géodes Maudites à cette époque de l'année, si tu en brises assez. Casses-en quelques-unes et garde ce qui en tombe.
quest.hallows_eve_old_jack_lantern.title = La Lanterne Creuse
quest.hallows_eve_old_jack_lantern.flavor = J'ai la braise du Cavalier. Maintenant, ta Lanterne Creuse veut une Citrouille Sanctifiée, de l'Ectoplasme, et les squelettes à ma figure mis à plat.
quest.hallows_eve_old_jack_horseman.title = Le Chevaucheur
quest.hallows_eve_old_jack_horseman.flavor = Le Gardien du Cimetière à côté de moi connaît le chemin du cimetière du Cavalier, mais il n'ouvrira pas la grille sans une Bougie de Tombe, et je les vends dans ma boutique dès que je te compte parmi les Habitués. Achètes-en une, entre avec des amis et fais-le tomber de sa selle.
quest.hallows_eve_old_jack_horseman_hard.title = Du feu pour la lanterne
quest.hallows_eve_old_jack_horseman_hard.flavor = Ta lanterne veut une flamme qui ne s'éteint pas, et le Cavalier en porte une. Demande au Gardien du Cimetière la chevauchée difficile, bats-le, et rapporte-moi sa braise.

# ---- Les quotidiennes du Vieux Jack ----
quest.hallows_eve_jack_daily_souls.title = Âmes agitées
quest.hallows_eve_jack_daily_souls.flavor = D'autres Âmes Perdues ont flotté jusqu'ici la nuit dernière. Libères-en quelques-unes avant qu'elles s'installent pour de bon.
quest.hallows_eve_jack_daily_horseman.title = De nouveau en selle
quest.hallows_eve_jack_daily_horseman.flavor = Il est de nouveau en selle, comme chaque nuit. Porte une Bougie de Tombe au Gardien du Cimetière et fais-le tomber de ce cheval une fois de plus. La chevauchée ordinaire, attention, pas la difficile.
quest.hallows_eve_jack_daily_pumpkins.title = Tournée des citrouilles
quest.hallows_eve_jack_daily_pumpkins.flavor = Les lanternes brûlent les Citrouilles Sanctifiées plus vite que j'arrive à les sculpter. Rapporte-m'en encore quelques-unes avant la nuit.
quest.hallows_eve_jack_daily_geodes.title = Géodes pour Jack
quest.hallows_eve_jack_daily_geodes.flavor = Casse-moi deux ou trois Géodes Maudites. J'ai les mains trop raides pour ça, ces temps-ci.

# ---- What Hallow's Eve's loot tables pay: the name on the reward, and the line under it on hover ----
lootable.hallows_eve_meet_pay.title = Accueil du Vieux Jack
lootable.hallows_eve_meet_pay.flavor = Quelques friandises pour dire bonjour.
lootable.hallows_eve_chain_pay.title = Paie du Vieux Jack
lootable.hallows_eve_chain_pay.flavor = Ce que le Vieux Jack paie pour chaque travail qu'il vous donne.
lootable.hallows_eve_daily_pay.title = Paie quotidienne du Vieux Jack
lootable.hallows_eve_daily_pay.flavor = Ce que le Vieux Jack paie pour une journée de travail.
lootable.hallows_eve_lantern_pay.title = Remerciements du Vieux Jack
lootable.hallows_eve_lantern_pay.flavor = Ce que le Vieux Jack offre chaque année pour avoir allumé la Lanterne Creuse.
lootable.hallows_eve_board_pay.title = Suppléments du Vieux Jack
lootable.hallows_eve_board_pay.flavor = Un petit supplément en plus de ce que paie le travail, pour quiconque fait mon tableau.
lootable.hallows_eve_board_sweets.title = Le Bocal de Bonbons
lootable.hallows_eve_board_sweets.flavor = Autant que j'en peux attraper d'une main.
lootable.hallows_eve_hallowed_cache.title = Réserve des Sanctifiés
lootable.hallows_eve_hallowed_cache.flavor = Les Sanctifiés te laissent ça chaque fois que tu montes d'un cran de plus au-delà d'Exalté avec eux. Me demande pas où ils le trouvent.
lootable.hallows_eve_trick_or_treat.title = Des bonbons ou un sort
lootable.hallows_eve_trick_or_treat.flavor = Frappe et vois ce que tu reçois. Des bonbons, surtout.
lootable.hallows_eve_treats.title = Quelque chose de sucré
lootable.hallows_eve_treats.flavor = Ce que tu reçois quand le sort ne prend pas.
lootable.hallows_eve_geode_crack.title = Géode Cassée
lootable.hallows_eve_geode_crack.flavor = Tout ce qui tombe d'une Géode Maudite quand tu la casses. Du cristal à chaque fois, et mieux quand tu as de la chance.

