currency.harvest_feast_coins.description = À dépenser dans la boutique de Martha, dans le Temple de l'Oubli.

# ---- Martha's reputation ----
reputation.harvest_feast_host.name = Faveur de Martha
reputation.harvest_feast_host.flavor = Martha se souvient de qui est venu aider et de qui n'est venu que pour manger.
reputation.harvest_feast_host.rank.neutral = Nouveau venu
reputation.harvest_feast_host.rank.friendly = Voisin
reputation.harvest_feast_host.rank.honored = Ami
reputation.harvest_feast_host.rank.revered = Famille
reputation.harvest_feast_host.rank.exalted = Tête de table
reputation.harvest_feast_host.earn.quests = Accomplissez ses quêtes et ses quotidiennes, ainsi que les tâches du jour de Tomas, Elsie et Bram.
reputation.harvest_feast_host.earn.board = Prenez des tâches sur le Tableau de la Fête.
reputation.harvest_feast_host.earn.talk = Passez-lui dire un mot une fois par jour.
reputation.harvest_feast_host.earn.turkeys = Chassez des dindes dans les Emerald Wilds pendant la fête (une Dinde sauvage rapporte le plus), et apportez-lui des Dindes en plus aussi souvent que vous voulez.
reputation.harvest_feast_host.earn.gear = Portez la Panoplie de Moisson de sa boutique, et vous gagnez sa faveur plus vite.
lootable.harvest_feast_feast_basket.title = Panier de la Fête
lootable.harvest_feast_feast_basket.flavor = Martha vous en prépare un chaque fois que votre faveur auprès d'elle monte d'un cran de plus au-delà de Tête de table.
notify.harvest_feast_feast_basket = Un Panier de la Fête de la part de Martha, pour toute votre aide à table.
notify.harvest_feast_feast_served = Le Festin est servi !
notify.harvest_feast_feast_served.sub = {0} a pris place à la table de Martha.

# ---- The feast board ----
board.harvest_feast_daily.title = Tableau de la Fête
board.harvest_feast_daily.desc = Des tâches aux champs et des tâches en cuisine, fraîches chaque matin. Plus tu aides, plus j'en affiche pour toi. Touche ta paie avant que la table soit rangée. Si tu es en retard, ce que tu as gagné t'attend dans ton Carnet de quêtes.
board.harvest_feast_daily.grade.field = Travail aux champs
board.harvest_feast_daily.grade.kitchen = Travail en cuisine
quest.harvest_feast_board_turkeys.title = Tâche des dindes
quest.harvest_feast_board_turkeys.flavor = Chasse les Dindes sauvages de jour, dans les bois et sur les plaines des Emerald Wilds. Elles courent comme si elles savaient ce qu'il y a au dîner.
quest.harvest_feast_board_wheat.title = Tâche du blé
quest.harvest_feast_board_wheat.flavor = Cueille le blé sauvage à la main sur les plaines des Emerald Wilds. Il n'attendra pas le gel.
quest.harvest_feast_board_pumpkins.title = Tâche des citrouilles
quest.harvest_feast_board_pumpkins.flavor = Cueille des citrouilles à la main dans les bois d'automne des Emerald Wilds. Chaque tarte commence par une.
quest.harvest_feast_board_carrots.title = Tâche des carottes
quest.harvest_feast_board_carrots.flavor = Cueille des carottes à la main dans les forêts des Emerald Wilds. Je veux un panier plein pour la table.
quest.harvest_feast_board_pies.title = Tâche des tartes
quest.harvest_feast_board_pies.flavor = Cuis des tartes à la citrouille sur une Cuisinière du chef et apporte-les à la table tant qu'elles sont chaudes.
quest.harvest_feast_board_roast.title = Tâche de cuisson
quest.harvest_feast_board_roast.flavor = Fais cuire de la viande crue sur un Feu de camp et apporte-la à la table. L'odeur suffit à attirer les gens.
quest.harvest_feast_board_vegetables.title = Tâche des légumes
quest.harvest_feast_board_vegetables.flavor = Fais rôtir des légumes sur un Feu de camp et apporte-les à la table. Une carotte, du maïs, une citrouille ou un champignon feront l'affaire.
quest.harvest_feast_board_spices.title = Tâche des épices
quest.harvest_feast_board_spices.flavor = Prépare des épices sur une Cuisinière du chef avec des fleurs et un légume, ou garde celles que tu trouves en cueillant des citrouilles. Apporte-les ici.

# ---- The feast stall ----
shop.harvest_feast_host.title = Boutique de la Fête
shop.harvest_feast_host.desc = Des recettes de mon propre carnet, du pop-corn au sac, des vêtements pour les champs et quelques bricoles pour la maison.
shop.harvest_feast_host.category.kitchen = Cuisine
shop.harvest_feast_host.category.clothes = Vêtements
shop.harvest_feast_host.category.decor = Décorations
shop.harvest_feast_offer_recipe_turkey_pie.title = Recette de la tourte de dinde
shop.harvest_feast_offer_recipe_turkey_pie.desc = La tourte à la viande de Martha. À cuire sur une Cuisinière du chef : plus de santé max et moins de dégâts subis, plus longtemps que toute autre tourte.
shop.harvest_feast_offer_recipe_harvest_salad.title = Recette de la salade de la récolte
shop.harvest_feast_offer_recipe_harvest_salad.desc = Des carottes, du maïs et de la citrouille. À préparer sur une Cuisinière du chef : plus d’endurance max, plus longtemps que toute autre salade.
shop.harvest_feast_offer_recipe_marthas_roast.title = Recette du rôti de Martha
shop.harvest_feast_offer_recipe_marthas_roast.desc = Son meilleur plat, noté pour la famille. Plus de santé et d’endurance max, et sa faveur monte plus vite tant que l’effet dure.
shop.harvest_feast_offer_harvest_gloves.title = Gants de Moisson
shop.harvest_feast_offer_harvest_gloves.desc = Des gants de laine chauds, qui font partie de la Panoplie de Moisson. Portez toute la panoplie et vous gagnez la faveur de Martha plus vite.
shop.harvest_feast_offer_harvest_hat.title = Chapeau de Moisson
shop.harvest_feast_offer_harvest_hat.desc = Un chapeau de laine chaud, qui fait partie de la Panoplie de Moisson. Portez toute la panoplie et vous gagnez la faveur de Martha plus vite.
shop.harvest_feast_offer_harvest_trousers.title = Pantalon de Moisson
shop.harvest_feast_offer_harvest_trousers.desc = Un pantalon de laine pour les champs, qui fait partie de la Panoplie de Moisson. Portez toute la panoplie et vous gagnez la faveur de Martha plus vite.
shop.harvest_feast_offer_harvest_tunic.title = Tunique de Moisson
shop.harvest_feast_offer_harvest_tunic.desc = Une tunique de laine, la dernière pièce de la Panoplie de Moisson. Portez toute la panoplie et vous gagnez la faveur de Martha plus vite.

# ---- The Harvest Set ----
# A set's notice is a toast, so no value carries markup.
gearset.harvest_feast_harvest_set.title = Panoplie de Moisson
gearset.harvest_feast_harvest_set.tier_half = La moitié de la panoplie portée : un peu plus de santé.
gearset.harvest_feast_harvest_set.tier_full = Toute la panoplie portée : encore plus de santé, et vous gagnez la faveur de Martha plus vite.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Rencontrer Martha
quest.harvest_feast_martha_meet.flavor = Les champs sont rentrés, alors je cuisine de nouveau au Temple de l'Oubli. N'importe quelle Entrée du Temple de l'Oubli t'y mènera. Viens me trouver, et viens affamé.
objective.harvest_feast.meet_martha = Trouvez Martha la Cuisinière dans le Temple de l'Oubli

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Moisson de blé
quest.harvest_feast_host_1.flavor = Le pain d'abord, toujours. Le blé sauvage pousse sur les plaines des Emerald Wilds. Cueille-m'en une bonne brassée à la main et apporte-la au Temple de l'Oubli.
quest.harvest_feast_host_2.title = La chasse aux dindes
quest.harvest_feast_host_2.flavor = Les Dindes sauvages sortent de jour dans les bois et sur les plaines des Emerald Wilds. Chasses-en quelques-unes, puis reviens me voir. La table ne vaut rien sans rôti.
quest.harvest_feast_host_3.title = La première tarte
quest.harvest_feast_host_3.flavor = À toi les fourneaux. Utilise la recette que je t'ai donnée pour l'apprendre, cuis une tarte à la citrouille sur une Cuisinière du chef avec de la pâte, une citrouille et des épices, et apporte-la-moi.
quest.harvest_feast_the_feast.title = Le Festin
quest.harvest_feast_the_feast.flavor = Une fois l'an, on met tout sur la table. Cuis une tarte à la citrouille sur une Cuisinière du chef, fais cuire de la viande sur un Feu de camp, cueille des carottes dans les forêts, et apporte-moi le tout.
quest.harvest_feast_supper_tomas.title = Souper pour Tomas
quest.harvest_feast_supper_tomas.flavor = Tomas a porté de la farine toute la semaine sans jamais s'asseoir. Porte-lui une tarte à la citrouille, prise dans les restes. Il est là où la route rejoint le village kweebec, dans le Temple de l'Oubli.
quest.harvest_feast_supper_elsie.title = Souper pour Elsie
quest.harvest_feast_supper_elsie.flavor = Elsie a tissé chaque nappe de cette table sans jamais manger sur l'une d'elles. Porte-lui un légume rôti. Elle est de l'autre côté du village kweebec, dans le Temple de l'Oubli.
quest.harvest_feast_supper_bram.title = Souper pour Bram
quest.harvest_feast_supper_bram.flavor = Bram a fait descendre sa laine des collines pour nous. Porte-lui de la viande cuite. Il est dans la prairie, près de la route qui mène au Temple de l'Oubli.
objective.harvest_feast.supper_for_tomas = Portez une Tarte à la citrouille à Tomas le Meunier
objective.harvest_feast.supper_for_elsie = Portez un Légume rôti à Elsie la Tisserande
objective.harvest_feast.supper_for_bram = Portez de la Viande sauvage cuite à Bram le Berger

# ---- Martha's dailies and Extra Turkeys ----
quest.harvest_feast_daily_turkeys.title = Dindes du jour
quest.harvest_feast_daily_turkeys.flavor = Le rôti d'hier est parti jusqu'au dernier os. Chasse encore quelques Dindes sauvages dans les Emerald Wilds et j'en lance un autre.
quest.harvest_feast_daily_wheat.title = Blé du jour
quest.harvest_feast_daily_wheat.flavor = Chaque miche que j'ai cuite aujourd'hui est déjà partie. Rapporte-moi du blé des plaines, sinon pas de pain demain matin.
quest.harvest_feast_daily_roast.title = Rôti du jour
quest.harvest_feast_daily_roast.flavor = Fais cuire de la viande crue sur un Feu de camp et apporte-la ici. Les gens la mangent avant qu'elle arrive à table.
quest.harvest_feast_extra_turkeys.title = Dindes en plus
quest.harvest_feast_extra_turkeys.flavor = Je prends toutes les dindes que tu peux attraper. Chasse encore des Dindes sauvages dans les Emerald Wilds, puis reviens me voir. Autant de fois que tu veux.
quest.harvest_feast_miller_flour.title = Farine du jour
quest.harvest_feast_miller_flour.flavor = Les fours mangent la farine plus vite que mon moulin ne la moud. Mouds du blé en farine sur une Cuisinière du chef et apporte-m'en, je ferai en sorte qu'elle arrive chez Martha.
quest.harvest_feast_weaver_spices.title = Épices du jour
quest.harvest_feast_weaver_spices.flavor = Il me faut un peu d'épices pour teindre le bord orange du chemin de table, et Martha prend le reste. Prépare des Épices sur une Cuisinière du chef avec des fleurs et un légume, et apporte-les-moi.
quest.harvest_feast_shepherd_eggs.title = Œufs du jour
quest.harvest_feast_shepherd_eggs.flavor = Tomas veut des œufs pour sa pâte, et c'est moi qui m'y connais en poules. Garde-en quelques-unes dans un Poulailler et apporte-moi ce qu'elles pondent.
objective.harvest_feast.bring_tomas_flour = Rapportez {0} Farine à Tomas
objective.harvest_feast.bring_elsie_spices = Rapportez {0} Épices à Elsie
objective.harvest_feast.bring_bram_eggs = Rapportez {0} {0, plural, one {Œuf} other {Œufs}} à Bram

