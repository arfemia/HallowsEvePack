
# Christmas with MMO Skill Tree, and what stands in for it without: the villagers' own job boards (a skill
# job a day where MMO Skill Tree runs, a plain errand where it does not), the season's boosts and their two
# one-day events, the Christmas Set's skill half, Christmas Morning's bag of treats, and the villagers'
# secrets with their apprentice quests and lock lines. Only a line that shows just where MMO Skill Tree
# runs names a skill, a level or XP; every other line here shows on both kinds of server, so it names none.
# Keys are written bare: MMO Skill Tree and the library find each one by its tail, whatever this file is
# called. A job or quest takes its words from the keys its id spells (quest.<id>.title and .flavor). A
# factor's name and an effect's name are read in full, christmas.mmo. and then the key.

# ---- The villagers' job boards ----
board.christmas_miller_jobs.title = Tomas's Jobs
board.christmas_miller_jobs.desc = One job from me a day, new every morning. Collect your pay before Christmas ends. If you're late, it waits in your Objective Book.
board.christmas_miller_jobs.grade.skill = Skill Job
board.christmas_miller_jobs.grade.errand = Errand
board.christmas_weaver_jobs.title = Elsie's Jobs
board.christmas_weaver_jobs.desc = One job from me each day, new every morning. Collect your pay before Christmas is over. If you are late, it waits in your Objective Book.
board.christmas_weaver_jobs.grade.skill = Skill Job
board.christmas_weaver_jobs.grade.errand = Errand
board.christmas_shepherd_jobs.title = Bram's Jobs
board.christmas_shepherd_jobs.desc = One job a day, new every morning. Get paid before Christmas ends, or it waits in your Objective Book.
board.christmas_shepherd_jobs.grade.skill = Skill Job
board.christmas_shepherd_jobs.grade.errand = Errand

# ---- The skill jobs (only where MMO Skill Tree runs) ----
quest.mmo_christmas_miller_skill_job.title = Crafting Job
quest.mmo_christmas_miller_skill_job.flavor = My ovens never cool down at Christmas. Spend today making things at any bench and get quicker at it.
quest.mmo_christmas_weaver_skill_job.title = Building Job
quest.mmo_christmas_weaver_skill_job.flavor = Every home wants its Christmas look. Spend today putting things up at yours and get better at it.
quest.mmo_christmas_shepherd_skill_job.title = Woodcutting Job
quest.mmo_christmas_shepherd_skill_job.flavor = Santa's fire eats wood all night. Spend today chopping trees and get quicker with an axe.

# ---- The errands (only where MMO Skill Tree is missing) ----
quest.christmas_errand_wheat.title = Wheat for the Mill
quest.christmas_errand_wheat.flavor = My flour won't grind itself. Bring me some wheat.
quest.christmas_errand_bread.title = Bread for the Table
quest.christmas_errand_bread.flavor = Santa's helpers need feeding too. Bake some bread.
quest.christmas_errand_decorations.title = Decorating Errand
quest.christmas_errand_decorations.flavor = Put up some Christmas decorations at your home. Garlands, lights, a snowman, anything bright will do.
quest.christmas_errand_wool.title = Wool for Stockings
quest.christmas_errand_wool.flavor = I need wool for the Christmas stockings. Bring me some bolts of wool.
quest.christmas_errand_logs.title = Log Errand
quest.christmas_errand_logs.flavor = Chop logs from any tree. The reindeer shed needs a fire tonight.
quest.christmas_errand_wolves.title = Wolf Errand
quest.christmas_errand_wolves.flavor = Wolves keep sniffing round my flock. Hunt a few in the forests or out in the snow.

