gearset.harvest_feast_harvest_set.title = Harvest Set
gearset.harvest_feast_harvest_set.tier_half = Half the set on: a little more health.
gearset.harvest_feast_harvest_set.tier_full = The whole set on: more health again, and you earn Martha's favor faster.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Meet Martha
quest.harvest_feast_martha_meet.flavor = The fields are in, so I'm cooking in the Forgotten Temple again. Any Forgotten Temple Gateway will get you there. Come and find me, and come hungry.
objective.harvest_feast.meet_martha = Find Martha the Cook in the Forgotten Temple

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Wheat Harvest
quest.harvest_feast_host_1.flavor = Bread first, it always is. Wild wheat grows on the plains of the Emerald Wilds. Pick me a good armful by hand and bring it to the Forgotten Temple.
quest.harvest_feast_host_2.title = Turkey Hunt
quest.harvest_feast_host_2.flavor = The table's no good without a roast. Hunt Wild Turkeys by day in the woods and on the plains of the Emerald Wilds, then come back to me.
quest.harvest_feast_host_3.title = Your First Pie
quest.harvest_feast_host_3.flavor = Your turn at the stove. Learn the recipe I gave you, bake a pumpkin pie and bring it to me.
quest.harvest_feast_the_feast.title = The Feast
quest.harvest_feast_the_feast.flavor = Once a year we put it all on the table. Bring me a pumpkin pie, some cooked meat and carrots.

# ---- The supper deliveries: after The Feast, a plate of the leftovers for each villager ----
quest.harvest_feast_supper_tomas.title = Supper for Tomas
quest.harvest_feast_supper_tomas.flavor = Tomas hauled flour all week and never sat down. Take him a pumpkin pie from the leftovers. He's where the road meets the kweebec village in the Forgotten Temple.
quest.harvest_feast_supper_elsie.title = Supper for Elsie
quest.harvest_feast_supper_elsie.flavor = Elsie wove every cloth on that table and never ate off one. Take her a roast vegetable. She's on the far side of the kweebec village in the Forgotten Temple.
quest.harvest_feast_supper_bram.title = Supper for Bram
quest.harvest_feast_supper_bram.flavor = Bram walked his fleece down from the hills for us. Take him some cooked meat. He's on the meadow by the road into the Forgotten Temple.
objective.harvest_feast.supper_for_tomas = Take a Pumpkin Pie to Tomas the Miller
objective.harvest_feast.supper_for_elsie = Take a Roast Vegetable to Elsie the Weaver
objective.harvest_feast.supper_for_bram = Take Cooked Wildmeat to Bram the Shepherd

# ---- Martha's dailies and Extra Turkeys ----
quest.harvest_feast_daily_turkeys.title = Daily Turkeys
quest.harvest_feast_daily_turkeys.flavor = Yesterday's roast went down to the last bone. Hunt a few more Wild Turkeys in the Emerald Wilds, then come back to me.
quest.harvest_feast_daily_wheat.title = Daily Wheat
quest.harvest_feast_daily_wheat.flavor = Every loaf I baked today is gone. Pick more wheat on the plains of the Emerald Wilds and bring it here.
quest.harvest_feast_daily_roast.title = Daily Roast
quest.harvest_feast_daily_roast.flavor = The roast keeps getting eaten before it reaches the table. Cook some meat and bring it here.
quest.harvest_feast_extra_turkeys.title = Extra Turkeys
quest.harvest_feast_extra_turkeys.flavor = I'll take every turkey you can catch. Hunt Wild Turkeys in the Emerald Wilds and come back to me, as often as you like.

# ---- The villagers' dailies: Tomas's flour, Elsie's spices and Bram's eggs ----
quest.harvest_feast_miller_flour.title = Daily Flour
quest.harvest_feast_miller_flour.flavor = The ovens eat flour faster than my mill can grind it. Bring me some.
quest.harvest_feast_weaver_spices.title = Daily Spices
quest.harvest_feast_weaver_spices.flavor = I need spice to dye the table runner orange. Bring me some.
quest.harvest_feast_shepherd_eggs.title = Daily Eggs
quest.harvest_feast_shepherd_eggs.flavor = Tomas wants eggs for his dough, and I'm the one who knows chickens. Bring me some.
