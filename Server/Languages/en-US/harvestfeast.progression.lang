# Harvest Feast progression: Martha's intro quest, her questline, the yearly feast and the dailies, the
# feast board and the feast stall, her conversation, the season's achievements and titles, her
# reputation and the Almanac page, the shared meal and the invitation tour, and the feast's villagers.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. A quest,
# a contract or an achievement takes its words from the keys its id spells (quest.<id>.title and
# .flavor, achievement.<id>.title and .desc), so no content file names those. Numbers ride {0} and
# come from the content files, so a retune never touches a translation.

# ---- Martha's reputation ----
reputation.harvest_feast_host.name = Favor at the Feast
reputation.harvest_feast_host.flavor = Martha remembers who turned up to help and who only turned up to eat.
reputation.harvest_feast_host.rank.neutral = Newcomer
reputation.harvest_feast_host.rank.friendly = Neighbor
reputation.harvest_feast_host.rank.honored = Known Face
reputation.harvest_feast_host.rank.revered = Family
reputation.harvest_feast_host.rank.exalted = Head of the Table

# ---- The feast board ----
board.harvest_feast_daily.title = The Feast Board
board.harvest_feast_daily.desc = Field jobs and kitchen jobs, fresh every morning. The more you help, the more I put up for you. Collect your pay before the table's packed away. If you're late, what you've earned still waits in your Objective Book.
board.harvest_feast_daily.grade.field = Field Work
board.harvest_feast_daily.grade.kitchen = Kitchen Work
quest.harvest_feast_board_turkeys.title = Turkey Drive
quest.harvest_feast_board_turkeys.flavor = The woods are full of turkeys this week. Bring down a good few, if you can catch them; they run like they know what's for dinner.
quest.harvest_feast_board_wheat.title = Wheat Harvest
quest.harvest_feast_board_wheat.flavor = The wild wheat won't wait for anybody. Get it picked before the frost does.
quest.harvest_feast_board_pies.title = Pies for the Table
quest.harvest_feast_board_pies.flavor = Every seat at the table wants a slice. Bake a couple of pumpkin pies and bring them over while they're warm.
quest.harvest_feast_board_roast.title = Fire Pit
quest.harvest_feast_board_roast.flavor = Cook a pile of meat over an open fire. The smell alone brings people to the table.

# ---- The feast stall ----
shop.harvest_feast_host.title = The Feast Stall
shop.harvest_feast_host.desc = Recipes from my own book, popcorn by the bag, and a few things for the house.
shop.harvest_feast_host.category.kitchen = Kitchen
shop.harvest_feast_host.category.decor = Decorations
shop.harvest_feast_offer_recipe_apple_pie.title = Apple Pie Recipe
shop.harvest_feast_offer_recipe_apple_pie.desc = Read it once and you can bake apple pies for good.
shop.harvest_feast_offer_recipe_meat_pie.title = Meat Pie Recipe
shop.harvest_feast_offer_recipe_meat_pie.desc = Martha's own meat pie, written down for friends of the table.
shop.harvest_feast_offer_recipe_caesar_salad.title = Caesar Salad Recipe
shop.harvest_feast_offer_recipe_caesar_salad.desc = Martha's Caesar salad, written down for family.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Supper in the Temple
quest.harvest_feast_martha_meet.flavor = The fields are in, so I'm cooking in the Forgotten Temple again. Any Forgotten Temple Gateway will get you there. Come and find me, and come hungry.
objective.harvest_feast.meet_martha = Find Martha the Cook in the Forgotten Temple

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Wheat for the Ovens
quest.harvest_feast_host_1.flavor = Bread first, it always is. The wild wheat grows thick this time of year, so bring me a good armful for the ovens.
quest.harvest_feast_host_2.title = The Turkey Hunt
quest.harvest_feast_host_2.flavor = The wild turkeys are fat and loud this month, and not as daft as they look. Bring a few down; the table's no good without a roast.
quest.harvest_feast_host_3.title = The First Pie
quest.harvest_feast_host_3.flavor = Your turn at the stove. Learn that recipe, bake a pumpkin pie at a Chef's Stove, and bring it to me.
quest.harvest_feast_the_feast.title = The Long Table
quest.harvest_feast_the_feast.flavor = Once a year we put it all on the table and eat till nobody can stand. Bring a pie, some roast and a basket of carrots, and we'll set it out together.

# ---- Martha's dailies ----
quest.harvest_feast_daily_turkeys.title = Turkey Run
quest.harvest_feast_daily_turkeys.flavor = Yesterday's roast went down to the last bone. Bring me a few more turkeys and I'll start another.
quest.harvest_feast_daily_wheat.title = Bread for the Morning
quest.harvest_feast_daily_wheat.flavor = Every loaf I baked today is already gone. Bring me more wheat, or there's no bread in the morning.
quest.harvest_feast_daily_roast.title = Roast for the Table
quest.harvest_feast_daily_roast.flavor = Cook some meat over a fire and bring it here. People keep eating it before it gets to the table.

