# ---- The feast board ----
board.harvest_feast_daily.title = The Feast Board
board.harvest_feast_daily.desc = Field jobs and kitchen jobs, fresh every morning. The more you help, the more I put up for you. Collect your pay before the table's packed away. If you're late, what you've earned still waits in your Objective Book.
board.harvest_feast_daily.grade.field = Field Work
board.harvest_feast_daily.grade.kitchen = Kitchen Work
quest.harvest_feast_board_turkeys.title = Turkey Job
quest.harvest_feast_board_turkeys.flavor = Hunt Wild Turkeys by day in the woods and on the plains of the Emerald Wilds. They run like they know what's for dinner.
quest.harvest_feast_board_wheat.title = Wheat Job
quest.harvest_feast_board_wheat.flavor = Pick wild wheat by hand on the plains of the Emerald Wilds. It won't wait for the frost.
quest.harvest_feast_board_pumpkins.title = Pumpkin Job
quest.harvest_feast_board_pumpkins.flavor = Pick pumpkins by hand in the autumn woods of the Emerald Wilds. Every pie starts with one.
quest.harvest_feast_board_carrots.title = Carrot Job
quest.harvest_feast_board_carrots.flavor = Pick carrots by hand in the forests of the Emerald Wilds. I want a full basket for the table.
quest.harvest_feast_board_pies.title = Pie Job
quest.harvest_feast_board_pies.flavor = Bake pumpkin pies at a Chef's Stove and bring them to the table while they're warm.
quest.harvest_feast_board_roast.title = Cooking Job
quest.harvest_feast_board_roast.flavor = Cook raw meat on a Campfire and bring it to the table. The smell alone brings people in.
quest.harvest_feast_board_vegetables.title = Vegetable Job
quest.harvest_feast_board_vegetables.flavor = Roast vegetables on a Campfire and bring them to the table. A carrot, corn, a pumpkin or a mushroom will do.
quest.harvest_feast_board_spices.title = Spice Job
quest.harvest_feast_board_spices.flavor = Make Spices at a Chef's Stove from flowers and a vegetable, or keep the ones you find picking pumpkins. Bring them here.

# ---- The feast shop ----
shop.harvest_feast_host.title = The Feast Shop
shop.harvest_feast_host.desc = Recipes from my own book, popcorn by the bag, clothes for the fields and a few things for the house.
shop.harvest_feast_host.category.kitchen = Kitchen
shop.harvest_feast_host.category.clothes = Clothes
shop.harvest_feast_host.category.decor = Decorations
shop.harvest_feast_offer_recipe_turkey_pie.title = Turkey Pie Recipe
shop.harvest_feast_offer_recipe_turkey_pie.desc = Martha's own meat pie. Bake it at a Chef's Stove for more max health and less damage taken, longer than any other pie.
shop.harvest_feast_offer_recipe_harvest_salad.title = Harvest Salad Recipe
shop.harvest_feast_offer_recipe_harvest_salad.desc = Carrots, corn and pumpkin. Make it at a Chef's Stove for more max stamina, longer than any other salad.
shop.harvest_feast_offer_recipe_marthas_roast.title = Martha's Roast Recipe
shop.harvest_feast_offer_recipe_marthas_roast.desc = Her best dish, written down for family. More max health and stamina, and her favor comes faster while it lasts.
shop.harvest_feast_offer_harvest_gloves.title = Harvest Gloves
shop.harvest_feast_offer_harvest_gloves.desc = Warm wool gloves, part of the Harvest Set. Wear the whole set and you earn Martha's favor faster.
shop.harvest_feast_offer_harvest_hat.title = Harvest Hat
shop.harvest_feast_offer_harvest_hat.desc = A warm wool hat, part of the Harvest Set. Wear the whole set and you earn Martha's favor faster.
shop.harvest_feast_offer_harvest_trousers.title = Harvest Trousers
shop.harvest_feast_offer_harvest_trousers.desc = Wool trousers for the fields, part of the Harvest Set. Wear the whole set and you earn Martha's favor faster.
shop.harvest_feast_offer_harvest_tunic.title = Harvest Tunic
shop.harvest_feast_offer_harvest_tunic.desc = A wool tunic, the last piece of the Harvest Set. Wear the whole set and you earn Martha's favor faster.

# ---- The Harvest Set ----
# A set's notice is a toast, so no value carries markup.
gearset.harvest_feast_harvest_set.title = Harvest Set
gearset.harvest_feast_harvest_set.tier_half = Half the set on: a little more health.
gearset.harvest_feast_harvest_set.tier_full = The whole set on: more health again, and you earn Martha's favor faster.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Meet Martha
quest.harvest_feast_martha_meet.flavor = The fields are in, so I'm cooking in the Forgotten Temple again. Any Forgotten Temple Gateway will get you there. Come and find me, and come hungry.
objective.harvest_feast.meet_martha = Find Martha the Cook in the Forgotten Temple

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Wheat Harvest
quest.harvest_feast_host_1.flavor = Bread first, it always is. Wild wheat grows on the plains of the Emerald Wilds. Pick me a good armful by hand and bring it to the Forgotten Temple.
quest.harvest_feast_host_2.title = Turkey Hunt
quest.harvest_feast_host_2.flavor = The Wild Turkeys are out by day in the woods and on the plains of the Emerald Wilds. Hunt a few, then come back to me. The table's no good without a roast.
quest.harvest_feast_host_3.title = Your First Pie
quest.harvest_feast_host_3.flavor = Your turn at the stove. Use the recipe I gave you to learn it, bake a pumpkin pie at a Chef's Stove from dough, a pumpkin and spice, and bring it to me.
quest.harvest_feast_the_feast.title = The Feast
quest.harvest_feast_the_feast.flavor = Once a year we put it all on the table. Bake a pumpkin pie at a Chef's Stove, cook meat on a Campfire, pick carrots in the forests, and bring it all to me.

# ---- The supper deliveries: after The Feast, a plate of the leftovers for each villager ----
quest.harvest_feast_supper_tomas.title = Supper for Tomas
quest.harvest_feast_supper_tomas.flavor = Tomas hauled flour all week and never sat down. Take him a pumpkin pie from the leftovers. He's where the road meets the kweebec village in the Forgotten Temple.
quest.harvest_feast_supper_elsie.title = Supper for Elsie
quest.harvest_feast_supper_elsie.flavor = Elsie wove every cloth on that table and never ate off one. Take her a roast vegetable. She's on the far side of the kweebec village in the Forgotten Temple.
quest.harvest_feast_supper_bram.title = Supper for Bram
quest.harvest_feast_supper_bram.flavor = Bram walked his fleece down from the hills for us. Take him some cooked meat. He's on the meadow by the road into the Forgotten Temple.
objective.harvest_feast.supper_for_tomas = Take a Pumpkin Pie to Tomas the Miller
objective.harvest_feast.supper_for_elsie = Take a Roast Vegetable to Elsie the Weaver
objective.harvest_feast.supper_for_bram = Take Cooked Wildmeat to Bram the Shepherd

# ---- Martha's dailies and Extra Turkeys ----
quest.harvest_feast_daily_turkeys.title = Daily Turkeys
quest.harvest_feast_daily_turkeys.flavor = Yesterday's roast went down to the last bone. Hunt a few more Wild Turkeys in the Emerald Wilds and I'll start another.
quest.harvest_feast_daily_wheat.title = Daily Wheat
quest.harvest_feast_daily_wheat.flavor = Every loaf I baked today is already gone. Bring me more wheat from the plains, or there's no bread in the morning.
quest.harvest_feast_daily_roast.title = Daily Roast
quest.harvest_feast_daily_roast.flavor = Cook some raw meat on a Campfire and bring it here. People keep eating it before it gets to the table.
quest.harvest_feast_extra_turkeys.title = Extra Turkeys
quest.harvest_feast_extra_turkeys.flavor = I'll take every turkey you can catch. Hunt more Wild Turkeys in the Emerald Wilds, then come back to me. Do it as often as you like.

# ---- The villagers' dailies: Tomas's flour, Elsie's spices and Bram's eggs ----
quest.harvest_feast_miller_flour.title = Daily Flour
quest.harvest_feast_miller_flour.flavor = The ovens eat flour faster than my mill can grind it. Grind wheat into flour at a Chef's Stove and bring me some, and I'll see it reaches Martha.
quest.harvest_feast_weaver_spices.title = Daily Spices
quest.harvest_feast_weaver_spices.flavor = I need a little spice to dye the orange edge of the table runner, and Martha takes the rest. Make Spices at a Chef's Stove from flowers and a vegetable, and bring them to me.
quest.harvest_feast_shepherd_eggs.title = Daily Eggs
quest.harvest_feast_shepherd_eggs.flavor = Tomas wants eggs for his dough, and I'm the one who knows chickens. Keep a few in a Chicken Coop and bring me what they lay.
objective.harvest_feast.bring_tomas_flour = Bring Tomas {0} Flour
objective.harvest_feast.bring_elsie_spices = Bring Elsie {0} Spices
objective.harvest_feast.bring_bram_eggs = Bring Bram {0} {0, plural, one {Egg} other {Eggs}}

