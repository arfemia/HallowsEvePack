# Hallow's Eve pack - the calendar's words (what each event is called, and its banners), the
# notices for a find, and the Headless Horseman's fight (its lines, its Claim and its graveyard).
# Keys are written bare: the library finds each one by its tail, whatever this file is called. Banners and notices print markup as text, so none of these values carries any.

# ---- Hallow's Eve ----
calendar.hallows_eve.name = Hallow's Eve
calendar.hallows_eve.flavor = Old Jack sets up in the Forgotten Temple, and the dead walk at night.
calendar.hallows_eve.herald.start = Hallow's Eve
calendar.hallows_eve.herald.start.sub = Old Jack is waiting at the Forgotten Temple.
calendar.hallows_eve.herald.end = Hallow's Eve is over
calendar.hallows_eve.herald.end.sub = The lanterns go dark until next autumn.

# ---- Harvest Moon ----
calendar.harvest_moon.name = Harvest Moon
calendar.harvest_moon.flavor = The moon hangs fat and orange, and more of the dead climb out to see it.
calendar.harvest_moon.herald.start = Harvest Moon
calendar.harvest_moon.herald.start.sub = The dead are restless tonight. Keep a lantern lit.
calendar.harvest_moon.herald.end = The Harvest Moon sets
calendar.harvest_moon.herald.end.sub = The nights go quiet again.

# ---- Finds ----
notify.hallows_eve_geode_found = A Cursed Geode, there in the rubble.
notify.hallows_eve_pumpkin_found = A Hallowed Pumpkin, glowing in your pack.

# ---- The Headless Horseman's fight ----
notify.hallows_eve_horseman_unhorsed = The Horseman is thrown from the saddle!
notify.hallows_eve_horseman_head_off = His head flies free! Cut it down and he can be hurt again.
notify.hallows_eve_horseman_head_down = The head falls. Cut him down!
notify.hallows_eve_horseman_head_returned = His head returns to him, and his wounds close.
notify.hallows_eve_horseman_wrath = The Horseman burns with rage!
notify.hallows_eve_horseman_engaged = The Headless Horseman rides!
notify.hallows_eve_horseman_engaged.sub = Keep off the glowing rings. When his head flies off, cut it down.
notify.hallows_eve_horseman_defeated = The Headless Horseman falls!
notify.hallows_eve_horseman_wiped = The Horseman rides on.
notify.hallows_eve_horseman_wiped.sub = Cut his head down when it flies off. He can't be hurt while it's loose, and if it gets back to him, he heals.
claim.hallows_eve_horseman_chase = The Horseman's Hoard
claim.hallows_eve_horseman_chase_hard = The Horseman's Hoard (Hard)
dungeon.hallows_eve_graveyard.name = The Horseman's Graveyard
dungeon.hallows_eve_graveyard.description = A walled graveyard where the Headless Horseman rides at night. Bring friends.
dungeon.hallows_eve_graveyard.goal = Defeat the Headless Horseman. When his head flies off, cut it down, or he can't be hurt.
dungeon.hallows_eve_graveyard_hard.name = The Horseman's Graveyard (Hard)
dungeon.hallows_eve_graveyard_hard.description = The Headless Horseman rides harder here, and drops things he drops nowhere else. Bring more friends.
dungeon.hallows_eve_graveyard_hard.goal = Defeat the Headless Horseman on the hard ride. When his head flies off, cut it down, or he can't be hurt.
