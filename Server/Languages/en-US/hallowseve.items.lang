# Hallow's Eve pack - the Hallowed and Flaming Hallowed sets' and the costumes' words. Keys are written
# bare: the library finds each gear-set key by its tail, whatever this file is called. A set's notice is
# a toast, so no value carries markup.
gearset.hallows_eve_hallowed.title = Hallowed Set
gearset.hallows_eve_hallowed.tier_pair = A piece of the set on and a Jack Shield in hand: a little more health, fire bites less, you glow like a lantern, and you earn favor with the Hallowed a little faster.
gearset.hallows_eve_hallowed.tier_armor = Helm, breastplate, gauntlets and greaves on: a little more health, and anything you set alight burns hotter.
gearset.hallows_eve_hallowed.tier_armor_shield = All four on and shield in hand: more health again, and your fire burns hotter still.
gearset.hallows_eve_flaming_hallowed.title = Flaming Hallowed Set
gearset.hallows_eve_flaming_hallowed.tier_armor = A Burning Jack Helm or the Flaming Horseman's Helm, with his flaming armour on: more health, and anything you set alight burns a lot hotter.
gearset.hallows_eve_flaming_hallowed.tier_armor_shield = All four on and the Flaming Jack Shield in hand: more health again, and your fire burns hotter still.

# The costumes' names, shown when a player hovers the costume's icon. The effect JSON spells the full
# key (hallowseve.items.effect...), because the client reads an effect's Name exactly as written.
effect.hallows_eve_costume_jack.name = Jack Skeleton Costume
effect.hallows_eve_costume_lost_soul.name = Lost Soul Costume

# The Lantern Bombs' burn, named like the game's own Burn.
effect.hallows_eve_lantern_burn.name = Burn

# The Fire Resistance Potion's buff, shown when a player hovers its icon.
effect.hallows_eve_fire_resistance.name = Fire Resistance
