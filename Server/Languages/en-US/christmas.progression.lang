# Christmas progression: the season's currency, Santa's Nice List and Santa's Sack, the four Christmas
# shops and their offers, the Christmas Set, the present's gift, Santa's conversation, the Christmas
# conversations of Tomas, Elsie and Bram, and the Christmas line their feast conversations gain.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. Numbers
# ride {0} and come from the content files, so a retune never touches a translation.

# ---- Christmas Coins ----
currency.christmas_coins.name = Christmas Coins
currency.christmas_coins.amount = {0, number} {0, plural, one {Christmas Coin} other {Christmas Coins}}
currency.christmas_coins.description = Spend them at the Christmas shops in the Forgotten Temple.

# ---- Santa's Nice List ----
reputation.christmas_nice_list.name = Santa's Nice List
reputation.christmas_nice_list.flavor = Santa checks it twice. Help him get his presents back and you climb it.
reputation.christmas_nice_list.rank.neutral = Newcomer
reputation.christmas_nice_list.rank.friendly = On the List
reputation.christmas_nice_list.rank.honored = Nice
reputation.christmas_nice_list.rank.revered = Very Nice
reputation.christmas_nice_list.rank.exalted = Santa's Favorite
reputation.christmas_nice_list.earn.quests = Help Santa, Tomas, Elsie and Bram in the Forgotten Temple with their Christmas quests and daily jobs.
reputation.christmas_nice_list.earn.board = Take jobs from the Christmas Board. Ask Santa what needs doing.
reputation.christmas_nice_list.earn.thieves = Catch Present Thieves at night in the Emerald Wilds, or any time in the snow of the Whisperfrost Frontiers. Other Trorks count for a little while Christmas runs.
reputation.christmas_nice_list.earn.presents = Give a Christmas Present to a friend: hold it, look at them and left-click.
reputation.christmas_nice_list.earn.carols = Sing a carol to anyone in the temple, once a day each.
reputation.christmas_nice_list.earn.yeti = Beat the Yeti in the Yeti Cave. Bram on the meadow takes you there. Your first win each day counts the most.
reputation.christmas_nice_list.earn.talk = Stop by Santa for a word once a day.
reputation.christmas_nice_list.earn.gear = Wear the Christmas Set from Elsie's shop, or eat a Christmas Cake, and you climb faster.
lootable.christmas_santas_sack.title = Santa's Sack
lootable.christmas_santas_sack.flavor = Santa packs you one every time you climb another step past Santa's Favorite.
lootable.christmas_present_gift.title = Christmas Present
lootable.christmas_present_gift.flavor = A few coins and a little surprise.
lootable.christmas_present_given.title = A Present from a Friend
lootable.christmas_present_given.flavor = Somebody gave you this. It beats opening your own.
lootable.christmas_stocking.title = Santa's Stocking
lootable.christmas_stocking.flavor = A treat and a little spending money, and now and then a present.

