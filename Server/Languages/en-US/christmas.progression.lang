shop.christmas_santa.category.packets = Christmas Packets
shop.christmas_santa.category.treats = Treats
shop.christmas_miller.title = Tomas's Bakery
shop.christmas_miller.desc = The recipes for everything I bake for Santa, and fresh dough if you're in a hurry.
shop.christmas_miller.category.kitchen = Kitchen
shop.christmas_weaver.title = Elsie's Shop
shop.christmas_weaver.desc = Presents I have wrapped myself, a little magic, and warm clothes for the snow.
shop.christmas_weaver.category.gifts = Gifts
shop.christmas_weaver.category.clothes = Clothes
shop.christmas_shepherd.title = Bram's Snowballs
shop.christmas_shepherd.desc = Packed hard. Mind who you throw them at.
shop.christmas_shepherd.category.snow = Snow
shop.christmas_offer_recipe_gingerbread_cookie.title = Gingerbread Cookie Recipe
shop.christmas_offer_recipe_gingerbread_cookie.desc = Bake them at a Chef's Stove from dough and spices. They put a spring in your step.
shop.christmas_offer_recipe_hot_cocoa.title = Hot Cocoa Recipe
shop.christmas_offer_recipe_hot_cocoa.desc = Make it at a Chef's Stove. It keeps the cold out and your health coming back.
shop.christmas_offer_recipe_cake.title = Christmas Cake Recipe
shop.christmas_offer_recipe_cake.desc = The best thing on the table. It does everything the cookies and the cocoa do, and you climb Santa's Nice List faster while it lasts.
shop.christmas_offer_present.title = Christmas Present
shop.christmas_offer_present.desc = Wrapped by Elsie. Open it to see what's inside.
shop.christmas_offer_christmas_wand.title = Christmas Wand
shop.christmas_offer_christmas_wand.desc = Point it at a friend to dress them up as an elf or a reindeer.
shop.christmas_offer_santa_suit.title = Santa Suit
shop.christmas_offer_santa_suit.desc = Put it on and you're Santa for a while.
shop.christmas_offer_christmas_gloves.title = Christmas Gloves
shop.christmas_offer_christmas_gloves.desc = Warm gloves, part of the Christmas Set. Wear the whole set and you climb Santa's Nice List faster.
shop.christmas_offer_christmas_hat.title = Christmas Hat
shop.christmas_offer_christmas_hat.desc = A warm hat, part of the Christmas Set. Wear the whole set and you climb Santa's Nice List faster.
shop.christmas_offer_christmas_trousers.title = Christmas Trousers
shop.christmas_offer_christmas_trousers.desc = Warm trousers for the snow, part of the Christmas Set. Wear the whole set and you climb Santa's Nice List faster.
shop.christmas_offer_christmas_coat.title = Christmas Coat
shop.christmas_offer_christmas_coat.desc = A warm coat, the last piece of the Christmas Set. Wear the whole set and you climb Santa's Nice List faster.
shop.christmas_offer_snowballs_daily.title = Free Snowballs
shop.christmas_offer_snowballs_daily.desc = A bundle of snowballs from Bram, free once a day.
shop.christmas_offer_snowballs.title = Snowballs
shop.christmas_offer_snowballs.desc = Another bundle, for when the free ones are gone.
shop.christmas_offer_stocking.title = Santa's Stocking
shop.christmas_offer_stocking.desc = Free once a day. Reach in and see what Santa left you.

# ---- The Christmas Set ----
# A set's notice is a toast, so no value carries markup.
gearset.christmas_set.title = Christmas Set
gearset.christmas_set.tier_half = Half the set on: a little more health.
gearset.christmas_set.tier_full = The whole set on: more health again, the cold bites less, and you climb Santa's Nice List faster.

# ---- Santa's conversation ----
dialogue.christmas_santa.off_season.text = Christmas is over, and my sleigh's packed for home.\nCome and find me again next winter.
dialogue.christmas_santa.off_season.opt.farewell = Goodbye, Santa.
dialogue.christmas_santa.first_words.text = Ho ho ho. There you are.\nI'm Santa, and I need a hand. Trorks in Santa hats robbed my sleigh and ran off with the presents. Catch those <b>Present Thieves</b> at night in the <b>Emerald Wilds</b>, or any time in the snow of the <b>Whisperfrost Frontiers</b>, and bring my presents back.
dialogue.christmas_santa.first_words.opt.hail = I'll help, Santa.
dialogue.christmas_santa.daily_word.text = Back again? Good. That's another day on my <b>Nice List</b>.\nThe thieves are still out there. Keep an eye on the woods tonight.
dialogue.christmas_santa.menu.text = Now then. What can I do for you?
dialogue.christmas_santa.who_are_you.text = I'm Santa. Every Christmas I bring presents to everyone in Orbis.\nThis year I've got help. Tomas bakes, Elsie wraps the presents and sews, and Bram keeps everybody in snowballs.
dialogue.christmas_santa.about_thieves.text = They're Trorks in Santa hats, and they only fight with their fists, so they're no match for you.\nLook at night in the woods and fields of the <b>Emerald Wilds</b>, or any time in the snow of the <b>Whisperfrost Frontiers</b>. Plenty of them still carry a present. Open it, and it's yours.
dialogue.christmas_santa.helpers.text = <b>Tomas</b> and <b>Elsie</b> keep their shops right here beside me. While Martha's feast is still on, they're helping her by the <b>kweebec village</b> at the end of the road.\n<b>Bram</b> is out on the meadow, halfway down the road from where you came in.
dialogue.christmas_santa.opt.shop = Show me your shop.
dialogue.christmas_santa.opt.standing = How am I doing on your list?
dialogue.christmas_santa.opt.thieves = Where are the thieves?
dialogue.christmas_santa.opt.helpers = Where are your helpers?
dialogue.christmas_santa.opt.who = Who are you?
dialogue.christmas_santa.opt.back = Something else.
dialogue.christmas_santa.opt.farewell = Merry Christmas, Santa.
dialogue.christmas_santa.opt.returned = I'm back.
dialogue.christmas_santa.opt.quests = What needs doing?
dialogue.christmas_santa.opt.almanac = Show me the Almanac.
dialogue.christmas_santa.opt.story = What can I help with?
dialogue.christmas_santa.meet_arrival.text = Ho ho ho. You found me.\nI'm Santa, and I need a hand. Trorks in Santa hats robbed my sleigh on the road and ran off with the presents. Let's get them back.
dialogue.christmas_santa.meet_arrival.opt.hail = I'll help, Santa.
dialogue.christmas_santa.morning_arrival.text = Merry Christmas. Look under my tree.\nThere's a present there with your name on it.
dialogue.christmas_santa.morning_arrival.opt.open = For me?
dialogue.christmas_santa.daily_word_story_done.text = Back again? Good. That's another day on my <b>Nice List</b>.\nThe sleigh's packed, so my story's done until next Christmas. I've still got <b>jobs</b> every day, the <b>Present Thieves</b> are still out there, and the <b>shops</b> are open.
dialogue.christmas_santa.story_done.text = The sleigh's packed, and that's your doing.\nMy story's done until next Christmas, but there's plenty left. Come by every day for my <b>jobs</b>, keep catching <b>Present Thieves</b>, and see what's new in the <b>shops</b>.
dialogue.christmas_santa.story.text = First, catch the <b>Present Thieves</b> for me. Then <b>Bram</b> needs carrots for the reindeer, <b>Tomas</b> needs a hand with the cookies, and <b>Elsie</b> needs help with the wrapping. After that, come back to me for <b>Christmas Eve</b>.\nI've got jobs every day too. Ask me what needs doing.
dialogue.christmas_santa.thieves_offer.text = Those thieves still have my presents. Catch a few <b>Present Thieves</b> for me.\nThey come out at night in the woods and fields of the <b>Emerald Wilds</b>, and they're about all day in the snow of the <b>Whisperfrost Frontiers</b>. Any Trork you catch counts.
dialogue.christmas_santa.thieves_offer.opt.accept = I'll catch them.
dialogue.christmas_santa.thieves_brief.text = Look at night in the <b>Emerald Wilds</b>, or any time in the snow of the <b>Whisperfrost Frontiers</b>. Any Trork counts.\nCome back to me when you've caught enough.
dialogue.christmas_santa.thieves_ready.text = You got them. One of them had this on him. Open it, or give it to a friend.\nNow, <b>Bram</b>'s reindeer are hungry. He's on the <b>meadow</b> halfway down the road from where you came in.
dialogue.christmas_santa.thieves_ready.opt.turnin = Here you go.
dialogue.christmas_santa.eve_offer.text = It's nearly <b>Christmas Eve</b>, and the sleigh isn't full yet.\nBring me <b>Gingerbread Cookies</b> for the sack and <b>carrots</b> for the reindeer. And give me a <b>Christmas Present</b> for the sleigh.
dialogue.christmas_santa.eve_offer.opt.accept = Let's fill the sleigh.
dialogue.christmas_santa.eve_brief.text = <b>Gingerbread Cookies</b> for the sack and <b>carrots</b> for the reindeer. Bring them here.\nFor the present, hold it, look at me and left-click.
dialogue.christmas_santa.eve_ready.text = That's the sleigh full. Ho ho ho.\nThis ornament is for you. Hang it where you'll see it every Christmas.
dialogue.christmas_santa.eve_ready.opt.turnin = Merry Christmas, Santa.
dialogue.christmas_santa.carols_offer.text = Nothing warms a cold temple like a carol.\nSing one to <b>people around the Forgotten Temple</b>, then come and tell me how it went. Not me, mind. I know all the words.
dialogue.christmas_santa.carols_offer.opt.accept = I'll go and sing.
dialogue.christmas_santa.carols_brief.text = Talk to people around the temple and pick <b>Sing a carol</b>. My helpers are a good start.\nEach person will listen once a day.
dialogue.christmas_santa.carols_ready.text = I heard you from here. Not bad at all.
dialogue.christmas_santa.carols_ready.opt.turnin = Everybody sang along.
dialogue.christmas_santa.daily_thieves_offer.text = Those Trorks are back at it.\nCatch a few more <b>Present Thieves</b> for me today?
dialogue.christmas_santa.daily_thieves_offer.opt.accept = I'll catch them.
dialogue.christmas_santa.daily_presents_offer.text = My helpers work hard.\nGive each of them a <b>Christmas Present</b> today. Hold one, look at them and left-click.
dialogue.christmas_santa.daily_presents_offer.opt.accept = I'll hand them out.
dialogue.christmas_santa.presents_brief.text = Give a <b>Christmas Present</b> to <b>Tomas</b>, <b>Elsie</b> and <b>Bram</b>. Hold one, look at them and left-click.\nThe thieves drop presents, and <b>Elsie</b> sells them.
dialogue.christmas_santa.extra_thieves_ready.text = More thieves caught. My list gets longer every day.
dialogue.christmas_santa.extra_thieves_ready.opt.turnin = Here's my count.
dialogue.christmas_santa.ready_generic.text = Done already? Let's see.
dialogue.christmas_santa.ready_generic.opt.turnin = It's done.

# ---- Santa's helpers: Tomas the Miller, Elsie the Weaver and Bram the Shepherd ----
dialogue.christmas_feast_line.opt.stall = What's in your Christmas shop?
dialogue.christmas_feast_line.opt.quests = Any Christmas work for me?
dialogue.christmas_carol.opt.sing = Sing a carol
dialogue.christmas_miller.off_season.text = Christmas is over, and the oven's gone cold.\nI'll see you when the snow comes back.
dialogue.christmas_miller.off_season.opt.farewell = See you next winter.
dialogue.christmas_miller.greeting.text = Merry Christmas. Santa needs cookies for his sack, so I've brought my oven up from the mill.\nI sell the recipes for <b>Gingerbread Cookies</b>, <b>Hot Cocoa</b> and <b>Christmas Cake</b>.
dialogue.christmas_miller.dough.text = Grind <b>wheat</b> into <b>flour</b> at a <b>Chef's Stove</b>, then mix the flour with <b>eggs</b> and a <b>tankard of water</b> at the same stove.\nShort on time? I sell a little dough every day.
dialogue.christmas_miller.why.text = Trorks robbed Santa's sleigh on the road, and he asked the village for help. Elsie and Bram came too.\nSomebody has to feed the old man.
dialogue.christmas_miller.opt.stall = What are you selling?
dialogue.christmas_miller.opt.dough = How do I make dough?
dialogue.christmas_miller.opt.why = Why are you here?
dialogue.christmas_miller.opt.thanks = Thanks, Tomas.
dialogue.christmas_miller.opt.back = Good of you.
dialogue.christmas_miller.opt.farewell = Merry Christmas, Tomas.
dialogue.christmas_miller.opt.quests = Any work for me?
dialogue.christmas_miller.opt.later = Not right now.
dialogue.christmas_miller.next_elsie.text = Santa's sack won't fill itself. <b>Elsie</b> needs a hand with the wrapping.\nHer shop's right here, next to Santa. While Martha's feast is still on, she's on the far side of the <b>kweebec village</b>.
dialogue.christmas_miller.cookies_offer.text = Bram gave you my recipe? Good. Santa wants cookies in his sack.\nLearn the recipe, bake a <b>Gingerbread Cookie</b> and bring it here. I want to see how it turns out.
dialogue.christmas_miller.cookies_offer.opt.accept = I'll bake one.
dialogue.christmas_miller.cookies_brief.text = Learn the recipe, then bake a <b>Gingerbread Cookie</b> and bring me one.\nNever made dough? Ask me how.
dialogue.christmas_miller.cookies_ready.text = That's a proper gingerbread man. Smells right, too.\nKeep baking. Santa will want plenty more before Christmas Eve.
dialogue.christmas_miller.cookies_ready.opt.turnin = Here, try it.
dialogue.christmas_miller.baking_offer.text = My oven eats dough faster than I can mix it.\nBring me some <b>dough</b> today?
dialogue.christmas_miller.baking_offer.opt.accept = I'll bring dough.
dialogue.christmas_miller.baking_brief.text = Bring me some <b>dough</b>.\nNever made it? Ask me how.
dialogue.christmas_miller.baking_ready.text = Fresh dough. The oven's been waiting.
dialogue.christmas_miller.baking_ready.opt.turnin = Here's the dough.
dialogue.christmas_weaver.off_season.text = Christmas is over and the ribbons are put away.\nCome and find me next winter. I will have new presents wrapped by then.
dialogue.christmas_weaver.off_season.opt.farewell = I'll look for you.
dialogue.christmas_weaver.greeting.text = Merry Christmas. The thieves left Santa's presents torn and muddy, so I am wrapping every one again.\nI sell <b>Christmas Presents</b>, the <b>Christmas Wand</b>, the <b>Santa Suit</b> and the <b>Christmas Set</b>. The higher you are on Santa's <b>Nice List</b>, the more I can sell you.
dialogue.christmas_weaver.presents.text = Right-click a present to open it. There is always something inside, and sometimes something lovely.\nOr give it away: hold it, look at a friend and left-click. They get a better gift than you would, and Santa notices. When Santa or one of us asks for a present, hand it over the same way.\nThe <b>Present Thieves</b> carry plenty. You will find them at night in the <b>Emerald Wilds</b>.
dialogue.christmas_weaver.why.text = Santa asked the village for help, so here I am. Somebody has to wrap all of this.\nAnd somebody has to sew him a new coat. The Trorks took his spare one too.
dialogue.christmas_weaver.opt.stall = Show me what you have.
dialogue.christmas_weaver.opt.presents = What do I do with a present?
dialogue.christmas_weaver.opt.why = Why are you here?
dialogue.christmas_weaver.opt.thanks = Thank you, Elsie.
dialogue.christmas_weaver.opt.back = That's a lot of wrapping.
dialogue.christmas_weaver.opt.farewell = Merry Christmas, Elsie.
dialogue.christmas_weaver.opt.quests = Can I help?
dialogue.christmas_weaver.opt.later = Not right now.
dialogue.christmas_weaver.next_santa.text = Santa has one more job for you before <b>Christmas Eve</b>.\nGo and see him by his tree.
dialogue.christmas_weaver.wrapping_offer.text = I am running out of ribbon, and the presents will not wrap themselves.\nBring me <b>Plant Fiber</b>. And take one of your presents to <b>Bram</b> for me. He has had a hard week.
dialogue.christmas_weaver.wrapping_offer.opt.accept = I'll help.
dialogue.christmas_weaver.wrapping_brief.text = Bring me some <b>Plant Fiber</b>.\nThen give <b>Bram</b> a <b>Christmas Present</b>: hold it, look at him and left-click. He is on the <b>meadow</b> halfway down the road. No present? I sell them.
dialogue.christmas_weaver.wrapping_ready.text = Ribbon for days, and Bram is still smiling about his present.\nThese three are for you. And Santa could use another elf, so hold still.
dialogue.christmas_weaver.wrapping_ready.opt.turnin = Thank you, Elsie.
dialogue.christmas_weaver.fibre_offer.text = I am out of ribbon again.\nBring me <b>Plant Fiber</b> today and I will wrap two presents for you.
dialogue.christmas_weaver.fibre_offer.opt.accept = I'll bring some.
dialogue.christmas_weaver.fibre_brief.text = Bring me some <b>Plant Fiber</b>.
dialogue.christmas_weaver.fibre_ready.text = Good long strands. Here, two presents, wrapped this morning.
dialogue.christmas_weaver.fibre_ready.opt.turnin = Here's the fiber.
dialogue.christmas_shepherd.off_season.text = Christmas is done. Back up the hill for me.
dialogue.christmas_shepherd.off_season.opt.farewell = Safe walk home.
dialogue.christmas_shepherd.greeting.text = Merry Christmas. Santa's sleigh got robbed, so I came down to help.\nI hand out <b>snowballs</b>, a free bundle every day. Hit someone with one and they slow down for a moment. Doesn't hurt.
dialogue.christmas_shepherd.thieves.text = Trorks in Santa hats. They come out at night in the <b>woods</b> and <b>fields</b> of the <b>Emerald Wilds</b>.\nUp in the snow of the <b>Whisperfrost Frontiers</b> they're about all day. Hit one with a snowball first. Slows it right down.
dialogue.christmas_shepherd.why.text = Somebody's got to keep the snow coming.\nAnd Santa asked nicely.
dialogue.christmas_shepherd.opt.stall = Got any snowballs?
dialogue.christmas_shepherd.opt.thieves = Where are the thieves?
dialogue.christmas_shepherd.opt.why = Why are you here?
dialogue.christmas_shepherd.opt.thanks = Thanks, Bram.
dialogue.christmas_shepherd.opt.back = Fair enough.
dialogue.christmas_shepherd.opt.farewell = Merry Christmas, Bram.
dialogue.christmas_shepherd.opt.quests = Need a hand?
dialogue.christmas_shepherd.opt.later = Not right now.
dialogue.christmas_shepherd.next_tomas.text = <b>Tomas</b> wants you in the kitchen next.\nHis shop's next to Santa. While Martha's feast is still on, he's where the road meets the <b>kweebec village</b>.
dialogue.christmas_shepherd.reindeer_offer.text = Santa's reindeer haven't eaten since the Trorks hit the sleigh.\nBring me some <b>carrots</b>.
dialogue.christmas_shepherd.reindeer_offer.opt.accept = I'll find carrots.
dialogue.christmas_shepherd.reindeer_brief.text = <b>Carrots</b> for the reindeer. Bring them here.
dialogue.christmas_shepherd.reindeer_ready.text = That'll keep them flying. Snowballs, for your trouble.\nAnd Tomas left this with me for you. His cookie recipe, with a bit of dough and spice.
dialogue.christmas_shepherd.reindeer_ready.opt.turnin = Thanks, Bram.
dialogue.christmas_shepherd.carrots_offer.text = Reindeer eat all day.\nBring me more <b>carrots</b>? I'll throw in snowballs.
dialogue.christmas_shepherd.carrots_offer.opt.accept = I'll bring carrots.
dialogue.christmas_shepherd.carrots_brief.text = More <b>carrots</b>. Bring them here.
dialogue.christmas_shepherd.carrots_ready.text = Good carrots. The reindeer will fight over these.
dialogue.christmas_shepherd.carrots_ready.opt.turnin = Here you go.

# ---- Santa's story, the dailies and the carol tour ----
quest.christmas_santa_meet.title = Meet Santa
quest.christmas_santa_meet.flavor = Trorks robbed my sleigh, and I need help. I'm by my tree in the Forgotten Temple. Any Forgotten Temple Gateway will get you there.
objective.christmas.meet_santa = Find Santa in the Forgotten Temple
quest.christmas_present_thieves.title = Present Thieves
quest.christmas_present_thieves.flavor = Trorks in Santa hats ran off with my presents. Catch them at night in the Emerald Wilds, or any time in the snow of the Whisperfrost Frontiers, then come back to me.
objective.christmas.catch_thieves = Catch {0} {0, plural, one {Present Thief} other {Present Thieves}}
quest.christmas_reindeer_food.title = Reindeer Food
quest.christmas_reindeer_food.flavor = Santa's reindeer haven't eaten since the sleigh got robbed. Bring me some carrots. I'm on the meadow.
objective.christmas.bring_bram_carrots = Bring Bram {0} {0, plural, one {Carrot} other {Carrots}}
quest.christmas_gingerbread_cookies.title = Christmas Cookies
quest.christmas_gingerbread_cookies.flavor = Santa's sack needs cookies. Learn my recipe, bake a Gingerbread Cookie and bring it to me by Santa's tree.
objective.christmas.bring_tomas_cookie = Bring Tomas a Gingerbread Cookie
quest.christmas_wrapping_presents.title = Wrapping Presents
quest.christmas_wrapping_presents.flavor = I need Plant Fiber for ribbon, so bring me some. And give one of your presents to Bram on the meadow. He has had a hard week.
objective.christmas.bring_elsie_fibre = Bring Elsie {0} Plant Fiber
objective.christmas.give_bram_present = Give Bram a Christmas Present
quest.christmas_eve.title = Christmas Eve
quest.christmas_eve.flavor = The sleigh leaves tonight. Bring me Gingerbread Cookies for the sack and carrots for the reindeer, and give me a Christmas Present for the sleigh.
objective.christmas.bring_santa_cookies = Bring Santa {0} Gingerbread {0, plural, one {Cookie} other {Cookies}}
objective.christmas.bring_santa_carrots = Bring Santa {0} {0, plural, one {Carrot} other {Carrots}}
objective.christmas.give_santa_present = Give Santa a Christmas Present
quest.christmas_morning.title = Christmas Morning
quest.christmas_morning.flavor = Merry Christmas. There's a present under my tree in the Forgotten Temple, and it has your name on it. Come and open it.
objective.christmas.morning = Open your present under Santa's tree
quest.christmas_daily_thieves.title = Daily Thieves
quest.christmas_daily_thieves.flavor = Those Trorks are back at it. Catch a few more Present Thieves tonight in the Emerald Wilds, then come back to me.
quest.christmas_daily_presents.title = Daily Presents
quest.christmas_daily_presents.flavor = My helpers work hard. Give Tomas, Elsie and Bram a Christmas Present each today. Hold one, look at them and left-click.
objective.christmas.give_tomas_present = Give Tomas a Christmas Present
objective.christmas.give_elsie_present = Give Elsie a Christmas Present
quest.christmas_daily_baking.title = Daily Baking
quest.christmas_daily_baking.flavor = My oven eats dough faster than I can mix it. Bring me some.
objective.christmas.bring_tomas_dough = Bring Tomas {0} Dough
quest.christmas_daily_wrapping.title = Daily Wrapping
quest.christmas_daily_wrapping.flavor = I am out of ribbon again. Bring me Plant Fiber and I will wrap two presents for you.
quest.christmas_daily_carrots.title = Daily Carrots
quest.christmas_daily_carrots.flavor = The reindeer eat all day. Bring me carrots and I'll throw in snowballs.
quest.christmas_extra_thieves.title = Extra Thieves
quest.christmas_extra_thieves.flavor = I'll take every thief you can catch. Look at night in the Emerald Wilds, or any time in the snow of the Whisperfrost Frontiers, then come back to me. Do it as often as you like.
quest.christmas_carols.title = Christmas Carols
quest.christmas_carols.flavor = Nothing warms a cold temple like a carol. Sing one to people around the Forgotten Temple, then come and tell me how it went.
objective.christmas.sing_carols = Sing a carol to {0} {0, plural, one {person} other {people}}

# ---- The Christmas Board ----
board.christmas_daily.title = The Christmas Board
board.christmas_daily.desc = Outdoor jobs and workshop jobs, fresh every morning. The higher you are on my Nice List, the more I put up. Collect your pay before the sleigh leaves. If you're late, it waits in your Objective Book.
board.christmas_daily.grade.outdoor = Outdoor Work
board.christmas_daily.grade.workshop = Workshop Work
quest.christmas_board_thieves.title = Thief Job
quest.christmas_board_thieves.flavor = Catch Present Thieves at night in the Emerald Wilds, or any time in the snow of the Whisperfrost Frontiers. Any Trork counts.
quest.christmas_board_carrots.title = Carrot Job
quest.christmas_board_carrots.flavor = Pick carrots by hand. The reindeer are hungry again.
objective.christmas.pick_carrots = Pick {0} {0, plural, one {Carrot} other {Carrots}}
quest.christmas_board_logs.title = Log Job
quest.christmas_board_logs.flavor = Chop logs from any tree for Santa's fire. The temple gets cold at night.
objective.christmas.chop_logs = Chop {0} {0, plural, one {log} other {logs}}
quest.christmas_board_eggs.title = Egg Job
quest.christmas_board_eggs.flavor = Tomas needs eggs for his cakes. Bring some to the board.
objective.christmas.bring_eggs = Bring {0} {0, plural, one {Egg} other {Eggs}}
quest.christmas_board_cookies.title = Cookie Job
quest.christmas_board_cookies.flavor = Santa wants more cookies in his sack. Bake some Gingerbread Cookies and bring them to the board.
objective.christmas.bring_cookies = Bring {0} Gingerbread {0, plural, one {Cookie} other {Cookies}}
quest.christmas_board_dough.title = Dough Job
