# Harvest Feast - the calendar's words (what the feast is called, and its banners) and the notice for
# a find. Keys are written bare: the library finds each one by its tail, whatever this file is called.
# Banners and notices print markup as text, so none of these values carries any.

# ---- Harvest Feast ----
calendar.harvest_feast.name = Hasat Şöleni
calendar.harvest_feast.flavor = Tarlalar toplandı ve Unutulmuş Tapınak'ta uzun bir sofra kuruluyor.
calendar.harvest_feast.herald.start = Hasat Şöleni
calendar.harvest_feast.herald.start.sub = Aşçı Martha, Unutulmuş Tapınak'ta sofrayı kuruyor.
calendar.harvest_feast.herald.end = Hasat Şöleni bitti
calendar.harvest_feast.herald.end.sub = Sofra gelecek yıla kadar kaldırıldı.

# ---- Finds ----
notify.harvest_feast_spice_found = Bal kabağının arasına sıkıştırılmış bir tutam baharat.

# ---- Costumes ----
# A costume's buff-bar tile name. Its effect's Name is this key in full
# (harvestfeast.world.effect...), because the client reads an effect's Name exactly as written.
effect.harvest_feast_costume_turkey.name = Hindi Kostümü
