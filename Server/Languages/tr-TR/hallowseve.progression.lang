# Cadılar Bayramı ilerlemesi: Yaşlı Jack'in görev zinciri, günlükleri, panosu ve tezgahı, sohbeti ve
# şeker mi şaka mı satırı, sezonun başarımları ve unvanı, ve Almanak sayfası.
# Anahtarlar çıplak yazılır: kütüphane her birini kuyruğundan bulur, bu dosyanın adı ne olursa olsun.
# Sayılar {0} ile gelir ve içerik dosyalarından okunur, böylece bir yeniden ayar hiçbir çeviriye dokunmaz.

# ---- Cüzdan ----
currency.hallows_eve_sweets.name = Cadı Şekeri
currency.hallows_eve_sweets.amount = {0, number} {0, plural, one {Cadı Şekeri} other {Cadı Şekeri}}
currency.hallows_eve_sweets.description = Onları Unutulmuş Tapınak'taki Yaşlı Jack'in dükkanında harca.
quest.category.hallows_eve = Cadılar Bayramı

# ---- Yaşlı Jack'in görev zinciri ----
quest.hallows_eve_old_jack_meet.title = Tapınakta Fenerler
quest.hallows_eve_old_jack_meet.flavor = Yine mevsimi geldi, ben de Unutulmuş Tapınak'a fenerlerimle döndüm. Herhangi bir Unutulmuş Tapınak Geçidi seni oraya götürür. Gel de beni bul. Bir çift el daha işime yarar.
quest.hallows_eve_old_jack_1.title = Bal Kabağı Bostanı
quest.hallows_eve_old_jack_1.flavor = Fenerlerimi Kutsanmış Bal Kabaklarından oyuyorum ve stokum azalıyor. Kabakları elle topla, bana soğuk, parlayan olanları getir.
quest.hallows_eve_old_jack_2.title = Fener İşi
quest.hallows_eve_old_jack_2.flavor = Barutla doldurulmuş bir bal kabağı ölüleri her fenerden iyi geri tutar. Birkaç Fener Bombası at, sonra nasıl yandıklarını anlat bana.
quest.hallows_eve_old_jack_3.title = Basamaklarda Gulyabaniler
quest.hallows_eve_old_jack_3.flavor = Fenerlerim gulyabanileri basamaklardan uzak tutuyor, ama zar zor. Karanlık çökünce birkaç Oyuk Gulyabani'yi toprağa geri yolla.
quest.hallows_eve_old_jack_4.title = Ektoplazma Seferi
quest.hallows_eve_old_jack_4.flavor = Fenerlerimde yanan şey Ektoplazma, bir Kayıp Ruh da serbest kalınca biraz geride bırakır. Birkaçını serbest bırak, onu bana getir.
quest.hallows_eve_old_jack_5.title = Lanetli Taş
quest.hallows_eve_old_jack_5.flavor = Yılın bu zamanı yeterince taş kırarsan taş Lanetli Jeot verir. Birkaçını kırıp aç, içinden ne düşerse sende kalsın.
quest.hallows_eve_old_jack_lantern.title = Oyuk Fener
quest.hallows_eve_old_jack_lantern.flavor = Süvari'nin közü bende. Şimdi Oyuk Fener'in bir Kutsanmış Bal Kabağı ve biraz Ektoplazma istiyor, bir de benim yüzümü takan iskeletlerin yere serilmesini.
quest.hallows_eve_old_jack_horseman.title = Binici
quest.hallows_eve_old_jack_horseman.flavor = Yanımdaki Mezar Bekçisi Süvari'nin mezarlığına giden yolu bilir, ama Mezar Mumu olmadan kapıyı açmaz, onları da dükkanımda ben satarım. Bir tane al, arkadaşlarınla gir ve onu eyerden düşür.
quest.hallows_eve_old_jack_horseman_hard.title = Fener İçin Ateş
quest.hallows_eve_old_jack_horseman_hard.flavor = Fenerin sönmeyen bir alev istiyor, Süvari de taşıyor. Mezar Bekçisi'nden zor sürüşü iste, onu yen ve bana közünü getir.

# ---- Yaşlı Jack'in günlükleri ----
quest.hallows_eve_jack_daily_souls.title = Huzursuz Ruhlar
quest.hallows_eve_jack_daily_souls.flavor = Dün gece daha çok Kayıp Ruh süzülüp geldi. Temelli yerleşmeden birkaçını serbest bırak.
quest.hallows_eve_jack_daily_pumpkins.title = Bal Kabağı Turu
quest.hallows_eve_jack_daily_pumpkins.flavor = Fenerler Kutsanmış Bal Kabaklarını benim oyabildiğimden hızlı yakıp bitiriyor. Hava kararmadan birkaç tane daha getir.
quest.hallows_eve_jack_daily_geodes.title = Jack İçin Jeotlar
quest.hallows_eve_jack_daily_geodes.flavor = Benim için birkaç Lanetli Jeot kır. Ellerim bu aralar o iş için fazla tutuk.

# ---- Yaşlı Jack'in ödülleri ----
lootable.hallows_eve_meet_pay.title = Yaşlı Jack'in Karşılaması
lootable.hallows_eve_meet_pay.flavor = Merhaba demek için birkaç şeker.
lootable.hallows_eve_chain_pay.title = Yaşlı Jack'in Ücreti
lootable.hallows_eve_chain_pay.flavor = Yaşlı Jack'in verdiği her iş için ödediği.
lootable.hallows_eve_daily_pay.title = Yaşlı Jack'in Günlük Ücreti
lootable.hallows_eve_daily_pay.flavor = Yaşlı Jack'in bir günlük iş için ödediği.
lootable.hallows_eve_lantern_pay.title = Yaşlı Jack'in Teşekkürü
lootable.hallows_eve_lantern_pay.flavor = Yaşlı Jack'in Oyuk Fener'i yaktığın için her yıl verdiği.
lootable.hallows_eve_board_pay.title = Yaşlı Jack'in Ekstraları
lootable.hallows_eve_board_pay.flavor = Panomda çalışan herkese, işin ödediğinin üstüne biraz fazlası.
lootable.hallows_eve_board_sweets.title = Şeker Kavanozu
lootable.hallows_eve_board_sweets.flavor = Bir elime sığdırabildiğim kadar.
lootable.hallows_eve_hallowed_cache.title = Kutsanmış Zula
lootable.hallows_eve_hallowed_cache.flavor = Kutsanmışlar, onlarla Yüce'nin ötesinde bir basamak daha çıktığın her seferde bunu senin için bırakır. Nereden bulduklarını bana sorma.
lootable.hallows_eve_trick_or_treat.title = Şeker mi, Şaka mı
lootable.hallows_eve_trick_or_treat.flavor = Kapıyı çal, ne çıkacağına bak. Çoğunlukla şeker.
lootable.hallows_eve_treats.title = Tatlı Bir Şey
lootable.hallows_eve_treats.flavor = Şaka tutmadığında eline geçen.
lootable.hallows_eve_geode_crack.title = Kırık Jeot
lootable.hallows_eve_geode_crack.flavor = Bir Lanetli Jeot'u kırınca içinden ne düşerse. Her seferinde kristal, şanslıysan daha iyisi.

