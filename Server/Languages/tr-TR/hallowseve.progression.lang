# Cadılar Bayramı ilerlemesi: Yaşlı Jack'in görev zinciri, günlükleri, panosu ve tezgahı, sohbeti ve
# şeker mi şaka mı satırı, sezonun başarımları ve unvanı, ve Almanak sayfası.
# Anahtarlar çıplak yazılır: kütüphane her birini kuyruğundan bulur, bu dosyanın adı ne olursa olsun.
# Sayılar {0} ile gelir ve içerik dosyalarından okunur, böylece bir yeniden ayar hiçbir çeviriye dokunmaz.

# ---- Cüzdan ----
currency.hallows_eve_sweets.name = Cadı Şekeri

# ---- Yaşlı Jack'in görev zinciri ----
quest.hallows_eve_old_jack_1.title = Bal Kabağı Bostanı
quest.hallows_eve_old_jack_1.flavor = Bu ay bal kabağı topla, arada bir soğuk ve parlayan bir tane çıkar. O Kutsanmışlardan birkaçını bana getir.
quest.hallows_eve_old_jack_2.title = Fener İşi
quest.hallows_eve_old_jack_2.flavor = Fitili kısa bir Kutsanmış bal kabağı iyi bir Fener Bombası olur. Hak eden bir şeye birkaç tane fırlat, sonra nasıl yandıklarını anlat bana.
quest.hallows_eve_old_jack_3.title = Basamaklarda Gulyabaniler
quest.hallows_eve_old_jack_3.flavor = Karanlık çökünce Oyuk Gulyabaniler eski mezarlardan aç karnına sürünerek çıkar. Tapınak basamaklarına varmadan birkaçını toprağa geri yolla.
quest.hallows_eve_old_jack_4.title = Ektoplazma Seferi
quest.hallows_eve_old_jack_4.flavor = Kayıp Ruhlar, biri onları salıverene kadar ortalıkta süzülür. Birkaçını serbest bırak, geride bıraktıkları ektoplazmayı bana getir; fenerlerim onu içer.
quest.hallows_eve_old_jack_5.title = Lanetli Taş
quest.hallows_eve_old_jack_5.flavor = Bu ay derine kaz, taşın içinde uğuldayan jeotlar büyür. Birkaçını kırıp aç; lanetin altında, içlerinde iyi şeyler var.
quest.hallows_eve_old_jack_lantern.title = Oyuk Fener
quest.hallows_eve_old_jack_lantern.flavor = Her yıl Oyuk Fener söner, birinin de onu yeniden yakması gerekir. Benim yüzümü takmış iskeletleri yere ser, sonra fenerin neye ihtiyacı varsa getir bana.

# ---- Yaşlı Jack'in günlükleri ----
quest.hallows_eve_jack_daily_souls.title = Huzursuz Ruhlar
quest.hallows_eve_jack_daily_souls.flavor = Dün gece daha çok Kayıp Ruh süzülüp geldi. Temelli yerleşmeden birkaçını serbest bırak.
quest.hallows_eve_jack_daily_pumpkins.title = Bal Kabağı Turu
quest.hallows_eve_jack_daily_pumpkins.flavor = Fenerler Kutsanmış bal kabaklarını benim oyabildiğimden hızlı yakıp bitiriyor. Hava kararmadan birkaç tane daha getir.
quest.hallows_eve_jack_daily_geodes.title = Uğuldayan Taş
quest.hallows_eve_jack_daily_geodes.flavor = Derindeki taş yine uğulduyor. Kendiliğinden çatlamadan birkaç Lanetli Jeot kır.

