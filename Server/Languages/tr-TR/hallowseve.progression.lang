# ---- Yaşlı Jack'in sohbeti ----
dialogue.hallows_eve_old_jack.first_words.text = Kafaya takılma. Bal kabağı o, uzun zamandır da orada.\nBen Yaşlı Jack. Her sonbahar ölüler huzursuzlanır ve <color is="#ffd97a">Unutulmuş Tapınak'taki</color> fenerler söner, ben de dönüp onları yakarım. Oyulmamış bir çift el işime yarar.
dialogue.hallows_eve_old_jack.first_words.opt.hail = Tanıştığımıza memnun oldum, Jack.
dialogue.hallows_eve_old_jack.board_fresh.text = Bu gece panomda yeni iş var. Tek bir iş, parası da var.
dialogue.hallows_eve_old_jack.board_fresh.opt.board = Panoyu göster.
dialogue.hallows_eve_old_jack.board_fresh.opt.later = Sonra, Jack.
dialogue.hallows_eve_old_jack.menu.text = Fenerler yandı, gulyabaniler de gezmeye çıktı. Ne lazım?
dialogue.hallows_eve_old_jack.patch_offer.text = Bu ay bal kabağı topla, arada bir dokununca soğuk, hafif parlayan bir tane çıkar. Ben onlara <b>Kutsanmış bal kabağı</b> derim.\nBirkaç tane getir bana. Ne işe yaradıklarını gösteririm.
dialogue.hallows_eve_old_jack.patch_offer.opt.accept = Sana birkaç bal kabağı bulurum.
dialogue.hallows_eve_old_jack.patch_brief.text = Bu ay topladığın herhangi bir <b>bal kabağı</b> Kutsanmış çıkabilir. Parlayan soğukları ayır, buraya getir.
dialogue.hallows_eve_old_jack.patch_ready.text = <b>Kutsanmış bal kabakları</b>. Kiler basamağı gibi soğuk. Güzel.\nLamba yağıyla doldurulunca bunlardan biri Fener Bombası olur. Ücretinin yanına birkaç tane koydum. Git, nasıl yandıklarını gör.
dialogue.hallows_eve_old_jack.patch_ready.opt.turnin = İşte bal kabakları.
dialogue.hallows_eve_old_jack.lantern_work_offer.text = <b>Fener Bombası</b> dediğin, fitili kısa bir Kutsanmış bal kabağıdır. Yak ve fırlat. Sonra geri çekil.\nHak eden bir şeye birkaç tane fırlat, sonra gel, nasıl gittiklerini anlat.
dialogue.hallows_eve_old_jack.lantern_work_offer.opt.accept = Birkaç tane fırlatırım.
dialogue.hallows_eve_old_jack.ghouls_offer.text = <b>Oyuk Gulyabaniler</b> karanlık çökünce eski mezarlardan sürünerek çıkar, aç da çıkarlar.\nTapınak basamaklarını bulmadan birkaçını toprağa geri yolla.
dialogue.hallows_eve_old_jack.ghouls_offer.opt.accept = Gulyabanileri ben hallederim.
dialogue.hallows_eve_old_jack.souls_offer.text = Zavallı şeyler şu <b>Kayıp Ruhlar</b>. Biri onları salıverene kadar ortalıkta süzülürler.\nBirkaçını serbest bırak, geride bıraktıkları <b>ektoplazmayı</b> bana getir. Fenerlerim onu içer.
dialogue.hallows_eve_old_jack.souls_offer.opt.accept = Onları serbest bırakırım.
dialogue.hallows_eve_old_jack.geodes_offer.text = Bu ay derine kaz, taşın içinde <b>Lanetli Jeotlar</b> büyür. Onları görmeden önce duyarsın. Uğuldarlar.\nBirkaçını kırıp aç. Lanetin altında, içlerinde iyi şeyler var.
dialogue.hallows_eve_old_jack.geodes_offer.opt.accept = Birkaçını kırıp açarım.
dialogue.hallows_eve_old_jack.lantern_offer.text = Her yıl <b>Oyuk Fener</b> söner, her yıl da birinin onu yeniden yakması gerekir.\nDışarıdaki iskeletlerin bazıları benim yüzümü takıyor. Birkaç <b>Jack İskeleti</b> yere ser, sonra bana bir <b>Kutsanmış bal kabağı</b> ve onu dolduracak kadar <b>ektoplazma</b> getir.
dialogue.hallows_eve_old_jack.lantern_offer.opt.accept = Hadi yakalım.
dialogue.hallows_eve_old_jack.lantern_brief.text = <b>Jack İskeletleri</b> geceleri dolaşır. Birkaçını yere ser. Sonra bir <b>Kutsanmış bal kabağı</b> ve <b>ektoplazma</b>, birlikte yakarız.
dialogue.hallows_eve_old_jack.lantern_ready.text = Bir <b>Kutsanmış bal kabağı</b>, bir de ağzına kadar dolduracak <b>ektoplazma</b>. Benim yüzümü taşıyan iskeletler de ait oldukları yerde, çimenlerde yatıyor.\nKıpırdama. Oldu. Oyuk Fener yandı, artık senin. Seneye gel, bir tane daha yakarız.
dialogue.hallows_eve_old_jack.lantern_ready.opt.turnin = İşte bal kabağı, bir de ektoplazma.
dialogue.hallows_eve_old_jack.active_generic.text = Hâlâ uğraşıyor musun? İyi. Gece uzun, bir yere gittiği yok.
dialogue.hallows_eve_old_jack.ready_generic.text = Bana bitmiş gibi görünüyor. Bir bakalım.
dialogue.hallows_eve_old_jack.ready_generic.opt.turnin = Bitti.
dialogue.hallows_eve_old_jack.daily_souls_offer.text = Dün gece daha çok <b>Kayıp Ruh</b> süzülüp geldi. Temelli yerleşmeden birkaçını serbest bırak.
dialogue.hallows_eve_old_jack.daily_souls_offer.opt.accept = Ruhlarla ben ilgilenirim.
dialogue.hallows_eve_old_jack.daily_pumpkins_offer.text = Fenerler <b>Kutsanmış bal kabaklarını</b> benim oyabildiğimden hızlı yakıp bitiriyor. Hava kararmadan birkaç tane daha getir.
dialogue.hallows_eve_old_jack.daily_pumpkins_offer.opt.accept = Bal kabağı getiririm.
dialogue.hallows_eve_old_jack.daily_geodes_offer.text = Derindeki taş yine uğulduyor. Kendiliğinden çatlamadan birkaç <b>Lanetli Jeot</b> kır.
dialogue.hallows_eve_old_jack.daily_geodes_offer.opt.accept = Birkaç tane kırarım.
dialogue.hallows_eve_old_jack.lantern_lit.text = Oyuk Fener hâlâ yanıyor. Karanlığın en kötüsünü basamaklardan uzak tutuyor.\nNe lazım?
dialogue.hallows_eve_old_jack.who_are_you.text = Yaşlı Jack. Bir zamanlar buradan çok uzakta bir çiftliğim vardı. Sonra bir ekimde eve dönmedim, o günden beri her ekim geri geliyorum.\nBana kafayı sorma.
dialogue.hallows_eve_old_jack.about_lantern.text = Oyuk Fener dediğin, oyulup içi ektoplazmayla doldurulmuş bir Kutsanmış bal kabağıdır. Birini yakarsan ölüler mesafesini korur.\nKasıma kadar sönüp giderler. O yüzden her yıl yenisine ihtiyacım var.
dialogue.hallows_eve_old_jack.harvest_moon.text = Şu aya baktın mı? Hasat Ayı. Yılda birkaç gece iri ve turuncu yükselir, mezarlardaki her şey de onunla birlikte yükselir.\nİş istiyorsan, bu gece o gece. Uyku istiyorsan, değil.
dialogue.hallows_eve_old_jack.opt.returned = Döndüm.
dialogue.hallows_eve_old_jack.opt.quests = Yapılacak ne var?
dialogue.hallows_eve_old_jack.opt.board = Panoda ne var?
dialogue.hallows_eve_old_jack.opt.shop = Tezgahına bakalım.
dialogue.hallows_eve_old_jack.opt.almanac = Almanak'ı göster.
dialogue.hallows_eve_old_jack.opt.who = Sen kimsin?
dialogue.hallows_eve_old_jack.opt.lantern = Oyuk Fener nedir?
dialogue.hallows_eve_old_jack.opt.harvest = Ay neden bu kadar büyük?
dialogue.hallows_eve_old_jack.opt.back = Başka bir şey.
dialogue.hallows_eve_old_jack.opt.farewell = İyi geceler, Jack.

