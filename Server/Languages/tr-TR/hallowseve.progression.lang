# ---- Yaşlı Jack'in panosu ----
board.hallows_eve_daily.title = Yaşlı Jack'in Panosu
board.hallows_eve_daily.desc = Karanlık için çalış, gün ışığı için çalış. Müdavimlerim biraz daha fazla alır. Toparlanmadan önce ücretini al. Beni kaçırırsan, kazandıkların yine Görev Kitabında bekler.
quest.hallows_eve_board_souls.title = Ruh Taraması
quest.hallows_eve_board_souls.flavor = Bu gece tapınağın çevresi ruh kaynıyor. Sabah olmadan epeycesini serbest bırak.
quest.hallows_eve_board_ghouls.title = Gulyabani Temizliği
quest.hallows_eve_board_ghouls.flavor = Mezarlar bu gece hareketli. Oyuk Gulyabanileri geldikleri yere geri yolla, kibarlık da etme.
quest.hallows_eve_board_bombs.title = Fener Yaylım Ateşi
quest.hallows_eve_board_bombs.flavor = Benim için bir yığın Fener Bombası tüket. Neye attığın pek umurumda değil, yeter ki tapınak olmasın.
quest.hallows_eve_board_geodes.title = Derin Jeotlar
quest.hallows_eve_board_geodes.flavor = Lanetli Jeotlar yine taştan çıkıyor, en çok da cevherden. Benim için birkaçını kırıp aç, parmaklarına da dikkat et.
quest.hallows_eve_board_harvest_moon.title = Hasat Ayı Avı
quest.hallows_eve_board_harvest_moon.flavor = Hasat Ayı doğdu, Jack İskeletleri de sürü sürü ortalıkta. Ay batmadan epeycesini yere ser.
quest.hallows_eve_board_wraiths.title = Maden Ocağı Hortlakları
quest.hallows_eve_board_wraiths.flavor = Elinde tırpan olan bir şey hava karardıktan sonra maden ocaklarında dolaşıyor, meşalelerin ışığı yetişmeyen diplerde. Birkaçını benim için alt et.
quest.hallows_eve_board_ectoplasm.title = Fener Yakıtı
quest.hallows_eve_board_ectoplasm.flavor = Fenerlerimin Ektoplazması azalıyor. Kayıp Ruhlar serbest kalınca onu geride bırakır, o yüzden bana bolca getir.
quest.hallows_eve_board_pumpkins.title = Soğuk Kabaklar
quest.hallows_eve_board_pumpkins.flavor = Fenerler, tek başıma bulabildiğimden fazla Kutsanmış Bal Kabağı istiyor. Kabakları elle topla, bana soğuk olanları getir.
quest.hallows_eve_board_carving.title = Tezgahta Oyma
quest.hallows_eve_board_carving.flavor = Her kapı eşiği bir fener ister, ben de ancak bu kadar hızlı oyabilirim. Oyma Tezgahında birkaç Jack Feneri oy, her biri için bir kabak ve azıcık odun kömürü.

# ---- Old Jack's errands board ----
board.hallows_eve_errands.title = Yaşlı Jack'in Ayak İşleri
board.hallows_eve_errands.desc = Ufak tefek işler, biri karanlık için, biri gün ışığı için. Birkaç saatte bir yeni bir çift asıyorum, o yüzden arada uğra.
board.hallows_eve_errands.pill = Ayak İşi
quest.hallows_eve_errand_souls.title = Başıboş Ruhlar
quest.hallows_eve_errand_souls.flavor = Ben son baktığımdan beri birkaç Kayıp Ruh buraya sürüklenmiş. Bir dakikan olunca onları serbest bırak.
quest.hallows_eve_errand_ghouls.title = Mezar Nöbeti
quest.hallows_eve_errand_ghouls.flavor = Birkaç Oyuk Gulyabani yine mezarları eşeliyor. Başlarını alıp gitmeden onları yerlerine geri yatır.
quest.hallows_eve_errand_ectoplasm.title = Titreyen Fener
quest.hallows_eve_errand_ectoplasm.flavor = Fenerlerimden biri titreyip sönmek üzere. Azıcık Ektoplazma onu geceden çıkarır.
quest.hallows_eve_errand_bombs.title = Bomba Talimi
quest.hallows_eve_errand_bombs.flavor = Elinde artan Fener Bombası var mı? Benim için birkaçını at. Gürültüsünü severim.
quest.hallows_eve_errand_geodes.title = Çatlak Taş
quest.hallows_eve_errand_geodes.flavor = Dışarıdayken birkaç Lanetli Jeot kır. Birinin yapması gerek.
quest.hallows_eve_errand_pumpkins.title = Yedek Kabaklar
quest.hallows_eve_errand_pumpkins.flavor = Basamaktaki bir fener çürüyüp çökmüş. Yoldan geçerken bana birkaç Kutsanmış Bal Kabağı getir.

