
# Christmas with MMO Skill Tree, and what stands in for it without: the villagers' own job boards (a skill
# job a day where MMO Skill Tree runs, a plain errand where it does not), the season's boosts and their two
# one-day events, the Christmas Set's skill half, Christmas Morning's bag of treats, and the villagers'
# secrets with their apprentice quests and lock lines. Only a line that shows just where MMO Skill Tree
# runs names a skill, a level or XP; every other line here shows on both kinds of server, so it names none.
# Keys are written bare: MMO Skill Tree and the library find each one by its tail, whatever this file is
# called. A job or quest takes its words from the keys its id spells (quest.<id>.title and .flavor). A
# factor's name and an effect's name are read in full, christmas.mmo. and then the key.

# ---- The villagers' job boards ----
board.christmas_miller_jobs.title = Tomas'ın İşleri
board.christmas_miller_jobs.desc = Günde bir iş benden, her sabah yenisi. Noel bitmeden ücretini al. Geç kalırsan, Görev Kitabında bekler.
board.christmas_miller_jobs.grade.skill = Yetenek İşi
board.christmas_miller_jobs.grade.errand = Ufak İş
board.christmas_weaver_jobs.title = Elsie'nin İşleri
board.christmas_weaver_jobs.desc = Her gün bir iş benden, her sabah yenisi. Noel bitmeden ücretini al. Geç kalırsan, Görev Kitabında bekler.
board.christmas_weaver_jobs.grade.skill = Yetenek İşi
board.christmas_weaver_jobs.grade.errand = Ufak İş
board.christmas_shepherd_jobs.title = Bram'ın İşleri
board.christmas_shepherd_jobs.desc = Günde bir iş, her sabah yenisi. Noel bitmeden ücretini al, yoksa Görev Kitabında bekler.
board.christmas_shepherd_jobs.grade.skill = Yetenek İşi
board.christmas_shepherd_jobs.grade.errand = Ufak İş

# ---- The skill jobs (only where MMO Skill Tree runs) ----
quest.mmo_christmas_miller_skill_job.title = Üretim İşi
quest.mmo_christmas_miller_skill_job.flavor = Fırınlarım Noel'de hiç soğumaz. Bugünü bir tezgahta bir şeyler yapmakla geçir, bu işte hızlan.
quest.mmo_christmas_weaver_skill_job.title = İnşa İşi
quest.mmo_christmas_weaver_skill_job.flavor = Her ev Noel havasını ister. Bugünü kendi evinde bir şeyler kurmakla geçir, bu işte ustalaş.
quest.mmo_christmas_shepherd_skill_job.title = Odunculuk İşi
quest.mmo_christmas_shepherd_skill_job.flavor = Noel Baba'nın ateşi bütün gece odun yer. Bugünü ağaç kesmekle geçir, baltada hızlan.

# ---- The errands (only where MMO Skill Tree is missing) ----
quest.christmas_errand_wheat.title = Değirmen İçin Buğday
quest.christmas_errand_wheat.flavor = Unum kendi kendine öğütülmez. Tarlalardan biraz buğday biç ve bana getir.
quest.christmas_errand_bread.title = Sofra İçin Ekmek
quest.christmas_errand_bread.flavor = Noel Baba'nın yardımcılarının da karnı doymalı. Bir Aşçı Ocağı'nda hamurdan biraz ekmek pişir.
quest.christmas_errand_decorations.title = Süsleme İşi
quest.christmas_errand_decorations.flavor = Evine biraz Noel süsü as. Çelenk, ışık, kardan adam, parlak ne olursa olur.
quest.christmas_errand_wool.title = Çoraplar İçin Yün
quest.christmas_errand_wool.flavor = Noel çorapları için yüne ihtiyacım var. Bir dokuma tezgahında yün balyaları yap ve bana getir.
quest.christmas_errand_logs.title = Kütük İşi
quest.christmas_errand_logs.flavor = Herhangi bir ağaçtan kütük kes. Ren geyiği ağılı bu gece bir ateş istiyor.
quest.christmas_errand_wolves.title = Kurt İşi
quest.christmas_errand_wolves.flavor = Kurtlar sürümün etrafını koklayıp duruyor. Ormanlarda ya da karlı yerlerde birkaçını avla.

