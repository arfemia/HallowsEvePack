# ---- The feast board ----
board.harvest_feast_daily.title = Şölen Panosu
board.harvest_feast_daily.desc = Tarla işleri ve mutfak işleri, her sabah taze. Ne kadar çok yardım edersen senin için o kadar çok işi panoya asarım. Sofra kaldırılmadan ücretini al. Geç kalırsan, kazandıkların yine Görev Kitabında bekler.
board.harvest_feast_daily.grade.field = Tarla İşleri
board.harvest_feast_daily.grade.kitchen = Mutfak İşleri
quest.harvest_feast_board_turkeys.title = Hindi Avı
quest.harvest_feast_board_turkeys.flavor = Bu hafta ormanlar hindi dolu. Yakalayabilirsen epey indir; sanki akşam yemeğinin ne olduğunu biliyorlarmış gibi kaçıyorlar.
quest.harvest_feast_board_wheat.title = Buğday Hasadı
quest.harvest_feast_board_wheat.flavor = Yabani buğday kimseyi beklemez. Don vurmadan topla.
quest.harvest_feast_board_pies.title = Sofra İçin Turtalar
quest.harvest_feast_board_pies.flavor = Sofradaki her koltuk bir dilim istiyor. Birkaç bal kabaklı turta pişir, sıcakken getir.
quest.harvest_feast_board_roast.title = Ateş Çukuru
quest.harvest_feast_board_roast.flavor = Açık ateşte bir yığın et pişir. Koku bile insanları sofraya getirir.

