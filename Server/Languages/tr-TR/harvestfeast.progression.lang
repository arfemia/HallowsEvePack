# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Martha ile Tanış
quest.harvest_feast_martha_meet.flavor = Tarlalar toplandı, ben de yine Unutulmuş Tapınak'ta yemek pişiriyorum. Herhangi bir Unutulmuş Tapınak Geçidi seni oraya götürür. Gel de beni bul, aç gel.
objective.harvest_feast.meet_martha = Unutulmuş Tapınak'ta Aşçı Martha'yı bul

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Buğday Hasadı
quest.harvest_feast_host_1.flavor = Önce ekmek, hep öyle olur. Yabani buğday Emerald Wilds'ın düzlüklerinde yetişir. Bana iyi bir kucak dolusu elle topla ve Unutulmuş Tapınak'a getir.
quest.harvest_feast_host_2.title = Hindi Avı
quest.harvest_feast_host_2.flavor = Kızartması olmayan sofra sofra değildir. Yabani Hindileri gündüz Emerald Wilds'ın ormanlarında ve düzlüklerinde avla, sonra bana dön.
quest.harvest_feast_host_3.title = İlk Turtan
quest.harvest_feast_host_3.flavor = Ocak başı sende. Sana verdiğim tarifi öğren, bir bal kabaklı turta pişir, bana getir.
quest.harvest_feast_the_feast.title = Şölen
quest.harvest_feast_the_feast.flavor = Yılda bir her şeyi sofraya koyarız. Bana bir bal kabaklı turta, biraz pişmiş et ve havuç getir.
quest.harvest_feast_supper_tomas.title = Tomas'a Akşam Yemeği
quest.harvest_feast_supper_tomas.flavor = Tomas bütün hafta un taşıdı ve bir kez bile oturmadı. Artanlardan ona bir bal kabaklı turta götür. Unutulmuş Tapınak'ta yolun kweebec köyüyle buluştuğu yerde.
quest.harvest_feast_supper_elsie.title = Elsie'ye Akşam Yemeği
quest.harvest_feast_supper_elsie.flavor = Elsie o sofradaki bütün örtüleri dokudu ve birinin başında bile yemek yemedi. Ona bir közlenmiş sebze götür. Unutulmuş Tapınak'ta kweebec köyünün öbür ucunda.
quest.harvest_feast_supper_bram.title = Bram'a Akşam Yemeği
quest.harvest_feast_supper_bram.flavor = Bram yününü bizim için tepelerden indirdi. Ona biraz pişmiş et götür. Unutulmuş Tapınak'a giden yolun yanındaki çayırda.
objective.harvest_feast.supper_for_tomas = Değirmenci Tomas'a bir Bal Kabaklı Turta götür
objective.harvest_feast.supper_for_elsie = Dokumacı Elsie'ye bir Közlenmiş Sebze götür
objective.harvest_feast.supper_for_bram = Çoban Bram'a Pişmiş Et götür

# ---- Martha's dailies and Extra Turkeys ----
quest.harvest_feast_daily_turkeys.title = Günlük Hindiler
quest.harvest_feast_daily_turkeys.flavor = Dünkü kızartma son kemiğine dek gitti. Emerald Wilds'ta birkaç Yabani Hindi daha avla, sonra bana dön.
quest.harvest_feast_daily_wheat.title = Günlük Buğday
quest.harvest_feast_daily_wheat.flavor = Bugün pişirdiğim her somun bitti. Emerald Wilds'ın düzlüklerinden daha çok buğday topla, buraya getir.
quest.harvest_feast_daily_roast.title = Günlük Kızartma
quest.harvest_feast_daily_roast.flavor = Kızartma sofraya varmadan yeniyor. Biraz et pişir, buraya getir.
quest.harvest_feast_extra_turkeys.title = Fazladan Hindiler
quest.harvest_feast_extra_turkeys.flavor = Yakalayabildiğin her hindiyi alırım. Emerald Wilds'ta Yabani Hindi avla, sonra bana dön, istediğin kadar sık.
quest.harvest_feast_miller_flour.title = Günlük Un
quest.harvest_feast_miller_flour.flavor = Fırınlar unu değirmenimin öğütebildiğinden hızlı yiyor. Bana biraz getir.
quest.harvest_feast_weaver_spices.title = Günlük Baharat
quest.harvest_feast_weaver_spices.flavor = Yolluğun kenarını turuncuya boyamak için baharat lazım. Bana biraz getir.
quest.harvest_feast_shepherd_eggs.title = Günlük Yumurta
quest.harvest_feast_shepherd_eggs.flavor = Tomas hamuru için yumurta istiyor, tavukları bilen de benim. Bana biraz getir.
