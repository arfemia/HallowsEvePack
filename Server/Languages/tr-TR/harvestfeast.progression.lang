# ---- The feast board ----
board.harvest_feast_daily.title = Şölen Panosu
board.harvest_feast_daily.desc = Tarla işleri ve mutfak işleri, her sabah taze. Ne kadar çok yardım edersen senin için o kadar çok işi panoya asarım. Sofra kaldırılmadan ücretini al. Geç kalırsan, kazandıkların yine Görev Kitabında bekler.
board.harvest_feast_daily.grade.field = Tarla İşleri
board.harvest_feast_daily.grade.kitchen = Mutfak İşleri
quest.harvest_feast_board_turkeys.title = Hindi İşi
quest.harvest_feast_board_turkeys.flavor = Yabani Hindileri gündüz Emerald Wilds'ın ormanlarında ve düzlüklerinde avla. Akşam yemeğinin ne olduğunu biliyorlarmış gibi kaçıyorlar.
quest.harvest_feast_board_wheat.title = Buğday İşi
quest.harvest_feast_board_wheat.flavor = Emerald Wilds'ın düzlüklerinde yabani buğdayı elle topla. Don vurmadan önce toplanmalı, beklemez.
quest.harvest_feast_board_pumpkins.title = Bal Kabağı İşi
quest.harvest_feast_board_pumpkins.flavor = Emerald Wilds'ın sonbahar ormanlarında bal kabağını elle topla. Her turta bir bal kabağıyla başlar.
quest.harvest_feast_board_carrots.title = Havuç İşi
quest.harvest_feast_board_carrots.flavor = Emerald Wilds'ın ormanlarında havucu elle topla. Sofra için dolu bir sepet istiyorum.
quest.harvest_feast_board_pies.title = Turta İşi
quest.harvest_feast_board_pies.flavor = Bir Aşçı Ocağı'nda bal kabaklı turta pişir ve sıcakken sofraya getir.
quest.harvest_feast_board_roast.title = Pişirme İşi
quest.harvest_feast_board_roast.flavor = Çiğ eti bir Kamp Ateşi'nde pişir ve sofraya getir. Koku bile insanları çeker.
quest.harvest_feast_board_vegetables.title = Sebze İşi
quest.harvest_feast_board_vegetables.flavor = Sebzeleri bir Kamp Ateşi'nde közle ve sofraya getir. Bir havuç, mısır, bal kabağı ya da mantar işi görür.
quest.harvest_feast_board_spices.title = Baharat İşi
quest.harvest_feast_board_spices.flavor = Bir Aşçı Ocağı'nda çiçeklerden ve bir sebzeden baharat yap ya da bal kabağı toplarken bulduklarını sakla. Buraya getir.

# ---- The feast shop ----
shop.harvest_feast_host.title = Şölen Dükkanı
shop.harvest_feast_host.desc = Kendi defterimden tarifler, torba torba patlamış mısır, tarla için giysiler ve ev için birkaç şey.
shop.harvest_feast_host.category.kitchen = Mutfak
shop.harvest_feast_host.category.clothes = Giysiler
shop.harvest_feast_host.category.decor = Süsler
shop.harvest_feast_offer_recipe_turkey_pie.title = Hindili Turta Tarifi
shop.harvest_feast_offer_recipe_turkey_pie.desc = Martha'nın kendi etli turtası. Bir Aşçı Ocağı'nda pişir; azami canı artırır, alınan hasarı azaltır, hem de diğer turtalardan daha uzun sürer.
shop.harvest_feast_offer_recipe_harvest_salad.title = Hasat Salatası Tarifi
shop.harvest_feast_offer_recipe_harvest_salad.desc = Havuç, mısır ve bal kabağı. Bir Aşçı Ocağı'nda yap; azami dayanıklılığı artırır, diğer salatalardan daha uzun sürer.
shop.harvest_feast_offer_recipe_marthas_roast.title = Martha'nın Kızartması Tarifi
shop.harvest_feast_offer_recipe_marthas_roast.desc = En iyi yemeği, aileye yazılmış. Azami can ve dayanıklılığı artırır, sürdüğü müddetçe Martha'nın teveccühü daha hızlı gelir.
shop.harvest_feast_offer_harvest_gloves.title = Hasat Eldivenleri
shop.harvest_feast_offer_harvest_gloves.desc = Sıcak yün eldivenler, Hasat Setinin parçası. Setin tamamını giy, Martha'nın teveccühünü daha hızlı kazan.
shop.harvest_feast_offer_harvest_hat.title = Hasat Şapkası
shop.harvest_feast_offer_harvest_hat.desc = Sıcak bir yün şapka, Hasat Setinin parçası. Setin tamamını giy, Martha'nın teveccühünü daha hızlı kazan.
shop.harvest_feast_offer_harvest_trousers.title = Hasat Pantolonu
shop.harvest_feast_offer_harvest_trousers.desc = Tarla için yün pantolon, Hasat Setinin parçası. Setin tamamını giy, Martha'nın teveccühünü daha hızlı kazan.
shop.harvest_feast_offer_harvest_tunic.title = Hasat Tuniği
shop.harvest_feast_offer_harvest_tunic.desc = Bir yün tunik, Hasat Setinin son parçası. Setin tamamını giy, Martha'nın teveccühünü daha hızlı kazan.

