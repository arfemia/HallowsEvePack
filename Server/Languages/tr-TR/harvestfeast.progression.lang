shop.harvest_feast_host.desc = Kendi defterimden tarifler, torba torba patlamış mısır ve ev için birkaç şey.
shop.harvest_feast_host.category.kitchen = Mutfak
shop.harvest_feast_host.category.decor = Süsler
shop.harvest_feast_offer_recipe_apple_pie.title = Elmalı Turta Tarifi
shop.harvest_feast_offer_recipe_apple_pie.desc = Bir kez oku, elmalı turtayı artık hep pişirebilirsin.
shop.harvest_feast_offer_recipe_meat_pie.title = Etli Turta Tarifi
shop.harvest_feast_offer_recipe_meat_pie.desc = Martha'nın kendi etli turtası, sofranın dostları için yazıldı.
shop.harvest_feast_offer_recipe_caesar_salad.title = Sezar Salata Tarifi
shop.harvest_feast_offer_recipe_caesar_salad.desc = Martha'nın Sezar salatası, aile için yazıldı.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Tapınakta Akşam Yemeği
quest.harvest_feast_martha_meet.flavor = Tarlalar toplandı, ben de yine Unutulmuş Tapınak'ta yemek pişiriyorum. Herhangi bir Unutulmuş Tapınak Geçidi seni oraya götürür. Gel de beni bul, aç gel.
objective.harvest_feast.meet_martha = Unutulmuş Tapınak'ta Aşçı Martha'yı bul

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Fırınlar İçin Buğday
quest.harvest_feast_host_1.flavor = Önce ekmek, hep öyle olur. Yabani buğday yılın bu zamanı gür büyür, bana fırınlar için bir kucak dolusu getir.
quest.harvest_feast_host_2.title = Hindi Avı
quest.harvest_feast_host_2.flavor = Yabani hindiler bu ay semiz ve gürültülü, göründükleri kadar da aptal değiller. Birkaçını indir; kızartması olmayan sofra sofra değildir.
quest.harvest_feast_host_3.title = İlk Turta
quest.harvest_feast_host_3.flavor = Ocak başı sende. Şu tarifi öğren, bir Aşçı Ocağı'nda bal kabaklı turta pişir ve bana getir.
quest.harvest_feast_the_feast.title = Uzun Sofra
quest.harvest_feast_the_feast.flavor = Yılda bir her şeyi sofraya koyar, kimse ayakta duramayana dek yeriz. Bir turta, biraz kızartma ve bir sepet havuç getir, birlikte kuralım.

# ---- Martha's dailies ----
