# ---- The feast board ----
board.harvest_feast_daily.title = Şölen Panosu
board.harvest_feast_daily.desc = Tarla işleri ve mutfak işleri, her sabah taze. Ne kadar çok yardım edersen senin için o kadar çok işi panoya asarım. Sofra kaldırılmadan ücretini al. Geç kalırsan, kazandıkların yine Görev Kitabında bekler.
board.harvest_feast_daily.grade.field = Tarla İşleri
board.harvest_feast_daily.grade.kitchen = Mutfak İşleri
quest.harvest_feast_board_turkeys.title = Hindi İşi
quest.harvest_feast_board_turkeys.flavor = Yabani Hindileri gündüz Emerald Wilds'ın ormanlarında ve düzlüklerinde avla. Akşam yemeğinin ne olduğunu biliyorlarmış gibi kaçıyorlar.
quest.harvest_feast_board_wheat.title = Buğday İşi
quest.harvest_feast_board_wheat.flavor = Emerald Wilds'ın düzlüklerinde yabani buğdayı elle topla. Don vurmadan önce toplanmalı, beklemez.
quest.harvest_feast_board_pumpkins.title = Bal Kabağı İşi
quest.harvest_feast_board_pumpkins.flavor = Emerald Wilds'ın sonbahar ormanlarında bal kabağını elle topla. Her turta bir bal kabağıyla başlar.
quest.harvest_feast_board_carrots.title = Havuç İşi
quest.harvest_feast_board_carrots.flavor = Emerald Wilds'ın ormanlarında havucu elle topla. Sofra için dolu bir sepet istiyorum.
quest.harvest_feast_board_pies.title = Turta İşi
quest.harvest_feast_board_pies.flavor = Bir Aşçı Ocağı'nda bal kabaklı turta pişir ve sıcakken sofraya getir.
quest.harvest_feast_board_roast.title = Pişirme İşi
quest.harvest_feast_board_roast.flavor = Çiğ eti bir Kamp Ateşi'nde pişir ve sofraya getir. Koku bile insanları çeker.
quest.harvest_feast_board_vegetables.title = Sebze İşi
quest.harvest_feast_board_vegetables.flavor = Sebzeleri bir Kamp Ateşi'nde közle ve sofraya getir. Bir havuç, mısır, bal kabağı ya da mantar işi görür.
quest.harvest_feast_board_spices.title = Baharat İşi
quest.harvest_feast_board_spices.flavor = Bir Aşçı Ocağı'nda çiçeklerden ve bir sebzeden baharat yap ya da bal kabağı toplarken bulduklarını sakla. Buraya getir.

