# ---- Martha's conversation ----
dialogue.harvest_feast_host.off_season.text = Bu yılın şöleni bitti.\nTarlalar toplanınca yine gel.
dialogue.harvest_feast_host.meet_arrival.text = Gelmişsin. Ben Martha, her yıl şölen yemeğini burada ben pişiririm.\nYemekten önce yapılacak çok iş var, seni <b>buğday</b> ile başlatalım.
dialogue.harvest_feast_host.meet_arrival.opt.hail = Memnun oldum, Martha.
dialogue.harvest_feast_host.first_words.text = Ben Martha. Her yıl tarlalar toplanınca burada kim gelirse onun için şölen pişiririm.\nÖnce yapılacak çok iş var. Ne yapılacağını bana sor.
dialogue.harvest_feast_host.first_words.opt.hail = Yardım etmekten memnunum.
dialogue.harvest_feast_host.board_fresh.text = Pano bugünün işleriyle hazır, tarlada da mutfakta da. Her iş dükkanımda harcayacağın <msg key="harvestfeast.progression.currency.harvest_feast_coins.name"/> öder.
dialogue.harvest_feast_host.board_fresh.opt.later = Sonra.
dialogue.harvest_feast_host.board_fresh_friendly.text = Botlarını sil.\nPanoda artık senin için fazladan bir tarla işi var.
dialogue.harvest_feast_host.board_fresh_honored.text = Ah, iyi ki geldin.\nPanoda artık senin için fazladan bir mutfak işi var.
dialogue.harvest_feast_host.board_fresh_revered.text = Önce otur bir şey ye, yarı aç görünüyorsun.\nSonra bugünün işlerinden seç.
dialogue.harvest_feast_host.menu.text = Kazana dikkat. Senin için ne yapabilirim?
dialogue.harvest_feast_host.wheat_offer.text = Önce ekmek. Hep öyle olur.\nYabani <b>buğday</b>, <b>Emerald Wilds'ın düzlüklerinde</b> yetişir. Bana iyi bir kucak dolusu elle topla ve buraya getir.
dialogue.harvest_feast_host.wheat_offer.opt.accept = Buğday getireceğim.
dialogue.harvest_feast_host.wheat_brief.text = Yabani <b>buğday</b>, <b>Emerald Wilds'ın düzlüklerinde</b> yetişir. Elle topla ve bana buraya, tapınağa getir.
dialogue.harvest_feast_host.wheat_ready.text = Güzel bir kucak bu.\nŞimdi şölene kızartma gerek. Ücretini al, seni ava yollayayım.
dialogue.harvest_feast_host.wheat_ready.opt.turnin = İşte buğday.
dialogue.harvest_feast_host.turkeys_offer.text = <b>Yabani Hindiler</b> gündüz Emerald Wilds'ın <b>ormanlarında</b> ve <b>düzlüklerinde</b> çıkar. Göründükleri kadar aptal değiller.\nBirkaçını avla, sonra bana dön. Başına iş açarlarsa Çoban Bram'a sor.
dialogue.harvest_feast_host.turkeys_offer.opt.accept = Ava çıkacağım.
dialogue.harvest_feast_host.turkeys_brief.text = Emerald Wilds'ın <b>ormanlarında</b> ve <b>düzlüklerinde</b> gündüz <b>Yabani Hindi</b> avla, sonra bana dön.
dialogue.harvest_feast_host.turkeys_ready.text = Orman kokuyorsun. İyi.\nSıradaki iş için <b>bal kabaklı turta tarifi</b> burada, başlaman için biraz <b>hamur</b> ve <b>baharat</b> da. Kıpırdama da: bütün hafta hindi kovalayacaksan, bari biri gibi görün.
dialogue.harvest_feast_host.turkeys_ready.opt.turnin = Avdan döndüm.
dialogue.harvest_feast_host.pie_offer.text = Ocak başı sende. <b>Tarifi</b> öğren, bir <b>bal kabaklı turta</b> pişir, bana getir.\nHamur ve baharat zaten sende. Yalnızca bir <b>bal kabağı</b> lazım.
dialogue.harvest_feast_host.pie_offer.opt.accept = Sana turta pişireceğim.
dialogue.harvest_feast_host.pie_brief.text = <b>Tarifi</b> öğren, sonra bir <b>bal kabaklı turta</b> pişir, buraya getir. Hamuru Tomas bilir, baharatı Elsie.
dialogue.harvest_feast_host.pie_ready.text = Şu kokuya bak. Birinin özenle yaptığı bir turta bu.\nÜcretini al, şölene hazırlanalım.
dialogue.harvest_feast_host.pie_ready.opt.turnin = İşte turta.
dialogue.harvest_feast_host.feast_offer.text = Yılda bir her şeyi sofraya koyarız.\nBana bir <b>bal kabaklı turta</b>, biraz <b>pişmiş et</b> ve <b>havuç</b> getir.
dialogue.harvest_feast_host.feast_offer.opt.accept = Sofrayı kuralım.
dialogue.harvest_feast_host.feast_brief.text = Bir <b>bal kabaklı turta</b>, <b>pişmiş et</b> ve <b>havuç</b>. Sonra yeriz.
dialogue.harvest_feast_host.feast_ready.text = Turta, kızartma ve havuç. İşte şölen bu.\nBunu eve götür: altın tabağım, üzerinde yıl yazıyor.\nArtanlardan payını al. Senin için son bir işim var.
dialogue.harvest_feast_host.feast_ready.opt.turnin = Hepsi burada.
dialogue.harvest_feast_host.feast_done.text = Hâlâ tok musun? Ben de.\nBüyük yemek bu yıl bitti ama şölen sürerken sofra kurulu kalır. Her gün <b>iş</b> var, istediğin zaman <b>hindiler</b> de. Tomas'ın, Elsie'nin ve Bram'ın da birer <b>işi</b> var. Yardım etmeye devam et, <b>dükkanım</b> daha çok açılır.
dialogue.harvest_feast_host.deliveries_offer.text = Artanlara bak.\n<b>Tomas'a</b> bir <b>bal kabaklı turta</b>, <b>Elsie'ye</b> bir <b>közlenmiş sebze</b>, <b>Bram'a</b> da biraz <b>pişmiş et</b> götür. Bütün hafta çalıştılar, hiç oturmadılar. Sana verdiğim artanlar yeter, hepsi <b>tapınakta</b>.
dialogue.harvest_feast_host.deliveries_offer.opt.accept = Hepsine götürürüm.
dialogue.harvest_feast_host.deliveries_brief.text = <b>Tomas'a</b> bir <b>bal kabaklı turta</b>, yolun kweebec köyüyle buluştuğu yerde. <b>Elsie'ye</b> bir <b>közlenmiş sebze</b>, köyün öbür ucunda. <b>Bram'a</b> <b>pişmiş et</b>, yolun girişindeki çayırda.
dialogue.harvest_feast_host.daily_turkeys_offer.text = Dünkü kızartma son kemiğine dek gitti. <b>Emerald Wilds'ta</b> birkaç <b>Yabani Hindi</b> daha avla, sonra bana dön.
dialogue.harvest_feast_host.daily_turkeys_offer.opt.accept = Ava çıkacağım.
dialogue.harvest_feast_host.daily_wheat_offer.text = Bugün pişirdiğim her somun bitti. <b>Emerald Wilds'ın düzlüklerinden</b> daha çok <b>buğday</b> topla, buraya getir.
dialogue.harvest_feast_host.daily_wheat_offer.opt.accept = Buğday getireceğim.
dialogue.harvest_feast_host.daily_roast_offer.text = Kızartma sofraya varmadan yeniyor.\nBiraz <b>et</b> pişir, buraya getir.
dialogue.harvest_feast_host.daily_roast_offer.opt.accept = Bir kızartma getireceğim.
dialogue.harvest_feast_host.roast_brief.text = Biraz <b>et</b> pişir, buraya getir.
dialogue.harvest_feast_host.extra_turkeys_ready.text = Daha çok hindi mi? Asla hayır demem.\nÜcretinle birlikte bir <b>Dilek Kemiği</b> de burada. <b>Hindi Mezarlığı</b> için hazır olunca bana geri getir. Daha çok avlamak istersen yapılacak işleri sor.
dialogue.harvest_feast_host.extra_turkeys_ready.opt.turnin = Sana daha çok hindi.
dialogue.harvest_feast_host.ready_generic.text = Neler getirdiğine bir bakayım.
dialogue.harvest_feast_host.ready_generic.opt.turnin = Bitti.
dialogue.harvest_feast_host.opt.returned = Döndüm.
dialogue.harvest_feast_host.opt.quests = Yapılacak ne var?
dialogue.harvest_feast_host.opt.shop = Dükkanına bakalım.
dialogue.harvest_feast_host.opt.graveyard = Hindi Mezarlığı'nı anlat.
dialogue.harvest_feast_host.opt.standing = Nezdinde durumum nasıl?
dialogue.harvest_feast_host.opt.almanac = Almanak'ı göster.
dialogue.harvest_feast_host.opt.back = Başka bir şey.
dialogue.harvest_feast_host.graveyard.text = Şölende yenen her hindi ruhunu geride bırakır. Hepsi eski bir <b>mezarlıkta</b> toplanıyor ve huzur bulmuyorlar. Büyük olan da bulmuyor.\nBana bir <b>Dilek Kemiği</b> getir, seni ve grubunu oraya yollarım. <b>Fazladan Hindiler</b> teslim ettiğin her seferinde sana bir tane veririm. Ruhları yatıştır, sonra <b>Büyük Hindi</b>'yi; hepsi dinlenir.\nBenim için <b>Büyük Hindi</b> görevini bitir, sana <b>zor yolu</b> gösteririm. Aynı Dilek Kemiği, daha azgın bir kuş ve daha iyi bir sandık.
dialogue.harvest_feast_host.graveyard.opt.enter = Beni Hindi Mezarlığı'na götür. (bir Dilek Kemiği harcar)
dialogue.harvest_feast_host.graveyard.opt.enter_hard = Beni zor yoldan götür. (bir Dilek Kemiği harcar)
dialogue.harvest_feast_host.opt.farewell = Sofrada görüşürüz.

# ---- The shared meal and the invitation tour ----
quest.harvest_feast_shared_meal.title = Ortak Sofra
quest.harvest_feast_shared_meal.flavor = Soframda kimse tek başına yemez. Bir sebze közle, buraya getir ve bir süre otur.
quest.harvest_feast_invitations.title = Davetli Listesi
quest.harvest_feast_invitations.flavor = Uzun sofra yarı boşken olmaz. Unutulmuş Tapınak çevresindeki insanlarla konuş, onları şölene davet et, sonra gelip kimlerin geleceğini söyle.
objective.harvest_feast.invite = {0} kişiyi şölene davet et
dialogue.harvest_feast_host.meal_offer.text = Soframda kimse tek başına yemez.\nBir <b>sebze</b> közle, buraya getir, paylaşırız. İstersen her gün uğra.
dialogue.harvest_feast_host.meal_offer.opt.accept = Bir şey getireceğim.
dialogue.harvest_feast_host.meal_brief.text = Herhangi bir <b>sebzeyi</b> közle, sofraya getir.
dialogue.harvest_feast_host.meal_ready.text = Otur, otur. Onu bana uzat, benimkinden de al.\nYarın yine gel, yine yeriz.
dialogue.harvest_feast_host.meal_ready.opt.turnin = Paylaşalım.
dialogue.harvest_feast_host.invitations_offer.text = Uzun sofra yarı boşken olmaz.\nBenden başka herkesle konuş, onları şölene davet et. Tapınaktaki <b>Tomas</b>, <b>Elsie</b> ve <b>Bram</b> iyi bir başlangıç. Birkaç kişiye sor, sonra dön ve kimin geleceğini söyle.
dialogue.harvest_feast_host.invitations_offer.opt.accept = Haberi yayacağım.
dialogue.harvest_feast_host.invitations_brief.text = Benden başka herkesle konuş, onları şölene davet et. Tapınaktaki <b>Tomas</b>, <b>Elsie</b> ve <b>Bram</b> ile başla. Birkaç kişiye sorunca dön.
dialogue.harvest_feast_host.invitations_ready.text = O kadar mı? Daha çok ekmek pişirsem iyi olur.
dialogue.harvest_feast_host.invitations_ready.opt.turnin = Geliyorlar.
dialogue.harvest_feast_invitation.opt.invite = Gel, Martha'nın sofrasında ye.

# ---- The feast's villagers: Tomas the Miller, Elsie the Weaver and Bram the Shepherd ----
dialogue.harvest_feast_miller.off_season.text = Şölen kaldırıldı.\nGelecek yıl tarlalar toplanınca dönerim.
dialogue.harvest_feast_miller.off_season.opt.farewell = Öyleyse gelecek yıla.
dialogue.harvest_feast_miller.greeting.text = Ben Tomas, değirmenciyim. Bu şölendeki her turta benim ununla başlar.\nPişirecek olursan hamurun nasıl yapıldığını anlatabilirim.
dialogue.harvest_feast_miller.dough.text = Önce un. Bir <b>Aşçı Ocağı'nda</b> <b>buğdayı</b> <b>una</b> öğüt.\nSonra unu aynı ocakta <b>yumurta</b> ve bir <b>maşrapa su</b> ile karıştır, hamurun hazır. Yumurtayı nerede bulacağını Bram bilir.
dialogue.harvest_feast_miller.opt.dough = Hamuru nasıl yaparım?
dialogue.harvest_feast_miller.opt.quests = Yapılacak ne var?
dialogue.harvest_feast_miller.opt.thanks = Sağ ol, Tomas.
dialogue.harvest_feast_miller.opt.farewell = İşinin başına dönebilirsin.
dialogue.harvest_feast_miller.supper.text = Bu bal kabaklı turta mı? Bana mı?\nMartha'ya sağ ol de. Gelecek yıl sofraya ilk ben otururum.
dialogue.harvest_feast_miller.supper.opt.give = Martha sana akşam yemeği gönderdi.
dialogue.harvest_feast_miller.flour_offer.text = Fırınlar unu değirmenimin öğütebildiğinden hızlı yiyor.\nBana biraz <b>un</b> getir.
dialogue.harvest_feast_miller.flour_offer.opt.accept = Sana un getireceğim.
dialogue.harvest_feast_miller.flour_offer.opt.later = Bugün olmaz.
dialogue.harvest_feast_miller.flour_brief.text = Bana biraz <b>un</b> getir.
dialogue.harvest_feast_miller.flour_ready.text = Toz gibi ince. İşte doğru dürüst un bu.\nSağ ol. Yarın yine gel, daha çok lazım olacak.
dialogue.harvest_feast_miller.flour_ready.opt.turnin = İşte unun.
dialogue.harvest_feast_weaver.off_season.text = Bu yılın şöleni bitti.\nTarlalar yine toplanınca beni bul.
dialogue.harvest_feast_weaver.off_season.opt.farewell = Seneye görüşürüz.
dialogue.harvest_feast_weaver.greeting.text = Ben Elsie. Martha'nın uzun sofrasının örtülerini ben dokudum.\nYemek pişirecek olursan baharatın nereden geldiğini anlatabilirim.
dialogue.harvest_feast_weaver.spice.text = <b>Baharatı</b> bir <b>Aşçı Ocağı'nda</b>, <b>çiçeklerden</b> ve bir <b>sebzeden</b> yaparsınız.\nYa da <b>sonbahar ormanlarında</b> elle <b>bal kabağı</b> toplarsınız. Arada bir yanında biraz baharat bulunur. Nedenini sormam.
dialogue.harvest_feast_weaver.opt.spice = Baharatı nereden bulurum?
dialogue.harvest_feast_weaver.opt.quests = Yapılacak ne var?
dialogue.harvest_feast_weaver.opt.thanks = Teşekkür ederim, Elsie.
dialogue.harvest_feast_weaver.opt.farewell = Seni oyalamayayım.
dialogue.harvest_feast_weaver.supper.text = Bu bir közlenmiş sebze mi? Bana mı?\nTeşekkür ederim. Tezgahın başında yerim.
dialogue.harvest_feast_weaver.supper.opt.give = Martha sana akşam yemeği ayırmış.
dialogue.harvest_feast_weaver.spices_offer.text = Yolluğu turuncuya boyamak için baharat lazım.\nBana biraz <b>Baharat</b> getir.
dialogue.harvest_feast_weaver.spices_offer.opt.accept = Sana biraz yaparım.
dialogue.harvest_feast_weaver.spices_offer.opt.later = Bugün olmaz.
dialogue.harvest_feast_weaver.spices_brief.text = Bana biraz <b>Baharat</b> getir. <b>Bal kabağını</b> elle toplarken bir kısmı çıkar.
dialogue.harvest_feast_weaver.spices_ready.text = Güzel bir renk. Yolluk tam doğru turuncu olacak.\nTeşekkür ederim. Yarın daha çok lazım olacak.
dialogue.harvest_feast_weaver.spices_ready.opt.turnin = İşte baharatın.
dialogue.harvest_feast_shepherd.off_season.text = Şölen bitti. Tepeye dönüyorum.
dialogue.harvest_feast_shepherd.off_season.opt.farewell = Eve sağ salim yürü.
dialogue.harvest_feast_shepherd.greeting.text = Ben Bram. Koyun güderim, hindileri de bilirim.\nİstersen bir ipucu veririm.
dialogue.harvest_feast_shepherd.turkeys.text = <b>Yabani Hindiler</b> yalnızca gündüz çıkar. Emerald Wilds'ın <b>ormanlarına</b> ve <b>düzlüklerine</b> bak. Kolay ürkerler, bir yay işe yarar.\nYumurta <b>tavuklardan</b> gelir, hindilerden değil. Bir hindiye <b>mısır</b> yedirirsen senin olur ama yumurtlamaz.
dialogue.harvest_feast_shepherd.opt.turkeys = Hindiler için ipucu var mı?
dialogue.harvest_feast_shepherd.opt.quests = Yapılacak ne var?
dialogue.harvest_feast_shepherd.opt.thanks = Sağ ol, Bram.
dialogue.harvest_feast_shepherd.opt.farewell = Şölenin tadını çıkar.
dialogue.harvest_feast_shepherd.supper.text = O et bana mı? Martha'nın işi, bahse girerim.\nOna sağ ol de.
dialogue.harvest_feast_shepherd.supper.opt.give = Martha sana akşam yemeği gönderdi.
dialogue.harvest_feast_shepherd.eggs_offer.text = Tomas hamuru için yumurta istiyor, tavukları da ben bilirim.\nBana biraz <b>yumurta</b> getir.dialogue.harvest_feast_shepherd.eggs_offer.opt.accept = Sana yumurta getireceğim.
dialogue.harvest_feast_shepherd.eggs_offer.opt.later = Bugün olmaz.
dialogue.harvest_feast_shepherd.eggs_brief.text = Bana biraz <b>yumurta</b> getir.
dialogue.harvest_feast_shepherd.eggs_ready.text = Tek bir tanesi bile çatlamamış. İyi.\nYarın yine aynısı.
dialogue.harvest_feast_shepherd.eggs_ready.opt.turnin = İşte yumurtalar.
dungeon.harvest_feast_turkey_graveyard.name = Hindi Mezarlığı
dungeon.harvest_feast_turkey_graveyard.description = Şölende avlanan hindilerin ruhları burada oyalanıyor, Büyük Hindi de onlarla. Onları özgür bırak. Arkadaşlarını getir.
dungeon.harvest_feast_turkey_graveyard.goal = Büyük Hindi'yi uyandırmak için çeşmenin etrafındaki Hindi Ruhu dalgalarını yere ser, sonra her ruhu özgür bırakmak için onu yen. Yanına gelen ruhlarla ilgilen, yoksa seni yıpratırlar.
dungeon.harvest_feast_turkey_graveyard.cost_hint = Martha, Fazladan Hindiler teslim ettiğin her seferinde sana bir Dilek Kemiği verir. Yapılacak işi ona sor.
dungeon.harvest_feast_turkey_graveyard.confirm = Dilek Kemiğini Kır
dungeon.harvest_feast_turkey_graveyard.chest = Ödülün, onun düştüğü yerdeki sandıkta seni bekliyor.
notify.harvest_feast_turkey_souls_rise = Hindi Ruhları mezarlardan yükseliyor!
notify.harvest_feast_turkey_souls_rise.sub = {0}. dalga. Büyük Hindi'yi uyandırmak için hepsini yere ser.
notify.harvest_feast_great_turkey_engaged = Büyük Hindi yükseliyor!
notify.harvest_feast_great_turkey_engaged.sub = Onu yere ser, buradaki her ruh özgür kalsın.
notify.harvest_feast_great_turkey_souls = Daha çok Hindi Ruhu onun yanına geliyor!
notify.harvest_feast_great_turkey_flock = Büyük Hindi gululdadı, sürü cevap verdi!
notify.harvest_feast_great_turkey_fury = Büyük Hindi öfkeli!
notify.harvest_feast_great_turkey_defeated = Büyük Hindi düştü, ruhlar özgür!
notify.harvest_feast_great_turkey_defeated.sub = Payın: {0}%,{1, number} saniyede.
notify.harvest_feast_great_turkey_wiped = Büyük Hindi gösterişle yoluna devam ediyor.
notify.harvest_feast_great_turkey_wiped.sub = Yanına gelen Hindi Ruhlarını yere ser, yoksa seni yıpratırlar.
claim.harvest_feast_great_turkey_chase = Büyük Hindi: Boss Zaferi
claim.harvest_feast_great_turkey_chase_hard = Büyük Hindi: Boss Zaferi (Zor)
dungeon.harvest_feast_turkey_graveyard_hard.name = Hindi Mezarlığı (Zor)
dungeon.harvest_feast_turkey_graveyard_hard.description = Büyük Hindi burada daha sert gagalar, ruhlar daha sık gelir; geride daha iyi şeyler de bırakır. Daha çok arkadaş getir.
dungeon.harvest_feast_turkey_graveyard_hard.goal = Büyük Hindi'yi uyandırmak için çeşmenin etrafındaki Hindi Ruhu dalgalarını yere ser, sonra onu yen. Yanına normal yoldakinden daha çok ruh gelir ve burada can paketi düşmez.
quest.harvest_feast_great_turkey.title = Büyük Hindi
quest.harvest_feast_great_turkey.flavor = Kızarttığımız her hindinin ruhu eski bir mezarlıkta toplanıyor, en büyüğü de ötekilerin uyumasına izin vermiyor. Bana bir Dilek Kemiği getir, seni oraya yollarım. Onu bir kez yere ser, sonra gelip bana söyle.
quest.harvest_feast_great_turkey_hard.title = Huzursuz Bir Ruh
quest.harvest_feast_great_turkey_hard.flavor = Büyük Hindi yerde kalmıyor. Zor yoldan gir; orada daha sert gagalıyor, ruhlar daha sık geliyor. Onu orada yere ser. Aynı Dilek Kemiği. Arkadaşlarını getir.
quest.harvest_feast_daily_graveyard.title = Günlük Mezarlık
quest.harvest_feast_daily_graveyard.flavor = Ruhları yine ocağımdan duyuyorum. Mezarlığa bir Dilek Kemiği götür, bugün Büyük Hindi'yi bir kez yere ser, hangi yoldan olursa.
objective.harvest_feast.defeat_great_turkey_hard = Büyük Hindi'yi zor yolda yen
objective.harvest_feast.find_golden_turkey = Bir Altın Hindi Kupası bul
achievement.harvest_feast_great_turkey_hard_down.title = Zor Mezarlık
achievement.harvest_feast_great_turkey_hard_down.desc = Hindi Mezarlığı'nda Büyük Hindi'yi zor yolda yen.
achievement.harvest_feast_golden_turkey.title = Altın Hindi
achievement.harvest_feast_golden_turkey.desc = Büyük Hindi'den bir Altın Hindi Kupası bul.
dialogue.harvest_feast_host.graveyard_offer.text = Avın neler getirdiğini gördün. Her hindi sessizce gitmez.\nRuhları eski bir <b>mezarlıkta</b> toplanıyor, en büyükleri <b>Büyük Hindi</b> de ötekilerin dinlenmesine izin vermiyor. Bana <b>Fazladan Hindiler</b>'den bir <b>Dilek Kemiği</b> getir, seni oraya yollarım. Onu bir kez yere ser, sonra gelip bana söyle.
dialogue.harvest_feast_host.graveyard_offer.opt.accept = Onu yere sereceğim.
dialogue.harvest_feast_host.graveyard_ready.text = Yerde mi? O zaman bu gece uyurlar.\nYerde kalmaz ama. Onu yendiğine göre aynı <b>Dilek Kemiği</b> ile seni <b>zor yola</b> yollayabilirim. Daha sert gagalar, ruhlar daha sık gelir; ama sandığı da daha iyidir, <b>Büyük Hindi Pelerini</b> en çok orada çıkar.
dialogue.harvest_feast_host.graveyard_ready.opt.turnin = Yere serdim.
dialogue.harvest_feast_host.graveyard_hard_offer.text = Geri geldi, üstelik daha gürültülü. Gıdaklamasını ocağımdan duydum.\n<b>Zor yoldan</b> gir, <b>Büyük Hindi</b>'yi orada yere ser. Aynı <b>Dilek Kemiği</b>. Grubunu getir. Bu sefer daha çok ruh var.
dialogue.harvest_feast_host.graveyard_hard_offer.opt.accept = Zor yolu seçeceğim.
dialogue.harvest_feast_host.graveyard_hard_ready.text = Onu zor yoldan yendin. Düşmeden otur.\nİstediğin zaman geri dön, hangi yoldan olursa. Her zafer sandığında bir şey bırakır, zor yol daha çoğunu.
dialogue.harvest_feast_host.graveyard_hard_ready.opt.turnin = Yere serdim, zor yoldan.
dialogue.harvest_feast_host.graveyard_daily_offer.text = Ruhlar yine ayakta. Buradan duyuyorum.\nBir <b>Dilek Kemiği</b> alıp <b>mezarlığa</b> git, bugün <b>Büyük Hindi</b>'yi bir kez yere ser. Hangi yoldan olursa olur.
dialogue.harvest_feast_host.graveyard_daily_offer.opt.accept = Bugün giderim.
almanac.harvest_feast.great_turkey.line = Aşçı Martha, bir Dilek Kemiği karşılığında seni Hindi Mezarlığı'na yollar. Büyük Hindi'yi bir kez yen, zor yolu açar. Arkadaşlarını getir.
almanac.harvest_feast.great_turkey.button = Boss savaşı kayıtları
almanac.harvest_feast.boss_kill.line = Her zafer, Boss Zaferi ödülünü düştüğü yerdeki sandıkta bırakır; Ödüller altında: birkaç para ve bir bal kabaklı turta, bazen de bir Hindili Turta, geri bir Dilek Kemiği, Büyük Hindi Pelerini ya da çok nadiren bir Altın Hindi Kupası. Her günün ilk zaferinde Pelerin ve kupa için yeniden şans doğar. Zor yolda daha çok verir, ikisi de çok daha sık çıkar.
almanac.harvest_feast.source.boss_kill_pie = Büyük Hindi'nin Boss Zaferi ödülünde her zaman çıkar, zor yolda daha çoğu. Bir Aşçı Ocağı'nda da pişirebilirsin.
almanac.harvest_feast.source.boss_kill_turkey_pie = Büyük Hindi'nin Boss Zaferi ödülünde sık çıkar, zor yolda daha sık, günlük ödülünde de her zaman. Martha'nın tarifini öğrendikten sonra bir Aşçı Ocağı'nda da pişirebilirsin.
almanac.harvest_feast.source.great_turkey_mantle = Yalnızca Büyük Hindi'den: Her zaferde ara sıra, günün ilk zaferinde daha sık, zor yolda çok daha sık. Martha, onu yendikten sonra zor yolu açar. Hasat Setinin göğüs parçası sayılır.
almanac.harvest_feast.source.golden_turkey_trophy = Yalnızca Büyük Hindi'den: Her zaferde çok nadiren, günün ilk zaferinde ve zor yolda daha sık. Blok olarak yerleştir.
