shop.christmas_santa.title = Noel Baba'nın Dükkanı
shop.christmas_santa.desc = Kendi hediyelerini sarman için paketler, soğukta eve yürüyüş için de şekerleme bastonları.
shop.christmas_santa.category.packets = Noel Paketleri
shop.christmas_santa.category.treats = İkramlar
shop.christmas_miller.title = Tomas'ın Fırını
shop.christmas_miller.desc = Noel Baba için pişirdiğim her şeyin tarifi, acelen varsa da taze hamur.
shop.christmas_miller.category.kitchen = Mutfak
shop.christmas_weaver.title = Elsie'nin Dükkanı
shop.christmas_weaver.desc = Kendi sardığım hediyeler, biraz büyü ve kar için sıcak giysiler.
shop.christmas_weaver.category.gifts = Hediyeler
shop.christmas_weaver.category.clothes = Giysiler
shop.christmas_shepherd.title = Bram'ın Kartopları
shop.christmas_shepherd.desc = Sımsıkı sıkılmış. Kime attığına dikkat et.
shop.christmas_shepherd.category.snow = Kar
shop.christmas_offer_recipe_gingerbread_cookie.title = Zencefilli Kurabiye Tarifi
shop.christmas_offer_recipe_gingerbread_cookie.desc = Bir Aşçı Ocağı'nda hamur ve baharattan pişir. Adımına yay gibi bir hız katarlar.
shop.christmas_offer_recipe_hot_cocoa.title = Sıcak Kakao Tarifi
shop.christmas_offer_recipe_hot_cocoa.desc = Bir Aşçı Ocağı'nda yap. Soğuğu dışarıda tutar, canın da geri gelir.
shop.christmas_offer_recipe_cake.title = Noel Pastası Tarifi
shop.christmas_offer_recipe_cake.desc = Sofradaki en iyi şey. Kurabiyelerin ve kakaonun yaptığı her şeyi yapar, sürdüğü müddetçe de Noel Baba'nın Uslular Listesi'nde daha hızlı yükselirsin.
shop.christmas_offer_present.title = Noel Hediyesi
shop.christmas_offer_present.desc = Elsie sardı. İçinde ne olduğunu görmek için aç.
shop.christmas_offer_christmas_wand.title = Noel Asası
shop.christmas_offer_christmas_wand.desc = Bir arkadaşına doğrult, onu elf ya da ren geyiği gibi giydir.
shop.christmas_offer_santa_suit.title = Noel Baba Kıyafeti
shop.christmas_offer_santa_suit.desc = Giy, bir süre Noel Baba olursun.
shop.christmas_offer_christmas_gloves.title = Noel Eldivenleri
shop.christmas_offer_christmas_gloves.desc = Sıcak eldivenler, Noel Setinin parçası. Setin tamamını giy, Noel Baba'nın Uslular Listesi'nde daha hızlı yüksel.
shop.christmas_offer_christmas_hat.title = Noel Şapkası
shop.christmas_offer_christmas_hat.desc = Sıcak bir şapka, Noel Setinin parçası. Setin tamamını giy, Noel Baba'nın Uslular Listesi'nde daha hızlı yüksel.
shop.christmas_offer_christmas_trousers.title = Noel Pantolonu
shop.christmas_offer_christmas_trousers.desc = Kar için sıcak pantolon, Noel Setinin parçası. Setin tamamını giy, Noel Baba'nın Uslular Listesi'nde daha hızlı yüksel.
shop.christmas_offer_christmas_coat.title = Noel Montu
shop.christmas_offer_christmas_coat.desc = Sıcak bir mont, Noel Setinin son parçası. Setin tamamını giy, Noel Baba'nın Uslular Listesi'nde daha hızlı yüksel.
shop.christmas_offer_snowballs_daily.title = Bedava Kartopları
shop.christmas_offer_snowballs_daily.desc = Bram'dan bir deste kartopu, günde bir kez bedava.
shop.christmas_offer_snowballs.title = Kartopları
shop.christmas_offer_snowballs.desc = Bedavalar bitince bir deste daha.
shop.christmas_offer_stocking.title = Noel Baba'nın Çorabı
shop.christmas_offer_stocking.desc = Günde bir kez bedava. Elini daldır, Noel Baba'nın sana ne bıraktığına bak.

# ---- The Christmas Set ----
# A set's notice is a toast, so no value carries markup.
gearset.christmas_set.title = Noel Seti
gearset.christmas_set.tier_half = Setin yarısı üstünde: biraz daha fazla can.
gearset.christmas_set.tier_full = Setin tamamı üstünde: yine daha fazla can, soğuk daha az ısırıyor ve Noel Baba'nın Uslular Listesi'nde daha hızlı yükseliyorsun.

# ---- Santa's conversation ----
dialogue.christmas_santa.off_season.text = Noel bitti, kızağım eve dönmek için toplandı.\nGelecek kış yine gel de beni bul.
dialogue.christmas_santa.off_season.opt.farewell = Hoşça kal, Noel Baba.
dialogue.christmas_santa.first_words.text = Ho ho ho. Demek geldin.\nBen Noel Baba'yım ve bir ele ihtiyacım var. Noel Baba şapkalı Trork'lar kızağımı soyup hediyelerle kaçtı. O <b>Hediye Hırsızlarını</b> <b>Emerald Wilds</b>'ta geceleri ya da <b>Whisperfrost Frontiers</b>'ın karında her an yakala, hediyelerimi geri getir.
dialogue.christmas_santa.first_words.opt.hail = Yardım ederim, Noel Baba.
dialogue.christmas_santa.daily_word.text = Yine mi geldin? İyi. <b>Uslular Listem</b>'de bir gün daha.\nHırsızlar hâlâ dışarıda. Bu gece ormana göz kulak ol.
dialogue.christmas_santa.menu.text = Eee. Senin için ne yapabilirim?
dialogue.christmas_santa.who_are_you.text = Ben Noel Baba'yım. Her Noel Orbis'teki herkese hediye getiririm.\nBu yıl yardımcılarım var. Tomas pişirir, Elsie hediyeleri sarar ve diker, Bram da herkesi kartopuyla doldurur.
dialogue.christmas_santa.about_thieves.text = Noel Baba şapkalı Trork'lar bunlar, yalnızca yumrukla dövüşürler, yani sana denk değiller.\n<b>Emerald Wilds</b>'ın ormanlarında ve tarlalarında geceleri ya da <b>Whisperfrost Frontiers</b>'ın karında her an bak. Birçoğunun yanında hâlâ bir hediye var. Aç, senin olsun.
dialogue.christmas_santa.helpers.text = <b>Tomas</b> ve <b>Elsie</b> dükkanlarını burada, yanımda kurdu. Martha'nın şöleni sürerken yolun sonundaki <b>kweebec köyü</b>'nün yanında ona yardım ediyorlar.\n<b>Bram</b> çayırda, içeri girdiğin yerden yolun yarısında.
dialogue.christmas_santa.opt.shop = Dükkanını göster.
dialogue.christmas_santa.opt.standing = Listende durumum nasıl?
dialogue.christmas_santa.opt.thieves = Hırsızlar nerede?
dialogue.christmas_santa.opt.helpers = Yardımcıların nerede?
dialogue.christmas_santa.opt.who = Sen kimsin?
dialogue.christmas_santa.opt.back = Başka bir şey.
dialogue.christmas_santa.opt.farewell = Mutlu Noeller, Noel Baba.
dialogue.christmas_santa.opt.returned = Döndüm.
dialogue.christmas_santa.opt.quests = Ne yapılması lazım?
dialogue.christmas_santa.opt.almanac = Almanak'ı göster.
dialogue.christmas_santa.opt.story = Ne konuda yardım edebilirim?
dialogue.christmas_santa.meet_arrival.text = Ho ho ho. Beni buldun.\nBen Noel Baba'yım ve bir ele ihtiyacım var. Noel Baba şapkalı Trork'lar yolda kızağımı soyup hediyelerle kaçtı. Hadi onları geri alalım.
dialogue.christmas_santa.meet_arrival.opt.hail = Yardım ederim, Noel Baba.
dialogue.christmas_santa.morning_arrival.text = Mutlu Noeller. Ağacımın altına bak.\nOrada üstünde adın yazan bir hediye var.
dialogue.christmas_santa.morning_arrival.opt.open = Benim için mi?
dialogue.christmas_santa.daily_word_story_done.text = Yine mi geldin? İyi. <b>Uslular Listem</b>'de bir gün daha.\nKızak hazır, yani hikâyem gelecek Noel'e kadar bitti. Her gün hâlâ <b>işlerim</b> var, <b>Hediye Hırsızları</b> hâlâ dışarıda ve <b>dükkanlar</b> açık.
dialogue.christmas_santa.story_done.text = Kızak hazır, bu da senin sayende.\nHikâyem gelecek Noel'e kadar bitti ama yapılacak çok şey var. Her gün <b>işlerim</b> için uğra, <b>Hediye Hırsızlarını</b> yakalamaya devam et, <b>dükkanlarda</b> neler yeni gör.
dialogue.christmas_santa.story.text = Önce <b>Hediye Hırsızlarını</b> benim için yakala. Sonra <b>Bram</b>'ın ren geyikleri için havuca, <b>Tomas</b>'ın kurabiyelerde bir ele, <b>Elsie</b>'nin de sarmada yardıma ihtiyacı var. Ondan sonra <b>Noel Arifesi</b> için bana dön.\nHer gün işlerim de var. Ne yapılması gerektiğini bana sor.
dialogue.christmas_santa.thieves_offer.text = O hırsızlar hâlâ hediyelerimde. Benim için birkaç <b>Hediye Hırsızı</b> yakala.\n<b>Emerald Wilds</b>'ın ormanlarında ve tarlalarında geceleri çıkıyorlar, <b>Whisperfrost Frontiers</b>'ın karında da bütün gün ortalıkta. Yakaladığın her Trork sayılır.
dialogue.christmas_santa.thieves_offer.opt.accept = Yakalarım.
dialogue.christmas_santa.thieves_brief.text = <b>Emerald Wilds</b>'ta geceleri ya da <b>Whisperfrost Frontiers</b>'ın karında her an bak. Her Trork sayılır.\nYeterince yakalayınca bana dön.
dialogue.christmas_santa.thieves_ready.text = Yakalamışsın. Birinin üstünde bu vardı. Aç ya da bir arkadaşına ver.\nŞimdi, <b>Bram</b>'ın ren geyikleri aç. O, içeri girdiğin yerden yolun yarısındaki <b>çayırda</b>.
dialogue.christmas_santa.thieves_ready.opt.turnin = Buyur.
dialogue.christmas_santa.eve_offer.text = <b>Noel Arifesi</b> neredeyse geldi, kızak da henüz dolmadı.\nÇuval için <b>Zencefilli Kurabiyeler</b>, ren geyikleri için <b>havuç</b> getir. Bir de kızak için bir <b>Noel Hediyesi</b> ver.
dialogue.christmas_santa.eve_offer.opt.accept = Kızağı dolduralım.
dialogue.christmas_santa.eve_brief.text = Çuval için <b>Zencefilli Kurabiyeler</b>, ren geyikleri için <b>havuç</b>. Buraya getir.\nHediye için elinde tut, bana bak ve sol tıkla.
dialogue.christmas_santa.eve_ready.text = Kızak doldu. Ho ho ho.\nBu süs senin için. Her Noel göreceğin bir yere as.
dialogue.christmas_santa.eve_ready.opt.turnin = Mutlu Noeller, Noel Baba.
dialogue.christmas_santa.carols_offer.text = Soğuk bir tapınağı ilahi kadar ısıtan yok.\n<b>Unutulmuş Tapınak'taki insanlara</b> bir ilahi söyle, sonra gel de nasıl geçtiğini anlat. Bana değil, dikkat et. Ben bütün sözleri bilirim.
dialogue.christmas_santa.carols_offer.opt.accept = Gidip söyleyeyim.
dialogue.christmas_santa.carols_brief.text = Tapınaktaki insanlarla konuş ve <b>İlahi söyle</b>'yi seç. Yardımcılarım iyi bir başlangıç.\nHer kişi günde bir kez dinler.
dialogue.christmas_santa.carols_ready.text = Seni buradan duydum. Hiç fena değil.
dialogue.christmas_santa.carols_ready.opt.turnin = Herkes eşlik etti.
dialogue.christmas_santa.daily_thieves_offer.text = O Trork'lar yine iş başında.\nBugün benim için birkaç <b>Hediye Hırsızı</b> daha yakalar mısın?
dialogue.christmas_santa.daily_thieves_offer.opt.accept = Yakalarım.
dialogue.christmas_santa.daily_presents_offer.text = Yardımcılarım çok çalışıyor.\nBugün her birine bir <b>Noel Hediyesi</b> ver. Birini elinde tut, ona bak ve sol tıkla.
dialogue.christmas_santa.daily_presents_offer.opt.accept = Dağıtırım.
dialogue.christmas_santa.presents_brief.text = <b>Tomas</b>'a, <b>Elsie</b>'ye ve <b>Bram</b>'a birer <b>Noel Hediyesi</b> ver. Birini elinde tut, ona bak ve sol tıkla.\nHırsızlar hediye düşürür, <b>Elsie</b> de satar.
dialogue.christmas_santa.extra_thieves_ready.text = Daha fazla hırsız yakalandı. Listem her gün uzuyor.
dialogue.christmas_santa.extra_thieves_ready.opt.turnin = İşte sayım.
dialogue.christmas_santa.ready_generic.text = Şimdiden bitti mi? Bakalım.
dialogue.christmas_santa.ready_generic.opt.turnin = Bitti.

# ---- Santa's helpers: Tomas the Miller, Elsie the Weaver and Bram the Shepherd ----
dialogue.christmas_feast_line.opt.stall = Noel dükkanında neler var?
dialogue.christmas_feast_line.opt.quests = Benim için Noel işi var mı?
dialogue.christmas_carol.opt.sing = İlahi söyle
dialogue.christmas_miller.off_season.text = Noel bitti, fırın da soğudu.\nKar geri geldiğinde görüşürüz.
dialogue.christmas_miller.off_season.opt.farewell = Gelecek kış görüşürüz.
dialogue.christmas_miller.greeting.text = Mutlu Noeller. Noel Baba'nın çuvalı için kurabiye lazım, ben de fırınımı değirmenden buraya getirdim.\n<b>Zencefilli Kurabiye</b>, <b>Sıcak Kakao</b> ve <b>Noel Pastası</b> tariflerini satarım.
dialogue.christmas_miller.dough.text = Bir <b>Aşçı Ocağı</b>'nda <b>buğdayı</b> <b>una</b> öğüt, sonra unu aynı ocakta <b>yumurta</b> ve bir <b>maşrapa su</b> ile karıştır.\nZamanın dar mı? Her gün biraz hamur satarım.
dialogue.christmas_miller.why.text = Trork'lar Noel Baba'nın kızağını yolda soydu, o da köyden yardım istedi. Elsie ile Bram de geldi.\nİhtiyarı birinin doyurması lazım.
dialogue.christmas_miller.opt.stall = Ne satıyorsun?
dialogue.christmas_miller.opt.dough = Hamuru nasıl yaparım?
dialogue.christmas_miller.opt.why = Neden buradasın?
dialogue.christmas_miller.opt.thanks = Sağ ol, Tomas.
dialogue.christmas_miller.opt.back = Çok iyisin.
dialogue.christmas_miller.opt.farewell = Mutlu Noeller, Tomas.
dialogue.christmas_miller.opt.quests = Benim için iş var mı?
dialogue.christmas_miller.opt.later = Şimdi değil.
dialogue.christmas_miller.next_elsie.text = Noel Baba'nın çuvalı kendi kendine dolmaz. <b>Elsie</b>'nin sarmada bir ele ihtiyacı var.\nDükkanı burada, Noel Baba'nın yanında. Martha'nın şöleni sürerken <b>kweebec köyü</b>'nün öbür ucunda.
dialogue.christmas_miller.cookies_offer.text = Tarifimi Bram mı verdi? İyi. Noel Baba çuvalında kurabiye istiyor.\nTarifi öğren, bir <b>Zencefilli Kurabiye</b> pişir ve buraya getir. Nasıl olmuş görmek istiyorum.
dialogue.christmas_miller.cookies_offer.opt.accept = Bir tane pişiririm.
dialogue.christmas_miller.cookies_brief.text = Tarifi öğren, sonra bir <b>Zencefilli Kurabiye</b> pişir ve bana bir tane getir.\nHiç hamur yapmadın mı? Bana nasıl yapıldığını sor.
dialogue.christmas_miller.cookies_ready.text = Tam bir zencefilli adam bu. Kokusu da yerinde.\nPişirmeye devam et. Noel Baba, Noel Arifesi'nden önce çok daha fazlasını isteyecek.
dialogue.christmas_miller.cookies_ready.opt.turnin = Al, tat.
dialogue.christmas_miller.baking_offer.text = Fırınım hamuru ben karıştırabileceğimden hızlı yiyor.\nBugün bana biraz <b>hamur</b> getirir misin?
dialogue.christmas_miller.baking_offer.opt.accept = Hamur getiririm.
dialogue.christmas_miller.baking_brief.text = Bana biraz <b>hamur</b> getir.\nHiç yapmadın mı? Bana nasıl yapıldığını sor.
dialogue.christmas_miller.baking_ready.text = Taze hamur. Fırın bekliyordu.
dialogue.christmas_miller.baking_ready.opt.turnin = İşte hamur.
dialogue.christmas_weaver.off_season.text = Noel bitti, kurdeleler kaldırıldı.\nGelecek kış gel de beni bul. O zamana kadar yeni hediyeler saracağım.
dialogue.christmas_weaver.off_season.opt.farewell = Seni ararım.
dialogue.christmas_weaver.greeting.text = Mutlu Noeller. Hırsızlar Noel Baba'nın hediyelerini yırtık ve çamurlu bıraktı, ben de hepsini yeniden sarıyorum.\n<b>Noel Hediyeleri</b>, <b>Noel Asası</b>, <b>Noel Baba Kıyafeti</b> ve <b>Noel Seti</b> satarım. Noel Baba'nın <b>Uslular Listesi</b>'nde ne kadar yüksekteysen sana o kadar fazlasını satabilirim.
dialogue.christmas_weaver.presents.text = Bir hediyeyi açmak için sağ tıkla. İçinde hep bir şey vardır, bazen de güzel bir şey.\nYa da ver gitsin: elinde tut, bir arkadaşına bak ve sol tıkla. Senin alacağından daha iyi bir hediye alırlar, Noel Baba da fark eder. Noel Baba ya da bizden biri hediye isterse aynı şekilde uzat.\n<b>Hediye Hırsızları</b> bir sürü taşır. Onları <b>Emerald Wilds</b>'ta geceleri bulursun.
dialogue.christmas_weaver.why.text = Noel Baba köyden yardım istedi, ben de buradayım. Bütün bunları birinin sarması lazım.\nBir de ona yeni bir mont dikmek lazım. Trork'lar yedeğini de aldı.
dialogue.christmas_weaver.opt.stall = Neyin var göster.
dialogue.christmas_weaver.opt.presents = Bir hediyeyle ne yapacağım?
dialogue.christmas_weaver.opt.why = Neden buradasın?
dialogue.christmas_weaver.opt.thanks = Teşekkürler, Elsie.
dialogue.christmas_weaver.opt.back = Çok fazla sarma işi var.
dialogue.christmas_weaver.opt.farewell = Mutlu Noeller, Elsie.
dialogue.christmas_weaver.opt.quests = Yardım edebilir miyim?
dialogue.christmas_weaver.opt.later = Şimdi değil.
dialogue.christmas_weaver.next_santa.text = Noel Baba'nın <b>Noel Arifesi</b>'nden önce sana bir işi daha var.\nGidip ağacının yanında onu gör.
dialogue.christmas_weaver.wrapping_offer.text = Kurdelem bitiyor ve hediyeler kendi kendine sarılmaz.\nBana <b>Bitki Lifi</b> getir. Bir de hediyelerinden birini benim için <b>Bram</b>'a götür. Zor bir hafta geçirdi.
dialogue.christmas_weaver.wrapping_offer.opt.accept = Yardım ederim.
dialogue.christmas_weaver.wrapping_brief.text = Bana biraz <b>Bitki Lifi</b> getir.\nSonra <b>Bram</b>'a bir <b>Noel Hediyesi</b> ver: elinde tut, ona bak ve sol tıkla. O, yolun yarısındaki <b>çayırda</b>. Hediyen yok mu? Ben satıyorum.
dialogue.christmas_weaver.wrapping_ready.text = Günlerce yetecek kurdele, Bram da hediyesine hâlâ gülümsüyor.\nBu üçü senin için. Noel Baba'nın bir elfe daha ihtiyacı olabilir, kıpırdama.
dialogue.christmas_weaver.wrapping_ready.opt.turnin = Teşekkürler, Elsie.
dialogue.christmas_weaver.fibre_offer.text = Kurdelem yine bitti.\nBugün bana <b>Bitki Lifi</b> getir, senin için iki hediye sarayım.
dialogue.christmas_weaver.fibre_offer.opt.accept = Biraz getiririm.
dialogue.christmas_weaver.fibre_brief.text = Bana biraz <b>Bitki Lifi</b> getir.
dialogue.christmas_weaver.fibre_ready.text = Güzel uzun teller. Al, bu sabah sarılmış iki hediye.
dialogue.christmas_weaver.fibre_ready.opt.turnin = İşte lif.
dialogue.christmas_shepherd.off_season.text = Noel bitti. Benim için tepeye geri dön.
dialogue.christmas_shepherd.off_season.opt.farewell = Eve sağ salim yürü.
dialogue.christmas_shepherd.greeting.text = Mutlu Noeller. Noel Baba'nın kızağı soyuldu, ben de yardıma indim.\nHer gün bir deste <b>kartopu</b> bedava dağıtırım. Biriyle birine vurursan o kişi bir an yavaşlar. Canını yakmaz.
dialogue.christmas_shepherd.thieves.text = Noel Baba şapkalı Trork'lar. <b>Emerald Wilds</b>'ın <b>ormanlarında</b> ve <b>tarlalarında</b> geceleri çıkarlar.\n<b>Whisperfrost Frontiers</b>'ın karında bütün gün ortalıkta. Önce birine kartopuyla vur. Hemen yavaşlatır.
dialogue.christmas_shepherd.why.text = Karın gelmeye devam etmesini birinin sağlaması lazım.\nBir de Noel Baba kibarca rica etti.
dialogue.christmas_shepherd.opt.stall = Kartopun var mı?
dialogue.christmas_shepherd.opt.thieves = Hırsızlar nerede?
dialogue.christmas_shepherd.opt.why = Neden buradasın?
dialogue.christmas_shepherd.opt.thanks = Sağ ol, Bram.
dialogue.christmas_shepherd.opt.back = Haklısın.
dialogue.christmas_shepherd.opt.farewell = Mutlu Noeller, Bram.
dialogue.christmas_shepherd.opt.quests = Yardım lazım mı?
dialogue.christmas_shepherd.opt.later = Şimdi değil.
dialogue.christmas_shepherd.next_tomas.text = Sıradaki için <b>Tomas</b> seni mutfakta istiyor.\nDükkanı Noel Baba'nın yanında. Martha'nın şöleni sürerken yolun <b>kweebec köyü</b> ile buluştuğu yerde.
dialogue.christmas_shepherd.reindeer_offer.text = Noel Baba'nın ren geyikleri Trork'lar kızağa saldırdığından beri bir şey yemedi.\nBana biraz <b>havuç</b> getir.
dialogue.christmas_shepherd.reindeer_offer.opt.accept = Havuç bulurum.
dialogue.christmas_shepherd.reindeer_brief.text = Ren geyikleri için <b>havuç</b>. Buraya getir.
dialogue.christmas_shepherd.reindeer_ready.text = Bu onları uçurmaya yeter. Zahmetin için kartopları.\nBir de Tomas bunu senin için bende bıraktı. Kurabiye tarifi, azıcık hamur ve baharatla.
dialogue.christmas_shepherd.reindeer_ready.opt.turnin = Sağ ol, Bram.
dialogue.christmas_shepherd.carrots_offer.text = Ren geyikleri bütün gün yer.\nBana biraz daha <b>havuç</b> getirir misin? Kartopu da katarım.
dialogue.christmas_shepherd.carrots_offer.opt.accept = Havuç getiririm.
dialogue.christmas_shepherd.carrots_brief.text = Biraz daha <b>havuç</b>. Buraya getir.
dialogue.christmas_shepherd.carrots_ready.text = İyi havuçlar. Ren geyikleri bunun için kapışacak.
dialogue.christmas_shepherd.carrots_ready.opt.turnin = Buyur.

# ---- Santa's story, the dailies and the carol tour ----
quest.christmas_santa_meet.title = Noel Baba ile Tanış
quest.christmas_santa_meet.flavor = Trork'lar kızağımı soydu ve yardıma ihtiyacım var. Unutulmuş Tapınak'ta ağacımın yanındayım. Herhangi bir Unutulmuş Tapınak Geçidi seni oraya götürür.
objective.christmas.meet_santa = Unutulmuş Tapınak'ta Noel Baba'yı bul
quest.christmas_present_thieves.title = Hediye Hırsızları
quest.christmas_present_thieves.flavor = Noel Baba şapkalı Trork'lar hediyelerimle kaçtı. Onları Emerald Wilds'ta geceleri ya da Whisperfrost Frontiers'ın karında her an yakala, sonra bana dön.
objective.christmas.catch_thieves = {0} {0, plural, one {Hediye Hırsızı} other {Hediye Hırsızı}} yakala
quest.christmas_reindeer_food.title = Ren Geyiği Yemi
quest.christmas_reindeer_food.flavor = Noel Baba'nın ren geyikleri kızak soyulduğundan beri bir şey yemedi. Bana biraz havuç getir. Çayırdayım.
objective.christmas.bring_bram_carrots = Bram'a {0} {0, plural, one {Havuç} other {Havuç}} getir
quest.christmas_gingerbread_cookies.title = Noel Kurabiyeleri
quest.christmas_gingerbread_cookies.flavor = Noel Baba'nın çuvalı kurabiye istiyor. Tarifimi öğren, bir Zencefilli Kurabiye pişir ve Noel Baba'nın ağacının yanında bana getir.
objective.christmas.bring_tomas_cookie = Tomas'a bir Zencefilli Kurabiye getir
quest.christmas_wrapping_presents.title = Hediye Sarma
quest.christmas_wrapping_presents.flavor = Kurdele için Bitki Lifi lazım, bana biraz getir. Bir de hediyelerinden birini çayırdaki Bram'a ver. Zor bir hafta geçirdi.
objective.christmas.bring_elsie_fibre = Elsie'ye {0} Bitki Lifi getir
objective.christmas.give_bram_present = Bram'a bir Noel Hediyesi ver
quest.christmas_eve.title = Noel Arifesi
quest.christmas_eve.flavor = Kızak bu gece yola çıkıyor. Çuval için Zencefilli Kurabiyeler, ren geyikleri için havuç getir, bir de kızak için bana bir Noel Hediyesi ver.
objective.christmas.bring_santa_cookies = Noel Baba'ya {0} Zencefilli {0, plural, one {Kurabiye} other {Kurabiye}} getir
objective.christmas.bring_santa_carrots = Noel Baba'ya {0} {0, plural, one {Havuç} other {Havuç}} getir
objective.christmas.give_santa_present = Noel Baba'ya bir Noel Hediyesi ver
quest.christmas_morning.title = Noel Sabahı
quest.christmas_morning.flavor = Mutlu Noeller. Unutulmuş Tapınak'taki ağacımın altında üstünde adın yazan bir hediye var. Gel de aç.
objective.christmas.morning = Noel Baba'nın ağacının altındaki hediyeni aç
quest.christmas_daily_thieves.title = Günlük Hırsızlar
quest.christmas_daily_thieves.flavor = O Trork'lar yine iş başında. Bu gece Emerald Wilds'ta birkaç Hediye Hırsızı daha yakala, sonra bana dön.
quest.christmas_daily_presents.title = Günlük Hediyeler
quest.christmas_daily_presents.flavor = Yardımcılarım çok çalışıyor. Bugün Tomas'a, Elsie'ye ve Bram'a birer Noel Hediyesi ver. Birini elinde tut, ona bak ve sol tıkla.
objective.christmas.give_tomas_present = Tomas'a bir Noel Hediyesi ver
objective.christmas.give_elsie_present = Elsie'ye bir Noel Hediyesi ver
quest.christmas_daily_baking.title = Günlük Pişirme
quest.christmas_daily_baking.flavor = Fırınım hamuru ben karıştırabileceğimden hızlı yiyor. Bana biraz getir.
objective.christmas.bring_tomas_dough = Tomas'a {0} Hamur getir
quest.christmas_daily_wrapping.title = Günlük Sarma
quest.christmas_daily_wrapping.flavor = Kurdelem yine bitti. Bana Bitki Lifi getir, senin için iki hediye sarayım.
quest.christmas_daily_carrots.title = Günlük Havuç
quest.christmas_daily_carrots.flavor = Ren geyikleri bütün gün yer. Bana havuç getir, kartopu da katarım.
quest.christmas_extra_thieves.title = Fazladan Hırsızlar
quest.christmas_extra_thieves.flavor = Yakalayabildiğin her hırsızı alırım. Emerald Wilds'ta geceleri ya da Whisperfrost Frontiers'ın karında her an bak, sonra bana dön. İstediğin kadar sık yap.
quest.christmas_carols.title = Noel İlahileri
quest.christmas_carols.flavor = Soğuk bir tapınağı ilahi kadar ısıtan yok. Unutulmuş Tapınak'taki insanlara bir ilahi söyle, sonra gel de nasıl geçtiğini anlat.
objective.christmas.sing_carols = {0} {0, plural, one {kişiye} other {kişiye}} ilahi söyle

