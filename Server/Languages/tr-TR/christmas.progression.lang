quest.christmas_board_presents.title = Hediye İşi
quest.christmas_board_presents.flavor = Noel Baba'ya çuvalı için Noel Hediyeleri ver. Birini elinde tut, ona bak ve sol tıkla.
objective.christmas.give_santa_presents = Noel Baba'ya {0} Noel {0, plural, one {Hediyesi} other {Hediyesi}} ver
