# ---- Christmas in the Almanac ----
almanac.christmas.title = Noel
almanac.christmas.flavor = Her kış Noel Baba Unutulmuş Tapınak'ta ağacının yanına kurulur ve köy ona yardıma gelir.
almanac.christmas.thieves_caught = Yakalanan Hediye Hırsızları
almanac.christmas.presents_opened = Açılan hediyeler
almanac.christmas.presents_given = Arkadaşlara verilen hediyeler
almanac.christmas.carols_sung = Söylenen ilahiler
almanac.christmas.snowballs_thrown = Atılan kartopları
almanac.christmas.yetis_defeated = Yenilen Yetiler
almanac.christmas.yeti.title = Yeti
almanac.christmas.yeti.line = Karlı yüksekliklerdeki bir mağaraya koca bir şey yerleşmiş. Bram'a biraz Yeti Yemi getir, seni ve arkadaşlarını Yeti Mağarası'na götürür.
almanac.christmas.source.present = Hediye Hırsızları düşürür, Elsie satar, Noel Baba ile yardımcıları da dağıtır.
almanac.christmas.source.snowball = Bram her gün bir deste bedava dağıtır.
almanac.christmas.source.cookie = Tomas'ın tarifiyle bir Aşçı Ocağı'nda pişirilir.
almanac.christmas.source.cook_dish = Tomas'ın sattığı bir tarifle öğrendikten sonra bir Aşçı Ocağı'nda yapılır.
almanac.christmas.source.recipe_cookie = Noel Baba'nın hikâyesi sırasında Bram, Tomas'tan iletir; Tomas da satar.
almanac.christmas.source.bakery_favor = Noel Baba'nın Uslular Listesi'nde yükseldikçe Tomas'ın fırınında satılır.
almanac.christmas.source.candy_cane = Noel Baba'nın dükkanında satılır, söylediğin her ilahi için de verilir.
almanac.christmas.source.elsie_favor = Noel Baba'nın Uslular Listesi'nde yükseldikçe Elsie'nin dükkanında satılır.
almanac.christmas.source.santa_suit = Elsie'nin dükkanında satılır, Noel Sabahı'nda da Noel Baba'nın ağacının altında bekler.
almanac.christmas.source.elf_suit = Elsie, ona hediye sarmada yardım ettiğin için sana bir tane verir.
almanac.christmas.source.yeti_bait = Bram'ın ren geyiklerine havuçlarını getirdiğinde onun dükkanında satılır. Bram bir tanesini alıp seni Yeti Mağarası'na götürür.
almanac.christmas.source.yeti_fur = Yeti, onu her günün ilk yenişinde ara sıra bir tane geride bırakır.
almanac.christmas.source.santa_stall = Noel Baba'nın dükkanında satılır.
almanac.christmas.source.morning = Noel Sabahı'nda Noel Baba'nın ağacının altında, ara sıra da bir Noel Baba'nın Çuvalı'nda.
almanac.christmas.source.bauble = Noel sürerken kestiğin ağaçlardan düşer ve hediyelerin içinde saklanır.
almanac.christmas.source.winter = Noel sürerken Noel Baba'nın dükkanındaki şenlik rafında satılır.
almanac.christmas.source.keepsake = Noel Arifesi'nin hatırası, Noel Baba'nın kızağını doldurmasına yardım ettiğinde yılda bir kez verilir.
almanac.christmas.source.festival_favor = Şenlik Teveccühü yüksek olanlara Noel Baba'nın dükkanındaki şenlik rafında satılır.
