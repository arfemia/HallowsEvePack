# Cadılar Bayramı paketi - Kutsanmış setin sözcükleri. Anahtarlar çıplak yazılır: kütüphane her birini
# kuyruğundan bulur, bu dosyanın adı ne olursa olsun. Setin bildirimi bir toast'tur, bu yüzden hiçbir değer biçimlendirme taşımaz.
gearset.hallows_eve_hallowed.title = Kutsanmış Set
gearset.hallows_eve_hallowed.tier_full = Miğfer başta, kalkan elde: biraz daha fazla can, ateş de daha az yakıyor, bir fener gibi parlıyorsun ve Kutsanmışların teveccühünü biraz daha hızlı kazanıyorsun.
gearset.hallows_eve_hallowed.tier_pair = Setten bir parça üstünde, elinde de bir Jack Kalkanı: biraz daha fazla can, ateş daha az yakıyor, bir fener gibi parlıyorsun ve Kutsanmışların teveccühünü biraz daha hızlı kazanıyorsun.
gearset.hallows_eve_hallowed.tier_armor = Miğfer, göğüslük, eldiven ve dizlik üstünde: biraz daha fazla can, ateşe verdiğin her şey daha sıcak yanıyor.
gearset.hallows_eve_hallowed.tier_armor_shield = Dördü de üstünde, kalkan da elde: yine biraz daha fazla can, ateşin daha da sıcak yanıyor.
gearset.hallows_eve_flaming_hallowed.title = Alevli Kutsanmış Set
gearset.hallows_eve_flaming_hallowed.tier_armor = Yanan Jack Miğferi ya da Alevli Süvari Miğferi ve onun alevli zırhı üstünde: daha fazla can, ateşe verdiğin her şey çok daha sıcak yanıyor.
gearset.hallows_eve_flaming_hallowed.tier_armor_shield = Dördü de üstünde, Alevli Jack Kalkanı da elde: yine daha fazla can, ateşin daha da sıcak yanıyor.

# The costumes' names, shown when a player hovers the costume's icon. The effect JSON spells the full
# key (hallowseve.items.effect...), because the client reads an effect's Name exactly as written.
effect.hallows_eve_costume_jack.name = Jack İskeleti Kostümü
effect.hallows_eve_costume_lost_soul.name = Kayıp Ruh Kostümü
effect.hallows_eve_lantern_burn.name = Yanık
effect.hallows_eve_fire_resistance.name = Ateş Direnci

