# Progressione della Vigilia di Ognissanti: la serie di missioni del Vecchio Jack, le giornaliere, la bacheca e il negozio,
# la sua conversazione e la battuta di dolcetto o scherzetto, gli obiettivi e il titolo della stagione, e la sua pagina dell'Almanacco.
# Le chiavi sono scritte nude: la libreria trova ciascuna dalla sua coda, comunque si chiami questo file.
# I numeri viaggiano in {0} e vengono dai file di contenuto, così una ritaratura non tocca mai una traduzione.

# ---- Il portafoglio ----
currency.hallows_eve_sweets.name = Dolcetti di Ognissanti
currency.hallows_eve_sweets.amount = {0, number} {0, plural, one {Dolcetto di Ognissanti} other {Dolcetti di Ognissanti}}
currency.hallows_eve_sweets.description = Spendili nel negozio del Vecchio Jack nel Tempio Dimenticato.
quest.category.hallows_eve = Vigilia di Ognissanti

# ---- La serie di missioni del Vecchio Jack ----
quest.hallows_eve_old_jack_meet.title = Lanterne nel Tempio
quest.hallows_eve_old_jack_meet.flavor = È tornata la stagione, quindi sono di nuovo nel Tempio Dimenticato con le mie lanterne. Ci arrivi da un Portale del Tempio Dimenticato qualsiasi. Vieni a cercarmi. Una mano mi farebbe comodo.
quest.hallows_eve_old_jack_1.title = Campo di Zucche
quest.hallows_eve_old_jack_1.flavor = Le mie lanterne sono intagliate da Zucche Consacrate, e ne sto finendo. Raccogli le zucche a mano e portami quelle fredde e luminose.
quest.hallows_eve_old_jack_2.title = Lanterne all'Opera
quest.hallows_eve_old_jack_2.flavor = Una zucca piena di polvere tiene indietro i morti meglio di qualsiasi lanterna. Tira qualche Bomba Lanterna, poi dimmi come hanno bruciato.
quest.hallows_eve_old_jack_3.title = Ghoul sui Gradini
quest.hallows_eve_old_jack_3.flavor = Le mie lanterne tengono i ghoul lontani dai gradini, ma per un soffio. Rimetti sottoterra qualche Ghoul Vuoto dopo il tramonto.
quest.hallows_eve_old_jack_4.title = Corsa all'Ectoplasma
quest.hallows_eve_old_jack_4.flavor = L'Ectoplasma è ciò che brucia nelle mie lanterne, e un'Anima Perduta ne lascia un po' quando viene liberata. Liberane qualcuna e portamelo.
quest.hallows_eve_old_jack_5.title = Pietra Maledetta
quest.hallows_eve_old_jack_5.flavor = In questa stagione la pietra cede Geodi Maledette, se ne rompi abbastanza. Spaccane qualcuna e tieni quello che ne esce.
quest.hallows_eve_old_jack_lantern.title = La Lanterna Cava
quest.hallows_eve_old_jack_lantern.flavor = Ho la brace del Cavaliere. Ora la tua Lanterna Cava vuole una Zucca Consacrata, un po' di Ectoplasma, e gli scheletri con la mia faccia stesi a terra.
quest.hallows_eve_old_jack_horseman.title = Il Cavaliere
quest.hallows_eve_old_jack_horseman.flavor = Il Custode del Cimitero qui accanto conosce la strada per il cimitero del Cavaliere, ma non apre il cancello senza una Candela Funebre, e quelle le vendo nel mio negozio quando ti considero un Habitué. Comprane una, entra con degli amici e disarcionalo.
quest.hallows_eve_old_jack_horseman_hard.title = Fuoco per la Lanterna
quest.hallows_eve_old_jack_horseman_hard.flavor = La tua lanterna vuole una fiamma che non si spenga, e il Cavaliere ne porta una. Chiedi al Custode del Cimitero la cavalcata difficile, battilo e portami la sua brace.

# ---- Le giornaliere del Vecchio Jack ----
quest.hallows_eve_jack_daily_souls.title = Anime Inquiete
quest.hallows_eve_jack_daily_souls.flavor = Ieri notte sono arrivate altre Anime Perdute. Liberane qualcuna prima che mettano radici.
quest.hallows_eve_jack_daily_horseman.title = Di Nuovo in Sella
quest.hallows_eve_jack_daily_horseman.flavor = È di nuovo in sella, come ogni notte. Porta una Candela Funebre al Custode del Cimitero e buttalo giù da quel cavallo ancora una volta. La cavalcata normale, bada bene, non quella difficile.
quest.hallows_eve_jack_daily_pumpkins.title = Giro delle Zucche
quest.hallows_eve_jack_daily_pumpkins.flavor = Le lanterne consumano le Zucche Consacrate più in fretta di quanto riesco a intagliarle. Portamene qualcun'altra prima che faccia buio.
quest.hallows_eve_jack_daily_geodes.title = Geodi per Jack
quest.hallows_eve_jack_daily_geodes.flavor = Spaccami un paio di Geodi Maledette. Ormai ho le mani troppo rigide per farlo.

# ---- What Hallow's Eve's loot tables pay: the name on the reward, and the line under it on hover ----
lootable.hallows_eve_meet_pay.title = Il Benvenuto del Vecchio Jack
lootable.hallows_eve_meet_pay.flavor = Qualche dolcetto per dire ciao.
lootable.hallows_eve_chain_pay.title = La Paga del Vecchio Jack
lootable.hallows_eve_chain_pay.flavor = Quello che il Vecchio Jack paga per ogni lavoro che ti dà.
lootable.hallows_eve_daily_pay.title = La Paga Giornaliera del Vecchio Jack
lootable.hallows_eve_daily_pay.flavor = Quello che il Vecchio Jack paga per una giornata di lavoro.
lootable.hallows_eve_lantern_pay.title = I Ringraziamenti del Vecchio Jack
lootable.hallows_eve_lantern_pay.flavor = Quello che il Vecchio Jack dà ogni anno per aver acceso la Lanterna Cava.
lootable.hallows_eve_board_pay.title = Gli Extra del Vecchio Jack
lootable.hallows_eve_board_pay.flavor = Un po' in più oltre alla paga del lavoro, per chi lavora con la mia bacheca.
lootable.hallows_eve_board_sweets.title = Il Barattolo dei Dolci
lootable.hallows_eve_board_sweets.flavor = Quanti ne riesco ad afferrare con una mano.
lootable.hallows_eve_hallowed_cache.title = Scorta dei Consacrati
lootable.hallows_eve_hallowed_cache.flavor = I Consacrati la lasciano per te ogni volta che sali un altro gradino oltre Osannato con loro. Non chiedermi dove la prendano.
lootable.hallows_eve_trick_or_treat.title = Dolcetto o Scherzetto
lootable.hallows_eve_trick_or_treat.flavor = Bussa e vedi cosa ricevi. Dolcetti, per lo più.
lootable.hallows_eve_treats.title = Qualcosa di Dolce
lootable.hallows_eve_treats.flavor = Quello che ricevi quando lo scherzetto non attacca.
lootable.hallows_eve_geode_crack.title = Geode Spaccata
lootable.hallows_eve_geode_crack.flavor = Quello che cade da una Geode Maledetta quando la spacchi. Cristallo ogni volta, e meglio se sei fortunato.

