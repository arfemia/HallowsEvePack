# ---- La bacheca del Vecchio Jack ----
board.hallows_eve_daily.title = Bacheca del Vecchio Jack
board.hallows_eve_daily.desc = Lavoro per il buio e lavoro per la luce del giorno. I miei habitué ricevono qualcosa in più. Ritira la paga prima che io sbaracchi. Se non mi trovi, quello che hai guadagnato ti aspetta comunque nel tuo Libro degli obiettivi.
quest.hallows_eve_board_souls.title = Retata di Anime
quest.hallows_eve_board_souls.flavor = Stanotte le anime sono fitte attorno al tempio. Liberane un bel po' prima del mattino.
quest.hallows_eve_board_ghouls.title = Falciata di Ghoul
quest.hallows_eve_board_ghouls.flavor = Stanotte le tombe sono affollate. Rimanda i Ghoul Vuoti da dove sono venuti, e non andarci piano.
quest.hallows_eve_board_bombs.title = Raffica di Lanterne
quest.hallows_eve_board_bombs.flavor = Brucia una pila di Bombe Lanterna per me. Contro cosa non m'importa granché, basta che non sia il tempio.
quest.hallows_eve_board_geodes.title = Geodi Profonde
quest.hallows_eve_board_geodes.flavor = Le Geodi Maledette spuntano di nuovo nella pietra, soprattutto nel minerale. Spaccamene qualcuna, e occhio alle dita.
quest.hallows_eve_board_harvest_moon.title = Caccia della Luna del Raccolto
quest.hallows_eve_board_harvest_moon.flavor = La Luna del Raccolto è sorta e gli Scheletri Jack sono fuori in gran numero. Buttane giù un bel po' prima che tramonti.
quest.hallows_eve_board_wraiths.title = Spettri delle Miniere
quest.hallows_eve_board_wraiths.flavor = Qualcosa con una falce cammina nelle miniere dopo il tramonto, laggiù dove le torce non arrivano. Abbattine qualcuno per me.
quest.hallows_eve_board_ectoplasm.title = Combustibile per Lanterne
quest.hallows_eve_board_ectoplasm.flavor = Alle mie lanterne manca l'Ectoplasma. Le Anime Perdute lo lasciano indietro quando le liberi, quindi portamene una bella scorta.
quest.hallows_eve_board_pumpkins.title = Zucche Fredde
quest.hallows_eve_board_pumpkins.flavor = Le lanterne vogliono più Zucche Consacrate di quante riesca a trovarne da solo. Raccogli le zucche a mano e portami quelle fredde.
quest.hallows_eve_board_carving.title = Intaglio al Banco
quest.hallows_eve_board_carving.flavor = Ogni soglia vuole una lanterna, e io più in fretta di così non intaglio. Intaglia qualche Lanterna di Jack a un Banco da Intaglio, una zucca e un po' di carbone per ciascuna.
quest.hallows_eve_board_skeletons.title = Ossa Sonanti
quest.hallows_eve_board_skeletons.flavor = Gli scheletri con la mia faccia sono di nuovo fuori dopo il tramonto, a far rumore dove le torce non arrivano. Buttane giù un bel po' per me.
quest.hallows_eve_board_fiends.title = Pulizia dell'Orto
quest.hallows_eve_board_fiends.flavor = I Diavoletti Zucca strisciano nei boschi d'autunno dopo il tramonto, dove crescono le zucche selvatiche. Schiacciane un bel po' per me prima che mettano radici.

# ---- Old Jack's errands board ----
board.hallows_eve_errands.title = Commissioni del Vecchio Jack
board.hallows_eve_errands.desc = Lavoretti, uno per il buio e uno per la luce del giorno. Appendo una coppia nuova ogni poche ore, quindi ripassa.
board.hallows_eve_errands.pill = Commissione
quest.hallows_eve_errand_souls.title = Anime Randagie
quest.hallows_eve_errand_souls.flavor = Qualche Anima Perduta è arrivata alla deriva dall'ultima volta che ho guardato. Liberale quando hai un minuto.
quest.hallows_eve_errand_ghouls.title = Guardia alle Tombe
quest.hallows_eve_errand_ghouls.flavor = Dei Ghoul Vuoti stanno di nuovo grattando sulle tombe. Rimettili giù prima che se ne vadano in giro.
quest.hallows_eve_errand_skeletons.title = Ossa Sciolte
quest.hallows_eve_errand_skeletons.flavor = Qualche Scheletro Jack è scappato ieri notte. Buttalo giù quando sei fuori dopo il tramonto.
quest.hallows_eve_errand_ectoplasm.title = Lanterna Boccheggiante
quest.hallows_eve_errand_ectoplasm.flavor = Una delle mie lanterne boccheggia. Un po' di Ectoplasma la porterebbe fino a fine notte.
quest.hallows_eve_errand_bombs.title = Esercizio con le Bombe
quest.hallows_eve_errand_bombs.flavor = Hai delle Bombe Lanterna in più? Lanciane qualcuna per me. Mi piace il fracasso.
quest.hallows_eve_errand_geodes.title = Pietra Spaccata
quest.hallows_eve_errand_geodes.flavor = Spacca qualche Geode Maledetta mentre sei in giro. Qualcuno deve pur farlo.
quest.hallows_eve_errand_pumpkins.title = Zucche di Scorta
quest.hallows_eve_errand_pumpkins.flavor = Una lanterna si è ammosciata sui gradini. Portami delle Zucche Consacrate quando passi.
quest.hallows_eve_errand_fiends.title = Semi Cattivi
quest.hallows_eve_errand_fiends.flavor = Qualche Diavoletto Zucca è spuntato nei boschi d'autunno. Schiacciali quando sei fuori dopo il tramonto.

# ---- Il negozio del Vecchio Jack ----
shop.hallows_eve_old_jack.title = Negozio del Vecchio Jack
shop.hallows_eve_old_jack.desc = Bombe Lanterna, lanterne e qualche stranezza di stagione.
shop.hallows_eve_old_jack.category.bombs = Bombe Lanterna
shop.hallows_eve_old_jack.category.lights = Lanterne
shop.hallows_eve_old_jack.category.gear = Equipaggiamento
shop.hallows_eve_offer_harvest_moon_bundle.title = Pacchetto della Luna del Raccolto
shop.hallows_eve_offer_harvest_moon_bundle.desc = Bombe Lanterna Frantumanti e Spettrali, in vendita solo finché la Luna del Raccolto è alta.
shop.hallows_eve_offer_spyglass.desc = Guardaci dentro nelle Cavità Tremolanti per individuare dove si trova una bestia Divorata dal Vuoto.
shop.hallows_eve_offer_sell_eternal_candle.title = Vendi una Candela Eterna di Scorta
shop.hallows_eve_offer_sell_eternal_candle.desc = Basta una Candela Eterna per aprire il cimitero del Cavaliere. Porta al Vecchio Jack una di scorta e te la pagherà.
shop.hallows_eve_offer_sell_horsemans_reins.title = Vendi delle Redini del Cavaliere di Scorta
shop.hallows_eve_offer_sell_horsemans_reins.desc = Un paio di Redini del Cavaliere basta per chiamare il suo cavallo. Porta al Vecchio Jack un paio di scorta e te lo pagherà.

