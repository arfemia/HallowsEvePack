# Christmas progression: the season's currency, Santa's Nice List and Santa's Sack, the four Christmas
# stalls and their offers, the Christmas Set, the present's gift, Santa's conversation, the Christmas
# conversations of Tomas, Elsie and Bram, and the Christmas line their feast conversations gain.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. Numbers
# ride {0} and come from the content files, so a retune never touches a translation.

# ---- Christmas Coins ----
currency.christmas_coins.name = Monete di Natale
currency.christmas_coins.amount = {0, number} {0, plural, one {Moneta di Natale} other {Monete di Natale}}
currency.christmas_coins.description = Spendile nei negozi di Natale nel Tempio Dimenticato.

# ---- Santa's Nice List ----
reputation.christmas_nice_list.name = Lista dei Buoni di Babbo Natale
reputation.christmas_nice_list.flavor = Babbo Natale la controlla due volte. Aiutalo a riavere i suoi regali e la sali.
reputation.christmas_nice_list.rank.neutral = Nuovo Arrivato
reputation.christmas_nice_list.rank.friendly = In Lista
reputation.christmas_nice_list.rank.honored = Buono
reputation.christmas_nice_list.rank.revered = Molto Buono
reputation.christmas_nice_list.rank.exalted = Preferito di Babbo Natale
reputation.christmas_nice_list.earn.quests = Aiuta Babbo Natale, Tomas, Elsie e Bram nel Tempio Dimenticato con le loro missioni di Natale e i lavori giornalieri.
reputation.christmas_nice_list.earn.board = Prendi lavori dalla Bacheca di Natale. Chiedi a Babbo Natale cosa c'è da fare.
reputation.christmas_nice_list.earn.thieves = Cattura i Ladri di Regali di notte nelle Emerald Wilds, o a qualsiasi ora nella neve delle Whisperfrost Frontiers. Gli altri Trork contano un po' finché dura il Natale.
reputation.christmas_nice_list.earn.presents = Fai un Regalo di Natale a un amico: tienilo in mano, guardalo e clicca con il tasto sinistro.
reputation.christmas_nice_list.earn.carols = Canta una canzone di Natale a chiunque nel tempio, una volta al giorno ciascuno.
reputation.christmas_nice_list.earn.yeti = Batti lo Yeti nella Grotta dello Yeti. Bram sul prato ti ci porta. La prima vittoria di ogni giorno vale di più.
reputation.christmas_nice_list.earn.talk = Passa da Babbo Natale a scambiare due parole una volta al giorno.
reputation.christmas_nice_list.earn.gear = Indossa il Set di Natale dal negozio di Elsie, o mangia una Torta di Natale, e sali più in fretta.
lootable.christmas_santas_sack.title = Sacco di Babbo Natale
lootable.christmas_santas_sack.flavor = Babbo Natale te ne prepara uno ogni volta che sali di un altro gradino oltre Preferito di Babbo Natale.
lootable.christmas_present_gift.title = Regalo di Natale
lootable.christmas_present_gift.flavor = Qualche moneta e una piccola sorpresa.
lootable.christmas_present_given.title = Un Regalo da un Amico
lootable.christmas_present_given.flavor = Qualcuno te l'ha fatto. Meglio che aprire il tuo.
lootable.christmas_stocking.title = Calza di Babbo Natale
lootable.christmas_stocking.flavor = Un dolcetto e un po' di spiccioli, e ogni tanto un regalo.

# ---- The Christmas stalls ----
shop.christmas_santa.title = Il Negozio di Babbo Natale
shop.christmas_santa.desc = Pacchetti per incartare i tuoi regali, e bastoncini di zucchero per la fredda strada di casa.
shop.christmas_santa.category.packets = Pacchetti di Natale
shop.christmas_santa.category.treats = Dolcetti
shop.christmas_miller.title = La Panetteria di Tomas
shop.christmas_miller.desc = Le ricette di tutto quello che cuocio per Babbo Natale, e impasto fresco se hai fretta.
shop.christmas_miller.category.kitchen = Cucina
shop.christmas_weaver.title = Il Negozio di Elsie
shop.christmas_weaver.desc = Regali incartati da me, un po' di magia, e vestiti caldi per la neve.
shop.christmas_weaver.category.gifts = Regali
shop.christmas_weaver.category.clothes = Abiti
shop.christmas_shepherd.title = Le Palle di Neve di Bram
shop.christmas_shepherd.desc = Pressate bene. Occhio a chi le tiri.
shop.christmas_shepherd.category.snow = Neve
shop.christmas_offer_recipe_gingerbread_cookie.title = Ricetta del Biscotto di Pan di Zenzero
shop.christmas_offer_recipe_gingerbread_cookie.desc = Cuocili a un Fornello dello Chef con impasto e spezie. Ti danno una spinta al passo.
shop.christmas_offer_recipe_hot_cocoa.title = Ricetta della Cioccolata Calda
shop.christmas_offer_recipe_hot_cocoa.desc = Preparala a un Fornello dello Chef. Tiene fuori il freddo e ti rimette in salute.
shop.christmas_offer_recipe_cake.title = Ricetta della Torta di Natale
shop.christmas_offer_recipe_cake.desc = La cosa più bella in tavola. Fa tutto quello che fanno i biscotti e la cioccolata, e finché dura sali più in fretta la Lista dei Buoni di Babbo Natale.
shop.christmas_offer_present.title = Regalo di Natale
shop.christmas_offer_present.desc = Incartato da Elsie. Aprilo per vedere cosa c'è dentro.
shop.christmas_offer_christmas_wand.title = Bacchetta di Natale
shop.christmas_offer_christmas_wand.desc = Puntala contro un amico per vestirlo da elfo o da renna.
shop.christmas_offer_santa_suit.title = Costume da Babbo Natale
shop.christmas_offer_santa_suit.desc = Indossalo e per un po' sei Babbo Natale.
shop.christmas_offer_christmas_gloves.title = Guanti di Natale
shop.christmas_offer_christmas_gloves.desc = Caldi guanti, parte del Set di Natale. Indossa il set intero e sali più in fretta la Lista dei Buoni di Babbo Natale.
shop.christmas_offer_christmas_hat.title = Cappello di Natale
shop.christmas_offer_christmas_hat.desc = Un caldo cappello, parte del Set di Natale. Indossa il set intero e sali più in fretta la Lista dei Buoni di Babbo Natale.
shop.christmas_offer_christmas_trousers.title = Pantaloni di Natale
shop.christmas_offer_christmas_trousers.desc = Caldi pantaloni per la neve, parte del Set di Natale. Indossa il set intero e sali più in fretta la Lista dei Buoni di Babbo Natale.
shop.christmas_offer_christmas_coat.title = Cappotto di Natale
shop.christmas_offer_christmas_coat.desc = Un caldo cappotto, l'ultimo pezzo del Set di Natale. Indossa il set intero e sali più in fretta la Lista dei Buoni di Babbo Natale.
shop.christmas_offer_snowballs_daily.title = Palle di Neve Gratis
shop.christmas_offer_snowballs_daily.desc = Un fascio di palle di neve da Bram, gratis una volta al giorno.
shop.christmas_offer_snowballs.title = Palle di Neve
shop.christmas_offer_snowballs.desc = Un altro fascio, per quando le gratuite sono finite.
shop.christmas_offer_stocking.title = Calza di Babbo Natale
shop.christmas_offer_stocking.desc = Gratis una volta al giorno. Infila la mano e guarda cosa ti ha lasciato Babbo Natale.

# ---- The Christmas Set ----
# A set's notice is a toast, so no value carries markup.
gearset.christmas_set.title = Set di Natale
gearset.christmas_set.tier_half = Metà set indosso: un po' più di salute.
gearset.christmas_set.tier_full = Set intero indosso: ancora più salute, il freddo morde meno, e sali più in fretta la Lista dei Buoni di Babbo Natale.

# ---- Santa's conversation ----
dialogue.christmas_santa.off_season.text = Il Natale è finito, e la mia slitta è pronta per tornare a casa.\nVieni a cercarmi di nuovo il prossimo inverno.
dialogue.christmas_santa.off_season.opt.farewell = Arrivederci, Babbo Natale.
dialogue.christmas_santa.first_words.text = Oh oh oh. Eccoti.\nSono Babbo Natale, e mi serve una mano. Dei Trork con il cappello da Babbo Natale hanno derubato la mia slitta e sono scappati con i regali. Cattura quei <b>Ladri di Regali</b> di notte nelle <b>Emerald Wilds</b>, o a qualsiasi ora nella neve delle <b>Whisperfrost Frontiers</b>, e riportami i miei regali.
dialogue.christmas_santa.first_words.opt.hail = Ti aiuto, Babbo Natale.
dialogue.christmas_santa.daily_word.text = Di nuovo qui? Bene. Ecco un altro giorno sulla mia <b>Lista dei Buoni</b>.\nI ladri sono ancora là fuori. Tieni d'occhio i boschi stanotte.
dialogue.christmas_santa.menu.text = Dunque. Cosa posso fare per te?
dialogue.christmas_santa.who_are_you.text = Sono Babbo Natale. Ogni Natale porto regali a tutti a Orbis.\nQuest'anno ho degli aiutanti. Tomas cuoce, Elsie incarta i regali e cuce, e Bram tiene tutti riforniti di palle di neve.
dialogue.christmas_santa.about_thieves.text = Sono Trork con il cappello da Babbo Natale, e combattono solo a pugni, quindi per te non sono un problema.\nCercali di notte nei boschi e nei campi delle <b>Emerald Wilds</b>, o a qualsiasi ora nella neve delle <b>Whisperfrost Frontiers</b>. Parecchi hanno ancora un regalo. Aprilo, ed è tuo.
dialogue.christmas_santa.helpers.text = <b>Tomas</b> ed <b>Elsie</b> tengono i loro negozi proprio qui accanto a me. Finché dura la festa di Martha, la aiutano vicino al <b>villaggio dei kweebec</b> in fondo alla strada.\n<b>Bram</b> è sul prato, a metà della strada da dove sei entrato.
dialogue.christmas_santa.opt.shop = Fammi vedere il tuo negozio.
dialogue.christmas_santa.opt.standing = Come me la cavo sulla tua lista?
dialogue.christmas_santa.opt.thieves = Dove sono i ladri?
dialogue.christmas_santa.opt.helpers = Dove sono i tuoi aiutanti?
dialogue.christmas_santa.opt.who = Chi sei?
dialogue.christmas_santa.opt.back = Altro.
dialogue.christmas_santa.opt.farewell = Buon Natale, Babbo Natale.
dialogue.christmas_santa.opt.returned = Eccomi di nuovo.
dialogue.christmas_santa.opt.quests = Cosa c'è da fare?
dialogue.christmas_santa.opt.almanac = Mostrami l'Almanacco.
dialogue.christmas_santa.opt.story = In cosa posso aiutarti?
dialogue.christmas_santa.meet_arrival.text = Oh oh oh. Mi hai trovato.\nSono Babbo Natale, e mi serve una mano. Dei Trork con il cappello da Babbo Natale hanno derubato la mia slitta sulla strada e sono scappati con i regali. Riprendiamoceli.
dialogue.christmas_santa.meet_arrival.opt.hail = Ti aiuto, Babbo Natale.
dialogue.christmas_santa.morning_arrival.text = Buon Natale. Guarda sotto il mio albero.\nC'è un regalo con il tuo nome sopra.
dialogue.christmas_santa.morning_arrival.opt.open = Per me?
dialogue.christmas_santa.daily_word_story_done.text = Di nuovo qui? Bene. Ecco un altro giorno sulla mia <b>Lista dei Buoni</b>.\nLa slitta è carica, quindi la mia storia è finita fino al prossimo Natale. Ho ancora <b>lavori</b> ogni giorno, i <b>Ladri di Regali</b> sono ancora là fuori, e i <b>negozi</b> sono aperti.
dialogue.christmas_santa.story_done.text = La slitta è carica, ed è merito tuo.\nLa mia storia è finita fino al prossimo Natale, ma c'è ancora molto da fare. Passa ogni giorno per i miei <b>lavori</b>, continua a catturare <b>Ladri di Regali</b>, e guarda cosa c'è di nuovo nei <b>negozi</b>.
dialogue.christmas_santa.story.text = Prima cattura per me i <b>Ladri di Regali</b>. Poi <b>Bram</b> ha bisogno di carote per le renne, <b>Tomas</b> di una mano con i biscotti, ed <b>Elsie</b> di aiuto con gli incarti. Dopo, torna da me per la <b>Vigilia di Natale</b>.\nHo lavori ogni giorno anche io. Chiedimi cosa c'è da fare.
dialogue.christmas_santa.thieves_offer.text = Quei ladri hanno ancora i miei regali. Cattura qualche <b>Ladro di Regali</b> per me.\nEscono di notte nei boschi e nei campi delle <b>Emerald Wilds</b>, e girano tutto il giorno nella neve delle <b>Whisperfrost Frontiers</b>. Conta qualsiasi Trork che catturi.
dialogue.christmas_santa.thieves_offer.opt.accept = Li catturo io.
dialogue.christmas_santa.thieves_brief.text = Cerca di notte nelle <b>Emerald Wilds</b>, o a qualsiasi ora nella neve delle <b>Whisperfrost Frontiers</b>. Conta qualsiasi Trork.\nTorna da me quando ne hai catturati abbastanza.
dialogue.christmas_santa.thieves_ready.text = Li hai presi. Uno di loro aveva questo addosso. Aprilo, o regalalo a un amico.\nOra, le renne di <b>Bram</b> hanno fame. Lui è sul <b>prato</b> a metà della strada da dove sei entrato.
dialogue.christmas_santa.thieves_ready.opt.turnin = Ecco qua.
dialogue.christmas_santa.eve_offer.text = È quasi la <b>Vigilia di Natale</b>, e la slitta non è ancora piena.\nPortami <b>Biscotti di Pan di Zenzero</b> per il sacco e <b>carote</b> per le renne. E dammi un <b>Regalo di Natale</b> per la slitta.
dialogue.christmas_santa.eve_offer.opt.accept = Riempiamo la slitta.
dialogue.christmas_santa.eve_brief.text = <b>Biscotti di Pan di Zenzero</b> per il sacco e <b>carote</b> per le renne. Portali qui.\nPer il regalo, tienilo in mano, guardami e clicca con il tasto sinistro.
dialogue.christmas_santa.eve_ready.text = Ecco la slitta piena. Oh oh oh.\nQuesta pallina è per te. Appendila dove la vedrai ogni Natale.
dialogue.christmas_santa.eve_ready.opt.turnin = Buon Natale, Babbo Natale.
dialogue.christmas_santa.carols_offer.text = Niente scalda un tempio freddo come una canzone di Natale.\nCantane una alla <b>gente intorno al Tempio Dimenticato</b>, poi vieni a dirmi com'è andata. A me no, bada bene. Conosco tutte le parole.
dialogue.christmas_santa.carols_offer.opt.accept = Vado a cantare.
dialogue.christmas_santa.carols_brief.text = Parla con la gente intorno al tempio e scegli <b>Canta una canzone di Natale</b>. I miei aiutanti sono un buon inizio.\nOgni persona ascolta una volta al giorno.
dialogue.christmas_santa.carols_ready.text = Ti ho sentito da qui. Niente male.
dialogue.christmas_santa.carols_ready.opt.turnin = Hanno cantato tutti con me.
dialogue.christmas_santa.daily_thieves_offer.text = Quei Trork ci sono ricascati.\nOggi catturi qualche altro <b>Ladro di Regali</b> per me?
dialogue.christmas_santa.daily_thieves_offer.opt.accept = Li catturo io.
dialogue.christmas_santa.daily_presents_offer.text = I miei aiutanti lavorano sodo.\nDai a ciascuno di loro un <b>Regalo di Natale</b> oggi. Tienilo in mano, guardali e clicca con il tasto sinistro.
dialogue.christmas_santa.daily_presents_offer.opt.accept = Glieli consegno io.
dialogue.christmas_santa.presents_brief.text = Dai un <b>Regalo di Natale</b> a <b>Tomas</b>, <b>Elsie</b> e <b>Bram</b>. Tienilo in mano, guardali e clicca con il tasto sinistro.\nI ladri lasciano cadere regali, ed <b>Elsie</b> li vende.
dialogue.christmas_santa.extra_thieves_ready.text = Altri ladri catturati. La mia lista si allunga ogni giorno.
dialogue.christmas_santa.extra_thieves_ready.opt.turnin = Ecco il mio conto.
dialogue.christmas_santa.ready_generic.text = Già fatto? Vediamo.
dialogue.christmas_santa.ready_generic.opt.turnin = È fatto.

# ---- Santa's helpers: Tomas the Miller, Elsie the Weaver and Bram the Shepherd ----
dialogue.christmas_feast_line.opt.stall = Cosa c'è nel tuo negozio di Natale?
dialogue.christmas_feast_line.opt.quests = Hai del lavoro di Natale per me?
dialogue.christmas_carol.opt.sing = Canta una canzone di Natale
dialogue.christmas_miller.off_season.text = Il Natale è finito, e il forno si è raffreddato.\nCi vediamo quando torna la neve.
dialogue.christmas_miller.off_season.opt.farewell = Ci vediamo il prossimo inverno.
dialogue.christmas_miller.greeting.text = Buon Natale. A Babbo Natale servono biscotti per il suo sacco, così ho portato il forno su dal mulino.\nVendo le ricette dei <b>Biscotti di Pan di Zenzero</b>, della <b>Cioccolata Calda</b> e della <b>Torta di Natale</b>.
dialogue.christmas_miller.dough.text = Macina il <b>grano</b> in <b>farina</b> a un <b>Fornello dello Chef</b>, poi mescola la farina con le <b>uova</b> e un <b>boccale d'acqua</b> allo stesso fornello.\nHai poco tempo? Ogni giorno vendo un po' d'impasto.
dialogue.christmas_miller.why.text = Dei Trork hanno derubato la slitta di Babbo Natale sulla strada, e lui ha chiesto aiuto al villaggio. Sono venuti anche Elsie e Bram.\nQualcuno deve pur dar da mangiare al vecchio.
dialogue.christmas_miller.opt.stall = Cosa vendi?
dialogue.christmas_miller.opt.dough = Come si fa l'impasto?
dialogue.christmas_miller.opt.why = Perché sei qui?
dialogue.christmas_miller.opt.thanks = Grazie, Tomas.
dialogue.christmas_miller.opt.back = Gentile da parte tua.
dialogue.christmas_miller.opt.farewell = Buon Natale, Tomas.
dialogue.christmas_miller.opt.quests = Hai del lavoro per me?
dialogue.christmas_miller.opt.later = Non adesso.
dialogue.christmas_miller.next_elsie.text = Il sacco di Babbo Natale non si riempie da solo. <b>Elsie</b> ha bisogno di una mano con gli incarti.\nIl suo negozio è proprio qui, accanto a Babbo Natale. Finché dura la festa di Martha, lei sta dall'altra parte del <b>villaggio dei kweebec</b>.
dialogue.christmas_miller.cookies_offer.text = Ti ha dato Bram la mia ricetta? Bene. Babbo Natale vuole biscotti nel suo sacco.\nImpara la ricetta, cuoci un <b>Biscotto di Pan di Zenzero</b> e portalo qui. Voglio vedere com'è venuto.
dialogue.christmas_miller.cookies_offer.opt.accept = Ne cuocio uno.
dialogue.christmas_miller.cookies_brief.text = Impara la ricetta, poi cuoci un <b>Biscotto di Pan di Zenzero</b> e portamene uno.\nNon hai mai fatto l'impasto? Chiedimi come.
dialogue.christmas_miller.cookies_ready.text = Questo è un vero omino di pan di zenzero. Ha anche il profumo giusto.\nContinua a cuocere. Babbo Natale ne vorrà ancora tanti prima della Vigilia di Natale.
dialogue.christmas_miller.cookies_ready.opt.turnin = Tieni, assaggia.
dialogue.christmas_miller.baking_offer.text = Il mio forno mangia impasto più in fretta di quanto riesca a mescolarlo.\nOggi mi porti un po' d'<b>impasto</b>?
dialogue.christmas_miller.baking_offer.opt.accept = Porto l'impasto.
dialogue.christmas_miller.baking_brief.text = Portami dell'<b>impasto</b>.\nNon l'hai mai fatto? Chiedimi come.
dialogue.christmas_miller.baking_ready.text = Impasto fresco. Il forno aspettava.
dialogue.christmas_miller.baking_ready.opt.turnin = Ecco l'impasto.
dialogue.christmas_weaver.off_season.text = Il Natale è finito e i nastri sono riposti.\nVieni a cercarmi il prossimo inverno. Avrò nuovi regali incartati per allora.
dialogue.christmas_weaver.off_season.opt.farewell = Ti cercherò.
dialogue.christmas_weaver.greeting.text = Buon Natale. I ladri hanno lasciato i regali di Babbo Natale strappati e infangati, così li sto incartando di nuovo tutti.\nVendo <b>Regali di Natale</b>, la <b>Bacchetta di Natale</b>, il <b>Costume da Babbo Natale</b> e il <b>Set di Natale</b>. Più sei in alto sulla <b>Lista dei Buoni</b> di Babbo Natale, più cose posso venderti.
dialogue.christmas_weaver.presents.text = Clicca con il tasto destro su un regalo per aprirlo. Dentro c'è sempre qualcosa, e a volte qualcosa di bello.\nOppure regalalo: tienilo in mano, guarda un amico e clicca con il tasto sinistro. Riceve un regalo migliore del tuo, e Babbo Natale se ne accorge. Quando Babbo Natale o uno di noi ti chiede un regalo, consegnalo allo stesso modo.\nI <b>Ladri di Regali</b> ne portano parecchi. Li trovi di notte nelle <b>Emerald Wilds</b>.
dialogue.christmas_weaver.why.text = Babbo Natale ha chiesto aiuto al villaggio, e io sono qui. Qualcuno deve incartare tutto questo.\nE qualcuno deve cucirgli un cappotto nuovo. I Trork hanno preso anche quello di scorta.
dialogue.christmas_weaver.opt.stall = Fammi vedere cosa hai.
dialogue.christmas_weaver.opt.presents = Cosa faccio con un regalo?
dialogue.christmas_weaver.opt.why = Perché sei qui?
dialogue.christmas_weaver.opt.thanks = Grazie, Elsie.
dialogue.christmas_weaver.opt.back = Sono un sacco di incarti.
dialogue.christmas_weaver.opt.farewell = Buon Natale, Elsie.
dialogue.christmas_weaver.opt.quests = Posso aiutarti?
dialogue.christmas_weaver.opt.later = Non adesso.
dialogue.christmas_weaver.next_santa.text = Babbo Natale ha ancora un lavoro per te prima della <b>Vigilia di Natale</b>.\nVai a trovarlo vicino al suo albero.
dialogue.christmas_weaver.wrapping_offer.text = Sto finendo il nastro, e i regali non si incartano da soli.\nPortami della <b>Fibra Vegetale</b>. E porta uno dei tuoi regali a <b>Bram</b> da parte mia. Ha avuto una settimana dura.
dialogue.christmas_weaver.wrapping_offer.opt.accept = Ti aiuto.
dialogue.christmas_weaver.wrapping_brief.text = Portami della <b>Fibra Vegetale</b>.\nPoi dai a <b>Bram</b> un <b>Regalo di Natale</b>: tienilo in mano, guardalo e clicca con il tasto sinistro. Lui è sul <b>prato</b> a metà della strada. Non hai un regalo? Li vendo io.
dialogue.christmas_weaver.wrapping_ready.text = Nastro per giorni, e Bram sorride ancora per il suo regalo.\nQuesti tre sono per te. E a Babbo Natale servirebbe un altro elfo, quindi stai fermo.
dialogue.christmas_weaver.wrapping_ready.opt.turnin = Grazie, Elsie.
dialogue.christmas_weaver.fibre_offer.text = Ho di nuovo finito il nastro.\nPortami della <b>Fibra Vegetale</b> oggi e ti incarto due regali.
dialogue.christmas_weaver.fibre_offer.opt.accept = Ne porto un po'.
dialogue.christmas_weaver.fibre_brief.text = Portami della <b>Fibra Vegetale</b>.
dialogue.christmas_weaver.fibre_ready.text = Bei fili lunghi. Tieni, due regali, incartati stamattina.
dialogue.christmas_weaver.fibre_ready.opt.turnin = Ecco la fibra.
dialogue.christmas_shepherd.off_season.text = Il Natale è finito. Io torno su per la collina.
dialogue.christmas_shepherd.off_season.opt.farewell = Buon ritorno a casa.
dialogue.christmas_shepherd.greeting.text = Buon Natale. La slitta di Babbo Natale è stata derubata, così sono sceso ad aiutare.\nDistribuisco <b>palle di neve</b>, un fascio gratis ogni giorno. Colpisci qualcuno con una e rallenta per un attimo. Non fa male.
dialogue.christmas_shepherd.thieves.text = Trork con il cappello da Babbo Natale. Escono di notte nei <b>boschi</b> e nei <b>campi</b> delle <b>Emerald Wilds</b>.\nLassù nella neve delle <b>Whisperfrost Frontiers</b> girano tutto il giorno. Colpiscine uno con una palla di neve per prima cosa. Lo rallenta di brutto.
dialogue.christmas_shepherd.why.text = Qualcuno deve pur far arrivare la neve.\nE Babbo Natale l'ha chiesto con gentilezza.
dialogue.christmas_shepherd.opt.stall = Hai delle palle di neve?
dialogue.christmas_shepherd.opt.thieves = Dove sono i ladri?
dialogue.christmas_shepherd.opt.why = Perché sei qui?
dialogue.christmas_shepherd.opt.thanks = Grazie, Bram.
dialogue.christmas_shepherd.opt.back = Giusto.
dialogue.christmas_shepherd.opt.farewell = Buon Natale, Bram.
dialogue.christmas_shepherd.opt.quests = Serve una mano?
dialogue.christmas_shepherd.opt.later = Non adesso.
dialogue.christmas_shepherd.next_tomas.text = Ora <b>Tomas</b> ti vuole in cucina.\nIl suo negozio è accanto a Babbo Natale. Finché dura la festa di Martha, sta dove la strada incontra il <b>villaggio dei kweebec</b>.
dialogue.christmas_shepherd.reindeer_offer.text = Le renne di Babbo Natale non mangiano da quando i Trork hanno colpito la slitta.\nPortami delle <b>carote</b>.
dialogue.christmas_shepherd.reindeer_offer.opt.accept = Trovo le carote.
dialogue.christmas_shepherd.reindeer_brief.text = <b>Carote</b> per le renne. Portale qui.
dialogue.christmas_shepherd.reindeer_ready.text = Così continueranno a volare. Palle di neve, per il disturbo.\nE Tomas ha lasciato questo da me per te. La sua ricetta dei biscotti, con un po' di impasto e di spezie.
dialogue.christmas_shepherd.reindeer_ready.opt.turnin = Grazie, Bram.
dialogue.christmas_shepherd.carrots_offer.text = Le renne mangiano tutto il giorno.\nMi porti altre <b>carote</b>? Ci aggiungo delle palle di neve.
dialogue.christmas_shepherd.carrots_offer.opt.accept = Porto le carote.
dialogue.christmas_shepherd.carrots_brief.text = Altre <b>carote</b>. Portale qui.
dialogue.christmas_shepherd.carrots_ready.text = Belle carote. Le renne se le contenderanno.
dialogue.christmas_shepherd.carrots_ready.opt.turnin = Ecco qua.

# ---- Santa's story, the dailies and the carol tour ----
quest.christmas_santa_meet.title = Incontra Babbo Natale
quest.christmas_santa_meet.flavor = Dei Trork hanno derubato la mia slitta, e mi serve aiuto. Sono vicino al mio albero nel Tempio Dimenticato. Ci arrivi da un Portale del Tempio Dimenticato qualsiasi.
objective.christmas.meet_santa = Trova Babbo Natale nel Tempio Dimenticato
quest.christmas_present_thieves.title = Ladri di Regali
quest.christmas_present_thieves.flavor = Dei Trork con il cappello da Babbo Natale sono scappati con i miei regali. Catturali di notte nelle Emerald Wilds, o a qualsiasi ora nella neve delle Whisperfrost Frontiers, poi torna da me.
objective.christmas.catch_thieves = Cattura {0} {0, plural, one {Ladro di Regali} other {Ladri di Regali}}
quest.christmas_reindeer_food.title = Cibo per le Renne
quest.christmas_reindeer_food.flavor = Le renne di Babbo Natale non mangiano da quando la slitta è stata derubata. Portami delle carote. Sono sul prato.
objective.christmas.bring_bram_carrots = Porta a Bram {0} {0, plural, one {Carota} other {Carote}}
quest.christmas_gingerbread_cookies.title = Biscotti di Natale
quest.christmas_gingerbread_cookies.flavor = Il sacco di Babbo Natale ha bisogno di biscotti. Impara la mia ricetta, cuoci un Biscotto di Pan di Zenzero e portamelo vicino all'albero di Babbo Natale.
objective.christmas.bring_tomas_cookie = Porta a Tomas un Biscotto di Pan di Zenzero
quest.christmas_wrapping_presents.title = Incartare i Regali
quest.christmas_wrapping_presents.flavor = Mi serve Fibra Vegetale per il nastro, quindi portamene un po'. E dai uno dei tuoi regali a Bram sul prato. Ha avuto una settimana dura.
objective.christmas.bring_elsie_fibre = Porta a Elsie {0} Fibra Vegetale
objective.christmas.give_bram_present = Dai a Bram un Regalo di Natale
quest.christmas_eve.title = Vigilia di Natale
quest.christmas_eve.flavor = La slitta parte stanotte. Portami Biscotti di Pan di Zenzero per il sacco e carote per le renne, e dammi un Regalo di Natale per la slitta.
objective.christmas.bring_santa_cookies = Porta a Babbo Natale {0} {0, plural, one {Biscotto} other {Biscotti}} di Pan di Zenzero
objective.christmas.bring_santa_carrots = Porta a Babbo Natale {0} {0, plural, one {Carota} other {Carote}}
objective.christmas.give_santa_present = Dai a Babbo Natale un Regalo di Natale
quest.christmas_morning.title = Mattina di Natale
quest.christmas_morning.flavor = Buon Natale. C'è un regalo sotto il mio albero nel Tempio Dimenticato, e porta il tuo nome. Vieni ad aprirlo.
objective.christmas.morning = Apri il tuo regalo sotto l'albero di Babbo Natale
quest.christmas_daily_thieves.title = Ladri del Giorno
quest.christmas_daily_thieves.flavor = Quei Trork ci sono ricascati. Cattura qualche altro Ladro di Regali stanotte nelle Emerald Wilds, poi torna da me.
quest.christmas_daily_presents.title = Regali del Giorno
quest.christmas_daily_presents.flavor = I miei aiutanti lavorano sodo. Dai oggi un Regalo di Natale a Tomas, a Elsie e a Bram. Tienilo in mano, guardali e clicca con il tasto sinistro.
objective.christmas.give_tomas_present = Dai a Tomas un Regalo di Natale
objective.christmas.give_elsie_present = Dai a Elsie un Regalo di Natale
quest.christmas_daily_baking.title = Cottura del Giorno
quest.christmas_daily_baking.flavor = Il mio forno mangia impasto più in fretta di quanto riesca a mescolarlo. Portamene un po'.
objective.christmas.bring_tomas_dough = Porta a Tomas {0} Impasto
quest.christmas_daily_wrapping.title = Incarti del Giorno
quest.christmas_daily_wrapping.flavor = Ho di nuovo finito il nastro. Portami della Fibra Vegetale e ti incarto due regali.
quest.christmas_daily_carrots.title = Carote del Giorno
quest.christmas_daily_carrots.flavor = Le renne mangiano tutto il giorno. Portami delle carote e ci aggiungo delle palle di neve.
quest.christmas_extra_thieves.title = Ladri Extra
quest.christmas_extra_thieves.flavor = Prendo tutti i ladri che riesci a catturare. Cerca di notte nelle Emerald Wilds, o a qualsiasi ora nella neve delle Whisperfrost Frontiers, poi torna da me. Fallo quante volte vuoi.
quest.christmas_carols.title = Canzoni di Natale
quest.christmas_carols.flavor = Niente scalda un tempio freddo come una canzone di Natale. Cantane una alla gente intorno al Tempio Dimenticato, poi vieni a dirmi com'è andata.
objective.christmas.sing_carols = Canta una canzone di Natale a {0} {0, plural, one {persona} other {persone}}

# ---- The Christmas Board ----
board.christmas_daily.title = La Bacheca di Natale
board.christmas_daily.desc = Lavori all'aperto e lavori in laboratorio, freschi ogni mattina. Più sei in alto sulla mia Lista dei Buoni, più ne metto. Ritira la paga prima che la slitta parta. Se arrivi tardi, ti aspetta nel tuo Libro degli obiettivi.
board.christmas_daily.grade.outdoor = Lavoro all'Aperto
board.christmas_daily.grade.workshop = Lavoro in Laboratorio
quest.christmas_board_thieves.title = Lavoro dei Ladri
quest.christmas_board_thieves.flavor = Cattura i Ladri di Regali di notte nelle Emerald Wilds, o a qualsiasi ora nella neve delle Whisperfrost Frontiers. Conta qualsiasi Trork.
quest.christmas_board_carrots.title = Lavoro delle Carote
quest.christmas_board_carrots.flavor = Raccogli le carote a mano. Le renne hanno di nuovo fame.
objective.christmas.pick_carrots = Raccogli {0} {0, plural, one {Carota} other {Carote}}
quest.christmas_board_logs.title = Lavoro dei Tronchi
quest.christmas_board_logs.flavor = Taglia tronchi da un albero qualsiasi per il fuoco di Babbo Natale. Il tempio la notte diventa freddo.
objective.christmas.chop_logs = Taglia {0} {0, plural, one {tronco} other {tronchi}}
quest.christmas_board_eggs.title = Lavoro delle Uova
quest.christmas_board_eggs.flavor = Tomas ha bisogno di uova per le sue torte. Portane un po' alla bacheca.
objective.christmas.bring_eggs = Porta {0} {0, plural, one {Uovo} other {Uova}}
quest.christmas_board_cookies.title = Lavoro dei Biscotti
quest.christmas_board_cookies.flavor = Babbo Natale vuole altri biscotti nel suo sacco. Cuoci dei Biscotti di Pan di Zenzero e portali alla bacheca.
objective.christmas.bring_cookies = Porta {0} {0, plural, one {Biscotto} other {Biscotti}} di Pan di Zenzero
quest.christmas_board_dough.title = Lavoro dell'Impasto
quest.christmas_board_dough.flavor = Porta dell'impasto alla bacheca. A Tomas non basta mai.
objective.christmas.bring_dough = Porta {0} Impasto
quest.christmas_board_presents.title = Lavoro dei Regali
quest.christmas_board_presents.flavor = Dai a Babbo Natale dei Regali di Natale per il suo sacco. Tienilo in mano, guardalo e clicca con il tasto sinistro.
objective.christmas.give_santa_presents = Dai a Babbo Natale {0} {0, plural, one {Regalo} other {Regali}} di Natale
quest.christmas_board_spices.title = Lavoro delle Spezie
quest.christmas_board_spices.flavor = Il pan di zenzero di Tomas ha bisogno di Spezie. Portane un po' alla bacheca.
objective.christmas.bring_spices = Porta {0} Spezie

