# Pacchetto Vigilia di Ognissanti - le parole del Set Consacrato. Le chiavi sono scritte nude: la libreria trova ciascuna
# dalla sua coda, comunque si chiami questo file. L'avviso del set è un toast, quindi nessun valore contiene markup.
gearset.hallows_eve_hallowed.title = Set Consacrato
gearset.hallows_eve_hallowed.tier_pair = Un pezzo del set indosso e uno Scudo di Jack in mano: un po' più di salute, il fuoco morde meno, brilli come una lanterna e guadagni il favore dei Consacrati un po' più in fretta.
gearset.hallows_eve_hallowed.tier_armor = Elmo, corazza, guanti e schinieri indosso: un po' più di salute, e tutto ciò a cui dai fuoco brucia più forte.
gearset.hallows_eve_hallowed.tier_armor_shield = Tutti e quattro indosso e scudo in mano: ancora più salute, e il tuo fuoco brucia ancora più forte.
gearset.hallows_eve_flaming_hallowed.title = Set Consacrato Fiammeggiante
gearset.hallows_eve_flaming_hallowed.tier_armor = Un Elmo di Jack Ardente o l'Elmo Fiammeggiante del Cavaliere, con la sua armatura fiammeggiante indosso: più salute, e tutto ciò a cui dai fuoco brucia molto più forte.
gearset.hallows_eve_flaming_hallowed.tier_armor_shield = Tutti e quattro indosso e lo Scudo di Jack Fiammeggiante in mano: ancora più salute, e il tuo fuoco brucia ancora più forte.

# I nomi dei costumi, mostrati quando il giocatore passa sull'icona del costume. Il JSON dell'effetto scrive la chiave
# per intero (hallowseve.items.effect...), perché il client legge il Name di un effetto esattamente come scritto.
effect.hallows_eve_costume_jack.name = Costume da Scheletro Jack
effect.hallows_eve_costume_lost_soul.name = Costume da Anima Perduta
effect.hallows_eve_lantern_burn.name = Bruciatura

# The Fire Resistance Potion's buff, shown when a player hovers its icon.
effect.hallows_eve_fire_resistance.name = Resistenza al Fuoco
