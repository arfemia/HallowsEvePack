
# Harvest Feast with MMO Skill Tree: the words for the skill jobs on the feast board, the board's skill
# band and the feast's Harvesting boost. Nothing reads them on a server without MMO Skill Tree.
# Keys are written bare: MMO Skill Tree and the library find each one by its tail, whatever this file is
# called. A skill job takes its words from the keys its id spells (quest.<id>.title and .flavor).

# ---- The feast board's skill band ----
board.harvest_feast_daily.grade.skill = Lavoro d'Abilità

# ---- The skill jobs ----
quest.mmo_harvest_feast_daily_harvesting.title = Campi Pieni
quest.mmo_harvest_feast_daily_harvesting.flavor = Nei campi c'è più di quanto un paio di mani possa portare a casa. Passa la giornata a raccogliere, e diventa più veloce.
quest.mmo_harvest_feast_daily_crafting.title = Banchi Affollati
quest.mmo_harvest_feast_daily_crafting.flavor = I banchi non si raffreddano mai, questa settimana. Passa la giornata a fabbricare; va bene qualsiasi banco.
quest.mmo_harvest_feast_daily_archery.title = Allenamento del Cacciatore
quest.mmo_harvest_feast_daily_archery.flavor = I tacchini si spaventano a ogni passo. Impara ad abbatterli da lontano, e l'arrosto ti ringrazierà.
quest.mmo_harvest_feast_daily_woodcutting.title = Legna per i Forni
quest.mmo_harvest_feast_daily_woodcutting.flavor = I forni mangiano legna tutta la settimana. Abbatti qualche albero e tieni vivi i fuochi.

# ---- The feast's boost ----
boostrule.mmo_harvest_feast_harvesting.title = Festa del Raccolto
