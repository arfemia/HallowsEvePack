board.grade.hallows_eve_skill = Lavoro di Abilità
boostrule.mmo_hallows_eve_harvest_moon.title = Luna del Raccolto
gearset.mmo_hallows_eve_hallowed.title = Set Consacrato (abilità)
gearset.mmo_hallows_eve_hallowed.tier_full = Elmo e scudo insieme: un po' più di fortuna, e colpi di Artillery più forti.
quest.mmo_hallows_eve_daily_artillery.title = Esercitazione con le Lanterne
quest.mmo_hallows_eve_daily_artillery.flavor = Un buon braccio vuole pratica, e questo è il mese giusto. Stanotte lancia contro qualunque cosa se lo meriti e torna con una mira più ferma.
quest.mmo_hallows_eve_daily_harvesting.title = Raccolto Notturno
quest.mmo_hallows_eve_daily_harvesting.flavor = Gli orti non si raccolgono da soli, e le zucche fredde spuntano solo per una mano ferma. Passa la notte nei campi.
quest.mmo_hallows_eve_daily_mining.title = Turno in Profondità
quest.mmo_hallows_eve_daily_mining.flavor = La pietra cede le sue geodi a chi la conosce. Stanotte fai un lungo turno sottoterra e impara a conoscerla meglio.
quest.mmo_hallows_eve_daily_crafting.title = Mani Operose
quest.mmo_hallows_eve_daily_crafting.flavor = Ogni lanterna sui gradini del tempio è uscita dalle mani di qualcuno. Passa la notte a un banco, uno qualunque, e tieni occupate le tue.
