boostrule.mmo_christmas_trades.title = Natale
boostrule.mmo_christmas_day.title = Giorno di Natale
boostrule.mmo_christmas_new_years_eve.title = Notte di Capodanno

# ---- The Christmas Set's skill half (only where MMO Skill Tree runs) ----
# A set's notice is a toast, so no value carries markup.
gearset.mmo_christmas_set.tier_half = Più XP di Woodcutting.
gearset.mmo_christmas_set.tier_full = Ancora più XP di Woodcutting, e più fortuna quando tagli gli alberi.

# ---- Christmas Morning's treats, and Bram's present ----
lootable.christmas_treats.title = Un Sacchetto di Dolcetti
lootable.christmas_treats.flavor = Bastoncini di zucchero, biscotti o cioccolata, e ogni tanto una Torta di Natale intera.
lootable.christmas_bram_decorations.title = Il Regalo di Bram
lootable.christmas_bram_decorations.flavor = Un piccolo extra da Bram in ogni regalo che apri: un addobbo di Natale per casa tua.

# ---- The villagers' secrets ----
quest.christmas_tomas_apprentice.title = L'Apprendista di Tomas
quest.christmas_tomas_apprentice.flavor = Cuoci i miei dolcetti di Natale. Conta ogni dolcetto che fai. Cuocine abbastanza e ti vendo la ricetta del mio Pane di Natale.
quest.christmas_elsie_apprentice.title = L'Apprendista di Elsie
quest.christmas_elsie_apprentice.flavor = Metti degli addobbi di Natale a casa tua. Mettine abbastanza e ti vendo il mio Costume da Renna.
quest.christmas_bram_apprentice.title = L'Apprendista di Bram
quest.christmas_bram_apprentice.flavor = Abbatti tronchi da un albero qualsiasi. Tagliane abbastanza e ogni Regalo di Natale che apri contiene un piccolo extra da parte mia.
shop.christmas_offer_recipe_tomas_loaf.title = Ricetta: Pane di Natale di Tomas
shop.christmas_offer_recipe_tomas_loaf.desc = Il pane dolce di Tomas in persona. Ti muovi più in fretta e il freddo morde meno finché dura.
shop.christmas_offer_reindeer_suit.title = Costume da Renna
shop.christmas_offer_reindeer_suit.desc = Indossalo e per un po' sei una delle renne di Babbo Natale.
# A lock line reads "Requires " and then one of these; each server loads the one its overlay names.
factor.christmas_tomas_key.name = aver finito L'Apprendista di Tomas
factor.christmas_tomas_key.name_mmo = aver finito L'Apprendista di Tomas o il livello 20 di Crafting
factor.christmas_elsie_key.name = aver finito L'Apprendista di Elsie
factor.christmas_elsie_key.name_mmo = aver finito L'Apprendista di Elsie o il livello 20 di Building
# A costume's buff-bar tile name. Its effect's Name is this key in full (christmas.mmo.effect...).
effect.christmas_costume_reindeer_suit.name = Costume da Renna

# ---- Tomas's secret, in his Christmas conversation ----
dialogue.christmas_miller.apprentice_offer.text = Ho un segreto: un <b>Pane di Natale</b> tutto mio, più dolce di qualsiasi torta.\nCuoci per un po' i miei dolcetti di Natale e ti vendo la ricetta.
dialogue.christmas_miller.apprentice_offer.opt.accept = Insegnami.
dialogue.christmas_miller.apprentice_brief.text = Cuoci <b>Biscotti di Pan di Zenzero</b>, <b>Cioccolata Calda</b> o <b>Torta di Natale</b>. Conta ogni cosa. Torna quando ne hai cotti abbastanza.
dialogue.christmas_miller.apprentice_ready.text = Guardati, un vero fornaio. Ora la ricetta del mio <b>Pane di Natale</b> è nel mio negozio per te.
dialogue.christmas_miller.apprentice_ready.opt.turnin = Grazie, Tomas.
dialogue.christmas_miller.opt.secret_skill = E se sono già un bravo cuoco?
dialogue.christmas_miller.secret_skill.text = Allora non ti servono le mie lezioni. Arriva al <b>livello 20 di Crafting</b> e ti vendo comunque la ricetta del mio <b>Pane di Natale</b>.\nOppure cuoci un po' con me. Va bene l'una e l'altra.

# ---- Elsie's secret, in her Christmas conversation ----
dialogue.christmas_weaver.apprentice_offer.text = Ho un segreto: un <b>Costume da Renna</b> che ho cucito io. Non è per tutti.\nMetti degli <b>addobbi di Natale</b> a casa tua, e quando ne avrai messi abbastanza, te ne vendo uno.
dialogue.christmas_weaver.apprentice_offer.opt.accept = Addobberò la casa.
dialogue.christmas_weaver.apprentice_brief.text = Metti a casa tua ghirlande, luci, corone, pupazzi di neve, qualsiasi addobbo di Natale. Qui nel tempio non si può mettere niente. Gli addobbi li trovi sullo scaffale delle feste nel negozio di Babbo Natale, e dentro i Regali di Natale.
dialogue.christmas_weaver.apprentice_ready.text = La tua casa deve essere meravigliosa. Ora il mio <b>Costume da Renna</b> è nel mio negozio per te.
dialogue.christmas_weaver.apprentice_ready.opt.turnin = Grazie, Elsie.
dialogue.christmas_weaver.opt.secret_skill = E se so già addobbare bene?
dialogue.christmas_weaver.secret_skill.text = Allora non ti servono le mie lezioni. Arriva al <b>livello 20 di Building</b> e ti vendo comunque il mio <b>Costume da Renna</b>.\nOppure addobba un po' con me. Va bene in tutti e due i modi.

# ---- Bram's secret, in his Christmas conversation ----
dialogue.christmas_shepherd.apprentice_offer.text = Ho un segreto. Aiutami ad abbattere tronchi e ogni <b>Regalo di Natale</b> che apri contiene un piccolo extra da parte mia. Un addobbo, magari il fiocco di neve per la cima dell'albero.
dialogue.christmas_shepherd.apprentice_offer.opt.accept = Taglio io.
dialogue.christmas_shepherd.apprentice_brief.text = Taglia tronchi da un albero qualsiasi. Conta ogni blocco di tronco. Torna quando ne hai abbastanza.
dialogue.christmas_shepherd.apprentice_ready.text = Che bella catasta. D'ora in poi, ogni <b>Regalo di Natale</b> che apri ha dentro un piccolo extra da parte mia.
dialogue.christmas_shepherd.apprentice_ready.opt.turnin = Grazie, Bram.
dialogue.christmas_shepherd.opt.secret_skill = E se sono già bravo con l'ascia?
dialogue.christmas_shepherd.secret_skill.text = Allora non hai bisogno di me. Arriva al <b>livello 20 di Woodcutting</b> e ogni <b>Regalo di Natale</b> che apri contiene un piccolo extra da parte mia.\nOppure taglia un po' con me. Va bene l'una e l'altra.
