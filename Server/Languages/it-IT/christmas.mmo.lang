calendar.christmas_day.name = Giorno di Natale
calendar.christmas_day.flavor = Il gran giorno in persona.
calendar.christmas_new_years_eve.name = Notte di Capodanno
calendar.christmas_new_years_eve.flavor = L'ultima notte dell'anno.

