# ---- Martha's reputation ----
reputation.harvest_feast_host.name = Favore di Martha
reputation.harvest_feast_host.flavor = Martha ricorda chi è venuto ad aiutare e chi è venuto solo a mangiare.
reputation.harvest_feast_host.rank.neutral = Nuovo Arrivato
reputation.harvest_feast_host.rank.friendly = Vicino di Casa
reputation.harvest_feast_host.rank.honored = Amico
reputation.harvest_feast_host.rank.revered = Famiglia
reputation.harvest_feast_host.rank.exalted = Capotavola
reputation.harvest_feast_host.earn.quests = Completa le sue missioni e i suoi lavori giornalieri.
reputation.harvest_feast_host.earn.board = Prendi lavori dalla Bacheca della Festa.
reputation.harvest_feast_host.earn.talk = Passa a scambiare due parole una volta al giorno.
reputation.harvest_feast_host.earn.turkeys = Caccia i tacchini nelle Emerald Wilds finché dura la festa (un Tacchino Selvatico dà di più), e prendi da lei Tacchini Extra quante volte vuoi.
reputation.harvest_feast_host.earn.gear = Indossa il Set del Raccolto del suo negozio, e guadagni il suo favore più in fretta.
lootable.harvest_feast_feast_basket.title = Cesto della Festa
lootable.harvest_feast_feast_basket.flavor = Martha te ne prepara uno ogni volta che il tuo favore con lei sale di un altro gradino oltre Capotavola.
notify.harvest_feast_feast_basket = Un Cesto della Festa da Martha, per tutto l'aiuto dato a tavola.

# ---- The feast board ----
board.harvest_feast_daily.title = La Bacheca della Festa
board.harvest_feast_daily.desc = Lavori nei campi e lavori in cucina, freschi ogni mattina. Più aiuti, più ne metto da parte per te. Ritira la paga prima che la tavola venga sparecchiata. Se arrivi tardi, quello che hai guadagnato ti aspetta comunque nel tuo Libro degli obiettivi.
board.harvest_feast_daily.grade.field = Lavoro nei Campi
board.harvest_feast_daily.grade.kitchen = Lavoro in Cucina
quest.harvest_feast_board_turkeys.title = Lavoro dei Tacchini
quest.harvest_feast_board_turkeys.flavor = Caccia i Tacchini Selvatici di giorno nei boschi e sulle pianure delle Emerald Wilds. Corrono come se sapessero cosa c'è per cena.
quest.harvest_feast_board_wheat.title = Lavoro del Grano
quest.harvest_feast_board_wheat.flavor = Raccogli a mano il grano selvatico sulle pianure delle Emerald Wilds. Non aspetta il gelo.
quest.harvest_feast_board_pumpkins.title = Lavoro delle Zucche
quest.harvest_feast_board_pumpkins.flavor = Raccogli le zucche a mano nei boschi autunnali delle Emerald Wilds. Ogni torta comincia da una.
quest.harvest_feast_board_carrots.title = Lavoro delle Carote
quest.harvest_feast_board_carrots.flavor = Raccogli le carote a mano nelle foreste delle Emerald Wilds. Voglio un cesto pieno per la tavola.
quest.harvest_feast_board_pies.title = Lavoro delle Torte
quest.harvest_feast_board_pies.flavor = Inforna torte di zucca a un Fornello dello Chef e portale a tavola finché sono calde.
quest.harvest_feast_board_roast.title = Lavoro di Cucina
quest.harvest_feast_board_roast.flavor = Cuoci della carne cruda su un Falò e portala a tavola. Basta il profumo a portare la gente.
quest.harvest_feast_board_vegetables.title = Lavoro delle Verdure
quest.harvest_feast_board_vegetables.flavor = Arrostisci delle verdure su un Falò e portale a tavola. Vanno bene una carota, il mais, una zucca o un fungo.
quest.harvest_feast_board_spices.title = Lavoro delle Spezie
quest.harvest_feast_board_spices.flavor = Prepara le Spezie a un Fornello dello Chef con dei fiori e una verdura, o tieni quelle che trovi raccogliendo zucche. Portale qui.

# ---- The feast stall ----
shop.harvest_feast_host.title = Il Negozio della Festa
shop.harvest_feast_host.desc = Ricette dal mio libro, popcorn a sacchetti, abiti per i campi e qualcosa per la casa.
shop.harvest_feast_host.category.kitchen = Cucina
shop.harvest_feast_host.category.clothes = Abiti
shop.harvest_feast_host.category.decor = Decorazioni
shop.harvest_feast_offer_recipe_turkey_pie.title = Ricetta: Torta di Tacchino
shop.harvest_feast_offer_recipe_turkey_pie.desc = La torta di carne di Martha. Cuocila a un Fornello dello Chef per avere più salute massima e subire meno danni, più a lungo di qualsiasi altra torta.
shop.harvest_feast_offer_recipe_harvest_salad.title = Ricetta: Insalata del Raccolto
shop.harvest_feast_offer_recipe_harvest_salad.desc = Carote, mais e zucca. Preparala a un Fornello dello Chef per avere più stamina massima, più a lungo di qualsiasi altra insalata.
shop.harvest_feast_offer_recipe_marthas_roast.title = Ricetta: Arrosto di Martha
shop.harvest_feast_offer_recipe_marthas_roast.desc = Il suo piatto migliore, scritto per la famiglia. Più salute e stamina massime, e il Favore di Martha cresce più in fretta finché dura.
shop.harvest_feast_offer_harvest_gloves.title = Guanti del Raccolto
shop.harvest_feast_offer_harvest_gloves.desc = Caldi guanti di lana, parte del Set del Raccolto. Indossa il set intero e guadagni più in fretta il favore di Martha.
shop.harvest_feast_offer_harvest_hat.title = Cappello del Raccolto
shop.harvest_feast_offer_harvest_hat.desc = Un caldo cappello di lana, parte del Set del Raccolto. Indossa il set intero e guadagni più in fretta il favore di Martha.
shop.harvest_feast_offer_harvest_trousers.title = Pantaloni del Raccolto
shop.harvest_feast_offer_harvest_trousers.desc = Pantaloni di lana per i campi, parte del Set del Raccolto. Indossa il set intero e guadagni più in fretta il favore di Martha.
shop.harvest_feast_offer_harvest_tunic.title = Tunica del Raccolto
shop.harvest_feast_offer_harvest_tunic.desc = Una tunica di lana, l'ultimo pezzo del Set del Raccolto. Indossa il set intero e guadagni più in fretta il favore di Martha.

# ---- The Harvest Set ----
# A set's notice is a toast, so no value carries markup.
gearset.harvest_feast_harvest_set.title = Set del Raccolto
gearset.harvest_feast_harvest_set.tier_half = A metà set: un po' più di salute.
gearset.harvest_feast_harvest_set.tier_full = Set intero indosso: ancora più salute, e guadagni più in fretta il favore di Martha.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Incontra Martha
quest.harvest_feast_martha_meet.flavor = I campi sono raccolti, quindi cucino di nuovo nel Tempio Dimenticato. Ci arrivi da un Portale del Tempio Dimenticato qualsiasi. Vieni a cercarmi, e vieni con appetito.
objective.harvest_feast.meet_martha = Trova Martha la Cuoca nel Tempio Dimenticato

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Raccolto di Grano
quest.harvest_feast_host_1.flavor = Prima il pane, sempre. Il grano selvatico cresce sulle pianure delle Emerald Wilds. Raccoglimene una bella bracciata a mano e portala al Tempio Dimenticato.
quest.harvest_feast_host_2.title = Caccia al Tacchino
quest.harvest_feast_host_2.flavor = I Tacchini Selvatici girano di giorno nei boschi e sulle pianure delle Emerald Wilds. Caccia qualcuno, poi torna da me. La tavola non vale niente senza un arrosto.
quest.harvest_feast_host_3.title = La Tua Prima Torta
quest.harvest_feast_host_3.flavor = Tocca a te ai fornelli. Usa la ricetta che ti ho dato per impararla, inforna una torta di zucca a un Fornello dello Chef con impasto, una zucca e spezie, e portala a me.
quest.harvest_feast_the_feast.title = Il Banchetto
quest.harvest_feast_the_feast.flavor = Una volta l'anno mettiamo tutto in tavola. Inforna una torta di zucca a un Fornello dello Chef, cuoci della carne su un Falò, raccogli carote nelle foreste e portami tutto.

# ---- Martha's dailies and Extra Turkeys ----
quest.harvest_feast_daily_turkeys.title = Tacchini del Giorno
quest.harvest_feast_daily_turkeys.flavor = L'arrosto di ieri è finito fino all'ultimo osso. Caccia qualche altro Tacchino Selvatico nelle Emerald Wilds e ne comincio un altro.
quest.harvest_feast_daily_wheat.title = Grano del Giorno
quest.harvest_feast_daily_wheat.flavor = Ogni pagnotta che ho sfornato oggi è già sparita. Portami altro grano dalle pianure, o domattina niente pane.
quest.harvest_feast_daily_roast.title = Arrosto del Giorno
quest.harvest_feast_daily_roast.flavor = Cuoci della carne cruda su un Falò e portala qui. La gente continua a mangiarsela prima che arrivi a tavola.
quest.harvest_feast_extra_turkeys.title = Tacchini Extra
quest.harvest_feast_extra_turkeys.flavor = Prendo tutti i tacchini che riesci a catturare. Caccia altri Tacchini Selvatici nelle Emerald Wilds, poi torna da me. Fallo quante volte vuoi.

