# ---- The feast board ----
board.harvest_feast_daily.title = La Bacheca della Festa
board.harvest_feast_daily.desc = Lavori nei campi e lavori in cucina, freschi ogni mattina. Più aiuti, più ne metto da parte per te. Ritira la paga prima che la tavola venga sparecchiata. Se arrivi tardi, quello che hai guadagnato ti aspetta comunque nel tuo Libro degli obiettivi.
board.harvest_feast_daily.grade.field = Lavoro nei Campi
board.harvest_feast_daily.grade.kitchen = Lavoro in Cucina
quest.harvest_feast_board_turkeys.title = Lavoro dei Tacchini
quest.harvest_feast_board_turkeys.flavor = Caccia i Tacchini Selvatici di giorno nei boschi e sulle pianure delle Emerald Wilds. Mi servono per l'arrosto.
quest.harvest_feast_board_wheat.title = Lavoro del Grano
quest.harvest_feast_board_wheat.flavor = Raccogli a mano il grano selvatico sulle pianure delle Emerald Wilds. È il pane di domani.
quest.harvest_feast_board_pumpkins.title = Lavoro delle Zucche
quest.harvest_feast_board_pumpkins.flavor = Raccogli le zucche a mano nei boschi autunnali delle Emerald Wilds. Ogni torta comincia da una.
quest.harvest_feast_board_carrots.title = Lavoro delle Carote
quest.harvest_feast_board_carrots.flavor = Raccogli le carote a mano nelle foreste delle Emerald Wilds. Voglio un cesto pieno per la tavola.
quest.harvest_feast_board_pies.title = Lavoro delle Torte
quest.harvest_feast_board_pies.flavor = La tavola vuole sempre altra torta. Inforna delle torte di zucca e portamele.
quest.harvest_feast_board_roast.title = Lavoro di Cucina
quest.harvest_feast_board_roast.flavor = Cuoci della carne e portamela. Basta il profumo a portare la gente.
quest.harvest_feast_board_vegetables.title = Lavoro delle Verdure
quest.harvest_feast_board_vegetables.flavor = Arrostisci delle verdure e portale a tavola.
quest.harvest_feast_board_spices.title = Lavoro delle Spezie
quest.harvest_feast_board_spices.flavor = Portami delle Spezie. Raccogliendo le zucche a mano se ne trovano.

# ---- The feast stall ----
shop.harvest_feast_host.title = Il Negozio della Festa
shop.harvest_feast_host.desc = Ricette dal mio libro, popcorn a sacchetti, abiti per i campi e qualcosa per la casa.
shop.harvest_feast_host.category.kitchen = Cucina
shop.harvest_feast_host.category.clothes = Abiti
shop.harvest_feast_host.category.decor = Decorazioni
shop.harvest_feast_offer_recipe_turkey_pie.title = Ricetta: Torta di Tacchino
shop.harvest_feast_offer_recipe_turkey_pie.desc = La torta di carne di Martha. Cuocila a un Fornello dello Chef per avere più salute massima e subire meno danni, più a lungo di qualsiasi altra torta.
shop.harvest_feast_offer_recipe_harvest_salad.title = Ricetta: Insalata del Raccolto
shop.harvest_feast_offer_recipe_harvest_salad.desc = Carote, mais e zucca. Preparala a un Fornello dello Chef per avere più stamina massima, più a lungo di qualsiasi altra insalata.
shop.harvest_feast_offer_recipe_marthas_roast.title = Ricetta: Arrosto di Martha
shop.harvest_feast_offer_recipe_marthas_roast.desc = Il suo piatto migliore, scritto per la famiglia. Più salute e stamina massime, e il Favore di Martha cresce più in fretta finché dura.
shop.harvest_feast_offer_harvest_gloves.title = Guanti del Raccolto
shop.harvest_feast_offer_harvest_gloves.desc = Caldi guanti di lana, parte del Set del Raccolto. Indossa il set intero e guadagni più in fretta il favore di Martha.
shop.harvest_feast_offer_harvest_hat.title = Cappello del Raccolto
shop.harvest_feast_offer_harvest_hat.desc = Un caldo cappello di lana, parte del Set del Raccolto. Indossa il set intero e guadagni più in fretta il favore di Martha.
shop.harvest_feast_offer_harvest_trousers.title = Pantaloni del Raccolto
shop.harvest_feast_offer_harvest_trousers.desc = Pantaloni di lana per i campi, parte del Set del Raccolto. Indossa il set intero e guadagni più in fretta il favore di Martha.
shop.harvest_feast_offer_harvest_tunic.title = Tunica del Raccolto
shop.harvest_feast_offer_harvest_tunic.desc = Una tunica di lana, l'ultimo pezzo del Set del Raccolto. Indossa il set intero e guadagni più in fretta il favore di Martha.

