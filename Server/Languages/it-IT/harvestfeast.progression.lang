# Harvest Feast progression: Martha's intro quest, her questline, the yearly feast and the dailies, the
# feast board and the feast stall, her conversation, the season's achievements and titles, her
# reputation and the Almanac page, the shared meal and the invitation tour, and the feast's villagers.
# Keys are written bare: the library finds each one by its tail, whatever this file is called. A quest,
# a contract or an achievement takes its words from the keys its id spells (quest.<id>.title and
# .flavor, achievement.<id>.title and .desc), so no content file names those. Numbers ride {0} and
# come from the content files, so a retune never touches a translation.

# ---- Martha's reputation ----
reputation.harvest_feast_host.name = Favore alla Festa
reputation.harvest_feast_host.flavor = Martha ricorda chi è venuto ad aiutare e chi è venuto solo a mangiare.
reputation.harvest_feast_host.rank.neutral = Nuovo Arrivato
reputation.harvest_feast_host.rank.friendly = Vicino di Casa
reputation.harvest_feast_host.rank.honored = Volto Noto
reputation.harvest_feast_host.rank.revered = Famiglia
reputation.harvest_feast_host.rank.exalted = Capotavola

# ---- The feast board ----
board.harvest_feast_daily.title = La Bacheca della Festa
board.harvest_feast_daily.desc = Lavori nei campi e lavori in cucina, freschi ogni mattina. Più aiuti, più ne metto da parte per te. Ritira la paga prima che la tavola venga sparecchiata. Se arrivi tardi, quello che hai guadagnato ti aspetta comunque nel tuo Libro degli obiettivi.
board.harvest_feast_daily.grade.field = Lavoro nei Campi
board.harvest_feast_daily.grade.kitchen = Lavoro in Cucina
quest.harvest_feast_board_turkeys.title = Battuta ai Tacchini
quest.harvest_feast_board_turkeys.flavor = I boschi sono pieni di tacchini questa settimana. Abbattine parecchi, se riesci a prenderli; corrono come se sapessero cosa c'è per cena.
quest.harvest_feast_board_wheat.title = Raccolto di Grano
quest.harvest_feast_board_wheat.flavor = Il grano selvatico non aspetta nessuno. Raccoglilo prima che arrivi il gelo.
quest.harvest_feast_board_pies.title = Torte per la Tavola
quest.harvest_feast_board_pies.flavor = Ogni posto a tavola vuole una fetta. Inforna un paio di torte di zucca e portale qui finché sono calde.
quest.harvest_feast_board_roast.title = Il Fuoco all'Aperto
quest.harvest_feast_board_roast.flavor = Cuoci un bel mucchio di carne su un fuoco aperto. Basta il profumo a portare la gente a tavola.

# ---- The feast stall ----
shop.harvest_feast_host.title = La Bancarella della Festa
shop.harvest_feast_host.desc = Ricette dal mio libro, popcorn a sacchetti e qualcosa per la casa.
shop.harvest_feast_host.category.kitchen = Cucina
shop.harvest_feast_host.category.decor = Decorazioni
shop.harvest_feast_offer_recipe_apple_pie.title = Ricetta della Torta di Mele
shop.harvest_feast_offer_recipe_apple_pie.desc = Leggila una volta e saprai fare la torta di mele per sempre.
shop.harvest_feast_offer_recipe_meat_pie.title = Ricetta della Torta di Carne
shop.harvest_feast_offer_recipe_meat_pie.desc = La torta di carne di Martha, messa per iscritto per gli amici della tavola.
shop.harvest_feast_offer_recipe_caesar_salad.title = Ricetta dell'Insalata Caesar
shop.harvest_feast_offer_recipe_caesar_salad.desc = L'insalata Caesar di Martha, messa per iscritto per la famiglia.

# ---- Martha's intro quest ----
quest.harvest_feast_martha_meet.title = Cena nel Tempio
quest.harvest_feast_martha_meet.flavor = I campi sono raccolti, quindi cucino di nuovo nel Tempio Dimenticato. Ci arrivi da un Portale del Tempio Dimenticato qualsiasi. Vieni a cercarmi, e vieni con appetito.
objective.harvest_feast.meet_martha = Trova Martha la Cuoca nel Tempio Dimenticato

# ---- Martha's questline and the yearly feast ----
quest.harvest_feast_host_1.title = Grano per i Forni
quest.harvest_feast_host_1.flavor = Prima il pane, sempre. Il grano selvatico cresce fitto in questo periodo, quindi portami una bella bracciata per i forni.
quest.harvest_feast_host_2.title = La Caccia al Tacchino
quest.harvest_feast_host_2.flavor = I tacchini selvatici sono grassi e rumorosi questo mese, e non così sciocchi come sembrano. Abbattine qualcuno; la tavola non vale niente senza un arrosto.
quest.harvest_feast_host_3.title = La Prima Torta
quest.harvest_feast_host_3.flavor = Tocca a te ai fornelli. Impara quella ricetta, inforna una torta di zucca a un Fornello dello Chef e portala a me.
quest.harvest_feast_the_feast.title = La Lunga Tavola
quest.harvest_feast_the_feast.flavor = Una volta l'anno mettiamo tutto in tavola e mangiamo finché nessuno si regge in piedi. Porta una torta, un po' di arrosto e un cesto di carote, e la apparecchiamo insieme.

# ---- Martha's dailies ----
quest.harvest_feast_daily_turkeys.title = Corsa ai Tacchini
quest.harvest_feast_daily_turkeys.flavor = L'arrosto di ieri è finito fino all'ultimo osso. Portami qualche altro tacchino e ne comincio un altro.
quest.harvest_feast_daily_wheat.title = Pane per il Mattino
quest.harvest_feast_daily_wheat.flavor = Ogni pagnotta che ho sfornato oggi è già sparita. Portami altro grano, o domattina niente pane.
quest.harvest_feast_daily_roast.title = Arrosto per la Tavola
quest.harvest_feast_daily_roast.flavor = Cuoci della carne su un fuoco e portala qui. La gente continua a mangiarsela prima che arrivi a tavola.

