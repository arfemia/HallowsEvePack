# Christmas - the Yeti Cave: the cave's name and its lines, the Yeti's fight's notices, his Boss Kill
# Claim, Bram's Yeti Bait offer and way-in line, and the Yeti Hunter achievement. Keys are written bare:
# the library finds each one by its tail, whatever this file is called. Numbers ride {0} and come from
# the content files, so a retune never touches a translation. The Yeti's nameplate is in npcs.lang and
# his bait's and fur's names in items.lang.

# ---- The Yeti Cave ----
dungeon.christmas_yeti_cave.name = La Grotta dello Yeti
dungeon.christmas_yeti_cave.description = Qui vive lo Yeti che ha spaventato una delle renne di Babbo Natale, con una pila di regali rubati. Porta degli amici, e copriti bene.
dungeon.christmas_yeti_cave.goal = Entra nella grotta per svegliare lo Yeti, poi abbattilo. Allontanati quando un anello si accende attorno a lui, e togliti dagli anelli sotto i tuoi piedi prima che arrivino le sue palle di neve.
dungeon.christmas_yeti_cave.cost_hint = Bram vende l'Esca per Yeti nel suo negozio dopo che hai portato le carote alle sue renne.
dungeon.christmas_yeti_cave.confirm = Lancia l'Esca
dungeon.christmas_yeti_cave.chest = La tua ricompensa ti aspetta nel forziere dove è caduto.

# ---- The Yeti's fight ----
notify.christmas_yeti_engaged = Lo Yeti si sveglia!
notify.christmas_yeti_engaged.sub = Abbattilo e la sua scorta di regali è tua.
notify.christmas_yeti_snowballs = Lo Yeti inizia a lanciare palle di neve! Togliti dagli anelli.
notify.christmas_yeti_wolves = Due Lupi Bianchi vengono in aiuto dello Yeti!
notify.christmas_yeti_defeated = Lo Yeti è a terra!
notify.christmas_yeti_defeated.sub = La tua parte: {0}%, in {1, number} secondi.
notify.christmas_yeti_wiped = Lo Yeti torna nella sua tana.
notify.christmas_yeti_wiped.sub = Allontanati quando un anello si accende attorno a lui, e togliti dagli anelli prima che arrivino le sue palle di neve.
claim.christmas_yeti_chase = Lo Yeti: Uccisione Boss

# ---- Bram's stall and his way in ----
shop.christmas_offer_yeti_bait.title = Esca per Yeti
shop.christmas_offer_yeti_bait.desc = Un pesce a cui nessuno Yeti sa dire di no. Bram ne prende uno per portare te e i tuoi amici nella Grotta dello Yeti.
dialogue.christmas_yeti_cave_line.opt.enter = Portami alla Grotta dello Yeti. (costa un'Esca per Yeti, dal negozio di Bram)

# ---- Achievement ----
achievement.christmas_yeti_hunter.title = Cacciatore di Yeti {0}
achievement.christmas_yeti_hunter.desc = Sconfiggi lo Yeti nella sua grotta.
