              {
                "Sensor": {
                  "Type": "AdjustPosition",
                  "Sensor": { "Type": "Leash", "Range": 0.1 },
                  "Offset": [ -8.5, 7, -1.5 ]
                },
                "BodyMotion": {
                  "Type": "Seek",
                  "DesiredAltitudeWeight": 0,
                  "RelativeSpeed": { "Compute": "SwingSpeed" },
                  "SlowDownDistance": 2,
                  "StopDistance": 1
                }
              }
            ]
          }
        ]
      },
      {
        "$Comment": "Lap_1 to Lap_8: round the fountain clockwise seen from above, north, east, south, west, 7 blocks from its centre and 7 up, until LapTime runs out, then dive. Each lap point is stored in the Lap_Point slot so the next instruction can tell when he reaches it.",
        "Sensor": {
          "Type": "State",
          "State": ".Lap_1"
        },
        "Instructions": [
          {
            "Sensor": { "Type": "Timer", "Name": "Hallows_Eve_Horseman_Lap", "State": "Stopped" },
            "Actions": [
              { "Type": "TimerStart", "Name": "Hallows_Eve_Horseman_Dive", "StartValueRange": { "Compute": "DiveTimeLimit" }, "RestartValueRange": { "Compute": "DiveTimeLimit" } },
              { "Type": "State", "State": ".Dive" }
            ]
          },
          {
            "Continue": true,
            "Sensor": { "Type": "AdjustPosition", "Sensor": { "Type": "Leash", "Range": 0.1 }, "Offset": [ 0, 7, 0 ] },
            "Actions": [ { "Type": "StorePosition", "Slot": "Hallows_Eve_Horseman_Lap_Point" } ]
          },
          {
            "Sensor": { "Type": "ReadPosition", "Slot": "Hallows_Eve_Horseman_Lap_Point", "Range": { "Compute": "LapPointReach" } },
            "Actions": [ { "Type": "State", "State": ".Lap_2" } ]
          },
          {
            "Sensor": { "Type": "ReadPosition", "Slot": "Hallows_Eve_Horseman_Lap_Point", "Range": 200 },
            "BodyMotion": { "Type": "Seek", "DesiredAltitudeWeight": 0, "RelativeSpeed": { "Compute": "LapSpeed" }, "SlowDownDistance": 2, "StopDistance": 1 }
          }
        ]
