{
  "$Comment": "The Gravekeeper: a still, invulnerable lantern wraith who stands near Old Jack in the Forgotten Temple while Hallow's Eve runs, talks, and sends whoever asks into the Headless Horseman's graveyard. Press F runs ZigPlacementInteract, which opens what the placement standing him authored under Interact (NpcPlacements/Hallows_Eve_Gravekeeper_Temple.json opens his conversation, Dialogues/HallowsEvePack/Hallows_Eve_Gravekeeper.json); the Dialogue on that action is the same conversation for a Gravekeeper nothing placed, such as one spawned by command. This is a full role body rather than a Variant of the library's quest-giver template because the template's worn armour and stance are not his. Hint is the library's shared talk prompt (npcs.Zig_QuestGiver.hint), read literally by the engine. BusyStates is left out on purpose: a conversation is per player, so a second player is never turned away while the first is talking. Appearance is the game's own lantern wraith; NameTranslationKey is in this pack's npcs.lang.",
  "Type": "Generic",
  "StartState": "Idle",
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Neutral",
  "Appearance": "Wraith_Lantern",
  "MaxHealth": 100,
  "IsMemory": false,
  "DisableDamageGroups": [ "Self" ],
  "CombatConfig": {
    "EntityEffects": [ "Immunity_Environmental" ]
  },
  "Invulnerable": true,
  "KnockbackScale": 0.0,
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 5,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 10
    }
  ],
  "Instructions": [
    {
      "Instructions": [
        {
          "$Comment": "Idle: nobody near; stand still.",
          "Sensor": { "Type": "State", "State": "Idle" },
          "Instructions": [
            {
              "Sensor": { "Type": "Player", "Range": 8 },
              "Actions": [ { "Type": "State", "State": "Watching" } ]
            },
            { "Sensor": { "Type": "Any" }, "BodyMotion": { "Type": "Nothing" } }
          ]
        },
        {
          "$Comment": "Watching: a player is near; follow them with the head, back to Idle when they leave.",
          "Sensor": { "Type": "State", "State": "Watching" },
          "Instructions": [
            {
              "Continue": true,
              "Sensor": { "Type": "Player", "Range": 12 },
              "HeadMotion": { "Type": "Watch" }
            },
            {
              "Sensor": { "Type": "Not", "Sensor": { "Type": "Player", "Range": 12 } },
              "Actions": [ { "Type": "State", "State": "Idle" } ]
            },
            { "Sensor": { "Type": "Any" }, "BodyMotion": { "Type": "Nothing" } }
          ]
        },
        {
          "$Comment": "Interaction: F was pressed; look at the player, then back to Watching.",
          "Sensor": { "Type": "State", "State": "$Interaction" },
          "Instructions": [
            {
              "Continue": true,
              "Sensor": { "Type": "Target", "Range": 10 },
              "HeadMotion": { "Type": "Watch" }
            },
            {
              "Sensor": { "Type": "Any" },
              "Actions": [
                {
                  "Type": "Timeout",
                  "Delay": [ 1, 1 ],
                  "Action": {
                    "Type": "Sequence",
                    "Actions": [
                      { "Type": "ReleaseTarget" },
                      { "Type": "State", "State": "Watching" }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Instructions": [
      {
        "Sensor": { "Type": "Not", "Sensor": { "Type": "CanInteract", "ViewSector": 180 } },
        "Actions": [ { "Type": "SetInteractable", "Interactable": false } ]
      },
      {
        "Continue": true,
        "Sensor": { "Type": "Any" },
        "Actions": [ { "Type": "SetInteractable", "Interactable": true, "Hint": "npcs.Zig_QuestGiver.hint" } ]
      },
      {
        "Sensor": { "Type": "HasInteracted" },
        "Instructions": [
          {
            "Sensor": { "Type": "Not", "Sensor": { "Type": "State", "State": "$Interaction" } },
            "Actions": [
              { "Type": "LockOnInteractionTarget" },
              { "Type": "ZigPlacementInteract", "Dialogue": "Hallows_Eve_Gravekeeper" },
              { "Type": "State", "State": "$Interaction" }
            ]
          }
        ]
      }
    ]
  },
  "NameTranslationKey": "npcs.Hallows_Eve_Gravekeeper.name"
}
