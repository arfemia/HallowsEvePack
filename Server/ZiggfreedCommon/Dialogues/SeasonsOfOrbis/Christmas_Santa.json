      "christmas_daily_presents": { "Offerable": "daily_presents_offer", "Active": "presents_brief", "Ready": "ready_generic" },
      "christmas_extra_thieves": { "Active": "thieves_brief", "Ready": "extra_thieves_ready" }
    },
    "Then": [
