        ],
        "Once": { "Period": "Daily" },
        "OnceId": "board_fresh",
        "Actions": [
          { "Type": "Grant", "Rewards": [ { "Kind": "Reputation", "Params": { "Reputation": "Harvest_Feast_Host", "Amount": 10 } } ] }
