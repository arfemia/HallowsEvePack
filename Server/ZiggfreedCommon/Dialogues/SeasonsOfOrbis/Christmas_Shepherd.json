          "LabelKey": "dialogue.christmas_shepherd.carrots_offer.opt.accept",
          "Style": "accept",
          "Do": [ { "Accept": "christmas_daily_carrots" }, { "Goto": "carrots_brief" } ]
        },
        { "LabelKey": "dialogue.christmas_shepherd.opt.later", "Style": "neutral", "Goto": "greeting" }
      ],
      "IncludeOptions": [ "goodbye" ]
    },
    "carrots_brief": {
