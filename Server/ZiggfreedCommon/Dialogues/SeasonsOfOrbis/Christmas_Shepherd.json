      "Options": [
        {
          "LabelKey": "dialogue.christmas_shepherd.carrots_ready.opt.turnin",
          "Style": "turnin",
          "Conditions": [ { "Type": "ReadyToTurnIn", "Quest": "christmas_daily_carrots" } ],
          "Do": [
            { "TurnIn": "christmas_daily_carrots" },
            { "Open": { "Type": "Quests", "Highlight": "christmas_daily_carrots" } }
          ]
        }
      ],
      "IncludeOptions": [ "goodbye" ]
    }
  },
  "Fragments": {
    "goodbye": [
      { "LabelKey": "dialogue.christmas_shepherd.opt.farewell", "Style": "farewell", "Close": true }
    ]
  }
}
