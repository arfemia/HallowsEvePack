{
  "$Comment": "Clears the Headless Horseman's own bookkeeping while his fight resets (his fight's reset slot runs it), so the next try starts from his first phase: the shield a flying Head left on him (ShieldClear, run once where he stands), every Horseman_ flag the phase macros and his volleys set, and the Head slot. Add a flag here whenever a Horseman macro gains one.",
  "Class": "Instruction",
  "Type": "Component",
  "Interface": "Hytale.Instruction.Encounter.Phase.Behavior",
  "Parameters": {
    "ShieldClear": {
      "Value": "Root_Hallows_Eve_Horseman_Clear_Shield",
      "Description": "The interaction run where he stands to take off the shield a flying Head left on him."
    },
    "Range": {
      "Value": 80,
      "Description": "How far from the script's entity the boss is looked for."
    }
  },
  "Content": {
    "Continue": true,
    "Sensor": {
      "Type": "Any"
    },
    "Instructions": [
      {
        "$Comment": "His head was flying when the fight reset: his shield comes off, once, before the flags below clear.",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Target",
              "TargetSlot": "Boss",
              "Range": { "Compute": "Range" }
            },
            {
              "Type": "Flag",
              "Name": "Horseman_Head_Out"
            }
          ]
        },
        "Actions": [
          {
            "Type": "SpawnInteraction",
            "PositionSource": "Sensor",
            "Interaction": { "Compute": "ShieldClear" },
            "OrientationSource": "Absolute"
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          { "Type": "SetFlag", "Name": "Horseman_P2_Armed", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_P2_Landed", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_Head_Out", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_Head_Bound", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_Head_Flown", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_P3_Armed", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_Unhorse_GuardArmed", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_P1_Volley_Armed", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_P1_Volley_Active", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_P1_Volley_Running", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_P3_Volley_Armed", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_P3_Volley_Active", "SetTo": false },
          { "Type": "SetFlag", "Name": "Horseman_P3_Volley_Running", "SetTo": false },
          { "Type": "ReleaseTarget", "TargetSlot": "Head" }
        ]
      }
    ]
  }
}
